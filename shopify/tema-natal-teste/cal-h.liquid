{%- comment -%}
  Natal 2026 · Ouro de Reis — «Calendário de Ouro, do Advento aos Reis».
  Grelha de mês verdadeira (6 semanas, a começar à segunda); cada bloco «dia» é uma porta.
  O conteúdo de cada porta fica num <template> e só entra na página (e carrega imagens) quando a porta abre.
  As portas abrem no navegador com window.LOD_NATAL.hoje() (hora de Lisboa, respeita a data simulada).
  No editor do tema todas as portas abrem. Sem prémios, sorteios nem descontos atrás de nenhuma porta.

  Línguas e mercados (contrato: scratchpad/natal/i18n-contrato.md):
  - A definição «Versão do calendário» diz de que mercado é a instância: «pt» (Portugal, «Ouro de Reis») ou «es»
    (Espanha, «Oro de Reyes»). A instância só aparece no site quando a versão do mercado da visita é a mesma
    (lod-natal-fase, mercado: 'auto'). O Internacional não tem calendário.
  - Fases ativas: Portugal ouro, incenso, ultima, consoada, mirra; Espanha navidad, reyes, reyes_ultima, noche_reyes.
  - Textos fixos do dicionário lod-natal-t; datas na língua da página. O conteúdo de cada porta tem o campo base
    (português) e os campos _en e _es; um campo _en/_es vazio usa o campo base.
  - Ligações escritas à mão («/collections/…», «/#…») ganham o prefixo da língua e do mercado (routes.root_url).

  Textos das portas (história, frase das peças e dica) aceitam marcadores com as datas das definições
  do tema › Natal 2026, como o banner: {acores}, {madeira}, {gravacao}, {continente}, {reis}, {retoma}
  (ex.: «domingo, 20 de dezembro»), {loja} («24 de dezembro, 13h», como na barra, no banner e nos Prazos), {trocas} («15 de janeiro de 2027»),
  {hora_continente} e {hora_reis} («23h59»). Espanha e Internacional (só o dia, nunca a hora): {es_navidad}, {es_reyes},
  {es_noche} e {int}. Todas saem na língua da página.
  A «frase das peças» só aparece quando todas as peças escolhidas estão à venda. Se nenhuma estiver,
  a porta mostra duas peças à venda da coleção do bloco.
  Um bloco pode depender de uma decisão (trocas de Natal aprovadas, Janeiras confirmadas): enquanto
  estiver desligada, aparece o outro bloco da mesma data.
  No editor, uma lista avisa de datas fora da grelha, peças esgotadas ou com 1 unidade, marcadores
  desconhecidos e portas «hoje/amanhã é o último dia» cuja data já não bate com o prazo das definições.
{%- endcomment -%}
{%- liquid
  capture lnat_lg
    render 'lod-natal-t', k: '_lingua'
  endcapture
  assign lnat_lg = lnat_lg | strip
  capture lnat_versao
    render 'lod-natal-fase', mercado: 'auto', devolve: 'versao'
  endcapture
  assign lnat_versao = lnat_versao | strip
  capture lnat_fase
    render 'lod-natal-fase', mercado: 'auto'
  endcapture
  assign lnat_fase = lnat_fase | strip

  # Versão desta instância: o calendário de Portugal não aparece em Espanha, nem o de Espanha em Portugal.
  assign cal_versao = section.settings.versao | default: 'pt'
  assign cal_ativa = false
  case lnat_versao
    when 'pt'
      case lnat_fase
        when 'ouro', 'incenso', 'ultima', 'consoada', 'mirra'
          assign cal_ativa = true
      endcase
    when 'es'
      case lnat_fase
        when 'navidad', 'reyes', 'reyes_ultima', 'noche_reyes'
          assign cal_ativa = true
      endcase
  endcase
  assign cal_mercado_ok = false
  if lnat_versao == cal_versao
    assign cal_mercado_ok = true
  endif
  assign cal_editor = false
  if request.design_mode
    assign cal_editor = true
  endif
  assign cal_mostrar = cal_editor
  if cal_ativa and cal_mercado_ok
    assign cal_mostrar = true
  endif
-%}
{%- if cal_mostrar -%}
{%- liquid
  assign cal_id = section.settings.ancora | default: 'calendario' | handleize
  assign cal_sid = 'lnat-cal-' | append: section.id

  assign cal_hoje = 'now' | date: '%Y-%m-%d'
  if settings.natal_data_simulada != blank and theme.role != 'main'
    assign cal_hoje = settings.natal_data_simulada | strip | slice: 0, 10
  endif

  assign cal_inicio = section.settings.grelha_inicio | default: '2026-11-30' | strip | slice: 0, 10
  assign cal_t0 = cal_inicio | append: ' 12:00' | date: '%s' | plus: 0
  if cal_t0 < 1000000000
    assign cal_inicio = '2026-11-30'
    assign cal_t0 = '2026-11-30 12:00' | date: '%s' | plus: 0
  endif
  assign cal_tfim = cal_t0 | plus: 3542400
  assign cal_fim = cal_tfim | date: '%Y-%m-%d'

  # Textos fixos na língua da página (dicionário lod-natal-t), lidos uma vez antes do ciclo das 42 células
  capture t_dias
    render 'lod-natal-t', k: 'dias'
  endcapture
  capture t_dabr
    render 'lod-natal-t', k: 'dias_abr'
  endcapture
  capture t_meses
    render 'lod-natal-t', k: 'meses'
  endcapture
  capture t_mabr
    render 'lod-natal-t', k: 'meses_abr'
  endcapture
  capture t_sem_ini
    render 'lod-natal-t', k: 'semana_iniciais'
  endcapture
  capture t_sem_nomes
    render 'lod-natal-t', k: 'semana_nomes'
  endcapture
  capture t_hoje
    render 'lod-natal-t', k: 'hoje'
  endcapture
  capture t_hoje_min
    render 'lod-natal-t', k: 'hoje_min'
  endcapture
  capture t_abrir
    render 'lod-natal-t', k: 'abrir'
  endcapture
  capture t_abrir_hoje
    render 'lod-natal-t', k: 'cal_abrir_hoje'
  endcapture
  capture t_ja_aberta
    render 'lod-natal-t', k: 'ja_aberta'
  endcapture
  capture t_ja_aberta_min
    render 'lod-natal-t', k: 'ja_aberta_min'
  endcapture
  capture t_fechada
    render 'lod-natal-t', k: 'ainda_fechada'
  endcapture
  capture t_abre_a
    render 'lod-natal-t', k: 'abre_a'
  endcapture
  capture t_abre_a_min
    render 'lod-natal-t', k: 'abre_a_min'
  endcapture
  capture t_porta_abre_a
    render 'lod-natal-t', k: 'porta_abre_a'
  endcapture
  capture t_porta_ant
    render 'lod-natal-t', k: 'porta_anterior'
  endcapture
  capture t_porta_seg
    render 'lod-natal-t', k: 'porta_seguinte'
  endcapture
  capture t_ver_colecao
    render 'lod-natal-t', k: 'ver_colecao'
  endcapture
  capture t_saber_mais
    render 'lod-natal-t', k: 'saber_mais'
  endcapture
  capture t_rot_dica
    render 'lod-natal-t', k: 'dica'
  endcapture
  capture t_fechar
    render 'lod-natal-t', k: 'fechar'
  endcapture
  capture t_partilhar
    render 'lod-natal-t', k: 'partilhar'
  endcapture
  capture t_copiada
    render 'lod-natal-t', k: 'ligacao_copiada'
  endcapture
  capture t_marca
    render 'lod-natal-t', k: 'marca'
  endcapture

  # Listas: dias e dias_abr começam no domingo (índice = %w); meses e meses_abr ficam a contar de 1 (janeiro).
  assign cal_dias = t_dias | split: ','
  assign cal_dabr = t_dabr | split: ','
  assign cal_meses = ',' | append: t_meses | split: ','
  assign cal_mabr = ',' | append: t_mabr | split: ','
  assign cal_sem_ini = t_sem_ini | split: ','
  assign cal_sem_nomes = t_sem_nomes | split: ','
  # «sexta, 18 de dezembro» / «Friday 18 December» / «viernes, 18 de diciembre» (como lod-natal-data)
  assign cal_de = ' de '
  assign cal_vg = ', '
  if lnat_lg == 'en'
    assign cal_de = ' '
    assign cal_vg = ' '
  endif
  assign cal_ouro = section.settings.dias_ouro | default: '' | remove: ' ' | split: ','

  assign cal_t_m1 = cal_t0 | plus: 604800
  assign cal_m1 = cal_t_m1 | date: '%-m' | plus: 0
  assign cal_a1 = cal_t_m1 | date: '%Y'
  assign cal_m2 = cal_tfim | date: '%-m' | plus: 0
  assign cal_a2 = cal_tfim | date: '%Y'
  # Primeira letra em maiúscula sem «| capitalize» (que passava «December» a «december»)
  assign cal_mn = cal_meses[cal_m1]
  assign cal_mn_a = cal_mn | slice: 0 | upcase
  assign cal_mn_b = cal_mn | slice: 1, 30
  assign cal_meses_txt = cal_mn_a | append: cal_mn_b | append: ' ' | append: cal_a1
  if cal_m2 != cal_m1
    assign cal_mn = cal_meses[cal_m2]
    assign cal_mn_a = cal_mn | slice: 0 | upcase
    assign cal_mn_b = cal_mn | slice: 1, 30
    assign cal_meses_txt = cal_meses_txt | append: ' · ' | append: cal_mn_a | append: cal_mn_b | append: ' ' | append: cal_a2
  endif

  # Cabeçalho: campo base em português; _en e _es quando preenchidos
  assign cal_eb = section.settings.eyebrow
  assign cal_titulo = section.settings.titulo
  assign cal_texto = section.settings.texto
  assign cal_nota = section.settings.nota
  if lnat_lg != 'pt'
    assign kx = 'eyebrow_' | append: lnat_lg
    if section.settings[kx] != blank
      assign cal_eb = section.settings[kx]
    endif
    assign kx = 'titulo_' | append: lnat_lg
    if section.settings[kx] != blank
      assign cal_titulo = section.settings[kx]
    endif
    assign kx = 'texto_' | append: lnat_lg
    if section.settings[kx] != blank
      assign cal_texto = section.settings[kx]
    endif
    assign kx = 'nota_' | append: lnat_lg
    if section.settings[kx] != blank
      assign cal_nota = section.settings[kx]
    endif
  endif
  if cal_titulo == blank
    capture cal_titulo
      render 'lod-natal-t', k: 'cal_titulo'
    endcapture
  endif
  assign cal_titulo_e = cal_titulo | escape
  capture t_portas
    render 'lod-natal-t', k: 'cal_portas', v1: cal_titulo_e
  endcapture

  # Campos por língua dos blocos (titulo_en, historia_es, …): nomes calculados uma vez
  assign k_titulo = 'titulo_' | append: lnat_lg
  assign k_rotulo = 'rotulo_' | append: lnat_lg
  assign k_historia = 'historia_' | append: lnat_lg
  assign k_sugestao = 'sugestao_' | append: lnat_lg
  assign k_dica = 'dica_' | append: lnat_lg
  assign k_cta = 'cta_texto_' | append: lnat_lg

  # Ligações escritas à mão: prefixo da língua e do mercado («/en», «/es», «/pt-pt»), como as ligações da Shopify
  assign cal_raiz = routes.root_url | default: '/'
  assign cal_raiz_b = cal_raiz | append: '/'
  assign cal_raiz_n = cal_raiz_b.size

  # Datas das definições do tema para os marcadores dos textos (as mesmas do banner, da barra e dos Prazos)
  capture cal_d_acores
    render 'lod-natal-data', valor: settings.natal_limite_acores, formato: 'longo'
  endcapture
  capture cal_d_madeira
    render 'lod-natal-data', valor: settings.natal_limite_madeira, formato: 'longo'
  endcapture
  capture cal_d_gravacao
    render 'lod-natal-data', valor: settings.natal_limite_gravacao, formato: 'longo'
  endcapture
  capture cal_d_cont
    render 'lod-natal-data', valor: settings.natal_limite_continente, formato: 'longo'
  endcapture
  capture cal_d_loja
    render 'lod-natal-data', valor: settings.natal_limite_loja, formato: 'hora'
  endcapture
  capture cal_d_reis
    render 'lod-natal-data', valor: settings.natal_limite_reis, formato: 'longo'
  endcapture
  capture cal_d_retoma
    render 'lod-natal-data', valor: settings.natal_retoma_envios, formato: 'longo'
  endcapture
  capture cal_d_trocas
    render 'lod-natal-data', valor: settings.natal_trocas_ate, formato: 'ano'
  endcapture
  capture cal_h_cont
    render 'lod-natal-data', valor: settings.natal_limite_continente, formato: 'hora'
  endcapture
  assign cal_h_cont = cal_h_cont | split: ', ' | last
  capture cal_h_reis
    render 'lod-natal-data', valor: settings.natal_limite_reis, formato: 'hora'
  endcapture
  assign cal_h_reis = cal_h_reis | split: ', ' | last
  # Espanha e Internacional: só o dia (as 23:59 de Lisboa são 00:59 em Madrid). Envios para Espanha: só a Península
  # (sem Baleares, Canárias, Ceuta e Melilla). Navidad 20 dez. confirmado pelo dono a 04-11-2026; Reyes e Internacional propostos.
  assign cal_v_es_nav = settings.natal_es_limite_navidad | default: '2026-12-20 23:59'
  assign cal_v_es_reyes = settings.natal_es_limite_reyes | default: '2026-12-29 23:59'
  assign cal_v_es_noche = settings.natal_fim | default: '2027-01-06 23:59' | date: '%Y' | append: '-01-05 00:00'
  assign cal_v_int = settings.natal_int_limite | default: '2026-12-10 23:59'
  capture cal_d_es_nav
    render 'lod-natal-data', valor: cal_v_es_nav, formato: 'longo'
  endcapture
  capture cal_d_es_reyes
    render 'lod-natal-data', valor: cal_v_es_reyes, formato: 'longo'
  endcapture
  capture cal_d_es_noche
    render 'lod-natal-data', valor: cal_v_es_noche, formato: 'longo'
  endcapture
  capture cal_d_int
    render 'lod-natal-data', valor: cal_v_int, formato: 'longo'
  endcapture

  # Blocos que dependem de uma decisão (opção «Mostrar» do bloco)
  assign cal_trocas = false
  if settings.natal_mostrar_trocas == true
    assign cal_trocas = true
  endif
  assign cal_janeiras = false
  if section.settings.janeiras_confirmadas == true
    assign cal_janeiras = true
  endif
-%}
<p>teste</p>
{%- endif -%}

