  .lnat-cal__dica b{font-weight:600}
  .lnat-cal__nav{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12px 16px;border-top:1px solid var(--lnat-linha);background:var(--lnat-papel)}
  .lnat-cal__seta{display:inline-flex;align-items:center;gap:8px;min-width:44px;min-height:44px;padding:0 8px;border:0;background:none;color:var(--lnat-tinta);font:600 14px/1 var(--lnat-sans);cursor:pointer;white-space:nowrap}
  .lnat-cal__seta-ico{transform:scaleX(-1)}
  .lnat-cal__seta.is-vazio{visibility:hidden}
  .lnat-cal__partilhar{min-height:44px;padding:0 18px}
  .lnat-cal .lnat-cal__dialogo .lnat-eb{color:var(--lnat-ouro-velho)}
  .lnat-cal .lnat-cal__dialogo .lnat-card{color:var(--lnat-texto)!important}
  .lnat-cal .lnat-cal__dialogo .lnat-link{color:var(--lnat-ouro-velho)!important}
  .lnat-cal .lnat-cal__dialogo a:focus-visible,.lnat-cal .lnat-cal__dialogo button:focus-visible{outline:2px solid var(--lnat-ouro-velho);outline-offset:3px}
  @media (min-width:750px){
    .lnat-cal__dialogo{position:fixed;top:0;right:0;bottom:0;left:auto;width:480px;height:100%;height:100dvh}
    .lnat-cal__dialogo[open] .lnat-cal__painel{animation:lnatCalLado .32s ease-out}
