    .lnat-cal__hoje-num{font-size:44px}
  }
  @media (prefers-reduced-motion:reduce){
    .lnat-cal__porta.is-hoje::before{animation:none;opacity:.55;transform:none}
    .lnat-cal__porta.is-a-abrir .lnat-cal__folha,.lnat-cal__dialogo[open] .lnat-cal__painel{animation:none}
  }
</style>

<script>
(function () {
  'use strict';
  var html = document.documentElement;
  if (html.hasAttribute('data-lnat-cal-js')) return;
  html.setAttribute('data-lnat-cal-js', '');

  var CHAVE = 'lnat-cal-abertas';
  var instancias = [];
  var calmo = false;
  try { calmo = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}

  function hojeLisboa() {
    var N = window.LOD_NATAL;
    if (N && typeof N.hoje === 'function') { try { return N.hoje(); } catch (e) {} }
    try { return new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Lisbon' }).format(new Date()); }
    catch (e) { return new Date().toISOString().slice(0, 10); }
  }
  function lerVistas() {
    try { var v = JSON.parse(window.localStorage.getItem(CHAVE) || '[]'); return Array.isArray(v) ? v : []; }
    catch (e) { return []; }
  }
  function guardarVista(dia) {
    try {
      var v = lerVistas();
      if (v.indexOf(dia) < 0) { v.push(dia); window.localStorage.setItem(CHAVE, JSON.stringify(v.slice(-80))); }
    } catch (e) {}
  }

  function iniciar(root) {
    if (!root || root.hasAttribute('data-pronto')) return;
    root.setAttribute('data-pronto', '');
    var editor = root.hasAttribute('data-editor') || !!(window.Shopify && window.Shopify.designMode);
    var N = window.LOD_NATAL;
    /* Repete a decisão do servidor (páginas em cache, ?natal_data=): versão do mercado = versão desta instância
       e fase ativa dessa versão. O Internacional não tem calendário. */
    var ATIVAS = { pt: ['ouro', 'incenso', 'ultima', 'consoada', 'mirra'], es: ['navidad', 'reyes', 'reyes_ultima', 'noche_reyes'] };
    if (!editor && N && typeof N.fase === 'function') {
      var v = N.versao || 'pt';
      var f = '';
      try { f = N.fase(v); } catch (e) {}
      if (v !== (root.getAttribute('data-versao') || 'pt') || !ATIVAS[v] || ATIVAS[v].indexOf(f) < 0) { root.hidden = true; return; }
    }
    /* Textos fixos na língua da página (dicionário lod-natal-t, escritos pelo servidor) */
    var TT = {};
    try { var tj = root.querySelector('script[data-cal-t]'); if (tj) TT = JSON.parse(tj.textContent) || {}; } catch (e) {}
    function tx(k, v1) { var s = TT[k] == null ? '' : String(TT[k]); return v1 == null ? s : s.split('{1}').join(v1); }

    var portas = Array.prototype.slice.call(root.querySelectorAll('.lnat-cal__porta[data-dia]'));
    var dlg = root.querySelector('[data-dialogo]');
    var conteudo = root.querySelector('[data-conteudo]');
    var btnAnt = root.querySelector('[data-ant]');
    var btnSeg = root.querySelector('[data-seg]');
    var btnPart = root.querySelector('[data-partilhar]');
    var avisoGrelha = root.querySelector('[data-aviso]');
    var avisoDlg = root.querySelector('[data-aviso-dialogo]');
    var cartao = root.querySelector('[data-hoje-cartao]');
    var icones = root.querySelector('template[data-icones]');
    var hoje = '';
    var atual = null;
    var abrindo = false;
    var tAviso = null;
    var tPart = null;
    if (!dlg || !conteudo) return;

    function livre(p) { return p.getAttribute('aria-disabled') !== 'true'; }

    function estado() {
      hoje = hojeLisboa();
      var vistas = lerVistas();
      var pHoje = null;
      portas.forEach(function (p) {
        var dia = p.getAttribute('data-dia');
        var aberta = editor || dia <= hoje;
        var vista = aberta && vistas.indexOf(dia) > -1;
        p.classList.toggle('is-hoje', dia === hoje);
        p.classList.toggle('is-passada', aberta && dia < hoje);
        p.classList.toggle('is-futura', !aberta);
        p.classList.toggle('is-vista', vista);
        if (aberta) p.removeAttribute('aria-disabled'); else p.setAttribute('aria-disabled', 'true');
        var est = p.querySelector('[data-estado]');
        if (est) {
          est.textContent = aberta
            ? ': ' + p.getAttribute('data-titulo') + (dia === hoje ? ' (' + tx('hoje_min') + ')' : (vista ? ' (' + tx('ja_aberta_min') + ')' : ''))
            : ', ' + tx('abre_a_min', p.getAttribute('data-abre'));
        }
        if (dia === hoje) pHoje = p;
      });
      if (cartao) {
        if (pHoje) {
          var n = pHoje.querySelector('.lnat-cal__num');
          cartao.querySelector('[data-hoje-num]').textContent = n ? n.textContent : '';
          cartao.querySelector('[data-hoje-data]').textContent = pHoje.getAttribute('data-longo');
          cartao.querySelector('[data-hoje-titulo]').textContent = pHoje.getAttribute('data-titulo');
          cartao.hidden = false;
        } else {
          cartao.hidden = true;
        }
      }
    }

    function anunciar(alvo, txt) {
      if (!alvo) return;
      alvo.textContent = '';
      setTimeout(function () { alvo.textContent = txt; }, 40);
    }

    function avisar(p) {
      anunciar(avisoGrelha, tx('porta_abre_a', p.getAttribute('data-abre')));
      portas.forEach(function (x) { x.classList.remove('is-aviso'); });
      p.classList.add('is-aviso');
      clearTimeout(tAviso);
      tAviso = setTimeout(function () { p.classList.remove('is-aviso'); }, 2600);
    }

    function nav(btn, alvo, chave) {
      if (!btn) return;
      var rot = btn.querySelector('[data-rot]');
      if (alvo) {
        btn.classList.remove('is-vazio');
        btn.disabled = false;
        btn.setAttribute('data-alvo', alvo.getAttribute('data-dia'));
        btn.setAttribute('aria-label', tx(chave, alvo.getAttribute('data-longo')));
        if (rot) rot.textContent = alvo.getAttribute('data-curto');
      } else {
        btn.classList.add('is-vazio');
        btn.disabled = true;
        btn.removeAttribute('data-alvo');
        btn.removeAttribute('aria-label');
        if (rot) rot.textContent = '';
      }
    }

    function preencher(p) {
      var dia = p.getAttribute('data-dia');
      var tpl = root.querySelector('template[data-tpl="' + dia + '"]');
      if (!tpl || !tpl.content) return false;
      conteudo.textContent = '';
      conteudo.appendChild(document.importNode(tpl.content, true));
      var alvoIco = conteudo.querySelector('[data-icone]');
      if (alvoIco && icones && icones.content) {
        var ico = icones.content.querySelector('[data-icone="' + alvoIco.getAttribute('data-icone') + '"] svg');
        if (ico) alvoIco.appendChild(ico.cloneNode(true));
      }
      conteudo.scrollTop = 0;
      atual = p;
      var abertas = portas.filter(livre);
      var i = abertas.indexOf(p);
      nav(btnAnt, i > 0 ? abertas[i - 1] : null, 'porta_anterior');
      nav(btnSeg, i > -1 && i < abertas.length - 1 ? abertas[i + 1] : null, 'porta_seguinte');
      if (btnPart) btnPart.textContent = tx('partilhar');
      guardarVista(dia);
      p.classList.add('is-vista');
      try {
        if (window.Shopify && window.Shopify.analytics && typeof window.Shopify.analytics.publish === 'function') {
          window.Shopify.analytics.publish('lod_calendario_abrir', { dia: dia });
        }
      } catch (e) {}
      try { if (typeof window.clarity === 'function') window.clarity('set', 'calendario_dia', dia); } catch (e) {}
      return true;
    }

    function focarTitulo() {
      var h = conteudo.querySelector('.lnat-cal__titulo');
      if (h) { try { h.focus({ preventScroll: true }); } catch (e) { h.focus(); } }
    }

    function focarFechar() {
      var b = dlg.querySelector('[data-fechar]');
      if (b) { try { b.focus({ preventScroll: true }); } catch (e) { b.focus(); } }
    }

    function mostrar() {
      abrindo = false;
      if (dlg.open) return;
      if (typeof dlg.showModal === 'function') {
        try { dlg.showModal(); } catch (e) { dlg.setAttribute('open', ''); dlg.classList.add('is-sem-modal'); }
      } else {
        dlg.setAttribute('open', '');
        dlg.classList.add('is-sem-modal');
      }
      html.classList.add('lnat-cal-aberto');
      focarFechar();
    }

    /* Ligação partilhada (#dia-…): ao tratar o fragmento, o navegador tenta focar o <li> da porta,
       que não é focável e fica por trás do diálogo, e o foco cai no body. Nos primeiros segundos,
       se o foco sair do diálogo para lado nenhum, volta ao botão «Fechar». */
    function prenderFoco() {
      var ate = Date.now() + 4000;
      function repor() { if (dlg.open && !dlg.contains(document.activeElement)) focarFechar(); }
      function aoSair(e) {
        if (Date.now() > ate || !dlg.open) { dlg.removeEventListener('focusout', aoSair); return; }
        if (!e.relatedTarget) setTimeout(repor, 0);
      }
      dlg.addEventListener('focusout', aoSair);
      if (document.readyState !== 'complete') {
        window.addEventListener('load', function () { setTimeout(repor, 0); setTimeout(repor, 300); }, { once: true });
      } else {
        setTimeout(repor, 0);
      }
    }

    function abrir(p, animar) {
      if (!p || abrindo) return;
      if (!livre(p)) { avisar(p); return; }
      if (!dlg.open && document.querySelector('.lnat-cal__dialogo[open]')) return;
      if (!preencher(p)) return;
      if (dlg.open) { focarTitulo(); return; }
      if (animar && !calmo) {
        abrindo = true;
        p.classList.add('is-a-abrir');
        setTimeout(mostrar, 300);
      } else {
        mostrar();
      }
    }

    function depoisDeFechar() {
      html.classList.remove('lnat-cal-aberto');
      dlg.classList.remove('is-sem-modal');
      portas.forEach(function (x) { x.classList.remove('is-a-abrir'); });
      estado();
      if (atual) { try { atual.focus({ preventScroll: true }); } catch (e) { atual.focus(); } }
    }

    function fechar() {
      if (!dlg.open && !dlg.hasAttribute('open')) return;
      if (typeof dlg.close === 'function' && !dlg.classList.contains('is-sem-modal')) { dlg.close(); return; }
      dlg.removeAttribute('open');
      depoisDeFechar();
    }

    function copiar(url) {
      function ok() {
        if (btnPart) btnPart.textContent = tx('ligacao_copiada');
        anunciar(avisoDlg, tx('ligacao_copiada') + '.');
        clearTimeout(tPart);
        tPart = setTimeout(function () { if (btnPart) btnPart.textContent = tx('partilhar'); }, 2500);
      }
      function manual() {
        try {
          var ta = document.createElement('textarea');
          ta.value = url;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.top = '0';
          ta.style.opacity = '0';
          dlg.appendChild(ta);
          ta.select();
          var r = document.execCommand('copy');
          dlg.removeChild(ta);
          if (r) ok(); else anunciar(avisoDlg, url);
        } catch (e) { anunciar(avisoDlg, url); }
      }
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(url).then(ok, manual);
      else manual();
    }

    function partilhar() {
      if (!atual) return;
      var dia = atual.getAttribute('data-dia');
      var tit = atual.getAttribute('data-titulo');
      var url = location.origin + location.pathname + '#dia-' + dia;
      if (navigator.share) {
        navigator.share({ title: tit, text: tit + ' · ' + tx('nome') + ', ' + tx('marca'), url: url }).catch(function () {});
        return;
      }
      copiar(url);
    }

    function deHash() {
      var m = /^#dia-(\d{4}-\d{2}-\d{2})$/.exec(location.hash || '');
      if (!m) return false;
      var p = root.querySelector('.lnat-cal__porta[data-dia="' + m[1] + '"]');
      if (!p) return false;
      if (!livre(p)) {
        try { p.scrollIntoView({ block: 'center' }); } catch (e) {}
        try { p.focus({ preventScroll: true }); } catch (e) {}
        avisar(p);
        return true;
      }
      abrir(p, false);
      if (dlg.open) prenderFoco();
      return true;
    }

    root.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      var p = t.closest('.lnat-cal__porta[data-dia]');
      if (p && root.contains(p)) { abrir(p, true); return; }
      if (t.closest('[data-hoje-cartao]')) {
        var ph = root.querySelector('.lnat-cal__porta.is-hoje');
        if (ph) abrir(ph, false);
        return;
      }
      if (t.closest('[data-fechar]')) { fechar(); return; }
      var seta = t.closest('[data-ant],[data-seg]');
      if (seta) {
        var d = seta.getAttribute('data-alvo');
        var alvo = d ? root.querySelector('.lnat-cal__porta[data-dia="' + d + '"]') : null;
        if (alvo && livre(alvo) && preencher(alvo)) focarTitulo();
        return;
      }
      if (t.closest('[data-partilhar]')) { partilhar(); return; }
    });
    dlg.addEventListener('click', function (e) { if (e.target === dlg) fechar(); });
    dlg.addEventListener('close', depoisDeFechar);
    function teclaEsc(e) {
      if ((e.key === 'Escape' || e.key === 'Esc') && dlg.classList.contains('is-sem-modal') && dlg.hasAttribute('open')) fechar();
    }
    document.addEventListener('keydown', teclaEsc);

    estado();
    var relogio = setInterval(function () { if (hojeLisboa() !== hoje) estado(); }, 60000);

    var inst = {
      root: root,
      secao: root.getAttribute('data-secao'),
      abrir: abrir,
      fechar: fechar,
      deHash: deHash,
      destruir: function () {
        clearInterval(relogio);
        document.removeEventListener('keydown', teclaEsc);
        html.classList.remove('lnat-cal-aberto');
      }
    };
    instancias.push(inst);
    deHash();
  }

  function todas() {
    Array.prototype.forEach.call(document.querySelectorAll('[data-lnat-cal]'), iniciar);
  }

  window.addEventListener('hashchange', function () {
    for (var i = 0; i < instancias.length; i++) { if (instancias[i].deHash()) break; }
  });
  document.addEventListener('shopify:section:load', function (e) {
    var r = e.target && e.target.querySelector ? e.target.querySelector('[data-lnat-cal]') : null;
    if (r) iniciar(r);
  });
  document.addEventListener('shopify:section:unload', function (e) {
    instancias = instancias.filter(function (it) {
      if (e.target && e.target.contains(it.root)) { it.destruir(); return false; }
      return true;
    });
  });
  document.addEventListener('shopify:block:select', function (e) {
    var d = e.detail || {};
    instancias.forEach(function (it) {
      if (it.secao !== d.sectionId) return;
      var p = it.root.querySelector('.lnat-cal__porta[data-bloco="' + d.blockId + '"]');
      if (p) it.abrir(p, false);
    });
  });
  document.addEventListener('shopify:block:deselect', function (e) {
    var d = e.detail || {};
    instancias.forEach(function (it) { if (it.secao === d.sectionId) it.fechar(); });
  });

  todas();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', todas);
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Natal · Calendário",
  "tag": "section",
  "class": "lnat-secao-calendario",
  "max_blocks": 50,
  "settings": [
    {
      "type": "header",
      "content": "Cabeçalho"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sobretítulo",
      "default": "Do Advento aos Reis"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "default": "Calendário de Ouro"
    },
    {
      "type": "textarea",
      "id": "texto",
      "label": "Texto",
      "default": "Uma história do ouro português por dia, de 1 de dezembro a 6 de janeiro. Volte amanhã para abrir a porta seguinte."
    },
    {
      "type": "text",
      "id": "nota",
      "label": "Nota curta",
      "default": "Sem prémios nem sorteios: só histórias, peças e dicas."
    },
    {
      "type": "header",
      "content": "Tradução — Inglês (EN)",
      "info": "Deixe vazio para usar o português. No mercado Espanha, a língua por omissão do site é o inglês."
    },
    {
      "type": "text",
      "id": "eyebrow_en",
      "label": "Sobretítulo (EN)"
    },
    {
      "type": "text",
      "id": "titulo_en",
      "label": "Título (EN)"
    },
    {
      "type": "textarea",
      "id": "texto_en",
      "label": "Texto (EN)"
    },
    {
      "type": "text",
      "id": "nota_en",
      "label": "Nota curta (EN)"
    },
    {
      "type": "header",
      "content": "Tradução — Espanhol (ES)",
      "info": "Deixe vazio para usar o português. Espanhol de Espanha, tratamento por «usted»."
    },
    {
      "type": "text",
      "id": "eyebrow_es",
      "label": "Sobretítulo (ES)"
