    .lnat-cal__semana,.lnat-cal__grelha{gap:4px}
    .lnat-cal__semana{letter-spacing:0}
    .lnat-cal__porta,.lnat-cal__vazio{height:auto;aspect-ratio:1/1;min-height:44px}
    .lnat-cal__vazio{font-size:16px}
    .lnat-cal__sem{display:none}
    .lnat-cal__num{font-size:20px}
    .lnat-cal__porta.is-passada::after,.lnat-cal__porta.is-vista::after{top:3px;right:3px;width:7px;height:7px}
    .lnat-cal__porta.is-futura .lnat-cal__face::after{top:3px;right:3px;width:9px;height:9px}
    .lnat-cal__porta.is-hoje::before{inset:-5px}
    .lnat-cal__dialogo{position:fixed;top:auto;right:0;bottom:0;left:0;width:100%;height:auto;max-height:85vh;max-height:85dvh;box-shadow:0 -12px 40px rgba(0,0,0,.35)}
    .lnat-cal__painel{max-height:85vh;max-height:85dvh}
    .lnat-cal__dialogo[open] .lnat-cal__painel{animation:lnatCalBaixo .32s ease-out}
    @keyframes lnatCalBaixo{from{transform:translateY(48px);opacity:0}to{transform:none;opacity:1}}
    .lnat-cal__topo{padding-left:16px}
    .lnat-cal__conteudo{padding:16px 16px 24px}
    .lnat-cal__titulo{font-size:28px;line-height:32px}
    .lnat-cal__media--icone{height:132px}
    .lnat-cal__nav{padding:8px 8px calc(8px + env(safe-area-inset-bottom,0px))}
    .lnat-cal__btns .lnat-btn{width:100%}
  }
  @media (max-width:379px){
    .lnat-cal__semana,.lnat-cal__grelha{gap:3px}
