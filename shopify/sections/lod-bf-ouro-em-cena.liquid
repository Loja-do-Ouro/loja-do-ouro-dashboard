        <h2 class="lbf3d__h1"><span class="lbf3d__ln"><span>{{ hl_1 | escape }}</span></span>{% if hl_2 != blank %}<span class="lbf3d__ln"><span>{{ hl_2 | escape }}</span></span>{% endif %}</h2>
        <p class="lbf3d__offer">{{ t_upto | escape }} <span>{{ disc_show | escape }}</span></p>
        {%- if x_sub1 != blank %}
        <p class="lbf3d__sub">{{ x_sub1 | escape }}</p>
        {%- endif %}
      </div>
      <div class="lbf3d__cue" aria-hidden="true"><span class="lbf3d__cue-t">{{ t_cue | escape }}</span><span class="lbf3d__cue-l"></span></div>
      {%- if request.design_mode %}
      <p class="lbf3d__ednote" hidden>Fora das datas da campanha: na loja esta secção está escondida (só aparece aqui no editor).</p>
      {%- endif %}
    </div>
    <div class="lbf3d__rest">
      <div class="lbf3d__ch2">
        <p class="lbf3d__kicker">{{ x_ch2 | escape }}</p>
        <h3 class="lbf3d__h2">{{ x_h2 | escape }}</h3>
        {%- if x_sub2 != blank %}
        <p class="lbf3d__sub2">{{ x_sub2 | escape }}</p>
        {%- endif %}
      </div>
      <div class="lbf3d__ch3">
        <p class="lbf3d__kicker">{{ x_ch3 | escape }}</p>
        <h3 class="lbf3d__h2">{{ x_h3 | escape }}</h3>
      </div>
      <div class="lbf3d__hold">
        <h3 class="lbf3d__ate" id="lbf3d-oferta-{{ section.id }}" tabindex="-1">{{ t_upto | escape }}<span class="lbf3d__sr"> {{ disc_num | escape }} {{ t_sroff | escape }}</span></h3>
        <p class="lbf3d__foilnum" aria-hidden="true">{% if disc_neg %}<span class="lbf3d__minus"></span>{% endif %}{{ disc_num | escape }}</p>
        <div class="lbf3d__low">
          {%- if x_line != blank %}
          <p class="lbf3d__line">{{ x_line | escape }}</p>
          {%- endif %}
          <div class="lbf3d__cd" role="timer" aria-live="off" aria-label="{{ x_cd_aria | escape }}">
            <p class="lbf3d__cd-label">{{ x_before | escape }}</p>
            <div class="lbf3d__cells">
              <span class="lbf3d__cell"><b>--</b><i>{{ x_units[0] | escape }}</i></span>
              <span class="lbf3d__cell"><b>--</b><i>{{ x_units[1] | escape }}</i></span>
              <span class="lbf3d__cell"><b>--</b><i>{{ x_units[2] | escape }}</i></span>
              <span class="lbf3d__cell"><b>--</b><i>{{ x_units[3] | escape }}</i></span>
            </div>
            <p class="lbf3d__cd-done" hidden>{{ x_done | escape }}</p>
          </div>
          <p class="lbf3d__trust">
            {%- for ln in trust_lines -%}
              {%- assign ln_s = ln | strip -%}
              {%- if ln_s != blank -%}
                {%- assign ln_items = ln_s | split: '|' -%}
                <span>{%- for it in ln_items -%}{%- unless forloop.first -%}<i class="lbf3d__dia" aria-hidden="true"></i>{%- endunless -%}{{ it | strip | escape }}{%- endfor -%}</span>
              {%- endif -%}
            {%- endfor -%}
          </p>
          <a class="lbf3d-pill lbf3d-pill--gold lbf3d__cta" href="{{ u_cta | escape }}">{{ x_cta | escape }}</a>
        </div>
      </div>
    </div>
    <div class="lbf3d__rmveil" aria-hidden="true"></div>
  </div>
  <span class="lbf3d__fim" id="lbf3d-fim-{{ section.id }}" tabindex="-1"></span>
  <span class="lbf3d__probe" aria-hidden="true"></span>
</section>

{%- if s.show_bottom_bar %}
