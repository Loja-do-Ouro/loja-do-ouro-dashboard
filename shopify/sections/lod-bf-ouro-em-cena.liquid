  <div class="lbf3d-bar__in">
    <a class="lbf3d-pill lbf3d-pill--gold" href="{{ u_cta | escape }}" data-primary>{{ x_cta | escape }}</a>
    <a class="lbf3d-pill lbf3d-pill--ghost" href="{% if u_remind != blank %}{{ u_remind | escape }}{% else %}#lbf3d-oferta-{{ section.id }}{% endif %}" data-remind>{{ x_remind | escape }}</a>
    <p class="lbf3d-bar__status" role="status" aria-live="polite"></p>
  </div>
</nav>
{%- endif %}
<script>
  /* Logo a seguir à secção, antes do primeiro desenho: a altura do cabeçalho do tema e da barra e o
     enquadramento do emblema (as mesmas contas do motor: measureTop, barH, emFrame), para que nada mude
     de sítio quando o motor arranca. Com o véu: sem WebGL, com ?lbf3d=static ou com «reduzir movimento»
     quando a definição pede a versão estática, retira-o antes de ser visto (não virá 3D); de resto, no
     seu primeiro frame guarda a hora (o relógio do véu), recomeça a varredura das linhas e pede já o
     three.js (descarregado desde o preload): corre logo a seguir a esse frame, sem esperar pelo motor. */
  (function (d, w) {
    try {
      var s = d.getElementById('lbf3d-{{ section.id }}');
      if (!s || s.__lbf3d) return;
      var ld = s.querySelector('.lbf3d__loader');
      if (ld && !ld.hidden && s.classList.contains('lbf3d--ld')) {
        var q = '';
        try { q = new URLSearchParams(w.location.search).get('lbf3d') || ''; } catch (e) {}
        var rms = {{ s.reduce_motion_static | json }} && w.matchMedia && w.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!w.WebGLRenderingContext || /(^|,)\s*static\s*(,|$)/.test(q) || rms) { ld.hidden = true; s.classList.remove('lbf3d--ld'); }
        else if (w.requestAnimationFrame) {
          s.__lbf3dF0 = null;
          w.requestAnimationFrame(function (t) {
            s.__lbf3dF0 = w.performance && performance.now ? performance.now() : t;
            try { [].forEach.call(ld.querySelectorAll('.lbf3d__ld-wipe,.lbf3d__ld-in'), function (el) { (el.getAnimations ? el.getAnimations() : []).forEach(function (a) { a.currentTime = 0; }); }); } catch (e) {}
            try {
              if (!w.THREE && !d.querySelector('script[data-lbf3d-three]')) {
                var sc = d.createElement('script');
                sc.src = {{ three_url | json }}; sc.async = true; sc.crossOrigin = 'anonymous'; sc.setAttribute('data-lbf3d-three', '');
                sc.onload = function () { sc.setAttribute('data-lbf3d-done', ''); };
                sc.onerror = function () { sc.setAttribute('data-lbf3d-done', 'error'); };
                (d.head || d.documentElement).appendChild(sc);
              }
            } catch (e) {}
          });
        }
      }
      var hd = d.querySelector('.lod-header__shell'), h = 64;
      if (!hd) { hd = d.querySelector('.section-header, #shopify-section-header'); if (hd && !/sticky|fixed/.test(getComputedStyle(hd).position)) hd = null; }
      if (hd && hd.offsetHeight > 0) h = hd.offsetHeight;
      s.style.setProperty('--lbf3d-head', h + 'px');
      var bar = d.getElementById('lbf3d-bar-{{ section.id }}');
      if (bar && !bar.hidden && bar.firstElementChild) s.style.setProperty('--lbf3d-bar-h', (bar.firstElementChild.offsetHeight + 12) + 'px');
      var hero = s.querySelector('.lbf3d__hero'), ch1 = s.querySelector('.lbf3d__ch1'), W = hero ? hero.clientWidth : 0, H = hero ? hero.clientHeight : 0;
      if (!W || !H) return;
      var pt = W / H < 1, fr = pt ? Math.min(0.68, 0.36 * H / W) : 0.58, k = 0.5225 * (pt ? W : H), rad = k * fr, cy = (pt ? (H < 640 ? 0.38 : 0.40) : 0.5) * H;
      if (pt && ch1) {
        var de = ch1.querySelector('.lbf3d__date'), tt = ch1.offsetTop + (de && de.offsetParent ? de.offsetTop : 0);
        cy = Math.min(cy, tt - 28 - rad);
        if (cy - rad < 64) { rad = Math.max(36, (tt - 28 - 64) / 2); cy = 64 + rad; }
      }
      s.style.setProperty('--em-x', Math.round((pt ? 0.5 : 0.62) * W) + 'px');
      s.style.setProperty('--em-y', Math.round(cy) + 'px');
      s.style.setProperty('--em-d', Math.round(2 * rad) + 'px');
    } catch (e) {}
  })(document, window);
</script>

