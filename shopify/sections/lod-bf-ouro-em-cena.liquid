      if (t1 <= t0) t1 = t0 + 60000;
      if (({{ s.hide_after_end | json }} && tn >= t1) || ({{ s.show_before_start | json }} === false && tn < t0)) {
        var st = d.createElement('style');
        st.id = 'lbf3d-pre-' + sid;
        st.textContent = '#lbf3d-' + sid + ',#lbf3d-bar-' + sid + '{display:none!important}';
