    assign t_brand = 'Loja do Ouro'
  else
    assign t_brand = 'Gold Store Premium'
  endif
  assign t_aria = 'Black Friday ' | append: t_brand

  # Portes grátis só em Portugal e acima de 150 € (como a barra do topo da loja); fora de PT, sem promessa de portes grátis
  assign bf_country = localization.country.iso_code | default: '' | upcase
  if bf_country == 'PT'
    assign t_ship_x = t_ship_free
  else
    assign t_ship_x = t_ship
  endif
  assign t_trust = t_trust_a | append: '¦' | append: t_ship_x | append: ' | ' | append: t_unique

  if bf_lang == 'de'
    assign t_desc = t_desc_a | append: disc_show | append: ' zusammenfügen.'
  else
    assign t_desc = t_desc_a | append: disc_show | append: '.'
  endif

  # Datas por extenso a partir de "AAAA-MM-DD HH:MM" (ex.: 27 a 30 de novembro)
  assign sd_parts = bf_start | split: ' ' | first | split: '-'
  assign ed_parts = bf_end | split: ' ' | first | split: '-'
  assign sd_m = sd_parts[1] | plus: 0
  assign sd_d = sd_parts[2] | plus: 0
  assign ed_m = ed_parts[1] | plus: 0
  assign ed_d = ed_parts[2] | plus: 0
  assign sd_y = sd_parts[0] | size
  assign ed_y = ed_parts[0] | size
  assign auto_date = ''
  if sd_y == 4 and ed_y == 4 and sd_m > 0 and sd_m < 13 and ed_m > 0 and ed_m < 13 and sd_d > 0 and sd_d < 32 and ed_d > 0 and ed_d < 32
    assign mi1 = sd_m | minus: 1
    assign mi2 = ed_m | minus: 1
    assign mn1 = t_months[mi1]
    assign mn2 = t_months[mi2]
    assign dd1 = sd_d | append: ''
    assign dd2 = ed_d | append: ''
