#lbf3d-{{ section.id }} .lbf3d__h1{margin:0;font-family:var(--serif);font-style:normal;font-weight:500;font-size:clamp(46px,14vw,128px);line-height:.9;letter-spacing:-.015em;text-transform:none;color:var(--g4);min-height:1.8em}
#lbf3d-{{ section.id }} .lbf3d__ln{display:block;overflow:hidden;padding-bottom:.26em;margin-bottom:-.26em}
#lbf3d-{{ section.id }} .lbf3d__offer{margin:10px 0 0;font:italic 400 clamp(20px,5.6vw,30px)/1.1 var(--serif);color:var(--g4)}
#lbf3d-{{ section.id }} .lbf3d__offer span{font-style:normal;font-weight:600;color:var(--g5);font-variant-numeric:lining-nums}
#lbf3d-{{ section.id }} .lbf3d__ln>span{display:block;color:var(--g4)}
@supports ((-webkit-background-clip:text) or (background-clip:text)){
  #lbf3d-{{ section.id }} .lbf3d__ln>span,#lbf3d-{{ section.id }} .lbf3d__foilnum{background:var(--foil);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}
}
#lbf3d-{{ section.id }} .lbf3d__sub{margin:14px 0 0;max-width:34ch;font:400 15px/1.5 var(--sans);color:var(--cream);text-shadow:0 1px 12px rgba(0,0,0,.6)}
@media (min-width:900px){#lbf3d-{{ section.id }} .lbf3d__sub{font-size:18px;max-width:30ch;margin-top:18px}}
#lbf3d-{{ section.id }} .lbf3d__cue{position:absolute;z-index:3;right:var(--gr);bottom:calc(var(--lbf3d-bar-h) + var(--lbf3d-bar-off,0px) + 24px + var(--sb));display:flex;flex-direction:column;align-items:center;gap:12px;pointer-events:none}
#lbf3d-{{ section.id }} .lbf3d__cue-t{writing-mode:vertical-rl;font:600 10.5px/1 var(--sans);letter-spacing:.3em;text-transform:uppercase;color:var(--g3)}
#lbf3d-{{ section.id }} .lbf3d__cue-l{position:relative;display:block;width:1px;height:28px;background:rgba(188,145,76,.4);overflow:hidden}
#lbf3d-{{ section.id }} .lbf3d__cue-l::after{content:"";position:absolute;left:-1.5px;top:0;width:4px;height:4px;border-radius:50%;background:var(--g5);animation:lbf3dCue 2.2s var(--ease) infinite}
@keyframes lbf3dCue{0%{transform:translateY(-6px);opacity:0}25%{opacity:1}100%{transform:translateY(30px);opacity:0}}
#lbf3d-{{ section.id }} .lbf3d__kicker{margin:0 0 14px;font:600 11px/1.2 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:var(--g3)}
#lbf3d-{{ section.id }} .lbf3d__h2{margin:0;font-family:var(--serif);font-style:normal;font-weight:500;font-size:clamp(32px,9.4vw,72px);line-height:.95;letter-spacing:-.01em;text-transform:none;color:var(--cream2);max-width:12ch;text-shadow:0 1px 2px rgba(6,5,4,.8),0 2px 22px rgba(6,5,4,.9)}
#lbf3d-{{ section.id }} .lbf3d__sub2{margin:14px 0 0;font:400 15px/1.5 var(--sans);color:var(--cream);text-shadow:0 1px 12px rgba(0,0,0,.6)}
@media (min-width:900px){
  #lbf3d-{{ section.id }} .lbf3d__ch1,#lbf3d-{{ section.id }}.is-3d .lbf3d__ch2,#lbf3d-{{ section.id }}.is-3d .lbf3d__ch3{padding-left:max(48px,var(--gl));right:auto;width:min(100%,620px)}
  #lbf3d-{{ section.id }} .lbf3d__cue{right:max(48px,var(--gr))}
}

/* static flow for chapters 02-03 + offer */
#lbf3d-{{ section.id }} .lbf3d__rest{position:relative;padding:72px var(--gr) 56px var(--gl);display:grid;gap:64px;background:linear-gradient(var(--ink),#0a0806)}
