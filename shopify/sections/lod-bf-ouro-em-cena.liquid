  # Título: "|" muda de linha; sem "|", a primeira palavra fica na 1.ª linha
  assign x_head = s.headline | strip | default: 'Black Friday'
  if x_head contains '|'
    assign hl_parts = x_head | split: '|'
    assign hl_1 = hl_parts[0] | strip
    assign hl_2 = x_head | remove_first: hl_parts[0] | remove_first: '|' | replace: '|', ' ' | strip
  else
    assign hl_1 = x_head | split: ' ' | first
    assign hl_2 = x_head | remove_first: hl_1 | strip
  endif

  # Linhas de confiança: uma por linha; "|" separa itens na mesma linha (losango entre eles)
  if s.trust != blank
    assign trust_joined = s.trust | newline_to_br | strip_newlines | replace: '<br />', '¦' | replace: '<br>', '¦'
  else
    assign trust_joined = t_trust
  endif
  assign trust_lines = trust_joined | split: '¦'

  # Links
  assign u_cta = s.cta_url | default: routes.collections_url
  assign u_see = s.secondary_url | default: routes.collections_url
  assign u_remind = s.remind_url | default: ''

  case s.sequence_length
    when '240'
      assign seq_len = 240
    when '360'
      assign seq_len = 360
    else
      assign seq_len = 300
  endcase
  assign bar_off = s.bar_bottom_offset | default: 0 | at_least: 0 | at_most: 120
  assign bar_side = s.bar_side_inset | default: 0 | at_least: 0 | at_most: 96
  assign q_cap = s.quality | default: 'auto'

  # three.js r149: o mesmo endereço que o motor usa (o preload só é reaproveitado se coincidir)
  assign three_url = 'https://cdn.jsdelivr.net/npm/three@0.149.0/build/three.min.js'
  # Véu de carregamento desenhado pelo servidor: visível no primeiro desenho; nunca no editor de temas
  assign use_ld = false
  if s.show_loader
    unless request.design_mode
      assign use_ld = true
    endunless
  endif
  # three.js pedido pelo servidor (o scanner de pré-carregamento do browser vê-o logo): só com o véu e quando a
  # secção vai aparecer (hora do servidor; antes do início só com a margem de 1 h). Sem WebGL o pedido fica por usar.
  assign ld_preload = use_ld
  if use_ld
    assign now_p = 'now' | date: '%s' | plus: 0
    if s.show_before_start == false
      assign st_p = bf_start | date: '%s' | plus: 0
      assign st_cut = st_p | minus: 3600
      if st_p > 1000000000 and now_p < st_cut
        assign ld_preload = false
      endif
    endif
    if s.hide_after_end
      assign en_p = bf_end | date: '%s' | plus: 0
      if en_p > 1000000000 and now_p > en_p
        assign ld_preload = false
      endif
    endif
  endif

  # A partir de 1 h depois do fim a secção nem é desenhada na loja (fuso da loja: Europe/Lisbon).
  # Até lá, um pequeno script antes da marcação esconde-a sem piscar; o motor confirma depois.
  assign bf_render = s.enabled
  if bf_render and s.hide_after_end
    unless request.design_mode
      assign now_s = 'now' | date: '%s' | plus: 0
      assign end_s = bf_end | date: '%s' | plus: 0
      if end_s > 1000000000
        assign end_cut = end_s | plus: 3600
        if now_s > end_cut
          assign bf_render = false
        endif
      endif
    endunless
  endif
-%}

{%- if bf_render -%}
{%- if ld_preload %}
{%- comment -%} Com o véu: o three.js começa a descarregar já na leitura do HTML (o scanner do browser vê-o logo); o script logo a seguir à secção usa este pedido, uma vez por página {%- endcomment %}
<link rel="preload" as="script" href="{{ three_url }}" crossorigin="anonymous"{% if s.reduce_motion_static %} media="(prefers-reduced-motion: no-preference)"{% endif %}>
{%- endif %}
<script>
  /* Antes do primeiro desenho e sem bloquear: liga ao CDN do three.js e (opcional) pede as fontes
     Bodoni Moda + Inter uma única vez por página, mesmo com várias secções. */
  (function (d) {
    try {
      var h = d.head || d.documentElement;
      function pc(u, c) {
        if (d.querySelector('link[rel="preconnect"][href="' + u + '"]')) return;
        var l = d.createElement('link'); l.rel = 'preconnect'; l.href = u; if (c) l.crossOrigin = 'anonymous'; h.appendChild(l);
      }
      pc('https://cdn.jsdelivr.net', 1);
      {%- if s.font_source != 'theme' %}
      var gf = 'https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..600&family=Inter:wght@400;500;600&display=swap';
      if (!d.getElementById('lbf3d-gf') && !d.querySelector('link[href="' + gf + '"]')) {
        pc('https://fonts.googleapis.com'); pc('https://fonts.gstatic.com', 1);
        var l = d.createElement('link'); l.id = 'lbf3d-gf'; l.rel = 'stylesheet'; l.href = gf;
        /* the Bodoni Moda files the 3D numerals are drawn from: requested as soon as the stylesheet is in */
        l.onload = function () { try { d.fonts.load('600 300px "Bodoni Moda"'); d.fonts.load('500 40px "Bodoni Moda"'); } catch (e) {} };
        h.appendChild(l);
      }
      {%- endif %}
    } catch (e) {}
    {%- unless request.design_mode %}{% if s.hide_after_end or s.show_before_start == false %}
    /* Fora das datas (hora de Lisboa, a mesma leitura do motor): escondida antes de ser desenhada,
