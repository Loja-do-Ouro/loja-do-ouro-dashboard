#lbf3d-{{ section.id }}.is-3d .lbf3d__canvas{display:block;position:absolute;inset:0;width:100%;height:100%;z-index:0;opacity:1;transition:opacity .6s var(--ease)}
#lbf3d-{{ section.id }}.is-3d .lbf3d__poster{opacity:0;transition:opacity .6s var(--ease)}
#lbf3d-{{ section.id }}.is-3d.is-lost .lbf3d__poster{opacity:1}
#lbf3d-{{ section.id }}.is-3d.is-lost .lbf3d__canvas{opacity:0}
#lbf3d-{{ section.id }}.is-3d.is-lost .lbf3d__em{transition:opacity .4s var(--ease)}
#lbf3d-{{ section.id }}.is-3d.is-lost.is-holdon .lbf3d__em{opacity:0}
/* hidden at once (warm-up runs underneath), faded back in with the .6s rule above */
#lbf3d-{{ section.id }}.is-fadein .lbf3d__canvas{opacity:0;transition:none}
#lbf3d-{{ section.id }}.is-fadein .lbf3d__poster{opacity:1;transition:none}

/* scrims (static, short) */
#lbf3d-{{ section.id }} .lbf3d__scrim{display:block;position:absolute;left:0;right:0;z-index:2;pointer-events:none}
#lbf3d-{{ section.id }} .lbf3d__scrim--top{top:0;height:120px;background:linear-gradient(rgba(6,5,4,.88) 0,rgba(6,5,4,.7) 44px,rgba(6,5,4,0) 100%)}
#lbf3d-{{ section.id }} .lbf3d__scrim--bot{bottom:0;height:52%;background:linear-gradient(to top,rgba(6,5,4,.86) 0%,rgba(6,5,4,.55) 40%,rgba(6,5,4,0) 100%)}

/* top row */
#lbf3d-{{ section.id }} .lbf3d__top{position:absolute;z-index:3;top:0;left:0;right:0;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:20px var(--gr) 0 var(--gl);pointer-events:none}
#lbf3d-{{ section.id }} .lbf3d__eyes{display:grid}
#lbf3d-{{ section.id }} .lbf3d__eye{grid-area:1/1;display:flex;align-items:center;gap:10px;font:600 11px/1.2 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:var(--g3);white-space:nowrap;text-shadow:0 0 4px #060504,0 0 12px rgba(6,5,4,.95)}
#lbf3d-{{ section.id }} .lbf3d__eye::before{content:"";width:18px;height:1px;background:var(--g3);flex:none}
#lbf3d-{{ section.id }} .lbf3d__eye+.lbf3d__eye{opacity:0}
#lbf3d-{{ section.id }} .lbf3d__tdate{display:none;font:500 11px/1 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:var(--g4);white-space:nowrap}
@media (min-width:480px){#lbf3d-{{ section.id }} .lbf3d__eye{letter-spacing:.28em}}
@media (min-width:900px){#lbf3d-{{ section.id }} .lbf3d__tdate{display:block}#lbf3d-{{ section.id }} .lbf3d__top{padding-left:max(48px,var(--gl));padding-right:max(48px,var(--gr))}}

/* chapter copy */
#lbf3d-{{ section.id }} .lbf3d__ch1{position:absolute;z-index:3;left:0;right:0;bottom:0;padding:0 calc(var(--gr) + 30px) calc(var(--lbf3d-bar-h) + var(--lbf3d-bar-off,0px) + 24px + var(--sb)) var(--gl)}
#lbf3d-{{ section.id }} .lbf3d__date{margin:0 0 12px;font:500 11px/1.4 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:var(--g4)}
/* desktop shows the date top-right; it stays in the accessibility tree */
