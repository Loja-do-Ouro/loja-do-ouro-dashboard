  #lbf3d-{{ section.id }} .lbf3d__cell{min-width:72px}
}
#lbf3d-{{ section.id }}.is-short .lbf3d__line{display:none}
#lbf3d-{{ section.id }}.is-tight .lbf3d__cell b{font-size:26px}
#lbf3d-{{ section.id }}.is-tight .lbf3d__cd{margin-bottom:10px}

/* Chapters 02 and 03 only exist inside their scroll ranges (3D overlay, driven by p). Outside the
   film (static poster, before init, no JS, after a fallback) they stay out of sight: only chapter 01
   and the offer are composed. Still in the accessibility tree. */
#lbf3d-{{ section.id }}:not(.is-3d) .lbf3d__ch2,#lbf3d-{{ section.id }}:not(.is-3d) .lbf3d__ch3{position:absolute!important;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;border:0}

/* 3D overlay placement */
#lbf3d-{{ section.id }}.is-3d .lbf3d__rest{position:absolute;inset:0;z-index:3;padding:0;display:block;background:none;pointer-events:none}
#lbf3d-{{ section.id }}.is-3d .lbf3d__ch2,#lbf3d-{{ section.id }}.is-3d .lbf3d__ch3{position:absolute;left:0;right:0;bottom:0;padding:0 var(--gr) calc(var(--lbf3d-bar-h) + var(--lbf3d-bar-off,0px) + 24px + var(--sb)) var(--gl);opacity:0;visibility:hidden}
#lbf3d-{{ section.id }}.is-3d .lbf3d__kicker{position:absolute!important;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}
#lbf3d-{{ section.id }}.is-3d .lbf3d__hold{position:absolute;inset:0;--h:0;visibility:hidden}
#lbf3d-{{ section.id }}.is-3d .lbf3d__hold a{pointer-events:auto}
#lbf3d-{{ section.id }}.is-3d .lbf3d__foilnum{display:none}
/* context lost or performance poster: the CSS numerals take the slot of the 3D ones */
#lbf3d-{{ section.id }}.is-3d.is-lost .lbf3d__foilnum{display:flex;align-items:center;justify-content:center;position:absolute;left:0;right:0;top:var(--num-t,30%);height:calc(var(--num-b,62%) - var(--num-t,30%));margin:0;font-size:calc((var(--num-b,62%) - var(--num-t,30%)) * 1.2);line-height:1;opacity:var(--h)}
#lbf3d-{{ section.id }}.is-3d .lbf3d__ate{position:absolute;left:var(--num-l,16px);top:var(--num-t,30%);--o:clamp(0, var(--h) * 2.75, 1);opacity:var(--o);transform:translateY(calc(-100% - 8px + (1 - var(--o)) * 10px))}
#lbf3d-{{ section.id }}.is-3d .lbf3d__low{position:absolute;left:0;right:0;top:calc(var(--num-b,62%) + 14px);padding-left:var(--gl);padding-right:var(--gr)}
#lbf3d-{{ section.id }}.is-3d .lbf3d__line{--o:clamp(0, (var(--h) - .273) * 2.75, 1)}
#lbf3d-{{ section.id }}.is-3d .lbf3d__cd{--o:clamp(0, (var(--h) - .455) * 2.75, 1)}
#lbf3d-{{ section.id }}.is-3d .lbf3d__trust,#lbf3d-{{ section.id }}.is-3d .lbf3d__cta{--o:clamp(0, (var(--h) - .636) * 2.75, 1)}
#lbf3d-{{ section.id }}.is-3d .lbf3d__line,#lbf3d-{{ section.id }}.is-3d .lbf3d__cd,#lbf3d-{{ section.id }}.is-3d .lbf3d__trust,#lbf3d-{{ section.id }}.is-3d .lbf3d__cta{opacity:var(--o);transform:translateY(calc((1 - var(--o)) * 10px))}
#lbf3d-{{ section.id }}.is-3d.is-rm .lbf3d__line,#lbf3d-{{ section.id }}.is-3d.is-rm .lbf3d__cd,#lbf3d-{{ section.id }}.is-3d.is-rm .lbf3d__trust,#lbf3d-{{ section.id }}.is-3d.is-rm .lbf3d__cta{transform:none}
#lbf3d-{{ section.id }}.is-3d.is-rm .lbf3d__ate{transform:translateY(calc(-100% - 8px))}
#lbf3d-{{ section.id }} .lbf3d__rmveil{display:block;position:absolute;inset:0;z-index:4;background:var(--ink);opacity:0;pointer-events:none;transition:opacity .2s linear}
#lbf3d-{{ section.id }} .lbf3d__rmveil.is-on{opacity:1;transition:none}

/* reveal: chapter 01 rises in as the veil opens (the script adds is-revealing in the same frame as the
   veil's is-out; the delays follow the veil's own fade) */
@keyframes lbf3dRise{from{transform:translateY(130%)}to{transform:none}}
@keyframes lbf3dFade{from{opacity:0}to{opacity:1}}
#lbf3d-{{ section.id }}.is-revealing .lbf3d__ln>span{animation:lbf3dRise .7s var(--ease) .15s both}
#lbf3d-{{ section.id }}.is-revealing .lbf3d__ln+.lbf3d__ln>span{animation-delay:.21s}
#lbf3d-{{ section.id }}.is-revealing .lbf3d__sub,#lbf3d-{{ section.id }}.is-revealing .lbf3d__date,#lbf3d-{{ section.id }}.is-revealing .lbf3d__offer{animation:lbf3dFade .45s var(--ease) .55s both}
/* With the veil (lbf3d--ld), chapter 01 waits in that pre-reveal state from the first paint, so it is
   never seen static before it rises (it stays in the DOM for search engines and screen readers).
   Failsafe: on its own it rises right after the veil's own CSS lift (separate keyframe names, so the
   script's is-revealing always starts a fresh rise). is-revealed: already past it, no rise. */
@keyframes lbf3dRiseF{from{transform:translateY(130%)}to{transform:none}}
@keyframes lbf3dFadeF{from{opacity:0}to{opacity:1}}
#lbf3d-{{ section.id }}.lbf3d--ld:not(.is-revealing):not(.is-revealed) .lbf3d__ln>span{animation:lbf3dRiseF .7s var(--ease) 3.45s both}
#lbf3d-{{ section.id }}.lbf3d--ld:not(.is-revealing):not(.is-revealed) .lbf3d__sub,#lbf3d-{{ section.id }}.lbf3d--ld:not(.is-revealing):not(.is-revealed) .lbf3d__date,#lbf3d-{{ section.id }}.lbf3d--ld:not(.is-revealing):not(.is-revealed) .lbf3d__offer{animation:lbf3dFadeF .45s var(--ease) 3.8s both}

/* loader: a veil over the stage only (never the theme header), server-rendered with the class
   lbf3d--ld so it is there in the first paint. The opaque veil hides the poster underneath. The
   emblem is drawn in thin gold lines exactly where the 3D (or flat) gold emblem appears
   (--em-x/--em-y/--em-d, as emFrame: set by the inline script right after the section, before the
   first paint), then hands over. */
#lbf3d-{{ section.id }} .lbf3d__loader{position:absolute;inset:0;z-index:10;pointer-events:none;overflow:hidden}
#lbf3d-{{ section.id }} .lbf3d__loader[hidden]{display:none}
/* CSS failsafe: it lifts itself 3.4 s after its first frame if no script takes over (blocked or
   failing script; without JavaScript at all a <noscript> rule removes it). Opacity only, so the
   compositor can run it even while long tasks hold the page (it never takes pointer events). The
   engine counts from the veil's first frame (ldClock) and always opens it first (by 3 s). */
#lbf3d-{{ section.id }}.lbf3d--ld .lbf3d__loader{animation:lbf3dLdLift .45s var(--ease) 3.4s forwards}
@keyframes lbf3dLdLift{to{opacity:0}}
#lbf3d-{{ section.id }} .lbf3d__ld-veil{display:block;position:absolute;inset:0;background:radial-gradient(64vmin 64vmin at var(--em-x,50%) var(--em-y,calc(max(470px,var(--stage-h)) * .4)),#140f08 0%,#090705 58%,#060504 100%),var(--ink)}
@media (min-width:900px){#lbf3d-{{ section.id }} .lbf3d__ld-veil{background:radial-gradient(64vmin 64vmin at var(--em-x,62%) var(--em-y,calc(max(470px,var(--stage-h)) * .5)),#140f08 0%,#090705 58%,#060504 100%),var(--ink)}}
#lbf3d-{{ section.id }} .lbf3d__ld-box{display:block;position:absolute;left:var(--em-x,50%);top:var(--em-y,calc(max(470px,var(--stage-h)) * .4));width:var(--em-d);aspect-ratio:1/1;transform:translate(-50%,-50%)}
@supports not (aspect-ratio:1/1){#lbf3d-{{ section.id }} .lbf3d__ld-box{height:var(--em-d)}}
@media (min-width:900px){#lbf3d-{{ section.id }} .lbf3d__ld-box{left:var(--em-x,62%);top:var(--em-y,calc(max(470px,var(--stage-h)) * .5))}}
/* later framing changes (resize, fonts) glide; the first one never does */
#lbf3d-{{ section.id }} .lbf3d__loader.is-live .lbf3d__ld-box{transition:left .35s var(--ease),top .35s var(--ease),width .35s var(--ease),height .35s var(--ease)}
/* The lines appear under a soft sweep, left to right: the clip layer (3 emblems wide, feathered right
   edge) moves in while the lines inside move the other way by exactly as much (they stay still).
   Translation only, so the compositor runs it even while the page's scripts hold the main thread, and
   the lines stay crisp. At rest the feather lies beyond the emblem. */
#lbf3d-{{ section.id }} .lbf3d__ld-lines{position:absolute;inset:0}
#lbf3d-{{ section.id }} .lbf3d__ld-wipe{position:absolute;left:-100%;top:-4%;width:300%;height:108%;overflow:hidden;
  -webkit-mask-image:linear-gradient(90deg,#000 70%,transparent 90%);mask-image:linear-gradient(90deg,#000 70%,transparent 90%);
  animation:lbf3dWipe .75s var(--ease) backwards}
#lbf3d-{{ section.id }} .lbf3d__ld-in{position:absolute;left:33.3333%;top:3.7037%;width:33.3333%;height:92.5926%;animation:lbf3dWipeIn .75s var(--ease) backwards}
@keyframes lbf3dWipe{from{transform:translateX(-57%)}to{transform:translateX(0)}}
@keyframes lbf3dWipeIn{from{transform:translateX(171%)}to{transform:translateX(0)}}
#lbf3d-{{ section.id }} .lbf3d__ld-em{display:block;position:absolute;inset:0;width:100%;height:100%;max-width:none;overflow:visible;fill:none;stroke-width:.24;stroke-linecap:round;stroke-linejoin:round}
@media (min-width:900px){#lbf3d-{{ section.id }} .lbf3d__ld-em{stroke-width:.18}}
/* the counter only exists once the script drives it (never a frozen 0 %) */
#lbf3d-{{ section.id }} .lbf3d__ld-pc{position:absolute;left:0;right:0;top:calc(100% + 22px);margin:0;text-align:center;font:600 11px/1 var(--sans);letter-spacing:.14em;color:var(--g4);font-variant-numeric:lining-nums tabular-nums;white-space:nowrap;visibility:hidden;opacity:0}
#lbf3d-{{ section.id }} .lbf3d__ld-pc b{font-weight:600;letter-spacing:.14em;margin-right:-.06em}
#lbf3d-{{ section.id }} .lbf3d__loader.is-live .lbf3d__ld-pc{visibility:visible;opacity:1;transition:opacity .25s linear}
/* exit: the counter goes first (before the copy can show through), then the veil opens onto the
   gold and the lines dissolve into the emblem */
#lbf3d-{{ section.id }} .lbf3d__loader.is-out .lbf3d__ld-pc{opacity:0;transition:opacity .15s linear}
#lbf3d-{{ section.id }} .lbf3d__loader.is-out .lbf3d__ld-veil{opacity:0;transition:opacity .5s var(--ease) .15s}
#lbf3d-{{ section.id }} .lbf3d__loader.is-out .lbf3d__ld-lines{opacity:0;transform:scale(1.03);transition:opacity .55s var(--ease) .2s,transform .75s var(--ease) .15s}
/* while the script's veil is up: what it covers can be neither clicked nor focused, and the poster's
   sheen waits (nobody sees it) */
#lbf3d-{{ section.id }}.is-veiled .lbf3d__stage a{visibility:hidden}
#lbf3d-{{ section.id }}.is-veiled .lbf3d__em-sheen{animation-play-state:paused}
/* the veil hands over to the 3D: canvas in, poster out, at once (under the still opaque veil) */
#lbf3d-{{ section.id }}.is-cut .lbf3d__canvas,#lbf3d-{{ section.id }}.is-cut .lbf3d__poster{transition:none}

/* static premium poster: the official emblem (inline SVG sprite) in gold */
#lbf3d-{{ section.id }} .lbf3d__poster{position:absolute;inset:0;z-index:1;pointer-events:none}
/* --em-x/--em-y/--em-d come from the same framing as the 3D camera (emFrame in JS) */
#lbf3d-{{ section.id }} .lbf3d__em{position:absolute;left:var(--em-x,50%);top:var(--em-y,40%);width:var(--em-d);aspect-ratio:1/1;transform:translate(-50%,-50%)}
@supports not (aspect-ratio:1/1){#lbf3d-{{ section.id }} .lbf3d__em{height:var(--em-d)}}
@media (min-width:900px){#lbf3d-{{ section.id }} .lbf3d__em{left:var(--em-x,62%);top:var(--em-y,50%)}}
#lbf3d-{{ section.id }} .lbf3d__em-svg{position:absolute;inset:0;width:100%;height:100%;max-width:none;overflow:visible}
#lbf3d-{{ section.id }} .lbf3d__em-base{filter:drop-shadow(0 10px 20px rgba(0,0,0,.55))}
/* a cream copy of the same paths, masked to a moving band: the sheen only lights the gold */
#lbf3d-{{ section.id }} .lbf3d__em-sheen{opacity:.8;
  -webkit-mask-image:linear-gradient(105deg,transparent 40%,#000 50%,transparent 60%);mask-image:linear-gradient(105deg,transparent 40%,#000 50%,transparent 60%);
  -webkit-mask-size:300% 100%;mask-size:300% 100%;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;
  -webkit-mask-position:120% 0;mask-position:120% 0;animation:lbf3dSheen 6s var(--ease) infinite}
@keyframes lbf3dSheen{0%,55%{-webkit-mask-position:120% 0;mask-position:120% 0}85%,100%{-webkit-mask-position:-20% 0;mask-position:-20% 0}}
/* the sheen only runs while the poster is what the reader sees */
#lbf3d-{{ section.id }}.is-3d:not(.is-lost):not(.is-fadein) .lbf3d__em-sheen{animation:none}
#lbf3d-{{ section.id }}.is-off .lbf3d__em-sheen,#lbf3d-{{ section.id }}.is-off .lbf3d__cue-l::after{animation-play-state:paused}

/* ---------- fixed bottom bar: only while the sequence is on screen (JS), above content ----------
   z-index 89: one below the header section wrapper (#shopify-section-<header>{z-index:90}), whose stacking
   context holds the mobile drawer and the search overlay, so both always paint (and take taps) above the bar */
#lbf3d-bar-{{ section.id }}{position:fixed;z-index:89;left:0;right:0;bottom:calc(12px + var(--lbf3d-bar-off,0px) + var(--sb));margin:0;padding:0 var(--gr) 0 var(--gl);pointer-events:none;transition:transform .3s var(--ease),opacity .3s var(--ease),visibility 0s}
#lbf3d-bar-{{ section.id }} .lbf3d-bar__in{position:relative;display:flex;gap:8px;padding:6px;border-radius:999px;background:rgba(12,9,6,.94);border:1px solid var(--hair);box-shadow:0 10px 30px rgba(0,0,0,.45);pointer-events:auto;margin:0 auto}
@media (min-width:900px){#lbf3d-bar-{{ section.id }} .lbf3d-bar__in{width:min(440px,calc(100% - 96px))}}
/* phones: room on the right for a chat bubble / back-to-top button (setting, 0 by default) */
@media (max-width:899px){#lbf3d-bar-{{ section.id }}{padding-right:calc(var(--gr) + var(--lbf3d-bar-side,0px))}}
@media (min-width:900px) and (pointer:fine){
  @supports ((-webkit-backdrop-filter:blur(1px)) or (backdrop-filter:blur(1px))){#lbf3d-bar-{{ section.id }} .lbf3d-bar__in{background:rgba(12,9,6,.72);-webkit-backdrop-filter:blur(14px) saturate(140%);backdrop-filter:blur(14px) saturate(140%)}}
}
@supports ((-webkit-backdrop-filter:blur(1px)) or (backdrop-filter:blur(1px))){#lbf3d-bar-{{ section.id }}.is-free .lbf3d-bar__in{background:rgba(12,9,6,.72);-webkit-backdrop-filter:blur(14px) saturate(140%);backdrop-filter:blur(14px) saturate(140%)}}
#lbf3d-bar-{{ section.id }}.is-pre{transform:translateY(16px);opacity:0;pointer-events:none}
#lbf3d-bar-{{ section.id }}.is-pre .lbf3d-bar__in{pointer-events:none}
#lbf3d-bar-{{ section.id }}.is-hidden,#lbf3d-bar-{{ section.id }}.is-endcta{transform:translateY(130%);opacity:0}
#lbf3d-bar-{{ section.id }}.is-hidden .lbf3d-bar__in,#lbf3d-bar-{{ section.id }}.is-endcta .lbf3d-bar__in{pointer-events:none}
/* invisible pills leave the tab order once the fade has finished */
#lbf3d-bar-{{ section.id }}.is-pre,#lbf3d-bar-{{ section.id }}.is-hidden,#lbf3d-bar-{{ section.id }}.is-endcta{visibility:hidden;transition:transform .3s var(--ease),opacity .3s var(--ease),visibility 0s .3s}
#lbf3d-{{ section.id }} .lbf3d-pill,#lbf3d-bar-{{ section.id }} .lbf3d-pill{display:flex;align-items:center;justify-content:center;text-align:center;min-height:48px;padding:8px 14px;border-radius:999px;font:600 14px/1.15 var(--sans);letter-spacing:.02em;text-transform:none;white-space:normal;text-decoration:none;cursor:pointer;-webkit-tap-highlight-color:transparent;transition:background-position .6s var(--ease),transform .15s ease,border-color .3s}
#lbf3d-{{ section.id }} .lbf3d-pill--gold,#lbf3d-bar-{{ section.id }} .lbf3d-pill--gold{flex:1.35;color:#120e08;border:0;background:linear-gradient(100deg,#a8823f 0%,#e5c98e 38%,#fff3cf 50%,#e5c98e 62%,#bc914c 100%);background-size:220% 100%;background-position:0% 0}
#lbf3d-{{ section.id }} .lbf3d-pill--gold:hover,#lbf3d-{{ section.id }} .lbf3d-pill--gold:focus-visible,#lbf3d-bar-{{ section.id }} .lbf3d-pill--gold:hover,#lbf3d-bar-{{ section.id }} .lbf3d-pill--gold:focus-visible{background-position:100% 0;color:#120e08}
#lbf3d-bar-{{ section.id }} .lbf3d-pill--ghost{flex:1;color:var(--g5);background:transparent;border:1px solid rgba(229,201,142,.45)}
#lbf3d-bar-{{ section.id }} .lbf3d-pill--ghost:hover{border-color:var(--g4);color:var(--g5)}
#lbf3d-{{ section.id }} .lbf3d-pill:active,#lbf3d-bar-{{ section.id }} .lbf3d-pill:active{transform:scale(.98)}
#lbf3d-{{ section.id }} .lbf3d-pill:focus-visible,#lbf3d-bar-{{ section.id }} .lbf3d-pill:focus-visible{outline:2px solid var(--g5);outline-offset:3px;box-shadow:0 0 0 2px #060504}
#lbf3d-bar-{{ section.id }} .lbf3d-pill[hidden]{display:none}
@media (max-width:339px){#lbf3d-{{ section.id }} .lbf3d-pill,#lbf3d-bar-{{ section.id }} .lbf3d-pill{font-size:13px;letter-spacing:0;padding:8px 10px}}
#lbf3d-bar-{{ section.id }} .lbf3d-bar__status{display:block;position:absolute;left:50%;bottom:calc(100% + 10px);width:max-content;max-width:min(92vw,420px);transform:translate(-50%,6px);margin:0;padding:9px 14px;border-radius:14px;background:rgba(12,9,6,.96);border:1px solid var(--hair);font:500 12.5px/1.4 var(--sans);color:var(--cream);text-align:center;opacity:0;pointer-events:none;transition:opacity .3s,transform .3s var(--ease)}
#lbf3d-bar-{{ section.id }} .lbf3d-bar__status.is-on{opacity:1;transform:translate(-50%,0)}

@media (prefers-reduced-motion:reduce){
  #lbf3d-{{ section.id }} .lbf3d__cue-l::after{animation:none}
  #lbf3d-{{ section.id }} .lbf3d__em-sheen{animation:none;opacity:0}
  #lbf3d-{{ section.id }}.is-revealing .lbf3d__ln>span{animation:lbf3dFade .2s linear both}
  #lbf3d-{{ section.id }}.is-revealing .lbf3d__sub,#lbf3d-{{ section.id }}.is-revealing .lbf3d__date,#lbf3d-{{ section.id }}.is-revealing .lbf3d__offer{animation:lbf3dFade .2s linear both}
  #lbf3d-bar-{{ section.id }}{transition:opacity .3s linear,visibility 0s}
  #lbf3d-bar-{{ section.id }}.is-pre,#lbf3d-bar-{{ section.id }}.is-hidden,#lbf3d-bar-{{ section.id }}.is-endcta{transition:opacity .3s linear,visibility 0s .3s}
  #lbf3d-bar-{{ section.id }}.is-pre{transform:none}
  #lbf3d-{{ section.id }} .lbf3d-pill,#lbf3d-bar-{{ section.id }} .lbf3d-pill{transition:none}
  /* loader: no sweep, no glide, an instant exit; the waiting copy simply appears */
  #lbf3d-{{ section.id }} .lbf3d__ld-wipe,#lbf3d-{{ section.id }} .lbf3d__ld-in{animation:none}
  #lbf3d-{{ section.id }} .lbf3d__loader.is-live .lbf3d__ld-box{transition:none}
  #lbf3d-{{ section.id }} .lbf3d__loader.is-out *{transition:none!important}
  #lbf3d-{{ section.id }}.lbf3d--ld .lbf3d__loader{animation-duration:.01s}
  #lbf3d-{{ section.id }}.lbf3d--ld:not(.is-revealing):not(.is-revealed) .lbf3d__ln>span{animation:lbf3dFadeF .01s linear 3.4s both}
  #lbf3d-{{ section.id }}.lbf3d--ld:not(.is-revealing):not(.is-revealed) .lbf3d__sub,#lbf3d-{{ section.id }}.lbf3d--ld:not(.is-revealing):not(.is-revealed) .lbf3d__date,#lbf3d-{{ section.id }}.lbf3d--ld:not(.is-revealing):not(.is-revealed) .lbf3d__offer{animation:lbf3dFadeF .01s linear 3.4s both}
  /* "static with reduced motion" setting: no 3D will come, so no veil either, and nothing waits for it */
  #lbf3d-{{ section.id }}.lbf3d--rmstatic .lbf3d__loader{display:none}
  #lbf3d-{{ section.id }}.lbf3d--ld.lbf3d--rmstatic:not(.is-revealing):not(.is-revealed) .lbf3d__ln>span,#lbf3d-{{ section.id }}.lbf3d--ld.lbf3d--rmstatic:not(.is-revealing):not(.is-revealed) .lbf3d__sub,#lbf3d-{{ section.id }}.lbf3d--ld.lbf3d--rmstatic:not(.is-revealing):not(.is-revealed) .lbf3d__date,#lbf3d-{{ section.id }}.lbf3d--ld.lbf3d--rmstatic:not(.is-revealing):not(.is-revealed) .lbf3d__offer{animation:none}
}
@media print{#lbf3d-bar-{{ section.id }},#lbf3d-{{ section.id }} .lbf3d__loader{display:none!important}#lbf3d-{{ section.id }} .lbf3d__ln>span,#lbf3d-{{ section.id }} .lbf3d__sub,#lbf3d-{{ section.id }} .lbf3d__date,#lbf3d-{{ section.id }} .lbf3d__offer{animation:none!important}}
{% endstyle %}

<section
  id="lbf3d-{{ section.id }}"
  class="lbf3d lbf3d--nojs{% unless s.show_bottom_bar %} lbf3d--nobar{% endunless %}{% if use_ld %} lbf3d--ld{% endif %}{% if s.reduce_motion_static %} lbf3d--rmstatic{% endif %}"
  data-lbf3d
  data-section-id="{{ section.id }}"
  data-numerals="{{ disc_show | escape }}"
  aria-label="{{ t_aria | escape }}"
  style="--lbf3d-len:{{ seq_len }};{% if s.show_bottom_bar %}--lbf3d-bar-off:{{ bar_off }}px;{% endif %}"
>
  {%- if use_ld %}
  {%- comment -%} Sem JavaScript não há véu nem espera: a versão estática aparece logo. {%- endcomment %}
  <noscript><style>#lbf3d-{{ section.id }} .lbf3d__loader{display:none!important}#lbf3d-{{ section.id }} .lbf3d__ln>span,#lbf3d-{{ section.id }} .lbf3d__sub,#lbf3d-{{ section.id }} .lbf3d__date,#lbf3d-{{ section.id }} .lbf3d__offer{animation:none!important}</style></noscript>
  {%- endif %}
  {%- comment -%}
    Vetores oficiais do emblema da Loja do Ouro: a única cópia dos dados do logótipo. O cartaz estático,
    o contador de carregamento e a extrusão 3D leem todos daqui. Nunca display:none (os degradés deixavam de pintar).
  {%- endcomment -%}
  <svg class="lbf3d__sprite" aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0;overflow:hidden"><defs>
