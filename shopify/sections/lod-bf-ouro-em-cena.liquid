  })(document);
</script>

{% style %}
/* Loja do Ouro · BF «Ouro em Cena»: tudo dentro de #lbf3d-{{ section.id }} (a secção) e #lbf3d-bar-{{ section.id }} (a barra fixa) */
#lbf3d-{{ section.id }},#lbf3d-bar-{{ section.id }}{
  color-scheme:dark;
  --ink:#060504;--ink2:#120e08;--ink3:#0b0806;--glow:#1a130a;--petrol:#1d3e47;
  --g1:#7a5a22;--g2:#a8823f;--g3:#bc914c;--g4:#e5c98e;--g5:#fff3cf;
  --cream:#efe3c4;--cream2:#f3e7c9;--trust:#e9dcbc;--hair:rgba(229,201,142,.18);
{%- if s.font_source == 'theme' %}
  --serif:var(--font-heading-family,"Bodoni Moda",Georgia,serif);
  --sans:var(--font-body-family,Inter,system-ui,sans-serif);
{%- else %}
  --serif:"Bodoni Moda","Bodoni 72",Didot,"Bodoni MT","Playfair Display",Georgia,serif;
  --sans:Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
{%- endif %}
  --gl:max(16px, env(safe-area-inset-left, 0px));
  --gr:max(16px, env(safe-area-inset-right, 0px));
  --sb:env(safe-area-inset-bottom, 0px);
  --ease:cubic-bezier(.2,.7,.2,1);
  --foil:linear-gradient(100deg,#bc914c 0%,#fff3cf 48%,#e5c98e 100%);
  color:var(--cream);font-family:var(--sans);font-size:15px;font-style:normal;font-weight:400;line-height:1.5;letter-spacing:normal;text-transform:none;text-align:left;
  -webkit-font-smoothing:antialiased;-webkit-text-size-adjust:100%;text-size-adjust:100%
}
#lbf3d-{{ section.id }},#lbf3d-{{ section.id }} *,#lbf3d-{{ section.id }} *::before,#lbf3d-{{ section.id }} *::after,#lbf3d-bar-{{ section.id }},#lbf3d-bar-{{ section.id }} *,#lbf3d-bar-{{ section.id }} *::before,#lbf3d-bar-{{ section.id }} *::after{box-sizing:border-box}
#lbf3d-{{ section.id }} a,#lbf3d-bar-{{ section.id }} a{color:inherit}
#lbf3d-{{ section.id }} :focus-visible,#lbf3d-bar-{{ section.id }} :focus-visible{outline:2px solid var(--g5);outline-offset:3px;box-shadow:none}
#lbf3d-{{ section.id }}[hidden],#lbf3d-bar-{{ section.id }}[hidden],#lbf3d-{{ section.id }} [hidden],#lbf3d-bar-{{ section.id }} [hidden]{display:none!important}
/* the theme's heading/paragraph styles stop at the section edge */
#lbf3d-{{ section.id }} h2,#lbf3d-{{ section.id }} h3,#lbf3d-{{ section.id }} p,#lbf3d-bar-{{ section.id }} p{margin:0;font-style:normal;letter-spacing:normal;text-transform:none;word-break:normal;overflow-wrap:normal}
#lbf3d-{{ section.id }} .lbf3d__sr{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;border:0}

/* ---------- section + stage ---------- */
/* --lbf3d-head: the theme's fixed header shell, measured in JS (64px until then) */
#lbf3d-{{ section.id }}{position:relative;display:block;margin:0;padding:0;background:var(--ink);--lbf3d-head:64px;--lbf3d-top:calc(var(--lbf3d-head) + env(safe-area-inset-top,0px));--lbf3d-bar-h:72px;--stage-h:calc(100vh - var(--lbf3d-top));--em-d:min(71vw,calc((100vh - var(--lbf3d-top)) * .376),300px)}
@supports (height:100svh){#lbf3d-{{ section.id }}{--stage-h:calc(100svh - var(--lbf3d-top));--em-d:min(71vw,calc((100svh - var(--lbf3d-top)) * .376),300px)}}
@media (min-width:900px){#lbf3d-{{ section.id }}{--em-d:min(34vw,52vh)}}
#lbf3d-{{ section.id }}.lbf3d--nobar{--lbf3d-bar-h:0px;--lbf3d-bar-off:0px}
#lbf3d-{{ section.id }} .lbf3d__stage{position:relative;isolation:isolate}
#lbf3d-{{ section.id }} .lbf3d__hero{position:relative;height:var(--stage-h);min-height:470px;overflow:hidden;
  background:radial-gradient(64vmin 64vmin at var(--em-x,50%) var(--em-y,40%),#1a130a 0%,#0b0806 58%,#060504 100%),var(--ink)}
#lbf3d-{{ section.id }} .lbf3d__hero::before{content:"";position:absolute;inset:0;background:radial-gradient(70% 45% at 0% 100%,rgba(29,62,71,.22),transparent 70%);pointer-events:none}
#lbf3d-{{ section.id }} .lbf3d__canvas{display:none}
#lbf3d-{{ section.id }} .lbf3d__skip{position:absolute;z-index:40;left:var(--gl);top:8px;padding:10px 16px;border-radius:999px;background:var(--ink2);color:var(--g5);font:600 13px/1 var(--sans);text-decoration:none;border:1px solid var(--hair);opacity:0;pointer-events:none;transform:translateY(-6px)}
#lbf3d-{{ section.id }} .lbf3d__skip:focus,#lbf3d-{{ section.id }} .lbf3d__skip:focus-visible{opacity:1;pointer-events:auto;transform:none}
#lbf3d-{{ section.id }} .lbf3d__fim{position:absolute;left:0;width:1px;height:1px;top:calc(100% - var(--stage-h));scroll-margin-top:var(--lbf3d-top)}
#lbf3d-{{ section.id }} .lbf3d__probe{position:absolute;left:0;top:0;width:1px;height:var(--lbf3d-top);visibility:hidden;pointer-events:none}
#lbf3d-{{ section.id }} .lbf3d__ednote{position:absolute;z-index:45;right:var(--gr);top:52px;max-width:280px;margin:0;padding:8px 12px;border-radius:10px;background:#7a1f12;color:#fff;font:600 12px/1.35 var(--sans);box-shadow:0 6px 18px rgba(0,0,0,.4)}

/* 3D mode (added by JS only once WebGL has rendered); length from the "Duração da sequência" setting.
