#lbf3d-{{ section.id }}.is-3d.is-rm{height:calc(var(--lbf3d-len,300) * .8vh)}
@supports (height:1svh){#lbf3d-{{ section.id }}.is-3d.is-rm{height:calc(var(--lbf3d-len,300) * .8svh)}}
#lbf3d-{{ section.id }}.is-3d .lbf3d__stage{position:-webkit-sticky;position:sticky;top:var(--lbf3d-top);height:var(--stage-h);overflow:hidden;touch-action:pan-y pinch-zoom}
