#lbf3d-{{ section.id }} .lbf3d__ch1 .lbf3d__kicker{position:absolute!important;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}
#lbf3d-{{ section.id }} .lbf3d__line{margin:0 0 18px;font:400 15px/1.5 var(--sans);color:var(--cream)}
#lbf3d-{{ section.id }} .lbf3d__cd{margin:0 auto 18px}
#lbf3d-{{ section.id }} .lbf3d__cd-label,#lbf3d-{{ section.id }} .lbf3d__cd-done{margin:0 0 8px;font:600 11px/1.2 var(--sans);letter-spacing:.28em;text-transform:uppercase;color:var(--g3)}
#lbf3d-{{ section.id }} .lbf3d__cd-done{letter-spacing:.04em;text-transform:none;font:italic 400 18px/1.3 var(--serif);color:var(--g4)}
#lbf3d-{{ section.id }} .lbf3d__cells{display:inline-flex;align-items:flex-start;gap:6px}
#lbf3d-{{ section.id }} .lbf3d__cell{display:grid;justify-items:center;gap:4px;min-width:56px}
#lbf3d-{{ section.id }} .lbf3d__cell+.lbf3d__cell{border-left:1px solid var(--hair);padding-left:6px}
#lbf3d-{{ section.id }} .lbf3d__cell b{display:block;width:2ch;text-align:center;font:500 32px/1 var(--serif);color:var(--g5);font-variant-numeric:lining-nums tabular-nums}
#lbf3d-{{ section.id }} .lbf3d__cell i{font:600 11px/1 var(--sans);font-style:normal;letter-spacing:.2em;text-transform:uppercase;color:var(--g3)}
#lbf3d-{{ section.id }} .lbf3d__trust{margin:0;display:grid;gap:6px;justify-items:center;font:500 12px/1.4 var(--sans);color:var(--trust)}
#lbf3d-{{ section.id }} .lbf3d__trust span{display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:center}
#lbf3d-{{ section.id }} .lbf3d__dia{display:inline-block;width:5px;height:5px;background:var(--g3);transform:rotate(45deg);flex:none}
#lbf3d-{{ section.id }} .lbf3d__cta{display:none!important;margin:22px auto 0;max-width:260px}
/* no bar (setting) or no JS: the end CTA also shows on phones */
#lbf3d-{{ section.id }}.lbf3d--nobar .lbf3d__cta,#lbf3d-{{ section.id }}.lbf3d--nojs .lbf3d__cta{display:flex!important}
@media (min-width:900px){
  #lbf3d-{{ section.id }} .lbf3d__cta{display:flex!important}
  #lbf3d-{{ section.id }} .lbf3d__ate{font-size:34px}
