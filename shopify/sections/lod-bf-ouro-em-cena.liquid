          assign auto_date = dd1 | append: ' a ' | append: dd2 | append: ' de ' | append: mn1
        else
          assign auto_date = dd1 | append: ' de ' | append: mn1 | append: ' a ' | append: dd2 | append: ' de ' | append: mn2
        endif
      when 'es'
        if sd_m == ed_m
          assign auto_date = dd1 | append: ' al ' | append: dd2 | append: ' de ' | append: mn1
        else
          assign auto_date = dd1 | append: ' de ' | append: mn1 | append: ' al ' | append: dd2 | append: ' de ' | append: mn2
        endif
      when 'fr'
        if sd_d == 1
          assign dd1 = '1er'
        endif
        if ed_d == 1
          assign dd2 = '1er'
        endif
        if sd_m == ed_m
          assign auto_date = dd1 | append: ' au ' | append: dd2 | append: ' ' | append: mn1
        else
          assign auto_date = dd1 | append: ' ' | append: mn1 | append: ' au ' | append: dd2 | append: ' ' | append: mn2
        endif
      when 'de'
        if sd_m == ed_m
          assign auto_date = dd1 | append: '.–' | append: dd2 | append: '. ' | append: mn1
        else
          assign auto_date = dd1 | append: '. ' | append: mn1 | append: ' – ' | append: dd2 | append: '. ' | append: mn2
        endif
      else
        if sd_m == ed_m
          assign auto_date = dd1 | append: '–' | append: dd2 | append: ' ' | append: mn1
        else
