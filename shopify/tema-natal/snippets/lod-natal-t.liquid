{%- liquid
  if k == '*'
    assign lnt_tudo = lnt_raw
    assign lnt_ok = true
  else
    assign lnt_x = lnt_raw | split: lnt_n
    if lnt_x.size > 1
      assign lnt_v = lnt_x[1] | split: '~~' | first | strip
      assign lnt_ok = true
    endif
  endif
-%}
{%- endunless -%}
{%- endfor -%}
{%- liquid
  if k == '*'
    echo lnt_tudo | replace: '{marca}', lnt_marca
  elsif lnt_ok
    assign lnt_v = lnt_v | replace: '{marca}', lnt_marca
    if v1 != nil
      assign lnt_v = lnt_v | replace: '{1}', v1
    endif
    if v2 != nil
      assign lnt_v = lnt_v | replace: '{2}', v2
    endif
    echo lnt_v
  elsif request.design_mode
    echo '[' | append: k | append: ']'
  endif
-%}
{%- endif -%}
