{%- comment -%}
  Natal 2026 · Ouro de Reis — «Três presentes. Um Natal inteiro.»
  Fundo linho com azulejo. Blocos «presente» (ouro, incenso, mirra): colunas com filetes dourados no
  computador; linhas com o ícone à esquerda no telemóvel (sem imagens).
  Um bloco pode abrir a janela de embrulho (<dialog> desta secção) com os preços reais de 3 produtos.
  Nos textos dos blocos, {trocas} passa a data de settings.natal_trocas_ate (ex.: «15 de janeiro»).
  Línguas: campos base em português e campos _en/_es (vazios → português); «Fechar» e «Esgotado» vêm do
  dicionário lod-natal-t. Versões: Portugal e Espanha (no Internacional a secção não aparece), cada uma nas
  suas fases (contrato i18n, secção 5). Ligações começadas por «/» ganham o prefixo da língua e do mercado.
{%- endcomment -%}
{%- liquid
  # Língua da página, versão da campanha (mercado da visita) e fase dessa versão
  capture lnat_lg
    render 'lod-natal-t', k: '_lingua'
  endcapture
  assign lnat_lg = lnat_lg | strip
  capture lnat_versao
    render 'lod-natal-fase', mercado: 'auto', devolve: 'versao'
  endcapture
  assign lnat_versao = lnat_versao | strip
  capture lnat_fase
    render 'lod-natal-fase', mercado: 'auto'
  endcapture
  assign lnat_fase = lnat_fase | strip
  # Versões em que esta secção existe: Portugal e Espanha
  assign versoes = ',pt,es,'
  case lnat_versao
    when 'es'
      assign fases_versao = ',navidad,reyes,reyes_ultima,noche_reyes,'
    when 'int'
      assign fases_versao = ',navidad,'
    else
      assign lnat_versao = 'pt'
      assign fases_versao = ',ouro,incenso,ultima,consoada,mirra,'
  endcase
  assign k_v = ',' | append: lnat_versao | append: ','
  assign k_f = ',' | append: lnat_fase | append: ','
  assign suporta = false
  if versoes contains k_v
    assign suporta = true
  endif
  assign oculta = true
  if suporta and fases_versao contains k_f
    assign oculta = false
  endif
  assign mostrar = true
  if oculta
    assign mostrar = false
    if request.design_mode
      assign mostrar = true
    endif
  endif

  # Textos na língua da página
  assign s = section.settings
  assign t_eyebrow = s.eyebrow
  assign t_titulo = s.titulo
  assign t_lead = s.lead
  assign t_emb_titulo = s.embrulho_titulo
  assign t_emb_nota = s.embrulho_nota
  assign suf = ''
  if lnat_lg != 'pt'
    assign suf = '_' | append: lnat_lg
    assign k = 'eyebrow' | append: suf
    if s[k] != blank
      assign t_eyebrow = s[k]
    endif
    assign k = 'titulo' | append: suf
    if s[k] != blank
      assign t_titulo = s[k]
    endif
    assign k = 'lead' | append: suf
    if s[k] != blank
      assign t_lead = s[k]
    endif
    assign k = 'embrulho_titulo' | append: suf
    if s[k] != blank
      assign t_emb_titulo = s[k]
    endif
    assign k = 'embrulho_nota' | append: suf
    if s[k] != blank
      assign t_emb_nota = s[k]
    endif
  endif
  capture t_fechar
    render 'lod-natal-t', k: 'fechar'
  endcapture
  capture t_esgotado
    render 'lod-natal-t', k: 'esgotado'
  endcapture
  assign t_fechar = t_fechar | strip
  assign t_esgotado = t_esgotado | strip

  # Prefixo da língua e do mercado para as ligações (routes.root_url é «/» na língua principal de cada domínio)
  assign raiz = routes.root_url | default: '/'
  assign raiz_pre = raiz | append: '/'

  capture d_trocas
    render 'lod-natal-data', valor: settings.natal_trocas_ate, formato: 'curto'
  endcapture
  assign d_trocas = d_trocas | strip
  assign com_trocas = false
  if settings.natal_mostrar_trocas and d_trocas != blank
    assign com_trocas = true
  endif

  assign dlg_id = 'lnat-tp-dlg-' | append: section.id
  assign n_emb = 0
  for i in (1..3)
    assign chave = 'embrulho_' | append: i
    if section.settings[chave] != blank
      assign n_emb = n_emb | plus: 1
    endif
  endfor
  assign tem_embrulho = false
  if n_emb > 0 or t_emb_nota != blank
    assign tem_embrulho = true
  endif
-%}
{%- if mostrar -%}
<section
  class="lnat lnat-tp lnat-sec lnat-bg-linho{% if section.settings.azulejo %} lnat-azulejo-linho{% endif %}{% unless section.settings.mostrar_no_telemovel %} lnat-tp--sem-tel{% endunless %}{% if request.design_mode %} lnat-tp--editor{% endif %}"
  id="lnat-tp-{{ section.id }}"
  aria-labelledby="lnat-tp-h-{{ section.id }}"
>
  <span id="embrulho" aria-hidden="true"></span>
  <div class="lnat-wrap">
    {%- if request.design_mode and suporta == false -%}
      <p class="lnat-aviso-fase" style="margin:0 0 24px;padding:8px 12px;background:#fff3cd;color:#3d2f00;font:13px/1.4 var(--lnat-sans,system-ui,sans-serif);text-align:left">Pré-visualização no editor: esta secção não aparece no mercado Internacional (só em Portugal e em Espanha).</p>
    {%- elsif oculta -%}
      {%- render 'lod-natal-aviso-fase', fase: lnat_fase -%}
    {%- endif -%}

    <header class="lnat-tp__cab">
      {%- if t_eyebrow != blank -%}
        <p class="lnat-eb">{{ t_eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="lnat-h2 lnat-tp__h" id="lnat-tp-h-{{ section.id }}">{{ t_titulo | escape }}</h2>
      {%- if t_lead != blank -%}
        <p class="lnat-cg lnat-tp__lead">{{ t_lead | escape }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <ol class="lnat-tp__lista" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign b_eyebrow = b.eyebrow
            assign b_titulo = b.titulo
            assign texto = b.texto
            assign texto_trocas = b.texto_trocas
            assign img_alt = b.imagem_alt
            assign b_link = b.link_texto
            if suf != ''
              assign k = 'eyebrow' | append: suf
              if b[k] != blank
                assign b_eyebrow = b[k]
              endif
              assign k = 'titulo' | append: suf
              if b[k] != blank
                assign b_titulo = b[k]
              endif
              assign k = 'texto' | append: suf
              if b[k] != blank
                assign texto = b[k]
              endif
              assign k = 'texto_trocas' | append: suf
              if b[k] != blank
                assign texto_trocas = b[k]
              endif
              assign k = 'imagem_alt' | append: suf
              if b[k] != blank
                assign img_alt = b[k]
              endif
              assign k = 'link_texto' | append: suf
              if b[k] != blank
                assign b_link = b[k]
              endif
            endif
            if com_trocas and texto_trocas != blank
              assign texto = texto_trocas
            endif
            assign texto = texto | replace: '{trocas}', d_trocas
            assign img = b.imagem
            if img_alt == blank and img
              assign img_alt = img.alt
            endif
            assign u = b.link_url
            if u != blank and raiz != '/'
              assign u1 = u | slice: 0, 1
              assign u2 = u | slice: 0, 2
              assign u_pre = u | slice: 0, raiz_pre.size
              if u1 == '/' and u2 != '//' and u_pre != raiz_pre and u != raiz
                assign u = raiz | append: u
              endif
            endif
          -%}
          <li class="lnat-tp__item" {{ block.shopify_attributes }}>
            <span class="lnat-tp__ico">{%- render 'lod-natal-icon', nome: b.icone, tamanho: 48 -%}</span>
            <div class="lnat-tp__corpo">
              {%- if b.numeral != blank or b_eyebrow != blank -%}
                <p class="lnat-eb lnat-eb--simples lnat-tp__num">{{ b.numeral | escape }}{% if b.numeral != blank and b_eyebrow != blank %} · {% endif %}{{ b_eyebrow | escape }}</p>
              {%- endif -%}
              {%- if b_titulo != blank -%}
                <h3 class="lnat-h3 lnat-tp__titulo">{{ b_titulo | escape }}</h3>
              {%- endif -%}
              {%- if img -%}
                <div class="lnat-tp__img">
                  {{- img | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 480, 600, 720', sizes: '(min-width: 1440px) 400px, (min-width: 990px) 28vw, 1px', alt: img_alt -}}
                </div>
              {%- endif -%}
              {%- if texto != blank -%}
                <p class="lnat-txt lnat-tp__txt">{{ texto }}</p>
              {%- endif -%}
              {%- if b_link != blank -%}
                {%- if b.abre_embrulho and tem_embrulho -%}
                  <button type="button" class="lnat-link lnat-tp__link" data-lnat-tp-abrir="{{ dlg_id }}" aria-haspopup="dialog" aria-controls="{{ dlg_id }}">{{ b_link | escape }} <span aria-hidden="true">→</span></button>
                {%- elsif u != blank -%}
                  <a class="lnat-link lnat-tp__link" href="{{ u }}">{{ b_link | escape }} <span aria-hidden="true">→</span></a>
                {%- endif -%}
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- elsif request.design_mode -%}
      <p class="lnat-peq lnat-tp__vazio">Acrescente blocos «Presente» (ouro, incenso e mirra).</p>
    {%- endif -%}
  </div>

  {%- if tem_embrulho -%}
    <dialog class="lnat-tp__dlg" id="{{ dlg_id }}" aria-labelledby="{{ dlg_id }}-h">
      <div class="lnat-tp__dlg-topo">
        <span class="lnat-tp__dlg-ico">{%- render 'lod-natal-icon', nome: 'laco', tamanho: 40 -%}</span>
        <h2 class="lnat-h3 lnat-tp__dlg-h" id="{{ dlg_id }}-h">{{ t_emb_titulo | escape }}</h2>
        <form method="dialog" class="lnat-tp__dlg-form">
          <button type="submit" class="lnat-tp__fechar" aria-label="{{ t_fechar | escape }}">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6L18 18M18 6L6 18"/></svg>
          </button>
        </form>
      </div>
      {%- if n_emb > 0 -%}
        <ul class="lnat-tp__opcoes" role="list">
          {%- for i in (1..3) -%}
            {%- liquid
              assign chave = 'embrulho_' | append: i
              assign chave_t = chave | append: '_texto'
              assign p = section.settings[chave]
            -%}
            {%- if p != blank -%}
              {%- liquid
                assign desc = section.settings[chave_t]
                if suf != ''
                  assign k = chave_t | append: suf
                  if section.settings[k] != blank
                    assign desc = section.settings[k]
                  endif
                endif
                if desc == blank
                  assign desc = p.description | strip_html | strip_newlines | truncatewords: 18
                endif
                assign p_img = p.featured_media
              -%}
              <li class="lnat-tp__opcao">
                <span class="lnat-tp__opcao-img">
                  {%- if p_img -%}
                    {{- p_img | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' -}}
                  {%- else -%}
                    {%- render 'lod-natal-icon', nome: 'laco', tamanho: 32 -%}
                  {%- endif -%}
                </span>
                <span class="lnat-tp__opcao-txt">
                  <span class="lnat-tp__opcao-nome">{{ p.title | escape }}</span>
                  {%- if desc != blank -%}<span class="lnat-tp__opcao-desc">{{ desc | escape }}</span>{%- endif -%}
                </span>
                <span class="lnat-tp__opcao-preco">
                  {{- p.price | money -}}
                  {%- unless p.available -%}<span class="lnat-tp__opcao-esg">{{ t_esgotado | escape }}</span>{%- endunless -%}
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if t_emb_nota != blank -%}
        <p class="lnat-tp__nota">{{ t_emb_nota | escape | newline_to_br }}</p>
      {%- endif -%}
    </dialog>
  {%- endif -%}
</section>

<style>
  .lnat-tp{overflow:hidden}
  .lnat-tp__cab{display:flex;flex-direction:column;align-items:center;gap:14px;max-width:760px;margin:0 auto;text-align:center}
  .lnat-tp__h{color:var(--lnat-tinta)}
  .lnat-tp__lead{margin:0;font-size:22px;line-height:28px;color:var(--lnat-texto);text-wrap:balance}
  .lnat-tp__lista{list-style:none;margin:32px 0 0;padding:0}
  .lnat-tp__item{display:grid;grid-template-columns:44px minmax(0,1fr);gap:14px;margin:0;padding:20px 0;border-bottom:1px solid rgba(125,90,34,.22)}
  .lnat-tp__item:last-child{border-bottom:0;padding-bottom:0}
  .lnat-tp__ico{color:var(--lnat-ouro-velho);line-height:0}
  .lnat-tp__ico svg{width:40px;height:40px}
  .lnat-tp__corpo{display:flex;flex-direction:column;align-items:flex-start;gap:6px;min-width:0}
  .lnat-tp__titulo{color:var(--lnat-tinta)}
  .lnat-tp__img{display:none}
  .lnat-tp__txt{font-size:15px;line-height:23px}
  .lnat-tp__link{display:inline-flex;align-items:center;gap:6px;min-height:44px;font-size:14px;font-weight:600}
  button.lnat-tp__link{-webkit-appearance:none;appearance:none;background:none;border:0;border-radius:0;padding:0;margin:0;font-family:inherit;line-height:1.3;cursor:pointer;text-align:left}
  .lnat-tp__vazio{margin-top:24px;text-align:center}

  .lnat-tp__dlg{width:min(560px,calc(100vw - 32px));max-width:none;max-height:min(86vh,760px);margin:auto;padding:24px 24px 22px;border:1px solid var(--lnat-linha);border-radius:0;background:var(--lnat-papel);color:var(--lnat-texto);box-shadow:0 24px 64px rgba(11,11,9,.28);overflow:auto;overscroll-behavior:contain}
  .lnat-tp__dlg::backdrop{background:rgba(11,11,9,.62)}
  .lnat-tp__dlg-topo{display:flex;align-items:center;gap:12px;margin:0 0 8px}
  .lnat-tp__dlg-ico{color:var(--lnat-ouro-velho);line-height:0}
  .lnat-tp__dlg-h{flex:1 1 auto;color:var(--lnat-tinta)}
  .lnat-tp__dlg-form{margin:0}
  .lnat-tp__fechar{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;margin:-6px -10px 0 0;padding:0;border:0;background:none;color:var(--lnat-tinta);cursor:pointer}
  .lnat-tp__fechar:hover{color:var(--lnat-ouro-velho)}
  .lnat-tp__opcoes{list-style:none;margin:0;padding:0}
  .lnat-tp__opcao{display:grid;grid-template-columns:64px minmax(0,1fr) auto;align-items:center;gap:14px;margin:0;padding:14px 0;border-bottom:1px solid var(--lnat-linha)}
  .lnat-tp__opcao-img{display:flex;align-items:center;justify-content:center;width:64px;height:64px;background:var(--lnat-linho);color:var(--lnat-ouro-velho);overflow:hidden}
  .lnat-tp__opcao-img img{width:100%;height:100%;object-fit:cover;display:block}
  .lnat-tp__opcao-txt{display:flex;flex-direction:column;gap:2px;min-width:0}
  .lnat-tp__opcao-nome{font-size:15px;line-height:21px;font-weight:600;color:var(--lnat-tinta)}
  .lnat-tp__opcao-desc{font-size:13px;line-height:19px;color:var(--lnat-cinza)}
  .lnat-tp__opcao-preco{display:flex;flex-direction:column;align-items:flex-end;gap:2px;font-weight:600;font-size:15px;font-variant-numeric:tabular-nums;white-space:nowrap;color:var(--lnat-tinta)}
  .lnat-tp__opcao-esg{font-size:12px;font-weight:500;color:var(--lnat-cinza)}
  .lnat-tp__nota{margin:18px 0 0;padding:14px 16px;background:var(--lnat-linho);border-left:2px solid var(--lnat-ouro);font-size:14px;line-height:21px}
  html:has(.lnat-tp__dlg[open]){overflow:hidden}

  @media screen and (max-width:749px){
    .lnat-tp--sem-tel{display:none}
    .lnat-tp__dlg{width:100%;max-width:100%;max-height:88vh;margin:auto 0 0;padding:20px 16px 24px;border-width:1px 0 0}
  }
  @media screen and (min-width:990px){
    .lnat-tp__lead{font-size:26px;line-height:32px}
    .lnat-tp__lista{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:56px}
    .lnat-tp__item{display:flex;flex-direction:column;gap:14px;padding:0 32px;border-bottom:0}
    .lnat-tp__item:first-child{padding-left:0}
    .lnat-tp__item:last-child{padding-right:0}
    .lnat-tp__item + .lnat-tp__item{border-left:1px solid var(--lnat-ouro)}
    .lnat-tp__ico svg{width:48px;height:48px}
    .lnat-tp__corpo{flex:1 1 auto;gap:14px}
    .lnat-tp__img{display:block;width:100%;aspect-ratio:4/5;overflow:hidden;background:#ece2cf}
    .lnat-tp__img img{display:block;width:100%;height:100%;object-fit:cover}
    .lnat-tp__txt{font-size:16px;line-height:26px}
    .lnat-tp__link{margin-top:auto}
  }
</style>

<script>
(function(){
  var doc = document.documentElement;
  // Fases em que a secção aparece, por versão da campanha (contrato i18n, secção 5); no Internacional não aparece
  var ATIVAS = { pt: ['ouro', 'incenso', 'ultima', 'consoada', 'mirra'], es: ['navidad', 'reyes', 'reyes_ultima', 'noche_reyes'] };
  function ini(sec){
    if (sec.getAttribute('data-lnat-pronto')) return;
    sec.setAttribute('data-lnat-pronto', '1');
    var N = window.LOD_NATAL;
    if (N && !sec.classList.contains('lnat-tp--editor')) {
      var v = N.versao || 'pt';
      var f = N.fase(v);
      if (!ATIVAS[v] || ATIVAS[v].indexOf(f) < 0) sec.hidden = true;
    }
  }
  function todos(){
    var l = document.querySelectorAll('.lnat-tp');
    for (var i = 0; i < l.length; i++) ini(l[i]);
  }
  todos();
  if (doc.hasAttribute('data-lnat-tp')) return;
  doc.setAttribute('data-lnat-tp', '');
  document.addEventListener('shopify:section:load', todos);
  document.addEventListener('click', function(e){
    var t = e.target;
    if (!t || !t.closest) return;
    var b = t.closest('[data-lnat-tp-abrir]');
    if (b) {
      var d = document.getElementById(b.getAttribute('data-lnat-tp-abrir'));
      if (!d) return;
      e.preventDefault();
      if (typeof d.showModal === 'function') { if (!d.open) d.showModal(); }
      else d.setAttribute('open', '');
      return;
    }
    // Clique no fundo escurecido fecha a janela.
    if (t.classList && t.classList.contains('lnat-tp__dlg') && t.open && typeof t.close === 'function') {
      var r = t.getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) t.close();
    }
  });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Natal · Três presentes",
  "tag": "section",
  "class": "lnat-secao lnat-secao--tres-presentes",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Ouro, incenso e mirra" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Três presentes. Um Natal inteiro." },
    { "type": "textarea", "id": "lead", "label": "Texto de abertura (letra Cormorant)", "default": "Conta o Evangelho de São Mateus que os Magos ofereceram ouro, incenso e mirra. Nós cuidamos do Natal da mesma maneira." },
    { "type": "checkbox", "id": "azulejo", "label": "Padrão de azulejo no fundo", "default": true },
    { "type": "header", "content": "Janela de embrulho" },
    { "type": "paragraph", "content": "Abre-se no bloco que tem ligada a opção O link abre as opções de embrulho. Preço e disponibilidade vêm dos produtos escolhidos." },
    { "type": "text", "id": "embrulho_titulo", "label": "Título da janela", "default": "Embrulho e mensagem" },
    { "type": "product", "id": "embrulho_1", "label": "Opção 1" },
    { "type": "text", "id": "embrulho_1_texto", "label": "Descrição da opção 1", "info": "Vazio: usa a descrição do produto." },
    { "type": "product", "id": "embrulho_2", "label": "Opção 2" },
    { "type": "text", "id": "embrulho_2_texto", "label": "Descrição da opção 2", "info": "Vazio: usa a descrição do produto." },
    { "type": "product", "id": "embrulho_3", "label": "Opção 3" },
    { "type": "text", "id": "embrulho_3_texto", "label": "Descrição da opção 3", "info": "Vazio: usa a descrição do produto." },
    { "type": "textarea", "id": "embrulho_nota", "label": "Nota", "default": "Escolha no carrinho, antes de finalizar a encomenda. Também podemos enviar diretamente para quem recebe: indique essa morada no checkout." },
    { "type": "header", "content": "Tradução — Inglês (EN)", "info": "Deixe vazio para usar o português." },
    { "type": "text", "id": "eyebrow_en", "label": "Sobretítulo (EN)" },
    { "type": "text", "id": "titulo_en", "label": "Título (EN)" },
    { "type": "textarea", "id": "lead_en", "label": "Texto de abertura (EN)" },
    { "type": "text", "id": "embrulho_titulo_en", "label": "Título da janela (EN)" },
    { "type": "text", "id": "embrulho_1_texto_en", "label": "Descrição da opção 1 (EN)" },
    { "type": "text", "id": "embrulho_2_texto_en", "label": "Descrição da opção 2 (EN)" },
    { "type": "text", "id": "embrulho_3_texto_en", "label": "Descrição da opção 3 (EN)" },
    { "type": "textarea", "id": "embrulho_nota_en", "label": "Nota (EN)" },
