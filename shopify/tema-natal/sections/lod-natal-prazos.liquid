{%- comment -%}
  Natal 2026 · Ouro de Reis — «Prazos, lojas e vales» (id="prazos"), por mercado e na língua da página.
  Contrato de línguas, mercados e fases: scratchpad/natal/i18n-contrato.md.

  A versão vem do mercado (lod-natal-fase, mercado: 'auto'); a língua decide os textos (lod-natal-t, os campos
  _en/_es das definições e o dicionário local prz_ deste ficheiro).
    Portugal (pt), fases ouro → mirra: três colunas sobre verde com azulejo.
      1. Quando encomendar: Açores, Madeira, peças gravadas, continente, levantar na loja e Dia de Reis.
      2. Levantar na loja: lojas por distrito (páginas /pages/loja-do-ouro-…), WhatsApp, horários de 24 e 31 dez.
         (só com o campo preenchido) e, na mirra, as Janeiras (só com «Janeiras confirmadas» ligado).
      3. Vales-prenda: físicos, seguem por correio. Na última hora (e depois do prazo dos Reis) avisa que já não
         chegam a tempo (não aparece com natal_vale_digital).
    Espanha (es), fases navidad, reyes e reyes_ultima (na noche_reyes, 5 e 6 de janeiro, não aparece: é um momento
    calmo e sem prazos): prazos de Espanha para a Navidad e para o Dia de Reis (natal_es_limite_*), avisos de
    «já não chega para a Navidad / para o Dia de Reis» e, de 24 dez., 13h, a 25 dez., «as encomendas de hoje seguem
    a partir de 28 dez.». Vales-prenda com os avisos de correio de Espanha. Sem a coluna das lojas.
    Internacional (int), fase navidad (até natal_int_limite): só o prazo internacional. Sem lojas; os vales só com
    «Mostrar vales-prenda» ligado (a instância internacional vem com ele desligado: moedas locais).
  Em Espanha e no Internacional as datas mostram só o dia, nunca a hora (23:59 em Lisboa = 00:59 em Madrid).
  Linhas cujo prazo já passou ficam a meia opacidade com «Terminado». A nota por baixo da lista nunca fica vazia.
  Botão «Adicionar ao calendário»: .ics do primeiro prazo que ainda não passou (continente / Navidad, depois Reyes /
  internacional), gerado no navegador.
  Entre 750 e 1199 px: duas colunas, com os vales por baixo (três colunas só em Portugal). Sem lojas: duas colunas
  (prazos e vales); só prazos: uma coluna. No telemóvel vira acordeão (com um só painel, não há acordeão).
  Fases off/antes/fim: não mostra nada (em «antes» o HTML sai escondido para o navegador o abrir à meia-noite
  de 1 de dezembro se a página vier da cache). No editor mostra sempre, com uma nota.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  capture lnz_lg
    render 'lod-natal-t', k: '_lingua'
  endcapture
  assign lnz_lg = lnz_lg | strip
  capture lnz_versao
    render 'lod-natal-fase', mercado: 'auto', devolve: 'versao'
  endcapture
  assign lnz_versao = lnz_versao | strip
  capture lnz_fase
    render 'lod-natal-fase', mercado: 'auto'
  endcapture
  assign lnz_fase = lnz_fase | strip

  # Fases em que a secção aparece, por versão
  case lnz_versao
    when 'pt'
      assign lnz_ativas = 'ouro incenso ultima consoada mirra'
    when 'es'
      assign lnz_ativas = 'navidad reyes reyes_ultima'
    else
      assign lnz_versao = 'int'
      assign lnz_ativas = 'navidad'
  endcase
  assign lnz_ativas_l = lnz_ativas | split: ' '
  assign lnz_ativa = false
  if lnz_ativas_l contains lnz_fase
    assign lnz_ativa = true
  endif
  # Fase usada no HTML do servidor (no editor, fora das datas: a primeira da versão)
  assign lnz_ff = lnz_fase
  unless lnz_ativa
    assign lnz_ff = lnz_ativas_l.first
  endunless

  assign lnz_render = lnz_ativa
  assign lnz_esconder = false
  assign lnz_nota = false
  if lnz_fase == 'antes'
    assign lnz_render = true
    assign lnz_esconder = true
  endif
  if request.design_mode and lnz_ativa == false
    assign lnz_render = true
    assign lnz_esconder = false
    assign lnz_nota = true
  endif
-%}

{%- if lnz_render -%}
{%- comment -%} Frases novas (dicionário local; a equipa BASE junta-as a lod-natal-t no fim). {%- endcomment -%}
{%- capture lnat_tl_pt -%}
~~prz_ics_titulo_reyes=Último dia para encomendar as prendas do Dia de Reis ({marca})
~~prz_ics_es_navidad=Encomende até {1}, para receber antes do Natal em Espanha peninsular (prazo indicativo).
~~prz_ics_es_reyes=Encomende até {1}, para receber antes do Dia de Reis em Espanha peninsular (prazo indicativo).
~~prz_ics_int=Encomende até {1}, para receber antes do Natal (envios internacionais, prazo indicativo).
{%- endcapture -%}
{%- capture lnat_tl_en -%}
~~prz_ics_titulo_reyes=Last day to order Three Kings’ Day gifts ({marca})
~~prz_ics_es_navidad=Order by {1} to receive your gifts before Christmas in mainland Spain (indicative deadline).
~~prz_ics_es_reyes=Order by {1} to receive your gifts before Three Kings’ Day in mainland Spain (indicative deadline).
~~prz_ics_int=Order by {1} to receive your gifts before Christmas (international delivery, indicative deadline).
{%- endcapture -%}
{%- capture lnat_tl_es -%}
~~prz_ics_titulo_reyes=Último día para pedir los regalos de Reyes ({marca})
~~prz_ics_es_navidad=Haga su pedido hasta el {1}, para recibirlo antes de Navidad en la España peninsular (plazo orientativo).
~~prz_ics_es_reyes=Haga su pedido hasta el {1}, para recibirlo antes del Día de Reyes en la España peninsular (plazo orientativo).
~~prz_ics_int=Haga su pedido hasta el {1}, para recibirlo antes de Navidad (envíos internacionales, plazo orientativo).
{%- endcapture -%}
{%- liquid
  case lnz_lg
    when 'pt'
      assign lnat_tl = lnat_tl_pt
    when 'es'
      assign lnat_tl = lnat_tl_es
    else
      assign lnat_tl = lnat_tl_en
  endcase
  capture lnz_marca
    render 'lod-natal-t', k: 'marca'
  endcapture
  assign tx_ics_titulo_reyes = ''
  assign tx_ics_es_navidad = ''
  assign tx_ics_es_reyes = ''
  assign tx_ics_int = ''
  assign lnz_tl_e = lnat_tl | split: '~~'
  for lnz_e in lnz_tl_e
    assign lnz_ek = lnz_e | split: '=' | first | strip
    assign lnz_ev = lnz_e | remove_first: lnz_ek | remove_first: '=' | strip | replace: '{marca}', lnz_marca
    case lnz_ek
      when 'prz_ics_titulo_reyes'
        assign tx_ics_titulo_reyes = lnz_ev
      when 'prz_ics_es_navidad'
        assign tx_ics_es_navidad = lnz_ev
      when 'prz_ics_es_reyes'
        assign tx_ics_es_reyes = lnz_ev
      when 'prz_ics_int'
        assign tx_ics_int = lnz_ev
    endcase
  endfor

  assign lnz_agora_txt = 'now'
  if settings.natal_data_simulada != blank and theme.role != 'main'
    assign lnz_agora_txt = settings.natal_data_simulada | strip
    if lnz_agora_txt.size == 10
      assign lnz_agora_txt = lnz_agora_txt | append: ' 10:00'
    endif
  endif
  assign lnz_agora = lnz_agora_txt | date: '%Y%m%d%H%M' | plus: 0

  assign lnz_inicio = settings.natal_inicio | default: '2026-12-01 00:00' | strip
  assign lnz_fim = settings.natal_fim | default: '2027-01-06 23:59' | strip
  assign lnz_acores = settings.natal_limite_acores | default: '2026-12-14 23:59' | strip
  assign lnz_madeira = settings.natal_limite_madeira | default: '2026-12-14 23:59' | strip
  assign lnz_gravacao = settings.natal_limite_gravacao | default: '2026-12-16 23:59' | strip
  assign lnz_continente = settings.natal_limite_continente | default: '2026-12-20 23:59' | strip
  assign lnz_loja = settings.natal_limite_loja | default: '2026-12-24 13:00' | strip
  assign lnz_festas = settings.natal_boas_festas_fim | default: '2026-12-25 23:59' | strip
  assign lnz_retoma = settings.natal_retoma_envios | default: '2026-12-28' | strip
  assign lnz_reis = settings.natal_limite_reis | default: '2026-12-30 23:59' | strip
  assign lnz_es_navidad = settings.natal_es_limite_navidad | default: '2026-12-20 23:59' | strip
  assign lnz_es_reyes = settings.natal_es_limite_reyes | default: '2026-12-29 23:59' | strip
  assign lnz_int = settings.natal_int_limite | default: '2026-12-10 23:59' | strip

  assign lnz_raiz = routes.root_url
  if lnz_raiz == '/'
    assign lnz_raiz = ''
  endif
  assign lnz_ancora = s.ancora | default: 'prazos' | handleize
  assign lnz_def_lojas = lnz_raiz | append: '/pages/agencias'
  assign lnz_def_vales = lnz_raiz | append: '/collections/voucher-prenda'
  assign lnz_lojas_url = s.lojas_url | default: lnz_def_lojas
  assign lnz_vales_url = s.vales_url | default: lnz_def_vales

  # Colunas: lojas só em Portugal; vales com «Mostrar vales-prenda»
  assign lnz_lojas_on = false
  if lnz_versao == 'pt'
    assign lnz_lojas_on = true
  endif
  assign lnz_vales_on = true
  if s.mostrar_vales == false
    assign lnz_vales_on = false
  endif
  assign lnz_paineis = 1
  assign lnz_ultimo = 1
  if lnz_lojas_on
    assign lnz_paineis = lnz_paineis | plus: 1
    assign lnz_ultimo = 2
  endif
  if lnz_vales_on
    assign lnz_paineis = lnz_paineis | plus: 1
    assign lnz_ultimo = 3
  endif
  assign lnz_acc = false
  if lnz_paineis > 1
    assign lnz_acc = true
  endif
  assign lnz_mod = ''
  unless lnz_lojas_on
    assign lnz_mod = lnz_mod | append: ' lnat-prazos--sem-lojas'
  endunless
  unless lnz_vales_on
    assign lnz_mod = lnz_mod | append: ' lnat-prazos--sem-vales'
  endunless
  unless lnz_acc
    assign lnz_mod = lnz_mod | append: ' lnat-prazos--uma'
  endunless

  # Campos por língua: campo base (pt) e _en / _es; vazio → campo base → texto do dicionário
  assign lnz_suf = ''
  if lnz_lg != 'pt'
    assign lnz_suf = '_' | append: lnz_lg
  endif
  capture t_def
    render 'lod-natal-t', k: 'prazos_titulo'
  endcapture
  assign lnz_k = 'titulo' | append: lnz_suf
  assign lnz_titulo = section.settings[lnz_k] | default: s.titulo | default: t_def
  case lnz_versao
    when 'pt'
      capture t_def
        render 'lod-natal-t', k: 'prazos_indicativos'
      endcapture
    when 'es'
      capture t_def
        render 'lod-natal-t', k: 'esp_nota'
      endcapture
    else
      capture t_def
        render 'lod-natal-t', k: 'int_nota'
      endcapture
  endcase
  # a nota dos prazos nunca fica vazia: os prazos são sempre indicativos
  assign lnz_k = 'nota' | append: lnz_suf
  assign lnz_nota_txt = section.settings[lnz_k] | default: s.nota | strip | default: t_def

  # Textos fixos
  capture t_prazos_entrega
    render 'lod-natal-t', k: 'prazos_entrega'
  endcapture
  capture t_terminado
    render 'lod-natal-t', k: 'terminado'
  endcapture
  capture t_adicionar_cal
    render 'lod-natal-t', k: 'adicionar_calendario'
  endcapture
  capture t_ics_ok
    render 'lod-natal-t', k: 'ics_ok'
  endcapture
  capture t_ics_titulo
    render 'lod-natal-t', k: 'ics_titulo'
  endcapture

  # Linhas e lembretes (.ics) de cada versão
  assign lnz_festas_n = lnz_festas | date: '%Y%m%d%H%M' | plus: 0
  assign lnz_loja_n = lnz_loja | date: '%Y%m%d%H%M' | plus: 0
  assign lnz_reis_n = lnz_reis | date: '%Y%m%d%H%M' | plus: 0
  case lnz_versao
    when 'pt'
      assign lnz_codigos = 'acores,madeira,gravacao,continente,loja,reis' | split: ','
      assign lnz_ics = 'continente' | split: ','
      capture t_l_acores
        render 'lod-natal-t', k: 'linha_acores'
      endcapture
      capture t_l_madeira
        render 'lod-natal-t', k: 'linha_madeira'
      endcapture
      capture t_l_gravacao
        render 'lod-natal-t', k: 'linha_gravacao'
      endcapture
      capture t_l_continente
        render 'lod-natal-t', k: 'linha_continente'
      endcapture
      capture t_l_loja
        render 'lod-natal-t', k: 'linha_loja'
      endcapture
      capture t_l_loja_c
        render 'lod-natal-t', k: 'linha_loja_curto'
      endcapture
      capture t_l_reis
        render 'lod-natal-t', k: 'linha_reis'
      endcapture
      capture t_l_reis_c
        render 'lod-natal-t', k: 'linha_reis_curto'
      endcapture
      capture lnz_d
        render 'lod-natal-data', valor: lnz_continente, formato: 'hora'
      endcapture
      capture t_ics_continente
        render 'lod-natal-t', k: 'ics_texto', v1: lnz_d
      endcapture
    when 'es'
      assign lnz_codigos = 'es_navidad,es_reyes' | split: ','
      assign lnz_ics = 'es_navidad,es_reyes' | split: ','
      capture t_l_es_navidad
        render 'lod-natal-t', k: 'esp_prazo_navidad'
      endcapture
      capture t_l_es_navidad_c
        render 'lod-natal-t', k: 'natal'
      endcapture
      capture t_l_es_reyes
        render 'lod-natal-t', k: 'esp_prazo_reyes'
      endcapture
      capture t_l_es_reyes_c
        render 'lod-natal-t', k: 'dia_de_reis'
      endcapture
      capture lnz_d
        render 'lod-natal-data', valor: lnz_es_navidad, formato: 'longo'
      endcapture
      assign tx_ics_es_navidad = tx_ics_es_navidad | replace: '{1}', lnz_d
      capture lnz_d
        render 'lod-natal-data', valor: lnz_es_reyes, formato: 'longo'
      endcapture
      assign tx_ics_es_reyes = tx_ics_es_reyes | replace: '{1}', lnz_d
      capture t_esp_navidad_ko
        render 'lod-natal-t', k: 'esp_navidad_ko'
      endcapture
      capture t_esp_reyes_ko
        render 'lod-natal-t', k: 'esp_reyes_ko'
      endcapture
      capture lnz_d
        render 'lod-natal-data', valor: lnz_retoma, formato: 'longo'
      endcapture
      capture t_pausa
        render 'lod-natal-t', k: 'pdp_consoada_html', v1: lnz_d
      endcapture
    else
      assign lnz_codigos = 'int' | split: ','
      assign lnz_ics = 'int' | split: ','
      capture t_l_int
        render 'lod-natal-t', k: 'int_prazo'
      endcapture
      capture lnz_d
        render 'lod-natal-data', valor: lnz_int, formato: 'longo'
      endcapture
      assign tx_ics_int = tx_ics_int | replace: '{1}', lnz_d
  endcase

  # Espanha, fase reyes: «já não chega para a Navidad» até 25 dez.; «as encomendas de hoje seguem a partir de…» de 24 dez., 13h, a 25 dez.
  assign lnz_es_navko = false
  assign lnz_es_pausa = false
  if lnz_ff == 'reyes' and lnz_agora <= lnz_festas_n
    assign lnz_es_navko = true
    if lnz_agora > lnz_loja_n
      assign lnz_es_pausa = true
    endif
  endif

  # Vales-prenda físicos (seguem por correio): avisa quando já não chegam a tempo, como o guia «Siga a estrela»
  assign lnz_vale_natal = false
  assign lnz_vale_reis = false
  unless settings.natal_vale_digital
    case lnz_versao
      when 'pt'
        if lnz_ff == 'ultima'
          assign lnz_vale_natal = true
        endif
        if lnz_ff == 'mirra' and lnz_agora > lnz_reis_n
          assign lnz_vale_reis = true
        endif
      when 'es'
        assign lnz_vale_natal = lnz_es_navko
        if lnz_ff == 'reyes_ultima'
          assign lnz_vale_reis = true
        endif
    endcase
  endunless

  # Coluna das lojas (só Portugal)
  if lnz_lojas_on
    capture t_levantar_loja
      render 'lod-natal-t', k: 'levantar_loja'
    endcapture
    capture t_def
      render 'lod-natal-t', k: 'lojas_titulo'
    endcapture
    assign lnz_k = 'lojas_titulo' | append: lnz_suf
    assign lnz_lojas_titulo = section.settings[lnz_k] | default: s.lojas_titulo | default: t_def
    assign lnz_k = 'lojas_texto' | append: lnz_suf
    assign lnz_lojas_texto = section.settings[lnz_k] | default: s.lojas_texto
    capture t_def
      render 'lod-natal-t', k: 'wa_loja'
    endcapture
    assign lnz_k = 'wa_texto' | append: lnz_suf
    assign lnz_wa_txt = section.settings[lnz_k] | default: s.wa_texto | default: t_def
    # depois do Natal (mirra) a mensagem deixa de falar em «prenda de Natal»
    if lnz_ff == 'mirra'
      capture lnz_wa_txt
        render 'lod-natal-t', k: 'wa_loja_reis'
      endcapture
    endif
    assign lnz_k = 'horarios' | append: lnz_suf
    assign lnz_horarios = section.settings[lnz_k] | default: s.horarios
    assign lnz_k = 'janeiras' | append: lnz_suf
    assign lnz_janeiras = section.settings[lnz_k] | default: s.janeiras
    capture t_lojas_distrito
      render 'lod-natal-t', k: 'lojas_distrito'
    endcapture
    capture t_marcar_wa
      render 'lod-natal-t', k: 'marcar_whatsapp'
    endcapture
    capture t_abre_janela
      render 'lod-natal-t', k: 'abre_janela'
    endcapture
    capture t_ver_lojas
      render 'lod-natal-t', k: 'ver_lojas'
    endcapture
    assign lnz_wa = settings.natal_whatsapp | default: '351910067687' | remove: ' ' | remove: '+' | remove: '-'
    assign lnz_wa_q = lnz_wa_txt | url_encode | replace: '+', '%20'
    # distrito | loja:página, …
    assign lnz_lojas = 'Lisboa|Benfica:loja-do-ouro-benfica,Loures:loja-do-ouro-loures-infantado;Santarém|Santarém:loja-do-ouro-santarem,Abrantes:loja-do-ouro-abrantes,Torres Novas:loja-do-ouro-torres-novas,Cartaxo:loja-do-ouro-cartaxo,Entroncamento:loja-do-ouro-entroncamento,Tomar:loja-do-ouro-tomar,Fátima:loja-do-ouro-fatima;Coimbra|Coimbra:loja-do-ouro-coimbra,Figueira da Foz:loja-do-ouro-figueira-da-foz;Leiria|Arcadas:loja-do-ouro-leiria-arcadas,Bairro de Jericó:loja-do-ouro-leiria-bairro-de-jerico' | split: ';'
  endif

  # Coluna dos vales
  if lnz_vales_on
    capture t_vales_prenda
      render 'lod-natal-t', k: 'vales_prenda'
    endcapture
    capture t_def
      render 'lod-natal-t', k: 'vales_titulo'
    endcapture
    assign lnz_k = 'vales_titulo' | append: lnz_suf
    assign lnz_vales_titulo = section.settings[lnz_k] | default: s.vales_titulo | default: t_def
    assign lnz_k = 'vales_texto' | append: lnz_suf
    assign lnz_vales_texto = section.settings[lnz_k] | default: s.vales_texto
    capture t_def
      render 'lod-natal-t', k: 'escolher_vale'
    endcapture
    assign lnz_k = 'vales_botao' | append: lnz_suf
    assign lnz_vales_botao = section.settings[lnz_k] | default: s.vales_botao | default: t_def
    capture t_vale_natal
      render 'lod-natal-t', k: 'vale_correio_natal'
    endcapture
    capture t_vale_reis
      render 'lod-natal-t', k: 'vale_correio_reis'
    endcapture
  endif

  # Nota do editor: até quando aparece em cada versão
  case lnz_versao
    when 'pt'
      assign lnz_ed_ate = lnz_fim
    when 'es'
      assign lnz_ed_ate = lnz_fim | date: '%Y' | append: '-01-04'
    else
      assign lnz_ed_ate = lnz_int
  endcase
-%}

<style>
  .lnat-prazos{scroll-margin-top:96px}
  .lnat-prazos__nota-editor{display:inline-block;margin:0 0 24px;padding:6px 10px;background:var(--lnat-tinta);color:var(--lnat-ouro-claro);font-size:13px;line-height:18px}
  .lnat-prazos__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:56px;row-gap:20px;align-items:start}
  .lnat-prazos__h2{grid-column:1;grid-row:1;font-size:clamp(26px,2.3vw,32px);line-height:1.18;color:var(--lnat-papel)}
  .lnat-prazos__p1{grid-column:1;grid-row:2}
  .lnat-prazos__p2{grid-column:2;grid-row:1/span 2}
  .lnat-prazos__p3{grid-column:3;grid-row:1/span 2}
  .lnat-prazos__acc{display:none}
  .lnat-prazos__painel{display:flex;flex-direction:column;gap:14px;min-width:0}
  .lnat-prazos__ico{color:var(--lnat-ouro)}
  .lnat-prazos .lnat-h3{color:var(--lnat-papel)}
  .lnat-prazos__txt{margin:0;font-size:15px;line-height:24px;color:#e1dacb}
  .lnat-prazos__lista{margin:0;padding:0}
  .lnat-prazos__linha{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:12px 0;border-bottom:1px solid #2c4c40;font-size:15px;line-height:21px;transition:opacity .3s}
  .lnat-prazos__linha:first-child{border-top:1px solid #2c4c40}
  .lnat-prazos__linha dt{margin:0;color:var(--lnat-papel)}
  .lnat-prazos__linha dd{margin:0;flex:0 0 auto;text-align:right;font-family:var(--lnat-cond);font-weight:400;font-size:16px;letter-spacing:.02em;font-variant-numeric:tabular-nums;color:var(--lnat-ouro-claro)}
  .lnat-prazos__linha.is-fim{opacity:.5}
  .lnat-prazos__linha.is-fim dd{color:var(--lnat-papel)}
  .lnat-prazos__dc,.lnat-prazos__lc{display:none}
  .lnat-prazos__aviso{margin:0;font-size:15px;line-height:23px;color:var(--lnat-papel)}
  .lnat-prazos__aviso strong{font-weight:600;color:var(--lnat-ouro-claro)}
  .lnat-prazos__nota{margin:2px 0 0;font-size:13px;line-height:20px;color:var(--lnat-cinza-noite)}
  .lnat-prazos__ics{align-self:flex-start;gap:10px}
  .lnat-prazos__lojas{margin:0;padding:0;list-style:none;font-size:14px;line-height:22px;color:#e1dacb}
  .lnat-prazos__lojas li{margin:0 0 6px;padding:0}
  .lnat-prazos__distrito{display:inline-block;margin-right:2px;font-weight:600;color:var(--lnat-ouro-claro)}
  .lnat-prazos__lojas a{color:#e1dacb!important;text-decoration:underline;text-decoration-color:rgba(229,201,142,.45);text-underline-offset:3px}
  .lnat-prazos__lojas a:hover{color:var(--lnat-papel)!important;text-decoration-color:var(--lnat-ouro-claro)}
  .lnat-prazos__peq{margin:0;font-size:13px;line-height:20px;color:var(--lnat-cinza-noite)}
  .lnat-prazos__janeiras{display:flex;gap:12px;align-items:flex-start;margin:4px 0 0;padding-top:14px;border-top:1px solid #2c4c40;font-size:14px;line-height:22px;color:#e1dacb}
  .lnat-prazos__janeiras svg{color:var(--lnat-ouro);margin-top:-2px}
  @media (min-width:750px) and (max-width:1199px){
    .lnat-prazos__grid{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:40px;row-gap:24px}
    .lnat-prazos__p2{grid-column:2;grid-row:1/span 2}
    .lnat-prazos__p3{grid-column:1/span 2;grid-row:3;padding-top:24px;border-top:1px solid #2c4c40}
  }
  /* Espanha e Internacional (sem lojas) ou sem vales: duas colunas; só os prazos: uma coluna */
  @media (min-width:750px){
    .lnat-prazos--sem-lojas .lnat-prazos__grid,.lnat-prazos--sem-vales .lnat-prazos__grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .lnat-prazos--sem-lojas .lnat-prazos__p3{grid-column:2;grid-row:1/span 2;padding-top:0;border-top:0}
    .lnat-prazos--uma .lnat-prazos__grid{grid-template-columns:minmax(0,1fr);max-width:720px}
  }
  @media (max-width:749px){
    .lnat-prazos__grid{display:block}
    .lnat-prazos__h2{margin-bottom:12px}
    .lnat-prazos__acc{display:flex;justify-content:space-between;align-items:center;width:100%;min-height:56px;margin:0;padding:0;background:transparent;border:0;border-top:1px solid #2c4c40;border-radius:0;color:var(--lnat-papel);font:500 15px/1.3 var(--lnat-sans);text-align:left;cursor:pointer}
    .lnat-prazos__acc-ico{position:relative;width:14px;height:14px;flex:0 0 14px;color:var(--lnat-ouro-claro)}
    .lnat-prazos__acc-ico::before,.lnat-prazos__acc-ico::after{content:"";position:absolute;left:0;top:6px;width:14px;height:1.5px;background:currentColor;transition:transform .25s}
    .lnat-prazos__acc-ico::after{transform:rotate(90deg)}
    .lnat-prazos__acc[aria-expanded="true"] .lnat-prazos__acc-ico::after{transform:rotate(0)}
    .lnat-prazos__acc[aria-expanded="false"]+.lnat-prazos__painel{display:none}
    .lnat-prazos__painel{padding:4px 0 24px}
    .lnat-prazos__painel--ultimo{border-bottom:1px solid #2c4c40}
    .lnat-prazos__acc--ultimo[aria-expanded="false"]{border-bottom:1px solid #2c4c40}
    .lnat-prazos__painel>.lnat-prazos__ico{display:none}
    .lnat-prazos__linha{font-size:14px;line-height:20px;padding:11px 0}
    .lnat-prazos__linha dd{font-size:15px}
    .lnat-prazos__linha:first-child{border-top:0}
    .lnat-prazos--uma .lnat-prazos__linha:first-child{border-top:1px solid #2c4c40}
    .lnat-prazos--uma .lnat-prazos__painel{padding-bottom:0}
    .lnat-prazos__dl,.lnat-prazos__ll{display:none}
    .lnat-prazos__dc,.lnat-prazos__lc{display:inline}
    .lnat-prazos .lnat-btns{flex-direction:column;align-items:stretch}
    .lnat-prazos__ics{align-self:stretch}
    {%- unless s.mostrar_no_telemovel %}
    #shopify-section-{{ section.id }}{display:none!important}
    {%- endunless %}
  }
</style>

<section class="lnat lnat-prazos lnat-sec lnat-bg-verde lnat-azulejo-escuro{{ lnz_mod }}" id="{{ lnz_ancora }}" aria-labelledby="lnz-h-{{ section.id }}" data-lnat-prazos data-lnz-versao="{{ lnz_versao }}"{% if lnz_esconder %} hidden{% endif %}>
  <div class="lnat-wrap">
    {%- if lnz_nota -%}
      <p class="lnat-prazos__nota-editor">Pré-visualização no editor ({{ lnz_versao }}) · visível de {% render 'lod-natal-data', valor: lnz_inicio, formato: 'curto', lingua: 'pt' %} a {% render 'lod-natal-data', valor: lnz_ed_ate, formato: 'curto', lingua: 'pt' %}</p>
    {%- endif -%}

    <div class="lnat-prazos__grid">
      <h2 class="lnat-h2 lnat-prazos__h2" id="lnz-h-{{ section.id }}">{{ lnz_titulo | escape }}</h2>

      {%- comment -%} 1 · Prazos {%- endcomment -%}
      {%- if lnz_acc -%}
        <button type="button" class="lnat-prazos__acc" data-lnz-acc aria-expanded="true" aria-controls="lnz-p1-{{ section.id }}">
          <span>{{ t_prazos_entrega }}</span><span class="lnat-prazos__acc-ico" aria-hidden="true"></span>
        </button>
      {%- endif -%}
      <div class="lnat-prazos__painel lnat-prazos__p1" id="lnz-p1-{{ section.id }}">
        <dl class="lnat-prazos__lista">
          {%- for lnz_c in lnz_codigos -%}
            {%- liquid
              case lnz_c
                when 'acores'
                  assign lnz_val = lnz_acores
                  assign lnz_rl = t_l_acores
                  assign lnz_rc = t_l_acores
                when 'madeira'
                  assign lnz_val = lnz_madeira
                  assign lnz_rl = t_l_madeira
                  assign lnz_rc = t_l_madeira
                when 'gravacao'
                  assign lnz_val = lnz_gravacao
                  assign lnz_rl = t_l_gravacao
                  assign lnz_rc = t_l_gravacao
                when 'continente'
                  assign lnz_val = lnz_continente
                  assign lnz_rl = t_l_continente
                  assign lnz_rc = t_l_continente
                when 'loja'
                  assign lnz_val = lnz_loja
                  assign lnz_rl = t_l_loja
                  assign lnz_rc = t_l_loja_c
                when 'reis'
                  assign lnz_val = lnz_reis
                  assign lnz_rl = t_l_reis
                  assign lnz_rc = t_l_reis_c
                when 'es_navidad'
                  assign lnz_val = lnz_es_navidad
                  assign lnz_rl = t_l_es_navidad
                  assign lnz_rc = t_l_es_navidad_c
                when 'es_reyes'
                  assign lnz_val = lnz_es_reyes
                  assign lnz_rl = t_l_es_reyes
                  assign lnz_rc = t_l_es_reyes_c
                else
                  assign lnz_val = lnz_int
                  assign lnz_rl = t_l_int
                  assign lnz_rc = t_l_int
              endcase
              assign lnz_n = lnz_val | date: '%Y%m%d%H%M' | plus: 0
              assign lnz_passou = false
              if lnz_c == 'loja'
                if lnz_agora >= lnz_n
                  assign lnz_passou = true
                endif
                # telemóvel: «24 dez., 13h» / «24 Dec, 1pm» / «24 dic., 13:00 h»
                assign lnz_fl = 'hora'
                assign lnz_fc = 'abrev-hora'
              else
                if lnz_agora > lnz_n
                  assign lnz_passou = true
                endif
                assign lnz_fl = 'longo'
                assign lnz_fc = 'abrev'
              endif
            -%}
            <div class="lnat-prazos__linha{% if lnz_passou %} is-fim{% endif %}" data-lnz-prazo="{{ lnz_c }}" data-valor="{{ lnz_val | escape }}"{% if lnz_c == 'loja' %} data-instante{% endif %}>
              <dt><span class="lnat-prazos__ll">{{ lnz_rl }}</span><span class="lnat-prazos__lc">{{ lnz_rc }}</span></dt>
              <dd>
                <span data-lnz-data{% if lnz_passou %} hidden{% endif %}><span class="lnat-prazos__dl">{%- render 'lod-natal-data', valor: lnz_val, formato: lnz_fl -%}</span><span class="lnat-prazos__dc">{%- render 'lod-natal-data', valor: lnz_val, formato: lnz_fc -%}</span></span>
                <span data-lnz-fim{% unless lnz_passou %} hidden{% endunless %}>{{ t_terminado }}</span>
              </dd>
            </div>
          {%- endfor -%}
        </dl>
        {%- if lnz_versao == 'es' -%}
          <p class="lnat-prazos__aviso" data-lnz-fases="reyes" data-lnz-ate="{{ lnz_festas | escape }}"{% unless lnz_es_navko %} hidden{% endunless %}>{{ t_esp_navidad_ko }}</p>
          <p class="lnat-prazos__aviso" data-lnz-fases="reyes" data-lnz-desde="{{ lnz_loja | escape }}" data-lnz-ate="{{ lnz_festas | escape }}"{% unless lnz_es_pausa %} hidden{% endunless %}>{{ t_pausa }}</p>
          <p class="lnat-prazos__aviso" data-lnz-fases="reyes_ultima"{% unless lnz_ff == 'reyes_ultima' %} hidden{% endunless %}>{{ t_esp_reyes_ko }}</p>
        {%- endif -%}
        <p class="lnat-prazos__nota">{{ lnz_nota_txt | escape | replace: ' €', '&nbsp;€' }}</p>
        {%- if s.mostrar_calendario -%}
          {%- assign lnz_ics_vis = false -%}
          {%- for lnz_c in lnz_ics -%}
            {%- liquid
              case lnz_c
                when 'continente'
                  assign lnz_val = lnz_continente
                  assign lnz_it = t_ics_titulo
                  assign lnz_ix = t_ics_continente
                when 'es_navidad'
                  assign lnz_val = lnz_es_navidad
                  assign lnz_it = t_ics_titulo
                  assign lnz_ix = tx_ics_es_navidad
                when 'es_reyes'
                  assign lnz_val = lnz_es_reyes
                  assign lnz_it = tx_ics_titulo_reyes
                  assign lnz_ix = tx_ics_es_reyes
                else
                  assign lnz_val = lnz_int
                  assign lnz_it = t_ics_titulo
                  assign lnz_ix = tx_ics_int
              endcase
              # só o primeiro lembrete cujo prazo ainda não passou
              assign lnz_n = lnz_val | date: '%Y%m%d%H%M' | plus: 0
              assign lnz_mostra = false
              if lnz_ics_vis == false and lnz_agora <= lnz_n
                assign lnz_mostra = true
                assign lnz_ics_vis = true
              endif
              assign lnz_uid = lnz_c | replace: '_', '-'
            -%}
            <button type="button" class="lnat-btn lnat-btn--claro lnat-prazos__ics" data-lnz-ics data-uid="{{ lnz_uid }}" data-valor="{{ lnz_val | escape }}" data-titulo="{{ lnz_it | escape }}" data-texto="{{ lnz_ix | strip | escape }}"{% unless lnz_mostra %} hidden{% endunless %}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="5" width="17" height="15.5" rx="1.5"/><path d="M3.5 10H20.5M8 3V7M16 3V7"/><path d="M12 13.2C12.3 14.4 12.8 14.9 14 15.2C12.8 15.5 12.3 16 12 17.2C11.7 16 11.2 15.5 10 15.2C11.2 14.9 11.7 14.4 12 13.2Z"/></svg>
              {{ t_adicionar_cal }}
            </button>
          {%- endfor -%}
          <p class="lnat-sr" role="status" data-lnz-estado data-ok="{{ t_ics_ok | escape }}"></p>
        {%- endif -%}
      </div>

      {%- comment -%} 2 · Levantar na loja (só Portugal) {%- endcomment -%}
      {%- if lnz_lojas_on -%}
        <button type="button" class="lnat-prazos__acc{% if lnz_ultimo == 2 %} lnat-prazos__acc--ultimo{% endif %}" data-lnz-acc aria-expanded="false" aria-controls="lnz-p2-{{ section.id }}">
          <span>{{ t_levantar_loja }}</span><span class="lnat-prazos__acc-ico" aria-hidden="true"></span>
        </button>
        <div class="lnat-prazos__painel lnat-prazos__p2{% if lnz_ultimo == 2 %} lnat-prazos__painel--ultimo{% endif %}" id="lnz-p2-{{ section.id }}">
          {%- render 'lod-natal-icon', nome: 'porta', tamanho: 40, classe: 'lnat-prazos__ico' -%}
          <h3 class="lnat-h3">{{ lnz_lojas_titulo | escape }}</h3>
          {%- if lnz_lojas_texto != blank -%}
            <p class="lnat-prazos__txt">{{ lnz_lojas_texto | escape | replace: ' €', '&nbsp;€' }}</p>
          {%- endif -%}
          <ul class="lnat-prazos__lojas" aria-label="{{ t_lojas_distrito | escape }}">
            {%- for lnz_d in lnz_lojas -%}
              {%- assign lnz_dp = lnz_d | split: '|' -%}
              {%- assign lnz_ls = lnz_dp[1] | split: ',' -%}
              <li><span class="lnat-prazos__distrito">{{ lnz_dp[0] }}</span>{{ ' ' }}
                {%- for lnz_lj in lnz_ls -%}
                  {%- assign lnz_lp = lnz_lj | split: ':' -%}
                  {% unless forloop.first %}, {% endunless %}<a href="{{ lnz_raiz }}/pages/{{ lnz_lp[1] }}">{{ lnz_lp[0] }}</a>
                {%- endfor -%}
              </li>
            {%- endfor -%}
          </ul>
          <div class="lnat-btns">
            <a class="lnat-btn lnat-btn--ouro" href="https://wa.me/{{ lnz_wa }}?text={{ lnz_wa_q }}" target="_blank" rel="noopener" data-lnz-wa data-texto="{{ lnz_wa_txt | escape }}">
              {%- render 'lod-natal-icon', nome: 'whatsapp', tamanho: 18 -%}
              <span>{{ t_marcar_wa }}</span><span class="lnat-sr"> {{ t_abre_janela }}</span>
            </a>
            <a class="lnat-btn lnat-btn--claro" href="{{ lnz_lojas_url }}">{{ t_ver_lojas }}</a>
          </div>
          {%- comment -%} Horários de 24 e 31 dez.: vazio = não mostra (decisão do dono por tomar). {%- endcomment -%}
          {%- if lnz_horarios != blank -%}
            <p class="lnat-prazos__peq">{{ lnz_horarios | escape }}</p>
          {%- endif -%}
          {%- comment -%} Janeiras: só com a definição ligada (lojas, dias e horas por decidir). {%- endcomment -%}
          {%- if s.janeiras_confirmadas and lnz_janeiras != blank -%}
            <p class="lnat-prazos__janeiras" data-lnz-fases="mirra"{% unless lnz_ff == 'mirra' %} hidden{% endunless %}>
              {%- render 'lod-natal-icon', nome: 'coroa', tamanho: 28 -%}
              <span>{{ lnz_janeiras | escape }}</span>
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} 3 · Vales-prenda {%- endcomment -%}
      {%- if lnz_vales_on -%}
        <button type="button" class="lnat-prazos__acc lnat-prazos__acc--ultimo" data-lnz-acc aria-expanded="false" aria-controls="lnz-p3-{{ section.id }}">
          <span>{{ t_vales_prenda }}</span><span class="lnat-prazos__acc-ico" aria-hidden="true"></span>
        </button>
        <div class="lnat-prazos__painel lnat-prazos__p3 lnat-prazos__painel--ultimo" id="lnz-p3-{{ section.id }}">
          {%- render 'lod-natal-icon', nome: 'estrela', tamanho: 40, classe: 'lnat-prazos__ico' -%}
          <h3 class="lnat-h3">{{ lnz_vales_titulo | escape }}</h3>
          {%- if lnz_vales_texto != blank -%}
            <p class="lnat-prazos__txt">{{ lnz_vales_texto | escape | replace: ' €', '&nbsp;€' }}</p>
          {%- endif -%}
          {%- unless settings.natal_vale_digital -%}
            {%- case lnz_versao -%}
              {%- when 'pt' -%}
                <p class="lnat-prazos__peq" data-lnz-fases="ultima"{% unless lnz_vale_natal %} hidden{% endunless %}>{{ t_vale_natal }}</p>
                <p class="lnat-prazos__peq" data-lnz-fases="mirra" data-lnz-desde="{{ lnz_reis | escape }}"{% unless lnz_vale_reis %} hidden{% endunless %}>{{ t_vale_reis }}</p>
              {%- when 'es' -%}
                <p class="lnat-prazos__peq" data-lnz-fases="reyes" data-lnz-ate="{{ lnz_festas | escape }}"{% unless lnz_vale_natal %} hidden{% endunless %}>{{ t_vale_natal }}</p>
                <p class="lnat-prazos__peq" data-lnz-fases="reyes_ultima"{% unless lnz_vale_reis %} hidden{% endunless %}>{{ t_vale_reis }}</p>
            {%- endcase -%}
          {%- endunless -%}
          <div class="lnat-btns">
            <a class="lnat-btn lnat-btn--ouro" href="{{ lnz_vales_url }}">{{ lnz_vales_botao | escape }}</a>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
(function () {
  // Fases em que a secção aparece, por versão (Espanha: sem a noche_reyes, que é calma e sem prazos)
  var ATIVAS = { pt: ['ouro', 'incenso', 'ultima', 'consoada', 'mirra'], es: ['navidad', 'reyes', 'reyes_ultima'], int: ['navidad'] };
  function N() { return window.LOD_NATAL || null; }
  function lx(v) {
    var n = N();
    if (n && n.lx) return n.lx(v);
    var m = String(v || '').match(/^(\d{4})-(\d{2})-(\d{2})(?:[ T](\d{1,2}):(\d{2}))?/);
    return m ? new Date(Date.UTC(+m[1], +m[2] - 1, +m[3], m[4] ? +m[4] : 0, m[5] ? +m[5] : 0)) : null;
  }
  function agora() { var n = N(); return n && n.agora ? n.agora().getTime() : Date.now(); }
  // prazo «até» conta o último minuto; «instante» (levantar na loja, 13:00) acaba à hora certa
  function passou(v, instante) { var d = lx(v); return d ? agora() >= d.getTime() + (instante ? 0 : 60000) : false; }
  function pad(n) { return n < 10 ? '0' + n : '' + n; }
  function icsTexto(v) { return String(v || '').replace(/[\\;,]/g, function (c) { return '\\' + c; }).replace(/\r?\n/g, '\\n'); }
  function dobrar(l) { var o = ''; while (l.length > 60) { o += l.slice(0, 60) + '\r\n '; l = l.slice(60); } return o + l; }

  function calendario(btn, estado) {
    try {
      var m = String(btn.getAttribute('data-valor') || '').match(/^(\d{4})-(\d{2})-(\d{2})/);
      if (!m || !window.Blob || !window.URL || !URL.createObjectURL) return;
      var dia = m[1] + m[2] + m[3];
      var s = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3] + 1));
      var fim = s.getUTCFullYear() + pad(s.getUTCMonth() + 1) + pad(s.getUTCDate());
      var raiz = btn.closest('[data-lnat-prazos]');
      var url = location.origin + location.pathname + '#' + ((raiz && raiz.id) || 'prazos');
      var titulo = btn.getAttribute('data-titulo') || 'Natal';
      var linhas = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Loja do Ouro//Natal 2026//PT', 'CALSCALE:GREGORIAN', 'METHOD:PUBLISH',
        'BEGIN:VEVENT', 'UID:natal-' + (btn.getAttribute('data-uid') || 'prazo') + '-' + dia + '@' + location.hostname,
        'DTSTAMP:' + new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d+Z$/, 'Z'),
        'DTSTART;VALUE=DATE:' + dia, 'DTEND;VALUE=DATE:' + fim,
        'SUMMARY:' + icsTexto(titulo), 'DESCRIPTION:' + icsTexto((btn.getAttribute('data-texto') || '') + ' ' + url),
        'URL:' + url, 'TRANSP:TRANSPARENT',
        'BEGIN:VALARM', 'ACTION:DISPLAY', 'DESCRIPTION:' + icsTexto(titulo), 'TRIGGER:PT10H', 'END:VALARM',
        'END:VEVENT', 'END:VCALENDAR'];
      var corpo = linhas.map(dobrar).join('\r\n');
      var href = URL.createObjectURL(new Blob([corpo], { type: 'text/calendar;charset=utf-8' }));
      var a = document.createElement('a');
      a.href = href; a.download = 'natal-loja-do-ouro.ics'; a.style.display = 'none';
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      setTimeout(function () { try { URL.revokeObjectURL(href); } catch (e) {} }, 4000);
      if (estado) estado.textContent = estado.getAttribute('data-ok') || '';
    } catch (e) {}
  }

  function aplicar(root) {
    var n = N(), design = !!(window.Shopify && Shopify.designMode);
    var v = root.getAttribute('data-lnz-versao') || 'pt';
    if (!ATIVAS[v]) v = 'int';
    var f = n && n.fase ? n.fase(v) : ATIVAS[v][0];
    if (ATIVAS[v].indexOf(f) < 0) {
      if (!design) { root.hidden = true; return; }
      f = ATIVAS[v][0];
    }
    root.hidden = false;
    root.querySelectorAll('[data-lnz-prazo]').forEach(function (l) {
      var p = passou(l.getAttribute('data-valor'), l.hasAttribute('data-instante'));
      l.classList.toggle('is-fim', p);
      var d = l.querySelector('[data-lnz-data]'), t = l.querySelector('[data-lnz-fim]');
      if (d) d.hidden = p;
      if (t) t.hidden = !p;
    });
    // um só lembrete: o primeiro cujo prazo ainda não passou
    var visto = false;
    root.querySelectorAll('[data-lnz-ics]').forEach(function (b) {
      var ok = !visto && !passou(b.getAttribute('data-valor'));
      b.hidden = !ok;
      if (ok) visto = true;
    });
    root.querySelectorAll('[data-lnz-fases]').forEach(function (el) {
      el.hidden = (' ' + el.getAttribute('data-lnz-fases') + ' ').indexOf(' ' + f + ' ') < 0;
      // «a partir de» / «até» um prazo: contam o último minuto desse prazo
      if (!el.hidden && el.hasAttribute('data-lnz-desde') && !passou(el.getAttribute('data-lnz-desde'))) el.hidden = true;
      if (!el.hidden && el.hasAttribute('data-lnz-ate') && passou(el.getAttribute('data-lnz-ate'))) el.hidden = true;
    });
    if (n && n.wa) {
      root.querySelectorAll('[data-lnz-wa]').forEach(function (a) {
        a.href = 'https://wa.me/' + n.wa + '?text=' + encodeURIComponent(a.getAttribute('data-texto') || '');
      });
    }
  }

  function init(root) {
    if (!root || root._lnz) return;
    root._lnz = true;
    aplicar(root);
    root.querySelectorAll('[data-lnz-acc]').forEach(function (b) {
      b.addEventListener('click', function () {
        b.setAttribute('aria-expanded', b.getAttribute('aria-expanded') === 'true' ? 'false' : 'true');
      });
    });
    var estado = root.querySelector('[data-lnz-estado]');
    root.querySelectorAll('[data-lnz-ics]').forEach(function (b) {
      b.addEventListener('click', function () { calendario(b, estado); });
    });
  }

  function todas() { document.querySelectorAll('[data-lnat-prazos]').forEach(init); }
  todas();

  var html = document.documentElement;
  if (html.hasAttribute('data-lnat-prazos-js')) return;
  html.setAttribute('data-lnat-prazos-js', '');
  document.addEventListener('shopify:section:load', todas);
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) document.querySelectorAll('[data-lnat-prazos]').forEach(function (r) { if (r._lnz) aplicar(r); });
  });
})();
</script>
{%- endif -%}

