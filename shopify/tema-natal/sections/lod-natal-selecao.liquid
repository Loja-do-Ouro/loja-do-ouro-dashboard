{%- comment -%}
  Natal 2026 · Ouro de Reis — «Os mais oferecidos» (seleção manual de produtos).
  Grelha de 4 a partir de 750 px, só com filas completas (com 5 a 7 cartões mostra 4, sem buracos);
  faixa com scroll-snap no telemóvel (2 cartões visíveis e o seguinte a espreitar).
  Usa o cartão lod-natal-card (sem selos de desconto). Os esgotados ficam de fora: escolha mais produtos
  do que o número máximo, para que entre o seguinte da lista quando um esgota.
  Línguas: campos base em português e campos _en/_es (vazios → português). Versões: Portugal, Espanha e
  Internacional, cada uma nas suas fases (contrato i18n, secção 5). Ligações começadas por «/» ganham o
  prefixo da língua e do mercado (routes.root_url: /en, /es, /pt-pt…).
{%- endcomment -%}
{%- liquid
  # Língua da página, versão da campanha (mercado da visita) e fase dessa versão
  capture lnat_lg
    render 'lod-natal-t', k: '_lingua'
  endcapture
  assign lnat_lg = lnat_lg | strip
  capture lnat_versao
    render 'lod-natal-fase', mercado: 'auto', devolve: 'versao'
  endcapture
  assign lnat_versao = lnat_versao | strip
  capture lnat_fase
    render 'lod-natal-fase', mercado: 'auto'
  endcapture
  assign lnat_fase = lnat_fase | strip
  # Versões em que esta secção existe: todas
  assign versoes = ',pt,es,int,'
  case lnat_versao
    when 'es'
      assign fases_versao = ',navidad,reyes,reyes_ultima,noche_reyes,'
    when 'int'
      assign fases_versao = ',navidad,'
    else
      assign lnat_versao = 'pt'
      assign fases_versao = ',ouro,incenso,ultima,consoada,mirra,'
  endcase
  assign k_v = ',' | append: lnat_versao | append: ','
  assign k_f = ',' | append: lnat_fase | append: ','
  assign suporta = false
  if versoes contains k_v
    assign suporta = true
  endif
  assign oculta = true
  if suporta and fases_versao contains k_f
    assign oculta = false
  endif
  assign mostrar = true
  if oculta
    assign mostrar = false
    if request.design_mode
      assign mostrar = true
    endif
  endif

  # Textos na língua da página
  assign s = section.settings
  assign t_eyebrow = s.eyebrow
  assign t_titulo = s.titulo
  assign t_descricao = s.descricao
  assign t_link = s.link_texto
  if lnat_lg != 'pt'
    assign k = 'eyebrow_' | append: lnat_lg
    if s[k] != blank
      assign t_eyebrow = s[k]
    endif
    assign k = 'titulo_' | append: lnat_lg
    if s[k] != blank
      assign t_titulo = s[k]
    endif
    assign k = 'descricao_' | append: lnat_lg
    if s[k] != blank
      assign t_descricao = s[k]
    endif
    assign k = 'link_texto_' | append: lnat_lg
    if s[k] != blank
      assign t_link = s[k]
    endif
  endif

  # Ligação com o prefixo da língua e do mercado (routes.root_url é «/» na língua principal de cada domínio)
  assign raiz = routes.root_url | default: '/'
  assign raiz_pre = raiz | append: '/'
  assign u = s.link_url
  if u != blank and raiz != '/'
    assign u1 = u | slice: 0, 1
    assign u2 = u | slice: 0, 2
    assign u_ja = false
    assign u_ini = u | slice: 0, raiz.size
    if u_ini == raiz
      assign u_seg = u | slice: raiz.size, 1
      if u_seg == blank or u_seg == '/' or u_seg == '#' or u_seg == '?'
        assign u_ja = true
      endif
    endif
    if u1 == '/' and u2 != '//' and u_ja == false
      assign u = raiz | append: u
    endif
  endif
  assign t_link_url = u

  assign limite = section.settings.limite | default: 8
  assign n = 0
  capture cartoes
    for p in section.settings.produtos
      if n >= limite
        break
      endif
      if p.available == false and section.settings.esconder_esgotados
        continue
      endif
      assign n = n | plus: 1
      echo '<li class="lnat-sel__item">'
      render 'lod-natal-card', product: p, largura: 480, carregar: 'lazy'
      echo '</li>'
    endfor
  endcapture

  if n == 0 and request.design_mode == false
    assign mostrar = false
  endif

  assign corta = 0
  if n > 4
    assign corta = n | modulo: 4
  endif

  assign fundo = section.settings.fundo | default: 'papel'
-%}
{%- if mostrar -%}
<section
  class="lnat lnat-sel lnat-sec lnat-bg-{{ fundo }}{% if corta > 0 %} lnat-sel--corta-{{ corta }}{% endif %}{% unless section.settings.mostrar_no_telemovel %} lnat-sel--sem-tel{% endunless %}{% if request.design_mode %} lnat-sel--editor{% endif %}"
  id="lnat-sel-{{ section.id }}"
  aria-labelledby="lnat-sel-h-{{ section.id }}"
>
  <div class="lnat-wrap">
    {%- if oculta -%}{%- render 'lod-natal-aviso-fase', fase: lnat_fase -%}{%- endif -%}

    <div class="lnat-sel__cab">
      <div class="lnat-sel__titulos">
        {%- if t_eyebrow != blank -%}
          <p class="lnat-eb">{{ t_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="lnat-h2 lnat-sel__h" id="lnat-sel-h-{{ section.id }}">{{ t_titulo | escape }}</h2>
        {%- if t_descricao != blank -%}
          <p class="lnat-txt lnat-sel__desc">{{ t_descricao | escape }}</p>
        {%- endif -%}
      </div>
      {%- if t_link != blank and t_link_url != blank -%}
        <a class="lnat-link lnat-sel__link" href="{{ t_link_url }}">{{ t_link | escape }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>

    {%- if n > 0 -%}
      <ul class="lnat-sel__lista" role="list" aria-label="{{ t_titulo | escape }}">
        {{- cartoes -}}
      </ul>
    {%- else -%}
      <p class="lnat-peq lnat-sel__vazio">Escolha os produtos nas definições da secção. Os esgotados não aparecem.</p>
    {%- endif -%}
  </div>
</section>

<style>
  .lnat-sel{overflow:hidden}
  .lnat-sel__cab{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px 32px;margin:0 0 24px}
  .lnat-sel__titulos{display:flex;flex-direction:column;align-items:flex-start;gap:10px;max-width:720px}
  .lnat-sel__h{color:var(--lnat-tinta)}
  .lnat-bg-tinta .lnat-sel__h,.lnat-bg-verde .lnat-sel__h{color:var(--lnat-papel)}
  .lnat-sel__link{display:inline-flex;align-items:center;gap:6px;min-height:44px;font-size:14px;font-weight:600}
  .lnat-sel__lista{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:32px 16px}
  .lnat-sel__item{margin:0;min-width:0;display:flex}
  .lnat-sel__item > .lnat-card{flex:1 1 auto}
  .lnat-sel .lnat-card__preco{margin-top:auto}
  .lnat-sel__vazio{padding:32px 0}

  @media screen and (max-width:749px){
    .lnat-sel--sem-tel{display:none}
    .lnat-sel__cab{margin-bottom:20px}
    .lnat-sel__lista{
      grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:calc((100% - 24px) / 2.25);gap:12px;
      margin:0 calc(-1 * var(--lnat-gutter));padding:0 var(--lnat-gutter) 4px;
      overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scroll-padding-inline:var(--lnat-gutter);
      -webkit-overflow-scrolling:touch;scrollbar-width:none
    }
    .lnat-sel__lista::-webkit-scrollbar{display:none}
    .lnat-sel__item{scroll-snap-align:start}
  }
  @media screen and (min-width:750px){
    .lnat-sel--corta-1 .lnat-sel__item:nth-last-child(-n+1),
    .lnat-sel--corta-2 .lnat-sel__item:nth-last-child(-n+2),
    .lnat-sel--corta-3 .lnat-sel__item:nth-last-child(-n+3){display:none}
  }
  @media screen and (min-width:990px){
    .lnat-sel__cab{margin-bottom:32px}
    .lnat-sel__lista{grid-template-columns:repeat(4,minmax(0,1fr));gap:40px 24px}
  }
</style>

<script>
(function(){
  // Fases em que a secção aparece, por versão da campanha (contrato i18n, secção 5)
  var ATIVAS = { pt: ['ouro', 'incenso', 'ultima', 'consoada', 'mirra'], es: ['navidad', 'reyes', 'reyes_ultima', 'noche_reyes'], int: ['navidad'] };
  function ini(sec){
    if (sec.getAttribute('data-lnat-pronto')) return;
    sec.setAttribute('data-lnat-pronto', '1');
    var N = window.LOD_NATAL;
    if (N && !sec.classList.contains('lnat-sel--editor')) {
      var v = N.versao || 'pt';
      var f = N.fase(v);
      if (!ATIVAS[v] || ATIVAS[v].indexOf(f) < 0) sec.hidden = true;
    }
  }
  function todos(){
    var l = document.querySelectorAll('.lnat-sel');
    for (var i = 0; i < l.length; i++) ini(l[i]);
  }
  todos();
  var doc = document.documentElement;
  if (doc.hasAttribute('data-lnat-sel')) return;
  doc.setAttribute('data-lnat-sel', '');
  document.addEventListener('shopify:section:load', todos);
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Natal · Mais oferecidos",
  "tag": "section",
  "class": "lnat-secao lnat-secao--selecao",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "No Natal passado" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Os mais oferecidos" },
    { "type": "textarea", "id": "descricao", "label": "Descrição", "default": "Algumas das peças mais escolhidas no nosso Natal de 2025." },
    { "type": "product_list", "id": "produtos", "label": "Produtos", "limit": 12, "info": "Escolha mais produtos do que o número máximo: quando um esgota, entra o seguinte da lista." },
    { "type": "range", "id": "limite", "label": "Número máximo de produtos", "min": 2, "max": 12, "step": 1, "default": 8, "info": "A partir de 750 px só se mostram filas completas de 4 (8 é o ideal)." },
    { "type": "checkbox", "id": "esconder_esgotados", "label": "Esconder produtos esgotados", "default": true },
    { "type": "text", "id": "link_texto", "label": "Texto do link (opcional)" },
    { "type": "url", "id": "link_url", "label": "Link" },
    {
      "type": "select",
      "id": "fundo",
      "label": "Fundo",
      "options": [
        { "value": "papel", "label": "Papel" },
        { "value": "linho", "label": "Linho" }
      ],
      "default": "papel"
    },
    { "type": "header", "content": "Tradução — Inglês (EN)", "info": "Deixe vazio para usar o português." },
    { "type": "text", "id": "eyebrow_en", "label": "Sobretítulo (EN)" },
    { "type": "text", "id": "titulo_en", "label": "Título (EN)" },
    { "type": "textarea", "id": "descricao_en", "label": "Descrição (EN)" },
    { "type": "text", "id": "link_texto_en", "label": "Texto do link (EN)" },
    { "type": "header", "content": "Tradução — Espanhol (ES)", "info": "Deixe vazio para usar o português." },
    { "type": "text", "id": "eyebrow_es", "label": "Sobretítulo (ES)" },
    { "type": "text", "id": "titulo_es", "label": "Título (ES)" },
    { "type": "textarea", "id": "descricao_es", "label": "Descrição (ES)" },
    { "type": "text", "id": "link_texto_es", "label": "Texto do link (ES)" },
    { "type": "header", "content": "Telemóvel" },
    { "type": "checkbox", "id": "mostrar_no_telemovel", "label": "Mostrar no telemóvel", "default": true }
  ],
  "presets": [
    { "name": "Natal · Mais oferecidos" }
  ]
}
{% endschema %}
