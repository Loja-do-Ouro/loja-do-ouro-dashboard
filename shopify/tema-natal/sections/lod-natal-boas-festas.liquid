{%- comment -%}
  Natal 2026 · Ouro de Reis — «Boas Festas», fundo tinta, centrado.
  Coração vermelho, título em Cormorant (72 px; 48 px no telemóvel), uma linha e a divisória «fio».
  Línguas: campos base em português e campos _en/_es (vazios → português). Versões: Portugal, Espanha e
  Internacional, cada uma nas suas fases (contrato i18n, secção 5).
  Título de Reis (opcional): a partir de 5 de janeiro, 00:00 (a noite da cabalgata em Espanha) até ao fim da
  campanha, o título passa a «Feliz Día de Reyes» (ou o que estiver no campo), em todas as versões que ainda
  estejam no ar. O servidor escolhe; o navegador volta a escolher com window.LOD_NATAL (páginas em cache).
{%- endcomment -%}
{%- liquid
  # Língua da página, versão da campanha (mercado da visita) e fase dessa versão
  capture lnat_lg
    render 'lod-natal-t', k: '_lingua'
  endcapture
  assign lnat_lg = lnat_lg | strip
  capture lnat_versao
    render 'lod-natal-fase', mercado: 'auto', devolve: 'versao'
  endcapture
  assign lnat_versao = lnat_versao | strip
  capture lnat_fase
    render 'lod-natal-fase', mercado: 'auto'
  endcapture
  assign lnat_fase = lnat_fase | strip
  # Versões em que esta secção existe: todas
  assign versoes = ',pt,es,int,'
  case lnat_versao
    when 'es'
      assign fases_versao = ',navidad,reyes,reyes_ultima,noche_reyes,'
    when 'int'
      assign fases_versao = ',navidad,'
    else
      assign lnat_versao = 'pt'
      assign fases_versao = ',ouro,incenso,ultima,consoada,mirra,'
  endcase
  assign k_v = ',' | append: lnat_versao | append: ','
  assign k_f = ',' | append: lnat_fase | append: ','
  assign suporta = false
  if versoes contains k_v
    assign suporta = true
  endif
  assign oculta = true
  if suporta and fases_versao contains k_f
    assign oculta = false
  endif
  assign mostrar = true
  if oculta
    assign mostrar = false
    if request.design_mode
      assign mostrar = true
    endif
  endif

  # Textos na língua da página
  assign s = section.settings
  assign t_titulo = s.titulo
  assign t_texto = s.texto
  assign t_titulo_reis = s.titulo_reis
  if lnat_lg != 'pt'
    assign k = 'titulo_' | append: lnat_lg
    if s[k] != blank
      assign t_titulo = s[k]
    endif
    assign k = 'texto_' | append: lnat_lg
    if s[k] != blank
      assign t_texto = s[k]
    endif
    assign k = 'titulo_reis_' | append: lnat_lg
    if s[k] != blank
      assign t_titulo_reis = s[k]
    endif
  endif

  # Noite e Dia de Reis: a fase de Espanha diz se já é 5 de janeiro (vale para todas as versões)
  assign reis_agora = false
  if t_titulo_reis != blank
    capture lnat_fase_es
      render 'lod-natal-fase', mercado: 'es'
    endcapture
    assign lnat_fase_es = lnat_fase_es | strip
    if lnat_fase_es == 'noche_reyes'
      assign reis_agora = true
    endif
  endif
-%}
{%- if mostrar -%}
<section
  class="lnat lnat-bf lnat-bg-tinta{% unless s.mostrar_no_telemovel %} lnat-bf--sem-tel{% endunless %}{% if request.design_mode %} lnat-bf--editor{% endif %}"
  id="lnat-bf-{{ section.id }}"
  aria-labelledby="lnat-bf-h-{{ section.id }}"
>
  <div class="lnat-wrap lnat-bf__wrap">
    {%- if oculta -%}{%- render 'lod-natal-aviso-fase', fase: lnat_fase -%}{%- endif -%}
    {%- if s.mostrar_coracao -%}
      <span class="lnat-bf__coracao">{%- render 'lod-natal-icon', nome: 'coracao-cheio', tamanho: 28 -%}</span>
    {%- endif -%}
    <h2 class="lnat-bf__h" id="lnat-bf-h-{{ section.id }}">
      {%- if t_titulo_reis != blank -%}
        <span data-lnat-bf-t="festas"{% if reis_agora %} hidden{% endif %}>{{ t_titulo | escape }}</span><span data-lnat-bf-t="reis"{% unless reis_agora %} hidden{% endunless %}>{{ t_titulo_reis | escape }}</span>
      {%- else -%}
        {{- t_titulo | escape -}}
      {%- endif -%}
    </h2>
    {%- if t_texto != blank -%}
      <p class="lnat-bf__txt">{{ t_texto | escape }}</p>
    {%- endif -%}
    {%- if s.mostrar_fio -%}
      {%- render 'lod-natal-icon', nome: 'fio' -%}
    {%- endif -%}
  </div>
</section>

<style>
  .lnat-bf{padding:44px 0}
  .lnat-bf__wrap{display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center}
  .lnat-bf__coracao{line-height:0}
  .lnat-bf__coracao svg{width:24px;height:24px}
  .lnat-bf__h{margin:0;font-family:var(--lnat-serif);font-style:italic;font-weight:500;font-size:48px;line-height:52px;letter-spacing:-.01em;color:var(--lnat-ouro-claro);text-wrap:balance}
  .lnat-bf__h [hidden]{display:none}
  .lnat-bf__txt{margin:0;font-size:14px;line-height:22px;color:#e1dacb}
  .lnat-bf .lnat-fio{width:240px;height:24px;margin-top:4px}
  @media screen and (max-width:749px){
    .lnat-bf--sem-tel{display:none}
  }
  @media screen and (min-width:750px){
    .lnat-bf{padding:80px 0}
    .lnat-bf__wrap{gap:14px}
    .lnat-bf__coracao svg{width:28px;height:28px}
    .lnat-bf__h{font-size:72px;line-height:76px}
    .lnat-bf__txt{font-size:16px;line-height:26px}
  }
</style>

<script>
(function(){
  // Fases em que a secção aparece, por versão da campanha (contrato i18n, secção 5)
  var ATIVAS = { pt: ['ouro', 'incenso', 'ultima', 'consoada', 'mirra'], es: ['navidad', 'reyes', 'reyes_ultima', 'noche_reyes'], int: ['navidad'] };
  function ini(sec){
    if (sec.getAttribute('data-lnat-pronto')) return;
    sec.setAttribute('data-lnat-pronto', '1');
    var N = window.LOD_NATAL;
    if (!N || sec.classList.contains('lnat-bf--editor')) return;
    var v = N.versao || 'pt';
    var f = N.fase(v);
    if (!ATIVAS[v] || ATIVAS[v].indexOf(f) < 0) { sec.hidden = true; return; }
    // Título de Reis: de 5 de janeiro, 00:00, até ao fim da campanha
    var reis = N.fase('es') === 'noche_reyes';
    var tf = sec.querySelector('[data-lnat-bf-t="festas"]');
    var tr = sec.querySelector('[data-lnat-bf-t="reis"]');
    if (tf && tr) { tf.hidden = reis; tr.hidden = !reis; }
  }
  function todos(){
    var l = document.querySelectorAll('.lnat-bf');
    for (var i = 0; i < l.length; i++) ini(l[i]);
  }
  todos();
  var doc = document.documentElement;
  if (doc.hasAttribute('data-lnat-bf')) return;
  doc.setAttribute('data-lnat-bf', '');
  document.addEventListener('shopify:section:load', todos);
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Natal · Boas Festas",
  "tag": "section",
  "class": "lnat-secao lnat-secao--boas-festas",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Boas Festas" },
    { "type": "text", "id": "texto", "label": "Linha", "default": "De todos nós, nas 13 lojas da Loja do Ouro." },
    { "type": "text", "id": "titulo_reis", "label": "Título de 5 e 6 de janeiro (opcional)", "info": "Substitui o título na Noite e no Dia de Reis, de 5 de janeiro até ao fim da campanha. Vazio: fica sempre o título acima." },
    { "type": "checkbox", "id": "mostrar_coracao", "label": "Coração vermelho", "default": true },
    { "type": "checkbox", "id": "mostrar_fio", "label": "Divisória em fio torcido", "default": true },
    { "type": "header", "content": "Tradução — Inglês (EN)", "info": "Deixe vazio para usar o português." },
    { "type": "text", "id": "titulo_en", "label": "Título (EN)" },
    { "type": "text", "id": "texto_en", "label": "Linha (EN)" },
    { "type": "text", "id": "titulo_reis_en", "label": "Título de 5 e 6 de janeiro (EN)" },
    { "type": "header", "content": "Tradução — Espanhol (ES)", "info": "Deixe vazio para usar o português." },
    { "type": "text", "id": "titulo_es", "label": "Título (ES)" },
    { "type": "text", "id": "texto_es", "label": "Linha (ES)" },
    { "type": "text", "id": "titulo_reis_es", "label": "Título de 5 e 6 de janeiro (ES)" },
    { "type": "header", "content": "Telemóvel" },
    { "type": "checkbox", "id": "mostrar_no_telemovel", "label": "Mostrar no telemóvel", "default": true }
  ],
  "presets": [
    { "name": "Natal · Boas Festas" }
  ]
}
{% endschema %}
