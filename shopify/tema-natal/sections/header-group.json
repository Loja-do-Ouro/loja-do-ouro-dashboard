ar .ldo-topbar__icon {\n    display: block;\n    flex: 0 0 16px;\n    width: 16px;\n    height: 16px;\n    color: #c4a368;\n  }\n\n  .ldo-topbar .ldo-topbar__text {\n    margin: 0;\n    padding: 0;\n    color: #ead9b5;\n    font-family: inherit;\n    font-size: 10px;\n    font-weight: 400;\n    line-height: 1.5;\n    letter-spacing: 0.07em;\n    text-transform: uppercase;\n    text-align: center;\n    text-wrap: balance;\n  }\n\n  .ldo-topbar .ldo-topbar__amount {\n    color: #fff3d8;\n    font-weight: 600;\n    white-space: nowrap;\n  }\n\n  .ldo-topbar .ldo-topbar__exception {\n    margin: 0;\n    padding: 0;\n    color: #cfc5b3;\n    font-family: inherit;\n    font-size: 10px;\n    font-weight: 400;\n    line-height: 1.5;\n    letter-spacing: 0.015em;\n    text-transform: none;\n    text-align: center;\n    text-wrap: balance;\n  }\n\n  .ldo-topbar .ldo-topbar__sparkle {\n    flex: 0 0 auto;\n    color: #c4a368;\n    font-size: 13px;\n    line-height: 1;\n  }\n\n  @media (min-width: 990px) {\n    .ldo-topbar .ldo-topbar__inner {\n      flex-direction: row;\n      flex-wrap: wrap;\n      gap: 6px 14px;\n      min-height: 32px;\n    }\n\n    .ldo-topbar .ldo-topbar__exception {\n      padding-inline-start: 14px;\n      border-inline-start: 1px solid rgba(196, 163, 104, 0.4);\n    }\n\n    .ldo-topbar .ldo-topbar__icon {\n      flex-basis: 14px;\n      width: 14px;\n      height: 14px;\n    }\n  }\n\n  @media (max-width: 640px) {\n    .ldo-topbar .ldo-topbar__inner {\n      min-height: 36px;\n      gap: 3px;\n      padding: 7px 12px;\n    }\n\n    .ldo-topbar .ldo-topbar__main {\n      gap: 7px;\n    }\n\n    .ldo-topbar .ldo-topbar__text {\n      font-size: 9px;\n      letter-spacing: 0.035em;\n    }\n\n    .ldo-topbar .ldo-topbar__exception {\n      font-size: 9px;\n      line-height: 1.4;\n      letter-spacing: 0;\n    }\n\n    .ldo-topbar .ldo-topbar__icon {\n      flex-basis: 14px;\n      width: 14px;\n      height: 14px;\n    }\n\n    .ldo-topbar .ldo-topbar__