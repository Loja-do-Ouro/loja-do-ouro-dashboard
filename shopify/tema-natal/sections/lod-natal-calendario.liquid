      try { if (typeof window.clarity === 'function') window.clarity('set', 'calendario_dia', dia); } catch (e) {}
      return true;
    }

    function focarTitulo() {
      var h = conteudo.querySelector('.lnat-cal__titulo');
      if (h) { try { h.focus({ preventScroll: true }); } catch (e) { h.focus(); } }
    }

    function mostrar() {
      abrindo = false;
      if (dlg.open) return;
      if (typeof dlg.showModal === 'function') {
        try { dlg.showModal(); } catch (e) { dlg.setAttribute('open', ''); dlg.classList.add('is-sem-modal'); }
      } else {
        dlg.setAttribute('open', '');
        dlg.classList.add('is-sem-modal');
      }
      html.classList.add('lnat-cal-aberto');
      var fechar = dlg.querySelector('[data-fechar]');
      if (fechar) fechar.focus();
