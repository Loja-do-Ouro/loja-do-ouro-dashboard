      var alvoIco = conteudo.querySelector('[data-icone]');
      if (alvoIco && icones && icones.content) {
        var ico = icones.content.querySelector('[data-icone="' + alvoIco.getAttribute('data-icone') + '"] svg');
        if (ico) alvoIco.appendChild(ico.cloneNode(true));
