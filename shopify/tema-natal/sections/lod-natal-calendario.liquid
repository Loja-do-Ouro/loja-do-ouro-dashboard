      conteudo.scrollTop = 0;
      atual = p;
      var abertas = portas.filter(livre);
      var i = abertas.indexOf(p);
      nav(btnAnt, i > 0 ? abertas[i - 1] : null, 'Porta anterior: ');
      nav(btnSeg, i > -1 && i < abertas.length - 1 ? abertas[i + 1] : null, 'Porta seguinte: ');
      if (btnPart) btnPart.textContent = 'Partilhar';
      guardarVista(dia);
      p.classList.add('is-vista');
      try {
        if (window.Shopify && window.Shopify.analytics && typeof window.Shopify.analytics.publish === 'function') {
