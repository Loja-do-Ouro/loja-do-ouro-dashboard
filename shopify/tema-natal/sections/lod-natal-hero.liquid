{%- comment -%}
  Natal 2026 · Ouro de Reis — banner principal.
  Fotografia + cartão em vidro (estilo do banner «O universo do ouro»), com a mensagem de cada fase.
  Esquemas: «foto-esquerda» (a foto ocupa ~2/3 e o cartão fica sobre a continuação desfocada da foto;
  não tapa ninguém) e «foto-inteira» (foto a toda a largura e cartão por cima, como no banner do ouro).

  Mensagens (blocos «fase»): aparece o PRIMEIRO bloco ligado cuja fase é a atual e que está dentro das suas
  datas («Mostrar a partir de» / «Mostrar até»). As datas aceitam «AAAA-MM-DD HH:MM» (hora de Lisboa) ou o nome
  de uma data das definições do Natal (inicio, fase2, acores, madeira, gravacao, continente, loja, festas, retoma,
  reis, fim, trocas), com a mesma regra da barra: num «a partir de», um prazo quer dizer «depois desse prazo»;
  num «até», um início (inicio, fase2, loja, retoma) quer dizer «até ao minuto antes».
  Ex.: na fase mirra, um bloco «até reis» (ainda a tempo dos Reis) e outro «a partir de reis» (levantar na loja).
  O botão secundário pode ter uma alternativa com datas próprias (ex.: «Luz de Ano Novo» só de 28 a 31 dez.).
  O servidor escolhe com a data do servidor (ou a simulada fora do tema publicado); o navegador volta a escolher
  com window.LOD_NATAL (página em cache, ?natal_data=) e repete a cada 30 s.
{%- endcomment -%}
{%- liquid
  capture lnat_fase
    render 'lod-natal-fase'
  endcapture
  assign lnat_fase = lnat_fase | strip
  assign mostrar = true
  if lnat_fase == 'off' or lnat_fase == 'antes' or lnat_fase == 'fim'
    assign mostrar = false
  endif
  if request.design_mode
    assign mostrar = true
  endif

  # Datas das definições (com os mesmos valores por omissão de lod-natal-config)
  assign v_inicio = settings.natal_inicio | default: '2026-12-01 00:00' | strip
  assign v_fase2 = settings.natal_fase2_inicio | default: '2026-12-14 00:00' | strip
  assign v_acores = settings.natal_limite_acores | default: '2026-12-04 23:59' | strip
  assign v_madeira = settings.natal_limite_madeira | default: '2026-12-11 23:59' | strip
  assign v_gravacao = settings.natal_limite_gravacao | default: '2026-12-16 23:59' | strip
  assign v_cont = settings.natal_limite_continente | default: '2026-12-18 23:59' | strip
  assign v_loja = settings.natal_limite_loja | default: '2026-12-24 13:00' | strip
  assign v_festas = settings.natal_boas_festas_fim | default: '2026-12-25 23:59' | strip
  assign v_retoma = settings.natal_retoma_envios | default: '2026-12-28' | strip
  assign v_reis = settings.natal_limite_reis | default: '2026-12-30 23:59' | strip
  assign v_fim = settings.natal_fim | default: '2027-01-06 23:59' | strip
  assign v_trocas = settings.natal_trocas_ate | default: '2027-01-15' | strip
  assign k_nomes = 'inicio,fase2,acores,madeira,gravacao,continente,loja,festas,retoma,reis,fim,trocas' | split: ','
  assign k_inst = ',inicio,fase2,loja,retoma,'
  assign k_v = v_inicio | append: '|' | append: v_fase2 | append: '|' | append: v_acores | append: '|' | append: v_madeira
  assign k_v = k_v | append: '|' | append: v_gravacao | append: '|' | append: v_cont | append: '|' | append: v_loja
  assign k_v = k_v | append: '|' | append: v_festas | append: '|' | append: v_retoma | append: '|' | append: v_reis
  assign k_v = k_v | append: '|' | append: v_fim | append: '|' | append: v_trocas
  assign k_v = k_v | split: '|'

  capture d_cont
    render 'lod-natal-data', valor: v_cont, formato: 'longo'
  endcapture
  capture d_loja
    render 'lod-natal-data', valor: v_loja, formato: 'hora'
  endcapture
  capture d_reis
    render 'lod-natal-data', valor: v_reis, formato: 'longo'
  endcapture
  capture d_retoma
    render 'lod-natal-data', valor: v_retoma, formato: 'longo'
  endcapture
  capture d_trocas
    render 'lod-natal-data', valor: v_trocas, formato: 'curto'
  endcapture
  capture d_gravacao
    render 'lod-natal-data', valor: v_gravacao, formato: 'longo'
  endcapture
  assign wa = settings.natal_whatsapp | default: '351910067687' | remove: ' ' | remove: '+'

  # Agora (hora da loja), com a data simulada fora do tema publicado, como em lod-natal-fase
  assign agora_txt = 'now'
  if settings.natal_data_simulada != blank and theme.role != 'main'
    assign agora_txt = settings.natal_data_simulada | strip
    if agora_txt.size == 10
      assign agora_txt = agora_txt | append: ' 10:00'
    endif
  endif
  assign agora = agora_txt | date: '%Y%m%d%H%M' | plus: 0

  assign img_d = section.settings.imagem
  assign img_m = section.settings.imagem_telemovel | default: section.settings.imagem
  assign esquema = section.settings.esquema
  assign tag_titulo = 'h2'
  if section.settings.titulo_h1
    assign tag_titulo = 'h1'
  endif

  assign janelas = 'bloco,alt' | split: ','
  assign cd_vazio = '<span class="lnat-hero__falta" data-lnat-falta="continente"></span>'
  assign cd_loja = '<span class="lnat-hero__falta" data-lnat-falta="loja"></span>'
  assign cd_reis = '<span class="lnat-hero__falta" data-lnat-falta="reis"></span>'
  assign html_fases = ''
  assign id_mostrado = ''
  assign id_primeiro = ''
-%}
{%- if mostrar -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      assign b_ligado = true
      if b.ligado == false
        assign b_ligado = false
      endif
      # Um bloco desligado só vai para a página no editor (para se poder ver ao selecioná-lo)
      unless b_ligado or request.design_mode
        continue
      endunless

      # Datas do bloco e do botão alternativo: nome de uma data das definições ou data escrita
      for j in janelas
        if j == 'bloco'
          assign w_de_raw = b.de | strip | downcase
          assign w_ate_raw = b.ate | strip | downcase
        else
          assign w_de_raw = b.botao2_alt_de | strip | downcase
          assign w_ate_raw = b.botao2_alt_ate | strip | downcase
        endif
        assign w_de = w_de_raw
        assign w_ate = w_ate_raw
        assign w_de_depois = false
        assign w_ate_antes = false
        for k in k_nomes
          assign kk = ',' | append: k | append: ','
          if k == w_de_raw
            assign w_de = k_v[forloop.index0]
            unless k_inst contains kk
              assign w_de_depois = true
            endunless
          endif
          if k == w_ate_raw
            assign w_ate = k_v[forloop.index0]
            if k_inst contains kk
              assign w_ate_antes = true
            endif
          endif
        endfor
        assign w_ok = true
        assign w_attr = ''
        if w_de != blank
          assign w_t = w_de | date: '%Y%m%d%H%M' | plus: 0
          if w_t > 190000000000
            if w_de_depois
              if agora <= w_t
                assign w_ok = false
              endif
            elsif agora < w_t
              assign w_ok = false
            endif
            assign w_esc = w_de | escape
            assign w_attr = w_attr | append: ' data-de="' | append: w_esc | append: '"'
            if w_de_depois
              assign w_attr = w_attr | append: ' data-de-depois'
            endif
          endif
        endif
        if w_ate != blank
          assign w_t = w_ate | date: '%Y%m%d%H%M' | plus: 0
          if w_t > 190000000000
            if w_ate_antes
              if agora >= w_t
                assign w_ok = false
              endif
            elsif agora > w_t
              assign w_ok = false
            endif
            assign w_esc = w_ate | escape
            assign w_attr = w_attr | append: ' data-ate="' | append: w_esc | append: '"'
            if w_ate_antes
              assign w_attr = w_attr | append: ' data-ate-antes'
            endif
          endif
        endif
        if j == 'bloco'
          assign f_ok = w_ok
          assign f_attr = w_attr
        else
          assign a_ok = w_ok
          assign a_attr = w_attr
        endif
      endfor

      if b_ligado and id_primeiro == blank
        assign id_primeiro = block.id
      endif
      if b_ligado and f_ok and id_mostrado == blank and b.fase == lnat_fase
        assign id_mostrado = block.id
      endif

      assign chip = b.chip | replace: '{continente}', d_cont | replace: '{loja}', d_loja | replace: '{reis}', d_reis | replace: '{retoma}', d_retoma | replace: '{trocas}', d_trocas | replace: '{gravacao}', d_gravacao
      assign tem_contagem = false
      if chip contains '{contagem'
        assign tem_contagem = true
        assign chip = chip | replace: '{contagem:loja}', cd_loja | replace: '{contagem:reis}', cd_reis | replace: '{contagem}', cd_vazio
      endif
      assign texto = b.texto | replace: '{continente}', d_cont | replace: '{loja}', d_loja | replace: '{reis}', d_reis | replace: '{retoma}', d_retoma | replace: '{trocas}', d_trocas | replace: '{gravacao}', d_gravacao
      assign id_titulo = 'lnat-hero-t-' | append: block.id
      assign marca = '@@lnh-' | append: block.id | append: '@@'
      assign tem_b2 = false
      if b.botao2_texto != blank or b.botao2_alt_texto != blank
        assign tem_b2 = true
      endif
    -%}
    {%- capture html_bloco -%}
      <div class="lnat-hero__fase" data-fase="{{ b.fase }}" data-bloco="{{ block.id }}"{{ f_attr }}{% unless b_ligado %} data-ligado="0"{% endunless %} {{ block.shopify_attributes }}{{ marca }}>
        {%- if b.eyebrow != blank -%}<p class="lnat-hero__eb"><span aria-hidden="true"></span>{{ b.eyebrow }}</p>{%- endif -%}
        <{{ tag_titulo }} class="lnat-hero__titulo" id="{{ id_titulo }}">{{ b.titulo }}</{{ tag_titulo }}>
        {%- if texto != blank -%}<p class="lnat-hero__texto">{{ texto }}</p>{%- endif -%}
        {%- if chip != blank -%}
          <p class="lnat-hero__chip"{% if tem_contagem %} data-lnat-cd hidden{% endif %}>{%- render 'lod-natal-icon', nome: 'sapatinho', tamanho: 20, traco: 2 -%}<span>{{ chip }}</span></p>
        {%- endif -%}
        {%- if b.botao1_texto != blank or tem_b2 -%}
          <div class="lnat-hero__btns">
            {%- if b.botao1_texto != blank -%}
              {%- liquid
                assign url1 = b.botao1_url | default: '#siga-a-estrela'
                if b.botao1_whatsapp
                  assign msg = b.mensagem_whatsapp | url_encode
                  assign url1 = 'https://wa.me/' | append: wa | append: '?text=' | append: msg
                endif
              -%}
              <a class="lnat-hero__btn lnat-hero__btn--ouro" href="{{ url1 }}"{% if b.botao1_whatsapp %} target="_blank" rel="noopener"{% endif %}>
                {%- if b.botao1_whatsapp -%}{%- render 'lod-natal-icon', nome: 'whatsapp', tamanho: 18 -%}{%- endif -%}
                <span>{{ b.botao1_texto }}</span>{%- render 'lod-natal-icon', nome: 'seta', tamanho: 18 -%}
              </a>
            {%- endif -%}
            {%- if b.botao2_texto != blank -%}
              <a class="lnat-hero__btn lnat-hero__btn--vidro" href="{{ b.botao2_url | default: '#prazos' }}"{% if b.botao2_alt_texto != blank %} data-lnat-alt-par{% if a_ok %} hidden{% endif %}{% endif %}><span>{{ b.botao2_texto }}</span></a>
            {%- endif -%}
            {%- if b.botao2_alt_texto != blank -%}
              <a class="lnat-hero__btn lnat-hero__btn--vidro" href="{{ b.botao2_alt_url | default: '#prazos' }}" data-lnat-alt{{ a_attr }}{% unless a_ok %} hidden{% endunless %}><span>{{ b.botao2_alt_texto }}</span></a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endcapture -%}
    {%- assign html_fases = html_fases | append: html_bloco -%}
  {%- endfor -%}
  {%- liquid
    # Nenhum bloco serve (editor antes de 1 dez., ou datas mal postas): fica o primeiro bloco ligado
    if id_mostrado == blank
      assign id_mostrado = id_primeiro
    endif
    assign fase_mostrada = lnat_fase
    for block in section.blocks
      assign marca = '@@lnh-' | append: block.id | append: '@@'
      if block.id == id_mostrado
        assign html_fases = html_fases | remove: marca
        assign fase_mostrada = block.settings.fase
      else
        assign html_fases = html_fases | replace: marca, ' hidden'
      endif
    endfor
  -%}
<section
  class="lnat lnat-hero lnat-hero--{{ esquema }} lnat-hero--cartao-{{ section.settings.lado_cartao }}{% unless section.settings.mostrar_no_telemovel %} lnat-hero--sem-tel{% endunless %}"
  id="lnat-hero-{{ section.id }}"
  data-fase-servidor="{{ lnat_fase }}"
  {%- if id_mostrado != blank %} aria-labelledby="lnat-hero-t-{{ id_mostrado }}"{% endif %}
  style="--lnat-hero-x: {{ section.settings.foco_x }}%; --lnat-hero-y: {{ section.settings.foco_y }}%; --lnat-hero-yt: {{ section.settings.foco_y_tablet }}%; --lnat-hero-ct: {{ section.settings.corte_tablet }}; --lnat-hero-ym: {{ section.settings.foco_y_tel }}%;"
>
  {%- if request.design_mode and lnat_fase == 'antes' -%}
    <p class="lnat-hero__aviso-editor">Pré-visualização no editor: no site esta secção aparece a partir de {% render 'lod-natal-data', valor: v_inicio, formato: 'curto' %}. Fase simulada: {{ fase_mostrada }}.</p>
  {%- endif -%}

  <div class="lnat-hero__palco">
    {%- if img_d -%}
      <div class="lnat-hero__desfoque" aria-hidden="true">
        {{ img_d | image_url: width: 480 | image_tag: loading: 'eager', alt: '', class: 'lnat-hero__desfoque-img' }}
      </div>
      <div class="lnat-hero__foto">
        <picture>
          {%- if img_m -%}
            <source media="(max-width: 749px)" srcset="{{ img_m | image_url: width: 560 }} 560w, {{ img_m | image_url: width: 750 }} 750w, {{ img_m | image_url: width: 1000 }} 1000w" sizes="100vw">
          {%- endif -%}
          {{ img_d | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '960, 1200, 1500, 1800', sizes: '(min-width: 750px) 70vw, 100vw', alt: section.settings.alt, class: 'lnat-hero__foto-img' }}
        </picture>
      </div>
    {%- else -%}
      <div class="lnat-hero__foto lnat-hero__foto--vazia lnat-azulejo-escuro">
        {%- render 'lod-natal-icon', nome: 'estrela', tamanho: 220, traco: 0.8 -%}
      </div>
    {%- endif -%}
    <div class="lnat-hero__veu" aria-hidden="true"></div>

    <div class="lnat-hero__interior">
      <div class="lnat-hero__cartao">
        {%- if section.settings.mostrar_estrela -%}
          <span class="lnat-hero__estrela">{%- render 'lod-natal-icon', nome: 'estrela', tamanho: 52, traco: 1.4 -%}</span>
        {%- endif -%}

        {{ html_fases }}

        {%- if section.settings.assinatura != blank -%}
          <p class="lnat-hero__assinatura"><span aria-hidden="true">◇</span>{{ section.settings.assinatura }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.marca_lateral != blank -%}
      <div class="lnat-hero__lateral" aria-hidden="true">{{ section.settings.marca_lateral }}</div>
    {%- endif -%}
  </div>

  {%- assign linhas = section.settings.faixa | newline_to_br | split: '<br />' -%}
  {%- if section.settings.faixa != blank -%}
    <div class="lnat-hero__faixa">
      <ul class="lnat-hero__faixa-lista" role="list">
        {%- for l in linhas -%}
          {%- assign l2 = l | strip -%}
          {%- if l2 != blank -%}<li>{{ l2 }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

<style>
  .lnat-hero{--hero-h:clamp(600px,46vw,860px);--foto-w:min(calc(var(--hero-h) * 1.51),100%);background:var(--lnat-verde-2);color:var(--lnat-papel);overflow:hidden;isolation:isolate}
  .lnat-hero__aviso-editor{margin:0;padding:8px 16px;background:#fff3cd;color:#3d2f00;font-size:13px}
  .lnat-hero__palco{position:relative;min-height:var(--hero-h)}
  .lnat-hero__desfoque{position:absolute;inset:0;overflow:hidden;z-index:0}
  .lnat-hero__desfoque-img{width:100%;height:100%;object-fit:cover;object-position:var(--lnat-hero-x) var(--lnat-hero-y);filter:blur(34px) saturate(.75) brightness(.7);transform:scale(1.18)}
  .lnat-hero__foto{position:absolute;top:0;bottom:0;left:0;width:var(--foto-w);z-index:1}
  .lnat-hero__foto picture,.lnat-hero__foto-img{display:block;width:100%;height:100%}
  .lnat-hero__foto-img{object-fit:cover;object-position:var(--lnat-hero-x) var(--lnat-hero-y);transform:scale(1.005);transition:transform 8s cubic-bezier(.2,.65,.25,1)}
  .lnat-hero--foto-esquerda .lnat-hero__foto{-webkit-mask-image:linear-gradient(90deg,#000 0,#000 86%,transparent 100%);mask-image:linear-gradient(90deg,#000 0,#000 86%,transparent 100%)}
  .lnat-hero--foto-esquerda.lnat-hero--cartao-esquerda .lnat-hero__foto{left:auto;right:0;-webkit-mask-image:linear-gradient(270deg,#000 0,#000 86%,transparent 100%);mask-image:linear-gradient(270deg,#000 0,#000 86%,transparent 100%)}
  .lnat-hero--foto-inteira .lnat-hero__foto{width:100%}
  .lnat-hero--foto-inteira .lnat-hero__desfoque{display:none}
  .lnat-hero__foto--vazia{display:flex;align-items:center;justify-content:center;color:var(--lnat-ouro);background-color:var(--lnat-verde)}
  @media (hover:hover){.lnat-hero:hover .lnat-hero__foto-img{transform:scale(1.03)}}
  /* Véu: só no tablet e no telemóvel, para a foto acabar no verde. O base.css do tema esconde div:empty, daí .lnat-hero antes. */
  .lnat-hero .lnat-hero__veu{display:none;position:absolute;top:0;left:0;width:100%;z-index:2;pointer-events:none}
  .lnat-hero__interior{position:relative;z-index:3;width:min(92%,1600px);min-height:var(--hero-h);margin:0 auto;display:flex;align-items:center;justify-content:flex-end;padding:40px 0}
  .lnat-hero--cartao-esquerda .lnat-hero__interior{justify-content:flex-start}
  .lnat-hero__cartao{position:relative;width:clamp(440px,34vw,520px);padding:clamp(28px,2.6vw,40px);border-radius:28px;background:linear-gradient(160deg,rgba(16,50,38,.80) 0%,rgba(16,50,38,.68) 50%,rgba(12,39,29,.58) 100%);border:1px solid rgba(229,201,142,.24);box-shadow:0 24px 64px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,255,255,.06);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px)}
  .lnat-hero__estrela{position:absolute;top:clamp(22px,2.2vw,32px);right:clamp(22px,2.2vw,32px);display:block;color:var(--lnat-ouro);opacity:.95}
  .lnat-hero__estrela svg{width:44px;height:44px}
  .lnat-hero__eb{display:inline-flex;align-items:center;gap:14px;margin:0 0 16px;font:600 11.5px/1.2 var(--lnat-sans);letter-spacing:.24em;text-transform:uppercase;color:var(--lnat-ouro-claro)}
  .lnat-hero__eb span{display:block;flex:0 0 auto;width:38px;height:1px;background:linear-gradient(90deg,var(--lnat-ouro-velho),var(--lnat-ouro-claro))}
  .lnat-hero__titulo{margin:0;font-family:var(--lnat-serif);font-style:italic;font-weight:500;font-size:clamp(40px,3.7vw,64px);line-height:1.03;letter-spacing:-.01em;color:#fff;text-wrap:balance;text-shadow:0 8px 24px rgba(0,0,0,.15)}
  .lnat-hero__texto{margin:20px 0 0;max-width:440px;font-size:clamp(15.5px,1.1vw,17.5px);line-height:1.62;font-weight:400;color:rgba(255,253,250,.88)}
  .lnat-hero__chip{display:flex;align-items:flex-start;gap:10px;margin:22px 0 0;padding:11px 14px;background:var(--lnat-vermelho);box-shadow:inset 0 0 0 1px rgba(229,201,142,.32);border-radius:12px;color:var(--lnat-papel);font-size:14.5px;line-height:21px}
  .lnat-hero__chip>span{text-wrap:pretty}
  .lnat-hero__chip svg{color:var(--lnat-ouro-claro);margin-top:1px}
  .lnat-hero__chip b,.lnat-hero__chip strong{font-weight:600;color:#fff}
  .lnat-hero__falta{font-family:var(--lnat-cond);font-size:16px;letter-spacing:.04em;font-variant-numeric:tabular-nums;color:var(--lnat-ouro-claro);white-space:nowrap}
  .lnat-hero__btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
  .lnat-hero__btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:54px;padding:0 22px;border-radius:999px;font:600 12px/1 var(--lnat-sans);letter-spacing:.16em;text-transform:uppercase;text-decoration:none!important;transition:transform .35s ease,background .35s ease,border-color .35s ease,color .35s ease}
  .lnat-hero__btn svg{transition:transform .35s ease}
  .lnat-hero__btn:hover{transform:translateY(-2px)}
  .lnat-hero__btn:hover svg:last-child{transform:translateX(4px)}
  .lnat-hero__btn--ouro{background:linear-gradient(135deg,#d4a45f 0%,#b98747 100%);color:var(--lnat-tinta)!important;border:1px solid #d4a45f;box-shadow:0 12px 30px rgba(0,0,0,.18)}
  .lnat-hero__btn--vidro{border:1px solid rgba(229,201,142,.55);background:linear-gradient(135deg,rgba(197,154,87,.16),rgba(197,154,87,.06));color:#fff!important;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
  .lnat-hero__btn--vidro:hover{background:rgba(229,201,142,.18)}
  .lnat-hero__btn:focus-visible{outline:2px solid var(--lnat-ouro-claro);outline-offset:3px}
  .lnat-hero__assinatura{display:flex;align-items:center;gap:9px;margin:22px 0 0;font:500 11px/1.2 var(--lnat-sans);letter-spacing:.16em;text-transform:uppercase;color:rgba(255,253,250,.7)}
  .lnat-hero__assinatura span{color:var(--lnat-ouro-claro);font-size:15px}
