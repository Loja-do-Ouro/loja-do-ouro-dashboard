  }
  @media (prefers-reduced-motion:reduce){.lnat-hero__foto-img{transition:none;transform:none!important}}
</style>

<script>
(function(){
  var raiz = document.getElementById('lnat-hero-{{ section.id }}');
  if (!raiz || raiz._lnatHero) return;
  var N = window.LOD_NATAL;
  if (!N) return;
  var editor = {{ request.design_mode | json }};
  var ATIVAS = ['ouro', 'incenso', 'ultima', 'consoada', 'mirra'];
  var st = raiz._lnatHero = { escolhido: null };
  var fases = Array.prototype.slice.call(raiz.querySelectorAll('.lnat-hero__fase'));

  // Mesma regra da barra: «a partir de» um prazo = depois do minuto do prazo; «até» um início = até ao minuto antes.
  function dentro(el){
    var t = N.agora().getTime(), de = el.getAttribute('data-de'), ate = el.getAttribute('data-ate'), a, b;
    if (de && (a = N.lx(de)) && t < a.getTime() + (el.hasAttribute('data-de-depois') ? 60000 : 0)) return false;
    if (ate && (b = N.lx(ate)) && t >= b.getTime() + (el.hasAttribute('data-ate-antes') ? 0 : 60000)) return false;
    return true;
  }
  // Contagem no formato da barra: «2 d 14 h» com dias, «14 h 30 min» no último dia.
  function un(v, c, l1, l2){
    return v + '<span aria-hidden="true"> ' + c + '</span><span class="lnat-sr"> ' + (v === 1 ? l1 : l2) + '</span>';
  }
  function duracao(f){
    return f.d > 0 ? un(f.d, 'd', 'dia', 'dias') + ' ' + un(f.h, 'h', 'hora', 'horas') : un(f.h, 'h', 'hora', 'horas') + ' ' + un(f.m, 'min', 'minuto', 'minutos');
  }

  function atualizar(){
    var fase = N.fase();
    var ativa = ATIVAS.indexOf(fase) > -1;
    if (!editor) {
      raiz.hidden = !ativa;
      if (!ativa) return;
    }
    var alvo = st.escolhido;
    if (!alvo) fases.forEach(function(el){
      if (!alvo && el.getAttribute('data-ligado') !== '0' && el.getAttribute('data-fase') === fase && dentro(el)) alvo = el;
    });
    if (alvo) {
      fases.forEach(function(el){ el.hidden = el !== alvo; });
      var t = alvo.querySelector('.lnat-hero__titulo');
      if (t && t.id) raiz.setAttribute('aria-labelledby', t.id);
    }
    raiz.querySelectorAll('[data-lnat-alt]').forEach(function(a){
      var ok = dentro(a);
      a.hidden = !ok;
      var par = a.parentNode.querySelector('[data-lnat-alt-par]');
      if (par) par.hidden = ok;
    });
    raiz.querySelectorAll('[data-lnat-falta]').forEach(function(el){
      var chip = el.closest('[data-lnat-cd]');
      var data = N.d[el.getAttribute('data-lnat-falta')];
      var f = data ? N.falta(data) : null;
      if (!f || f.ms <= 0) { if (chip) chip.hidden = true; return; }
      var h = duracao(f);
      if (el._h !== h) { el.innerHTML = h; el._h = h; }
      if (chip) chip.hidden = false;
    });
  }

  st.atualizar = atualizar;
  st.parar = function(){ clearInterval(st.t); };
  st.escolher = function(id){
    st.escolhido = null;
    if (id) fases.forEach(function(el){ if (el.getAttribute('data-bloco') === id) st.escolhido = el; });
    atualizar();
  };
  atualizar();
  st.t = setInterval(atualizar, 30000);

  // Ouvintes globais só uma vez (o editor volta a correr este script sempre que redesenha a secção)
  var html = document.documentElement;
  if (html.hasAttribute('data-lnat-hero-js')) return;
  html.setAttribute('data-lnat-hero-js', '');
  function daSecao(e){ return document.getElementById('lnat-hero-' + (e.detail && e.detail.sectionId)); }
  document.addEventListener('shopify:section:unload', function(e){ var r = daSecao(e); if (r && r._lnatHero) r._lnatHero.parar(); });
  document.addEventListener('shopify:block:select', function(e){ var r = daSecao(e); if (r && r._lnatHero) r._lnatHero.escolher(e.detail.blockId); });
  document.addEventListener('shopify:block:deselect', function(e){ var r = daSecao(e); if (r && r._lnatHero) r._lnatHero.escolher(null); });
  document.addEventListener('visibilitychange', function(){
    if (document.hidden) return;
    document.querySelectorAll('.lnat-hero').forEach(function(r){ if (r._lnatHero) r._lnatHero.atualizar(); });
  });
})();
</script>
{%- endif -%}

