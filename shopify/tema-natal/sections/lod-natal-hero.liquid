    .lnat-hero__foto-img{object-position:center var(--lnat-hero-ym);transform:none!important}
    .lnat-hero .lnat-hero__veu{display:block;height:auto;aspect-ratio:4/5;background:linear-gradient(180deg,rgba(12,39,29,0) 0%,rgba(12,39,29,0) 62%,rgba(12,39,29,.55) 88%,var(--lnat-verde-2) 100%)}
    .lnat-hero__interior{width:100%;min-height:0;padding:0 10px 14px;margin-top:-96px;display:block}
