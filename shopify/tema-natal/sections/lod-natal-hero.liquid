<script>
(function(){
  var raiz = document.getElementById('lnat-hero-{{ section.id }}');
  if (!raiz || raiz._lnatHero) return;
  var N = window.LOD_NATAL;
  if (!N) return;
  var editor = {{ request.design_mode | json }};
  // Fases em que a secção aparece, por versão da campanha (pt Portugal, es Espanha, int Internacional)
  var ATIVAS = { pt: ['ouro', 'incenso', 'ultima', 'consoada', 'mirra'], es: ['navidad', 'reyes', 'reyes_ultima', 'noche_reyes'], int: ['navidad'] };
  var versao = ATIVAS[N.versao] ? N.versao : (raiz.getAttribute('data-versao') || 'pt');
  var T = N.t || {};
  var st = raiz._lnatHero = { escolhido: null };
  var fases = Array.prototype.slice.call(raiz.querySelectorAll('.lnat-hero__fase'));

  // Mesma regra da barra: «a partir de» um prazo = depois do minuto do prazo; «até» um início = até ao minuto antes.
  function dentro(el){
    var t = N.agora().getTime(), de = el.getAttribute('data-de'), ate = el.getAttribute('data-ate'), a, b;
    if (de && (a = N.lx(de)) && t < a.getTime() + (el.hasAttribute('data-de-depois') ? 60000 : 0)) return false;
    if (ate && (b = N.lx(ate)) && t >= b.getTime() + (el.hasAttribute('data-ate-antes') ? 0 : 60000)) return false;
    return true;
  }
  function doMercado(el){
    var m = el.getAttribute('data-mercado') || 'todos';
    return m === 'todos' || m === versao;
  }
  // Textos fixos do dicionário (snippets/lod-natal-t), com o português como reserva
  function tx(k, pt){ return T[k] || pt; }
  function esc(s){
    return String(s).replace(/[&<>"]/g, function(c){ return c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : '&quot;'; });
  }
  // Contagem no formato da barra: «2 d 14 h» com dias, «14 h 30 min» no último dia; por extenso para leitores de ecrã.
  function un(v, c, l1, l2){
    return v + '<span aria-hidden="true"> ' + esc(c) + '</span><span class="lnat-sr"> ' + esc(v === 1 ? l1 : l2) + '</span>';
  }
  function duracao(f){
    var d = un(f.d, tx('un_d', 'd'), tx('dia_1', 'dia'), tx('dia_n', 'dias'));
    var h = un(f.h, tx('un_h', 'h'), tx('hora_1', 'hora'), tx('hora_n', 'horas'));
    var m = un(f.m, tx('un_min', 'min'), tx('minuto_1', 'minuto'), tx('minuto_n', 'minutos'));
    return f.d > 0 ? d + ' ' + h : h + ' ' + m;
  }

  function atualizar(){
    var fase = N.fase(versao);
    var ativa = (ATIVAS[versao] || []).indexOf(fase) > -1;
    if (!editor) {
      raiz.hidden = !ativa;
      if (!ativa) return;
    }
    var alvo = st.escolhido;
    if (!alvo) fases.forEach(function(el){
      if (!alvo && el.getAttribute('data-ligado') !== '0' && doMercado(el) && el.getAttribute('data-fase') === fase && dentro(el)) alvo = el;
    });
    if (alvo) {
      fases.forEach(function(el){ el.hidden = el !== alvo; });
      var t = alvo.querySelector('.lnat-hero__titulo');
      if (t && t.id) raiz.setAttribute('aria-labelledby', t.id);
    }
    raiz.querySelectorAll('[data-lnat-alt]').forEach(function(a){
      var ok = dentro(a);
      a.hidden = !ok;
      var par = a.parentNode.querySelector('[data-lnat-alt-par]');
      if (par) par.hidden = ok;
    });
    raiz.querySelectorAll('[data-lnat-falta]').forEach(function(el){
      var chip = el.closest('[data-lnat-cd]');
      var data = N.d[el.getAttribute('data-lnat-falta')];
      var f = data ? N.falta(data) : null;
      if (!f || f.ms <= 0) { if (chip) chip.hidden = true; return; }
      var h = duracao(f);
      if (el._h !== h) { el.innerHTML = h; el._h = h; }
      if (chip) chip.hidden = false;
    });
  }

  st.atualizar = atualizar;
  st.parar = function(){ clearInterval(st.t); };
  st.escolher = function(id){
    st.escolhido = null;
    if (id) fases.forEach(function(el){ if (el.getAttribute('data-bloco') === id) st.escolhido = el; });
    atualizar();
  };
  atualizar();
  st.t = setInterval(atualizar, 30000);

  // Ouvintes globais só uma vez (o editor volta a correr este script sempre que redesenha a secção)
  var html = document.documentElement;
  if (html.hasAttribute('data-lnat-hero-js')) return;
  html.setAttribute('data-lnat-hero-js', '');
  function daSecao(e){ return document.getElementById('lnat-hero-' + (e.detail && e.detail.sectionId)); }
  document.addEventListener('shopify:section:unload', function(e){ var r = daSecao(e); if (r && r._lnatHero) r._lnatHero.parar(); });
  document.addEventListener('shopify:block:select', function(e){ var r = daSecao(e); if (r && r._lnatHero) r._lnatHero.escolher(e.detail.blockId); });
  document.addEventListener('shopify:block:deselect', function(e){ var r = daSecao(e); if (r && r._lnatHero) r._lnatHero.escolher(null); });
  document.addEventListener('visibilitychange', function(){
    if (document.hidden) return;
    document.querySelectorAll('.lnat-hero').forEach(function(r){ if (r._lnatHero) r._lnatHero.atualizar(); });
  });
})();
</script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Natal · Banner principal",
  "tag": "div",
  "class": "lnat-hero-secao",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Fotografia" },
    { "type": "image_picker", "id": "imagem", "label": "Imagem (computador)" },
    { "type": "image_picker", "id": "imagem_telemovel", "label": "Imagem (telemóvel)", "info": "Vertical. Se ficar vazia, usa a do computador." },
    { "type": "text", "id": "alt", "label": "Descrição da imagem (acessibilidade)", "default": "Três mulheres de diferentes gerações, de fato creme, com joias em ouro, junto a uma árvore de Natal." },
    {
      "type": "select", "id": "esquema", "label": "Esquema",
      "options": [
        { "value": "foto-esquerda", "label": "Foto ao lado do cartão (não tapa as pessoas)" },
        { "value": "foto-inteira", "label": "Foto a toda a largura, cartão por cima" }
      ],
      "default": "foto-esquerda"
    },
    {
      "type": "select", "id": "lado_cartao", "label": "Lado do cartão",
      "options": [ { "value": "direita", "label": "Direita" }, { "value": "esquerda", "label": "Esquerda" } ],
      "default": "direita"
    },
