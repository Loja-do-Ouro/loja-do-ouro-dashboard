      if (p > 1) u += '&page=' + p;
      if (preview) u += '&preview_theme_id=' + encodeURIComponent(preview);
      return u;
    }
    function lerPagina(html) {
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var caixa = doc.querySelector('[data-lnat-grelha]');
      if (!caixa) return { itens: [], paginas: 1 };
      var cartoes = caixa.querySelectorAll('.lnat-card');
      var itens = [];
      for (var i = 0; i < cartoes.length; i++) {
        var a = cartoes[i];
        itens.push({
          el: a,
          url: (a.getAttribute('href') || '').split('?')[0],
          preco: parseInt(a.getAttribute('data-preco'), 10) || 0,
          metal: a.getAttribute('data-metal') || 'outro',
          disp: a.getAttribute('data-disponivel') === 'true'
