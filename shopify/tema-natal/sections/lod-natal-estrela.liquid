    function sugerir(base, baseAlt, s) {
      var vistos = {}, u1 = [], u2 = [], html = '';
      base.forEach(function (it) { if (it.url && !vistos[it.url]) { vistos[it.url] = 1; u1.push(it); } });
      (baseAlt || []).forEach(function (it) { if (it.url && !vistos[it.url]) { vistos[it.url] = 1; u2.push(it); } });
      function contaEm(l, metal, valor) {
