{%- comment -%}
  Natal 2026 · Ouro de Reis — «Siga a estrela», guia de prendas da página inicial.
  Três escolhas (para quem · ouro ou prata · quanto) e mostra as peças certas, com prazo de entrega.
  · Os blocos «Para quem» dizem que coleção usar (principal + alternativa quando a principal dá menos de 4 peças).
  · As peças vêm da secção lod-natal-estrela-grelha pela Section Rendering API (mais vendidos, 48 por página,
    no máximo 3 páginas por coleção) e são filtradas no navegador por metal, preço e disponibilidade.
  · Só começa a pedir peças quando a secção se aproxima do ecrã (IntersectionObserver).
  · As escolhas ficam no endereço: #siga-a-estrela?para=ela&metal=ouro&valor=100-250 (sem dados pessoais).
  · Sem JavaScript, as escolhas «Para quem» são ligações para as coleções.
  · Estado inicial (definição estado_inicial): por omissão o painel de resultados só abre depois da primeira
    escolha «Para quem», para não repetir as peças de «Os mais oferecidos», que vem a seguir.
  · «Ouro» ou «Prata» ficam desativados («Sem peças») quando a escolha não tem peças disponíveis nesse metal.
  · No telemóvel, depois da primeira escolha, uma barra fixa «Ver N prendas» leva aos resultados
    (fica acima do botão de chat; distância ao fundo na definição barra_fundo).

  Línguas e mercados (contrato: scratchpad/natal/i18n-contrato.md)
  · Textos fixos: dicionário snippets/lod-natal-t (Liquid) e window.LOD_NATAL.t (JavaScript), mais o dicionário
    local desta secção (lnat_tl_pt, lnat_tl_en, lnat_tl_es: chaves estx_*), que vai para o JavaScript em data-tl.
  · Conteúdo editável: campo base em português e campos _en e _es (vazios usam o campo base).
  · Versão pelo mercado (lod-natal-fase, mercado auto):
      pt   fases ouro, incenso, ultima, consoada, mirra; prazos de Portugal, levantamento em loja e WhatsApp.
      es   fases navidad, reyes, reyes_ultima, noche_reyes; prazos de Espanha (Navidad e Reyes), sem lojas nem WhatsApp.
      int  fase navidad (até ao prazo internacional); prazo internacional, sem lojas nem WhatsApp.
    Nas outras fases não mostra nada (no editor mostra, com uma nota).
  · Faixas de preço: em euros; com outra moeda (Internacional com moedas locais) os limites são convertidos
    pela taxa da loja e arredondados, e os rótulos passam a essa moeda.
  · O vale-prenda só é sugerido quando ainda chega a tempo por correio ou quando natal_vale_digital está ligado;
    fora de Portugal, só com a definição vale_fora_portugal ligada.
{%- endcomment -%}
{%- liquid
  capture lnat_versao
    render 'lod-natal-fase', mercado: 'auto', devolve: 'versao'
  endcapture
  assign lnat_versao = lnat_versao | strip
  capture lnat_fase
    render 'lod-natal-fase', mercado: 'auto'
  endcapture
  assign lnat_fase = lnat_fase | strip
  assign est_escondida = true
  case lnat_versao
    when 'pt'
      case lnat_fase
        when 'ouro', 'incenso', 'ultima', 'consoada', 'mirra'
          assign est_escondida = false
      endcase
    when 'es'
      case lnat_fase
        when 'navidad', 'reyes', 'reyes_ultima', 'noche_reyes'
          assign est_escondida = false
      endcase
    else
      if lnat_fase == 'navidad'
        assign est_escondida = false
      endif
  endcase
-%}
{%- if est_escondida == false or request.design_mode -%}
{%- capture lnat_lg -%}{%- render 'lod-natal-t', k: '_lingua' -%}{%- endcapture -%}
{%- capture lnat_tl_pt -%}
~~estx_es_ate=Para chegar a tempo, encomende até:
~~estx_v_ate=Até {1}
~~estx_v_entre={1} a {2}
~~estx_v_mais=Mais de {1}
~~estx_f_ate=até {1}
~~estx_f_entre=de {1} a {2}
~~estx_f_mais=acima de {1}
{%- endcapture -%}
{%- capture lnat_tl_en -%}
~~estx_es_ate=To arrive in time, order by:
~~estx_v_ate=Up to {1}
~~estx_v_entre={1} to {2}
~~estx_v_mais=Over {1}
~~estx_f_ate=up to {1}
~~estx_f_entre={1} to {2}
~~estx_f_mais=over {1}
{%- endcapture -%}
{%- capture lnat_tl_es -%}
~~estx_es_ate=Para que llegue a tiempo, haga su pedido hasta el:
~~estx_v_ate=Hasta {1}
~~estx_v_entre=De {1} a {2}
~~estx_v_mais=Más de {1}
~~estx_f_ate=hasta {1}
~~estx_f_entre=de {1} a {2}
~~estx_f_mais=de más de {1}
{%- endcapture -%}
{%- liquid
  assign lnat_lg = lnat_lg | strip
  case lnat_lg
    when 'pt'
      assign lnat_tl = lnat_tl_pt
    when 'es'
      assign lnat_tl = lnat_tl_es
    else
      assign lnat_tl = lnat_tl_en
  endcase
  assign est_sfx = ''
  if lnat_lg != 'pt'
    assign est_sfx = '_' | append: lnat_lg
  endif

  assign est_id = section.id
  assign est_ancora = section.settings.ancora | default: 'siga-a-estrela' | handleize
  assign est_titulo_id = 'lnat-est-t-' | append: est_id
  assign est_res_id = 'lnat-est-r-' | append: est_id
  assign est_wa = settings.natal_whatsapp | default: '351910067687' | remove: ' ' | remove: '+'
  assign est_vale_url = routes.collections_url | append: '/voucher-prenda'
  if section.settings.colecao_vale != blank
    assign est_vale_url = section.settings.colecao_vale.url
  endif
  assign est_inicial = section.settings.estado_inicial | default: 'fechado'
  assign est_fundo = section.settings.barra_fundo | default: 148

  assign est_eyebrow = section.settings.eyebrow
  assign est_titulo = section.settings.titulo
  assign est_texto = section.settings.texto
  assign est_ajuda = section.settings.ajuda
  assign est_ajuda_link = section.settings.ajuda_link
  assign est_ajuda_msg = section.settings.ajuda_mensagem
  assign est_titulo_res = section.settings.titulo_resultados
  if est_sfx != ''
    assign k = 'eyebrow' | append: est_sfx
    if section.settings[k] != blank
      assign est_eyebrow = section.settings[k]
    endif
    assign k = 'titulo' | append: est_sfx
    if section.settings[k] != blank
      assign est_titulo = section.settings[k]
    endif
    assign k = 'texto' | append: est_sfx
    if section.settings[k] != blank
      assign est_texto = section.settings[k]
    endif
    assign k = 'ajuda' | append: est_sfx
    if section.settings[k] != blank
      assign est_ajuda = section.settings[k]
    endif
    assign k = 'ajuda_link' | append: est_sfx
    if section.settings[k] != blank
      assign est_ajuda_link = section.settings[k]
    endif
    assign k = 'ajuda_mensagem' | append: est_sfx
    if section.settings[k] != blank
      assign est_ajuda_msg = section.settings[k]
    endif
    assign k = 'titulo_resultados' | append: est_sfx
    if section.settings[k] != blank
      assign est_titulo_res = section.settings[k]
    endif
  endif

  assign est_html_d = ''
  assign est_html_o = ''
  assign est_html_links = ''
  assign est_marcado = false
  assign est_todas = ''
-%}
{%- if est_titulo == blank -%}{%- capture est_titulo -%}{%- render 'lod-natal-t', k: 'est_titulo' -%}{%- endcapture -%}{%- endif -%}
{%- if est_titulo_res == blank -%}{%- capture est_titulo_res -%}{%- render 'lod-natal-t', k: 'est_titulo_res' -%}{%- endcapture -%}{%- endif -%}
{%- capture t_marco_1 -%}{%- render 'lod-natal-t', k: 'est_marco_1' -%}{%- endcapture -%}
{%- capture t_marco_2 -%}{%- render 'lod-natal-t', k: 'est_marco_2' -%}{%- endcapture -%}
{%- capture t_marco_3 -%}{%- render 'lod-natal-t', k: 'est_marco_3' -%}{%- endcapture -%}
{%- capture t_p1 -%}{%- render 'lod-natal-t', k: 'est_p1' -%}{%- endcapture -%}
{%- capture t_p2 -%}{%- render 'lod-natal-t', k: 'est_p2' -%}{%- endcapture -%}
{%- capture t_p3 -%}{%- render 'lod-natal-t', k: 'est_p3' -%}{%- endcapture -%}
{%- capture t_ouro -%}{%- render 'lod-natal-t', k: 'ouro' -%}{%- endcapture -%}
{%- capture t_prata -%}{%- render 'lod-natal-t', k: 'prata' -%}{%- endcapture -%}
{%- capture t_sem_pecas -%}{%- render 'lod-natal-t', k: 'sem_pecas' -%}{%- endcapture -%}
{%- capture t_tanto_faz -%}{%- render 'lod-natal-t', k: 'tanto_faz' -%}{%- endcapture -%}
{%- capture t_nao_aplica -%}{%- render 'lod-natal-t', k: 'nao_aplica' -%}{%- endcapture -%}
{%- capture t_v_ate_50 -%}{%- render 'lod-natal-t', k: 'valor_ate_50' -%}{%- endcapture -%}
{%- capture t_v_50_100 -%}{%- render 'lod-natal-t', k: 'valor_50_100' -%}{%- endcapture -%}
{%- capture t_v_100_250 -%}{%- render 'lod-natal-t', k: 'valor_100_250' -%}{%- endcapture -%}
{%- capture t_v_250_500 -%}{%- render 'lod-natal-t', k: 'valor_250_500' -%}{%- endcapture -%}
{%- capture t_v_mais_500 -%}{%- render 'lod-natal-t', k: 'valor_mais_500' -%}{%- endcapture -%}
{%- capture t_v_qualquer -%}{%- render 'lod-natal-t', k: 'valor_qualquer' -%}{%- endcapture -%}
{%- capture t_escolha -%}{%- render 'lod-natal-t', k: 'est_escolha_passo1' -%}{%- endcapture -%}
{%- capture t_ver_mais -%}{%- render 'lod-natal-t', k: 'ver_mais_colecao' -%}{%- endcapture -%}
{%- capture t_recomecar -%}{%- render 'lod-natal-t', k: 'recomecar' -%}{%- endcapture -%}
{%- capture t_ver_vales -%}{%- render 'lod-natal-t', k: 'ver_vales' -%}{%- endcapture -%}
{%- capture t_tentar -%}{%- render 'lod-natal-t', k: 'tentar_novo' -%}{%- endcapture -%}
{%- capture t_mostrar_mais -%}{%- render 'lod-natal-t', k: 'mostrar_mais' -%}{%- endcapture -%}
{%- for block in section.blocks -%}
  {%- liquid
    assign est_c1 = block.settings.colecao
    assign est_c2 = block.settings.alternativa
    if est_c1 == blank
      assign est_c1 = est_c2
      assign est_c2 = nil
    endif
  -%}
  {%- if est_c1 != blank -%}
    {%- liquid
      assign est_chave = block.settings.chave | default: block.id | handleize
      assign est_rotulo = block.settings.label
      assign est_resumo = block.settings.resumo
      assign est_desc = block.settings.descricao
      assign est_aviso = block.settings.aviso
      if est_sfx != ''
        assign k = 'label' | append: est_sfx
        assign est_rotulo_l = block.settings[k]
        assign k = 'resumo' | append: est_sfx
        assign est_resumo_l = block.settings[k]
        if est_rotulo_l != blank
          assign est_rotulo = est_rotulo_l
        endif
        if est_resumo_l != blank
          assign est_resumo = est_resumo_l
        elsif est_rotulo_l != blank
          assign est_resumo = est_rotulo_l | downcase
        endif
        assign k = 'descricao' | append: est_sfx
        if block.settings[k] != blank
          assign est_desc = block.settings[k]
        endif
        assign k = 'aviso' | append: est_sfx
        if block.settings[k] != blank
          assign est_aviso = block.settings[k]
        endif
      endif
      if est_rotulo == blank
        assign est_rotulo = est_c1.title
      endif
      if est_resumo == blank
        assign est_resumo = est_rotulo | downcase
      endif
      assign est_pag1 = est_c1.products_count | plus: 47 | divided_by: 48
      assign est_pag2 = 0
      assign est_url2 = ''
      if est_c2 != blank
        assign est_pag2 = est_c2.products_count | plus: 47 | divided_by: 48
        assign est_url2 = est_c2.url
      endif
      assign est_marcar = false
      if est_marcado == false
        assign est_marcado = true
        assign est_todas = est_c1.url
        if est_inicial == 'primeira'
          assign est_marcar = true
        endif
      endif
    -%}
    {%- capture est_chip -%}
      <label class="lnat-est__op{% if block.settings.destaque %} lnat-est__op--destaque{% endif %}" {{ block.shopify_attributes }}>
        <input class="lnat-est__radio" type="radio" name="lnat-est-{{ est_id }}-para" value="{{ est_chave }}" data-grupo="para" data-bloco="{{ block.id }}" data-url="{{ est_c1.url }}" data-pag="{{ est_pag1 }}" data-alt="{{ est_url2 }}" data-alt-pag="{{ est_pag2 }}" data-resumo="{{ est_resumo | escape }}" data-aviso="{{ est_aviso | escape }}"{% if block.settings.saltar_metal %} data-saltar-metal{% endif %}{% if est_marcar %} data-inicial checked{% endif %}>
        <span class="lnat-est__chip"><span class="lnat-est__chip-nome">{{ est_rotulo | escape }}</span>{%- if est_desc != blank -%}<span class="lnat-est__chip-desc">{{ est_desc | escape }}</span>{%- endif -%}</span>
      </label>
    {%- endcapture -%}
    {%- capture est_link -%}
      <li class="lnat-est__op{% if block.settings.destaque %} lnat-est__op--destaque{% endif %}"><a class="lnat-est__chip" href="{{ est_c1.url }}?sort_by=best-selling"><span class="lnat-est__chip-nome">{{ est_rotulo | escape }}</span></a></li>
    {%- endcapture -%}
    {%- liquid
      if block.settings.destaque
        assign est_html_d = est_html_d | append: est_chip
      else
        assign est_html_o = est_html_o | append: est_chip
      endif
      assign est_html_links = est_html_links | append: est_link
    -%}
  {%- endif -%}
{%- endfor -%}

<section class="lnat lnat-est lnat-sec lnat-bg-tinta lnat-azulejo-escuro{% unless section.settings.mostrar_no_telemovel %} lnat-est--sem-tel{% endunless %}" id="{{ est_ancora }}" aria-labelledby="{{ est_titulo_id }}" data-passo="1" data-versao="{{ lnat_versao }}"{% if lnat_versao == 'pt' %} data-wa="{{ est_wa }}"{% endif %} data-vale="{{ est_vale_url }}" data-vale-digital="{{ settings.natal_vale_digital }}" data-vale-fora="{{ section.settings.vale_fora_portugal }}" data-inicial="{{ est_inicial | escape }}" data-fundo="{{ est_fundo }}" data-tl="{{ lnat_tl | escape }}" style="--lnat-est-fundo:{{ est_fundo }}px">
  {%- if est_escondida -%}
    <p class="lnat-est__editor">
      {%- case lnat_fase -%}
        {%- when 'off' -%}Natal desligado nas definições do tema. Esta secção não aparece na loja.
        {%- when 'fim' -%}
          {%- if lnat_versao == 'int' -%}A versão internacional do Natal terminou no prazo dos envios internacionais. Neste mercado, esta secção já não aparece na loja.
          {%- else -%}A campanha de Natal terminou. Esta secção já não aparece na loja.
          {%- endif -%}
        {%- else -%}
          {%- capture est_inicio -%}{%- render 'lod-natal-data', valor: settings.natal_inicio, formato: 'curto', lingua: 'pt' -%}{%- endcapture -%}
          Visível a partir de {{ est_inicio | strip | default: '1 de dezembro' }}. Por agora só aparece aqui no editor.
      {%- endcase -%}
    </p>
  {%- endif -%}
  <div class="lnat-wrap">

    <div class="lnat-est__trilho" aria-hidden="true">
      <div class="lnat-est__ceu">
        <svg class="lnat-est__curva" viewBox="0 0 1000 100" preserveAspectRatio="none" focusable="false"><path d="M0 75C40 66 70 55 100 55C230 55 350 88 500 62C650 36 770 48 900 48C940 48 975 40 1000 32" vector-effect="non-scaling-stroke"/></svg>
        <span class="lnat-est__marco lnat-est__marco--1" style="--x:10%;--y:55%"><span class="lnat-est__marco-txt">I<span class="lnat-est__marco-nome"> · {{ t_marco_1 }}</span></span></span>
        <span class="lnat-est__marco lnat-est__marco--2" style="--x:50%;--y:62%"><span class="lnat-est__marco-txt">II<span class="lnat-est__marco-nome"> · {{ t_marco_2 }}</span></span></span>
        <span class="lnat-est__marco lnat-est__marco--3" style="--x:90%;--y:48%"><span class="lnat-est__marco-txt">III<span class="lnat-est__marco-nome"> · {{ t_marco_3 }}</span></span></span>
        <span class="lnat-est__viajante"><span class="lnat-est__viajante-y"><span class="lnat-est__astro">{%- render 'lod-natal-icon', nome: 'estrela', tamanho: 40 -%}</span></span></span>
      </div>
    </div>

    <div class="lnat-est__topo">
      <div class="lnat-est__cabecalho">
        {%- if est_eyebrow != blank -%}<p class="lnat-eb">{{ est_eyebrow | escape }}</p>{%- endif -%}
        <h2 class="lnat-h2" id="{{ est_titulo_id }}">{{ est_titulo | escape }}</h2>
        {%- if est_texto != blank -%}<p class="lnat-lead lnat-est__lead">{{ est_texto | escape }}</p>{%- endif -%}
        {%- if lnat_versao == 'pt' and est_ajuda_link != blank -%}
          {%- if est_ajuda_msg == blank -%}{%- capture est_ajuda_msg -%}{%- render 'lod-natal-t', k: 'wa_ajuda' -%}{%- endcapture -%}{%- endif -%}
          {%- capture t_janela -%}{%- render 'lod-natal-t', k: 'abre_janela' -%}{%- endcapture -%}
          {%- assign est_wa_msg = est_ajuda_msg | url_encode | replace: '+', '%20' -%}
          <p class="lnat-est__ajuda">{{ est_ajuda | escape }} <a class="lnat-link" href="https://wa.me/{{ est_wa }}?text={{ est_wa_msg }}" target="_blank" rel="noopener">{%- render 'lod-natal-icon', nome: 'whatsapp', tamanho: 16 -%}{{ est_ajuda_link | escape }}<span class="lnat-sr"> {{ t_janela }}</span></a>.</p>
        {%- endif -%}
      </div>

      <div class="lnat-est__passos lnat-est__js" data-est-form>
        <fieldset class="lnat-est__passo" data-est-passo="1">
          <legend class="lnat-est__leg"><span class="lnat-est__num" aria-hidden="true">I</span>{{ t_p1 }}</legend>
          {%- if est_html_d != '' -%}<div class="lnat-est__ops lnat-est__ops--destaque">{{ est_html_d }}</div>{%- endif -%}
          {%- if est_html_o != '' -%}<div class="lnat-est__ops lnat-est__ops--outros">{{ est_html_o }}</div>{%- endif -%}
          {%- if est_html_d == '' and est_html_o == '' and request.design_mode -%}
            <p class="lnat-est__nota">Acrescente blocos «Para quem» e escolha a coleção de cada um.</p>
          {%- endif -%}
        </fieldset>

        <fieldset class="lnat-est__passo" data-est-passo="2">
          <legend class="lnat-est__leg"><span class="lnat-est__num" aria-hidden="true">II</span>{{ t_p2 }}</legend>
          <div class="lnat-est__ops lnat-est__ops--3">
            <label class="lnat-est__op"><input class="lnat-est__radio" type="radio" name="lnat-est-{{ est_id }}-metal" value="ouro" data-grupo="metal"><span class="lnat-est__chip"><span class="lnat-est__chip-nome">{{ t_ouro }}</span><span class="lnat-est__chip-desc lnat-est__sem">{{ t_sem_pecas }}</span></span></label>
            <label class="lnat-est__op"><input class="lnat-est__radio" type="radio" name="lnat-est-{{ est_id }}-metal" value="prata" data-grupo="metal"><span class="lnat-est__chip"><span class="lnat-est__chip-nome">{{ t_prata }}</span><span class="lnat-est__chip-desc lnat-est__sem">{{ t_sem_pecas }}</span></span></label>
            <label class="lnat-est__op"><input class="lnat-est__radio" type="radio" name="lnat-est-{{ est_id }}-metal" value="tanto-faz" data-grupo="metal" data-inicial checked><span class="lnat-est__chip">{{ t_tanto_faz }}</span></label>
          </div>
          <p class="lnat-est__nota" data-est-nota-metal hidden>{{ t_nao_aplica }}</p>
        </fieldset>

        <fieldset class="lnat-est__passo" data-est-passo="3">
          <legend class="lnat-est__leg"><span class="lnat-est__num" aria-hidden="true">III</span>{{ t_p3 }}</legend>
          <div class="lnat-est__ops lnat-est__ops--3">
            <label class="lnat-est__op"><input class="lnat-est__radio" type="radio" name="lnat-est-{{ est_id }}-valor" value="ate-50" data-grupo="valor"><span class="lnat-est__chip">{{ t_v_ate_50 }}</span></label>
            <label class="lnat-est__op"><input class="lnat-est__radio" type="radio" name="lnat-est-{{ est_id }}-valor" value="50-100" data-grupo="valor"><span class="lnat-est__chip">{{ t_v_50_100 }}</span></label>
            <label class="lnat-est__op"><input class="lnat-est__radio" type="radio" name="lnat-est-{{ est_id }}-valor" value="100-250" data-grupo="valor"><span class="lnat-est__chip">{{ t_v_100_250 }}</span></label>
            <label class="lnat-est__op"><input class="lnat-est__radio" type="radio" name="lnat-est-{{ est_id }}-valor" value="250-500" data-grupo="valor"><span class="lnat-est__chip">{{ t_v_250_500 }}</span></label>
            <label class="lnat-est__op"><input class="lnat-est__radio" type="radio" name="lnat-est-{{ est_id }}-valor" value="mais-500" data-grupo="valor"><span class="lnat-est__chip">{{ t_v_mais_500 }}</span></label>
            <label class="lnat-est__op"><input class="lnat-est__radio" type="radio" name="lnat-est-{{ est_id }}-valor" value="qualquer" data-grupo="valor" data-inicial checked><span class="lnat-est__chip">{{ t_v_qualquer }}</span></label>
          </div>
        </fieldset>
      </div>

      <div class="lnat-est__nojs">
        <p class="lnat-est__leg"><span class="lnat-est__num" aria-hidden="true">I</span>{{ t_p1 }}</p>
        <ul class="lnat-est__ops lnat-est__ops--links">{{ est_html_links }}</ul>
      </div>

      {%- if section.settings.barra_telemovel -%}
        <div class="lnat-est__fixa lnat-est__js" data-est-fixa data-modo="para">
          <button type="button" class="lnat-est__fixa-btn" data-est-fixa-btn>
            <span class="lnat-est__fixa-txt"><span class="lnat-est__fixa-tit" data-est-fixa-tit>{{ t_p1 }}</span><span class="lnat-est__fixa-sub" data-est-fixa-sub>{{ t_escolha }}</span></span>
            <span class="lnat-est__fixa-ico" aria-hidden="true">{%- render 'lod-natal-icon', nome: 'seta', tamanho: 20 -%}</span>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="lnat-est__painel lnat-est__js" data-est-painel role="region" aria-labelledby="{{ est_res_id }}" aria-busy="true"{% if est_inicial != 'primeira' %} hidden{% endif %}>
      <span class="lnat-est__pousa" aria-hidden="true">{%- render 'lod-natal-icon', nome: 'estrela', tamanho: 32 -%}</span>
      <div class="lnat-est__res-cab">
        <h3 class="lnat-est__res-titulo" id="{{ est_res_id }}" tabindex="-1">{{ est_titulo_res | escape }}</h3>
        <p class="lnat-est__estado" data-est-estado role="status" aria-live="polite"></p>
        <p class="lnat-est__aviso" data-est-aviso hidden></p>
      </div>
      <div class="lnat-est__acoes">
        <a class="lnat-btn lnat-btn--tinta" data-est-todas href="{{ est_todas }}?sort_by=best-selling">{{ t_ver_mais }}</a>
        <button type="button" class="lnat-btn lnat-btn--contorno" data-est-recomecar>{{ t_recomecar }}</button>
      </div>
      <div class="lnat-est__grelha" data-est-grelha>
        {%- for i in (1..8) -%}<span class="lnat-est__esq" aria-hidden="true"><span></span><span></span><span></span></span>{%- endfor -%}
      </div>
      <div class="lnat-est__vazio" data-est-vazio hidden>
        <div class="lnat-est__sugestoes" data-est-sugestoes></div>
        <div class="lnat-btns" data-est-vale hidden><a class="lnat-btn lnat-btn--tinta" href="{{ est_vale_url }}">{{ t_ver_vales }}</a></div>
      </div>
      <div class="lnat-est__vazio" data-est-erro hidden>
        <div class="lnat-btns">
          <button type="button" class="lnat-btn lnat-btn--tinta" data-est-tentar>{{ t_tentar }}</button>
          <a class="lnat-btn lnat-btn--contorno" data-est-vale href="{{ est_vale_url }}" hidden>{{ t_ver_vales }}</a>
        </div>
      </div>
      <div class="lnat-est__mais" hidden>
        <button type="button" class="lnat-btn lnat-btn--contorno" data-est-mais>{{ t_mostrar_mais }}</button>
      </div>
      <div class="lnat-est__entrega" data-est-entrega hidden></div>
    </div>

  </div>
</section>

<style>
  .lnat-est{scroll-margin-top:72px;overflow:hidden}
  .lnat-est__editor{margin:-24px 0 24px;padding:10px 16px;background:var(--lnat-vermelho);color:var(--lnat-papel);font-size:14px;line-height:20px;text-align:center}

  /* Faixa com a estrela que viaja entre I, II e III */
  .lnat-est__trilho{position:relative;height:96px;margin:-12px 0 20px}
  .lnat-est__ceu{position:absolute;left:0;right:0;top:0;height:64px}
  .lnat-est__curva{position:absolute;left:0;top:0;width:100%;height:100%;overflow:visible;color:var(--lnat-ouro)}
  .lnat-est__curva path{fill:none;stroke:currentColor;stroke-width:1.5;opacity:.75}
  .lnat-est__marco{position:absolute;left:var(--x);top:var(--y);width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;border:1.5px solid var(--lnat-ouro);background:var(--lnat-tinta);transition:background .5s,opacity .3s}
  .lnat-est__marco-txt{position:absolute;left:50%;top:34px;transform:translateX(-50%);white-space:nowrap;font:500 12px/16px var(--lnat-sans);letter-spacing:.08em;color:var(--lnat-cinza-noite);transition:color .3s}
  .lnat-est__marco-nome{display:none}
  .lnat-est[data-passo="1"] .lnat-est__marco--1 .lnat-est__marco-txt,
  .lnat-est[data-passo="2"] .lnat-est__marco--2 .lnat-est__marco-txt,
  .lnat-est[data-passo="3"] .lnat-est__marco--3 .lnat-est__marco-txt{color:var(--lnat-ouro-claro)}
  .lnat-est[data-passo="2"] .lnat-est__marco--1,
  .lnat-est[data-passo="3"] .lnat-est__marco--1,
  .lnat-est[data-passo="3"] .lnat-est__marco--2{background:var(--lnat-ouro)}
  .lnat-est.is-sem-metal .lnat-est__marco--2{opacity:.35}
  .lnat-est__viajante,.lnat-est__viajante-y{position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none}
  .lnat-est__viajante{transform:translateX(10%);transition:transform .9s cubic-bezier(.65,0,.35,1)}
  .lnat-est__viajante-y{transform:translateY(55%);transition:transform .9s cubic-bezier(.3,0,.45,1)}
  .lnat-est[data-passo="2"] .lnat-est__viajante{transform:translateX(50%)}
  .lnat-est[data-passo="2"] .lnat-est__viajante-y{transform:translateY(62%)}
  .lnat-est[data-passo="3"] .lnat-est__viajante{transform:translateX(90%)}
  .lnat-est[data-passo="3"] .lnat-est__viajante-y{transform:translateY(48%)}
  .lnat-est__astro{position:absolute;left:0;top:0;width:44px;height:44px;margin:-22px 0 0 -22px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--lnat-tinta);color:var(--lnat-ouro-claro);filter:drop-shadow(0 0 10px rgba(229,201,142,.45));transition:transform .9s cubic-bezier(.65,0,.35,1)}
  .lnat-est__astro .lnat-ico{width:34px;height:34px}
  .lnat-est[data-passo="2"] .lnat-est__astro{transform:rotate(90deg)}
  .lnat-est[data-passo="3"] .lnat-est__astro{transform:rotate(180deg)}

  /* Cabeçalho e passos */
  .lnat-est__topo{display:grid;grid-template-columns:minmax(0,1fr);gap:32px}
  .lnat-est__cabecalho{display:flex;flex-direction:column;gap:14px;align-items:flex-start}
  .lnat-est__lead{color:var(--lnat-papel);opacity:.9}
  .lnat-est__ajuda{margin:4px 0 0;font-size:14px;line-height:22px;color:var(--lnat-cinza-noite)}
  .lnat-est__ajuda .lnat-ico{margin:-3px 6px 0 0}
  .lnat-est__passos{display:flex;flex-direction:column;gap:28px;min-width:0}
  .lnat-est__passo{border:0;margin:0;padding:0;min-width:0;scroll-margin-top:88px}
  .lnat-est__leg{display:block;width:100%;float:none;padding:0;margin:0 0 12px;font:500 15px/22px var(--lnat-sans);color:var(--lnat-ouro-claro)}
  .lnat-est__num{display:inline-block;min-width:22px;margin-right:8px;font-family:var(--lnat-serif);font-style:italic;font-weight:500;font-size:20px;color:var(--lnat-ouro)}
  .lnat-est__nota{margin:8px 0 0;font-size:13px;line-height:20px;color:var(--lnat-cinza-noite)}
  .lnat-est__ops{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:0;padding:0;list-style:none}
  .lnat-est__ops--destaque{margin-bottom:8px}
  .lnat-est__ops--3{grid-template-columns:repeat(3,minmax(0,1fr))}
  .lnat-est__op{position:relative;display:flex;min-width:0;margin:0}
  .lnat-est__radio{position:absolute;left:0;top:0;width:1px;height:1px;margin:0;opacity:0;pointer-events:none}
  .lnat-est__chip{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;width:100%;min-height:48px;padding:8px 10px;border:1px solid var(--lnat-ouro);background:transparent;color:var(--lnat-papel)!important;font:500 15px/1.25 var(--lnat-sans);text-align:center;text-decoration:none!important;cursor:pointer;-webkit-user-select:none;user-select:none;transition:background .2s,color .2s,border-color .2s}
  .lnat-est__chip:hover{background:rgba(188,145,76,.16)}
  .lnat-est__radio:checked+.lnat-est__chip{background:var(--lnat-ouro);border-color:var(--lnat-ouro);color:var(--lnat-tinta)!important}
  .lnat-est__radio:focus-visible+.lnat-est__chip{outline:2px solid var(--lnat-ouro-claro);outline-offset:3px}
  .lnat-est__radio:disabled+.lnat-est__chip{cursor:not-allowed}
  .lnat-est__passo[disabled] .lnat-est__ops{opacity:.35}
  .lnat-est__op--destaque .lnat-est__chip{min-height:76px;padding:12px}
  .lnat-est__op--destaque .lnat-est__chip-nome{font-family:var(--lnat-serif);font-style:italic;font-weight:500;font-size:28px;line-height:1.05}
  .lnat-est__chip-desc{font-size:11px;line-height:15px;letter-spacing:.08em;text-transform:uppercase;color:var(--lnat-ouro-claro)}
  .lnat-est__radio:checked+.lnat-est__chip .lnat-est__chip-desc{color:var(--lnat-tinta);opacity:.8}
  /* Metal sem peças para a escolha feita */
  .lnat-est__sem{display:none}
  .lnat-est__op.is-sem-pecas .lnat-est__sem{display:block}
  .lnat-est__op.is-sem-pecas .lnat-est__chip{opacity:.45;border-style:dashed}
  .lnat-est__op.is-sem-pecas .lnat-est__chip:hover{background:transparent}

  /* Sem JavaScript: só as ligações do passo I */
  .lnat-est__nojs{display:block;min-width:0}
  html[data-natal-fase] .lnat-est__nojs,.lnat-est--js .lnat-est__nojs{display:none}
  html:not([data-natal-fase]) .lnat-est:not(.lnat-est--js) .lnat-est__js{display:none}

  /* Painel claro dos resultados */
  .lnat-est__painel{position:relative;display:grid;grid-template-columns:minmax(0,1fr);grid-template-areas:"cab" "grelha" "mais" "acoes" "entrega";gap:20px;margin-top:48px;padding:36px 16px 24px;background:var(--lnat-papel);color:var(--lnat-texto);scroll-margin-top:100px}
  .lnat-est__pousa{position:absolute;left:50%;top:0;width:48px;height:48px;margin:-24px 0 0 -24px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--lnat-tinta);border:1px solid var(--lnat-ouro);color:var(--lnat-ouro-claro)}
  .lnat-est__painel.is-pronto .lnat-est__pousa{animation:lnat-est-pousa .8s cubic-bezier(.3,0,.3,1) both}
  @keyframes lnat-est-pousa{from{opacity:0;transform:translateY(-36px) rotate(-90deg)}to{opacity:1;transform:none}}
  .lnat-est__res-cab{grid-area:cab;min-width:0}
  .lnat-est__res-titulo{margin:0;font-family:var(--lnat-serif);font-style:italic;font-weight:500;font-size:clamp(30px,3vw,40px);line-height:1.1;color:var(--lnat-tinta);outline:0}
  .lnat-est__estado{margin:6px 0 0;min-height:22px;font-size:15px;line-height:22px;color:var(--lnat-cinza-linho)}
  .lnat-est__aviso{margin:12px 0 0;padding:10px 14px;border-left:2px solid var(--lnat-ouro);background:var(--lnat-linho);font-size:13px;line-height:20px;color:var(--lnat-texto)}
  .lnat-est__acoes{grid-area:acoes;display:flex;flex-wrap:wrap;gap:10px}
  .lnat-est__acoes .lnat-btn{flex:1 1 auto}
  .lnat-est__grelha{grid-area:grelha;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 12px;transition:opacity .25s}
  .lnat-est__painel.is-a-carregar .lnat-est__grelha,.lnat-est__painel.is-a-carregar .lnat-est__vazio{opacity:.45;pointer-events:none}
  .lnat-est__painel .lnat-card{color:var(--lnat-texto)!important}
  /* Nomes até 4 linhas («… em Prata Dourada» nunca fica cortado) e preços alinhados no fundo de cada linha */
  .lnat-est__painel .lnat-card__titulo{-webkit-line-clamp:4}
  .lnat-est__painel .lnat-card__preco{margin-top:auto;color:var(--lnat-tinta)}
  .lnat-est__painel a:focus-visible,.lnat-est__painel button:focus-visible{outline-color:var(--lnat-ouro-velho)}
  .lnat-est__painel .lnat-peq{color:var(--lnat-cinza)}
  .lnat-est__painel .lnat-link{color:var(--lnat-ouro-velho)!important}
  .lnat-est__esq{display:flex;flex-direction:column;gap:8px}
  .lnat-est__esq span{display:block;height:14px;background:linear-gradient(90deg,var(--lnat-linho) 0%,#efe4cf 50%,var(--lnat-linho) 100%);background-size:200% 100%;animation:lnat-est-brilho 1.4s linear infinite}
  .lnat-est__esq span:first-child{height:auto;aspect-ratio:1/1}
  .lnat-est__esq span:last-child{width:40%}
  @keyframes lnat-est-brilho{from{background-position:100% 0}to{background-position:-100% 0}}
  .lnat-est__vazio{grid-area:grelha;display:flex;flex-direction:column;gap:16px;align-items:flex-start}
  .lnat-est__sugestoes:empty{display:none}
  .lnat-est__sugestoes p{margin:0 0 10px;font-size:14px;line-height:20px}
  .lnat-est__sugs{display:flex;flex-wrap:wrap;gap:8px}
  .lnat-est__sug{min-height:44px;padding:0 14px;border:1px solid var(--lnat-linha);background:transparent;color:var(--lnat-texto);font:500 14px/1.2 var(--lnat-sans);cursor:pointer;transition:border-color .2s,background .2s}
  .lnat-est__sug:hover{border-color:var(--lnat-ouro-velho);background:var(--lnat-linho)}
  .lnat-est__sug span{color:var(--lnat-cinza);font-weight:400}
  .lnat-est__mais{grid-area:mais;display:flex;justify-content:center}
  .lnat-est__mais .lnat-btn{width:100%}
  .lnat-est__entrega{grid-area:entrega;padding-top:20px;border-top:1px solid var(--lnat-linha);font-size:14px;line-height:22px}
  .lnat-est__entrega p{margin:0 0 8px}
  .lnat-est__entrega b{font-weight:600;color:var(--lnat-tinta)}
  .lnat-est__regioes{list-style:none;margin:0 0 6px;padding:0}
  .lnat-est__entrega .lnat-est__ind{margin:0 0 14px}
  .lnat-est__regioes li{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:8px 0;border-bottom:1px dotted var(--lnat-linha)}
  .lnat-est__regioes li b{font-family:var(--lnat-cond);font-weight:400;font-size:15px;letter-spacing:.02em;color:var(--lnat-ouro-velho);text-align:right}
  .lnat-est__ent-ko{padding:8px 12px;background:var(--lnat-linho);border-left:2px solid var(--lnat-vermelho)}

  /* Barra fixa «Ver N prendas» (só no telemóvel; acima do botão de chat, que está a 84 px do fundo e tem 56 px) */
  .lnat-est__fixa{display:none}
  .lnat-est__fixa-btn{display:flex;align-items:center;gap:12px;width:100%;min-height:56px;margin:0;padding:8px 8px 8px 16px;border:1px solid var(--lnat-ouro);border-radius:0;background:var(--lnat-papel);color:var(--lnat-tinta);box-shadow:0 6px 18px rgba(0,0,0,.35);font:inherit;text-align:left;cursor:pointer}
  .lnat-est__fixa-txt{display:flex;flex-direction:column;flex:1 1 auto;min-width:0}
  .lnat-est__fixa-tit{font:600 15px/20px var(--lnat-sans);color:var(--lnat-tinta)}
  .lnat-est__fixa-sub{font-size:12px;line-height:16px;color:var(--lnat-cinza);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .lnat-est__fixa-ico{display:flex;flex:0 0 auto;align-items:center;justify-content:center;width:40px;height:40px;background:var(--lnat-tinta);color:var(--lnat-ouro-claro)}
  .lnat-est__fixa-ico .lnat-ico{transform:rotate(90deg)}
  .lnat-est__fixa[data-modo="para"] .lnat-est__fixa-ico .lnat-ico{transform:rotate(-90deg)}
  .lnat-est .lnat-est__fixa-btn:focus-visible{outline:2px solid var(--lnat-ouro-claro);outline-offset:3px}

  @media (min-width:600px){
    .lnat-est__marco-nome{display:inline}
  }
  @media (min-width:750px){
    .lnat-est__op--destaque .lnat-est__chip{min-height:88px}
    .lnat-est__op--destaque .lnat-est__chip-nome{font-size:34px}
    .lnat-est__ops--outros,.lnat-est__ops--links{grid-template-columns:repeat(3,minmax(0,1fr))}
    /* Sem buraco na última linha de 3 colunas */
    .lnat-est__ops--outros .lnat-est__op:last-child:nth-child(3n+2),.lnat-est__ops--links .lnat-est__op:last-child:nth-child(3n+2){grid-column:span 2}
    .lnat-est__ops--outros .lnat-est__op:last-child:nth-child(3n+1),.lnat-est__ops--links .lnat-est__op:last-child:nth-child(3n+1){grid-column:1/-1}
    .lnat-est__chip{min-height:52px}
    .lnat-est__painel{grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"cab acoes" "grelha grelha" "mais mais" "entrega entrega";gap:28px 24px;padding:48px 40px 32px}
    .lnat-est__acoes{align-self:end;justify-content:flex-end}
    .lnat-est__acoes .lnat-btn{flex:0 0 auto}
    .lnat-est__mais .lnat-btn{width:auto;min-width:240px}
    .lnat-est__regioes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
    .lnat-est__regioes li{flex-direction:column;align-items:flex-start;gap:2px;padding:0;border:0}
    .lnat-est__regioes li b{font-size:17px;text-align:left}
  }
  @media (min-width:990px){
    .lnat-est__trilho{height:122px;margin-bottom:28px}
    .lnat-est__ceu{height:84px}
    .lnat-est__astro{width:56px;height:56px;margin:-28px 0 0 -28px}
    .lnat-est__astro .lnat-ico{width:44px;height:44px}
    .lnat-est__marco-txt{top:40px;font-size:13px}
    .lnat-est__topo{grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:48px}
    .lnat-est__grelha{grid-template-columns:repeat(4,minmax(0,1fr));gap:32px 24px}
  }
  @media (max-width:749px){
    .lnat-est--sem-tel{display:none!important}
    /* Sem buraco na última linha de 2 colunas */
    .lnat-est__ops--outros .lnat-est__op:last-child:nth-child(odd),.lnat-est__ops--links .lnat-est__op:last-child:nth-child(odd){grid-column:1/-1}
    /* Preços em 2 colunas: «100 a 250 €» numa só linha */
    .lnat-est__passo[data-est-passo="3"] .lnat-est__ops--3{grid-template-columns:repeat(2,minmax(0,1fr))}
    .lnat-est__fixa{display:block;position:fixed;left:16px;right:16px;bottom:calc(var(--lnat-est-fundo,148px) + env(safe-area-inset-bottom,0px));z-index:3;visibility:hidden;opacity:0;transform:translateY(12px);transition:opacity .25s,transform .25s,visibility 0s linear .25s}
    .lnat-est__fixa.is-visivel{visibility:visible;opacity:1;transform:none;transition:opacity .25s,transform .25s,visibility 0s}
  }
  @media (prefers-reduced-motion:reduce){
    .lnat-est__viajante,.lnat-est__viajante-y,.lnat-est__astro,.lnat-est__marco,.lnat-est__fixa{transition:none!important}
    .lnat-est__painel.is-pronto .lnat-est__pousa,.lnat-est__esq span{animation:none!important}
  }
</style>

<script>
(function () {
  'use strict';
  var RAIZ = document.documentElement;
  /* Faixas de preço: limites em euros; valor «mínimo exclusivo, máximo inclusivo». */
  var VALORES = ['ate-50', '50-100', '100-250', '250-500', 'mais-500'];
  var LIM_EUR = [50, 100, 250, 500];
  var CHAVE_VALOR = { 'ate-50': 'ate_50', '50-100': '50_100', '100-250': '100_250', '250-500': '250_500', 'mais-500': 'mais_500' };
  /* Fases em que a secção aparece, por versão da campanha (contrato, secção 5). */
  var ATIVAS = { pt: ['ouro', 'incenso', 'ultima', 'consoada', 'mirra'], es: ['navidad', 'reyes', 'reyes_ultima', 'noche_reyes'], int: ['navidad'] };
  var POR = 8, MAX_PAGINAS = 3, MINIMO = 4;
  var GRELHA = 'lod-natal-estrela-grelha';

  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  /* Limite convertido para outra moeda: dois algarismos significativos, múltiplos de 5 abaixo de 100 (43 → 45, 215 → 220). */
  function redondo(x) {
    if (!(x > 0)) return 0;
    var p = Math.pow(10, Math.max(0, Math.floor(Math.log(x) / Math.LN10) - 1));
    var r = Math.round(x / p) * p;
    if (r < 100) r = Math.max(5, Math.round(x / 5) * 5);
    return r;
  }

  function init(root) {
    if (!root || root.hasAttribute('data-est-pronto')) return;
    root.setAttribute('data-est-pronto', '');
    root.classList.add('lnat-est--js');

    var N = window.LOD_NATAL || null;
    var design = !!(window.Shopify && window.Shopify.designMode);
    var versao = (N && N.versao) || root.getAttribute('data-versao') || 'pt';
    if (!ATIVAS[versao]) versao = 'int';
    if (N && !design && typeof N.fase === 'function') {
      if (ATIVAS[versao].indexOf(N.fase(versao)) < 0) { root.hidden = true; return; }
    }

    var form = root.querySelector('[data-est-form]');
    var painel = root.querySelector('[data-est-painel]');
    if (!form || !painel) return;
    var grelha = painel.querySelector('[data-est-grelha]');
    var estadoEl = painel.querySelector('[data-est-estado]');
    var avisoEl = painel.querySelector('[data-est-aviso]');
    var vazioEl = painel.querySelector('[data-est-vazio]');
    var sugEl = painel.querySelector('[data-est-sugestoes]');
    var erroEl = painel.querySelector('[data-est-erro]');
    var maisBtn = painel.querySelector('[data-est-mais]');
    var maisWrap = maisBtn.parentNode;
    var todasEl = painel.querySelector('[data-est-todas]');
    var tituloRes = painel.querySelector('.lnat-est__res-titulo');
    var entregaEl = painel.querySelector('[data-est-entrega]');
    var passo2 = form.querySelector('[data-est-passo="2"]');
