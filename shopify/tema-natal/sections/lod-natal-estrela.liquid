      painel.removeAttribute('aria-busy');
      erroEl.hidden = true;
      todasEl.href = r.todas + (r.todas.indexOf('?') > -1 ? '&' : '?') + 'sort_by=best-selling';
      grelha.textContent = '';
      if (!lista.length) {
        grelha.hidden = true;
        maisWrap.hidden = true;
        vazioEl.hidden = false;
        sugerir(r.base, s);
        estadoEl.textContent = 'Não encontrámos peças com estas escolhas. Experimente outro valor ou ofereça um vale-prenda.';
      } else {
        vazioEl.hidden = true;
        grelha.hidden = false;
        pintar(0, mostrar);
        estadoEl.textContent = resumo(lista.length, s, r.completo) + '.';
      }
      entrega();
      painel.classList.add('is-pronto');
      if (origem === 'utilizador' || origem === 'sugestao' || origem === 'hash') publicar(s, lista.length);
    }
    function falhou() {
      painel.classList.remove('is-a-carregar');
      painel.removeAttribute('aria-busy');
      grelha.textContent = '';
      grelha.hidden = true;
      maisWrap.hidden = true;
      vazioEl.hidden = true;
      erroEl.hidden = false;
      estadoEl.textContent = 'Não conseguimos mostrar as peças agora. Tente de novo ou veja a coleção.';
    }

    /* ---------- procura ---------- */
    function correr(origem) {
      var s = estado();
      if (!s) return;
      ui(s);
      if (origem === 'utilizador' || origem === 'sugestao') escreverHash(s);
      if (!ativo || !s.url) return;
      if (ctrlPara !== s.para) {
        if (ctrl) { try { ctrl.abort(); } catch (e) {} }
        ctrl = ('AbortController' in window) ? new AbortController() : null;
        ctrlPara = s.para;
      }
      var meu = ++seq;
      if (!cache[s.url]) aCarregar();
      carregar(s.url, s.pag).then(function (d1) {
        var m1 = filtrar(d1.itens, s);
        if (m1.length >= MINIMO || !s.alt || s.alt === s.url) {
          return { lista: m1, completo: d1.completo, todas: s.url, base: d1.itens };
        }
        if (!cache[s.alt] && meu === seq) aCarregar();
        return carregar(s.alt, s.altPag).then(function (d2) {
          var vistos = {};
          m1.forEach(function (it) { vistos[it.url] = 1; });
          var m2 = filtrar(d2.itens, s).filter(function (it) { return !vistos[it.url]; });
          return { lista: m1.concat(m2), completo: d1.completo && d2.completo, todas: m2.length ? s.alt : s.url, base: d1.itens.concat(d2.itens) };
        }, function (e) {
          if (e && e.name === 'AbortError') throw e;
          return { lista: m1, completo: d1.completo, todas: s.url, base: d1.itens };
        });
      }).then(function (r) {
        if (meu !== seq) return;
        desenhar(r, s, origem);
      }, function (e) {
        if (meu !== seq || (e && e.name === 'AbortError')) return;
        falhou();
      });
    }
    function ativar(origem) {
      if (!ativo) {
        ativo = true;
        if (io) { io.disconnect(); io = null; }
      }
      correr(origem);
    }

    /* ---------- eventos ---------- */
    form.addEventListener('change', function (e) {
      var t = e.target;
      if (!t || !t.hasAttribute || !t.hasAttribute('data-grupo')) return;
      var fs = t.closest('[data-est-passo]');
      if (fs) passo(fs.getAttribute('data-est-passo'));
      ativar('utilizador');
    });
    form.addEventListener('focusin', function (e) {
      var fs = e.target && e.target.closest && e.target.closest('[data-est-passo]');
      if (fs) passo(fs.getAttribute('data-est-passo'));
    });
    maisBtn.addEventListener('click', function () {
      var de = mostrar;
      mostrar += POR;
      var primeiro = pintar(de, mostrar);
      if (primeiro) { try { primeiro.focus({ preventScroll: false }); } catch (e) { primeiro.focus(); } }
    });
    painel.querySelector('[data-est-recomecar]').addEventListener('click', function () {
      var ini = form.querySelectorAll('[data-inicial]');
      for (var i = 0; i < ini.length; i++) ini[i].checked = true;
      passo(1);
      limparHash();
      ativar('recomecar');
      var p = marcado('para');
      if (p) { try { p.focus({ preventScroll: true }); } catch (e) {} }
      try { root.scrollIntoView({ behavior: 'auto', block: 'start' }); } catch (e) {}
    });
    painel.querySelector('[data-est-tentar]').addEventListener('click', function () { ativar('utilizador'); });
    sugEl.addEventListener('click', function (e) {
      var b = e.target && e.target.closest && e.target.closest('[data-sug]');
      if (!b) return;
      var g = b.getAttribute('data-sug-grupo');
      if (!marcar(g, b.getAttribute('data-sug'))) return;
      passo(g === 'valor' ? 3 : 2);
      ativar('sugestao');
      try { tituloRes.focus({ preventScroll: true }); } catch (err) {}
    });

    root._lnatEst = {
      hash: function () { if (lerHash()) { ativar('hash'); rolar(); } },
      bloco: function (el) {
        var inp = el && el.querySelector && el.querySelector('[data-grupo="para"]');
        if (!inp) return;
        inp.checked = true;
        passo(1);
        ativar('editor');
      },
      parar: function () {
        if (ctrl) { try { ctrl.abort(); } catch (e) {} }
        if (io) { io.disconnect(); io = null; }
      }
    };

    ui(estado());
    if (!design && lerHash()) {
      ativar('hash');
      rolar();
    } else if ('IntersectionObserver' in window) {
      io = new IntersectionObserver(function (en) {
        for (var i = 0; i < en.length; i++) if (en[i].isIntersecting) { ativar('auto'); break; }
      }, { rootMargin: '300px 0px' });
      io.observe(root);
    } else {
      ativar('auto');
    }
  }

  function todos() { [].forEach.call(document.querySelectorAll('.lnat-est'), init); }
  function daSecao(e) { return e && e.target && e.target.querySelector ? e.target.querySelector('.lnat-est') : null; }

  if (!RAIZ.hasAttribute('data-lnat-est')) {
    RAIZ.setAttribute('data-lnat-est', '');
    document.addEventListener('shopify:section:load', function (e) { init(daSecao(e)); });
    document.addEventListener('shopify:section:unload', function (e) { var r = daSecao(e); if (r && r._lnatEst) r._lnatEst.parar(); });
    document.addEventListener('shopify:block:select', function (e) {
      var r = e.target && e.target.closest ? e.target.closest('.lnat-est') : null;
      if (r && r._lnatEst) r._lnatEst.bloco(e.target);
    });
    window.addEventListener('hashchange', function () {
      [].forEach.call(document.querySelectorAll('.lnat-est'), function (r) { if (r._lnatEst) r._lnatEst.hash(); });
    });
  }
  todos();
})();
</script>
{%- endif -%}

