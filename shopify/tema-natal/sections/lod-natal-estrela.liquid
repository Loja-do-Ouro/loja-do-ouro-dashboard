    }
    function paragrafo(html) { return '<p>' + html + '</p>'; }
    function caixaKo(txt) { return '<p class="lnat-est__ent-ko">' + esc(txt) + '</p>'; }
    function dataB(v, f) { return '<b>' + esc(data(v, f)) + '</b>'; }
    /* linhas: [[rótulo, data], …] → lista com as datas (só o dia, sem hora) e a nota dos prazos indicativos */
    function linhas(l, nota) {
      var h = '<ul class="lnat-est__regioes">';
      l.forEach(function (r) { h += '<li><span>' + esc(r[0]) + '</span>' + dataB(r[1], 'longo') + '</li>'; });
      return h + '</ul><p class="lnat-peq lnat-est__ind">' + esc(nota) + '</p>';
