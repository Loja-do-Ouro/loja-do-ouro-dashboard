      var cartoes = caixa.querySelectorAll('.lnat-card');
      var itens = [];
      for (var i = 0; i < cartoes.length; i++) {
        var a = cartoes[i];
        itens.push({
          el: a,
          url: (a.getAttribute('href') || '').split('?')[0],
          preco: parseInt(a.getAttribute('data-preco'), 10) || 0,
          metal: a.getAttribute('data-metal') || 'outro',
          disp: a.getAttribute('data-disponivel') === 'true'
        });
      }
      return { itens: itens, paginas: parseInt(caixa.getAttribute('data-paginas'), 10) || 1 };
    }
    function pedir(base, p, sinal) {
      return fetch(urlPagina(base, p), { signal: sinal, credentials: 'same-origin', headers: { Accept: 'text/html' } })
        .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
        .then(lerPagina);
    }
    function carregar(base, dica) {
      if (cache[base]) return Promise.resolve(cache[base]);
      var atual = emCurso[base];
      /* reaproveita o mesmo pedido (ou a pré-carga, que não se cancela) */
      if (atual && (atual.ctrl === ctrl || !atual.ctrl)) return atual.pr;
      var meuCtrl = ctrl, sinal = meuCtrl ? meuCtrl.signal : undefined;
      var n = Math.max(1, Math.min(MAX_PAGINAS, dica || 1));
      var lote = [];
      for (var i = 1; i <= n; i++) lote.push(pedir(base, i, sinal));
      var pr = Promise.all(lote).then(function (res) {
        var total = res[0].paginas, extra = [];
        for (var j = n + 1; j <= Math.min(MAX_PAGINAS, total); j++) extra.push(pedir(base, j, sinal));
        return Promise.all(extra).then(function (mais) { return { res: res.concat(mais), total: total }; });
      }).then(function (o) {
        var vistos = {}, itens = [];
        o.res.forEach(function (r) {
          r.itens.forEach(function (it) {
            if (it.url && vistos[it.url]) return;
            vistos[it.url] = 1;
            itens.push(it);
          });
        });
        var dados = { itens: itens, completo: o.res.length >= o.total };
        cache[base] = dados;
        return dados;
      });
      var entrada = { pr: pr, ctrl: meuCtrl };
      emCurso[base] = entrada;
      function fim() { if (emCurso[base] === entrada) delete emCurso[base]; }
      pr.then(fim, fim);
      return pr;
    }

    /* ---------- filtro ---------- */
    function passa(it, metal, valor, saltar) {
      if (!it.disp || it.preco <= 0) return false;
      if (!saltar && metal !== 'tanto-faz' && it.metal !== metal) return false;
      var f = FAIXAS[valor];
      if (f && !(it.preco > f[0] * taxa && it.preco <= f[1] * taxa)) return false;
      return true;
    }
    function filtrar(itens, s) {
      var r = [];
      for (var i = 0; i < itens.length; i++) if (passa(itens[i], s.metal, s.valor, s.saltar)) r.push(itens[i]);
      return r;
    }

    /* ---------- desenho ---------- */
    function aCarregar() {
      painel.setAttribute('aria-busy', 'true');
      if (painel.classList.contains('is-pronto')) painel.classList.add('is-a-carregar');
    }
    function pintar(de, ate) {
      var frag = document.createDocumentFragment(), primeiro = null;
      lista.slice(de, ate).forEach(function (it) {
        var n = document.importNode(it.el, true);
        if (!primeiro) primeiro = n;
        frag.appendChild(n);
      });
      grelha.appendChild(frag);
      maisWrap.hidden = lista.length <= ate;
      return primeiro;
    }
    function resumo(n, s, completo) {
      var cauda = frase(s);
      if (completo) return n + (n === 1 ? ' prenda ' : ' prendas ') + cauda;
      return (n === 1 ? 'A prenda mais vendida ' : 'As ' + n + ' prendas mais vendidas ') + cauda;
    }
    /* Conta como correr(): só a principal quando dá 4 ou mais peças; senão, principal + alternativa
       (sem repetir peças). Assim o número do botão é o que aparece depois do clique. */
    function sugerir(base, baseAlt, s) {
      var vistos = {}, u1 = [], u2 = [], html = '';
      base.forEach(function (it) { if (it.url && !vistos[it.url]) { vistos[it.url] = 1; u1.push(it); } });
      (baseAlt || []).forEach(function (it) { if (it.url && !vistos[it.url]) { vistos[it.url] = 1; u2.push(it); } });
      function contaEm(l, metal, valor) {
        var c = 0;
        for (var i = 0; i < l.length; i++) if (passa(l[i], metal, valor, s.saltar)) c++;
        return c;
      }
      function conta(metal, valor) {
        var c1 = contaEm(u1, metal, valor);
        return (c1 >= MINIMO || !baseAlt) ? c1 : c1 + contaEm(u2, metal, valor);
      }
      function botao(g, v, txt, n) {
        return '<button type="button" class="lnat-est__sug" data-sug-grupo="' + g + '" data-sug="' + esc(v) + '">' + esc(txt) + ' <span>· ' + n + (n === 1 ? ' peça' : ' peças') + '</span></button>';
      }
      var vals = grupo('valor');
      for (var i = 0; i < vals.length; i++) {
        var k = vals[i].value;
        if (k === s.valor || k === 'qualquer') continue;
        var n = conta(s.metal, k);
        if (n) html += botao('valor', k, rotulo(vals[i]), n);
      }
      if (!html && !s.saltar && s.metal !== 'tanto-faz') {
        var n2 = conta('tanto-faz', s.valor);
        var tf = form.querySelector('[data-grupo="metal"][value="tanto-faz"]');
        if (n2 && tf) html = botao('metal', 'tanto-faz', rotulo(tf), n2);
      }
      sugEl.innerHTML = html ? '<p>Experimente:</p><div class="lnat-est__sugs">' + html + '</div>' : '';
      return !!html;
    }
    /* «Ver mais na coleção»: a coleção de onde vêm as peças, com o preço escolhido.
       O metal não vai no endereço: os filtros da loja não têm o tipo de produto. */
    function urlTodas(base, s) {
      var u = base + (base.indexOf('?') > -1 ? '&' : '?') + 'sort_by=best-selling';
      var f = FAIXAS[s.valor];
      if (f) {
        if (f[0] > 0) u += '&filter.v.price.gte=' + Math.floor(f[0] * taxa / 100);
        if (isFinite(f[1])) u += '&filter.v.price.lte=' + Math.ceil(f[1] * taxa / 100);
      }
      return u;
    }
    /* Os vales-prenda são físicos e seguem por correio: só se sugerem quando ainda chegam a tempo
       (ou quando natal_vale_digital estiver ligado). */
    function valeOk() {
      if (valeDigital) return true;
      var L = window.LOD_NATAL;
      if (!L || !L.d || typeof L.passou !== 'function' || typeof L.fase !== 'function') return true;
      var f = L.fase();
      if (f === 'consoada' || f === 'mirra') return !L.passou(L.d.reis);
      if (f === 'ultima' || f === 'fim') return false;
      return !L.passou(L.d.continente);
    }
    function vales() {
      var ok = valeOk();
      for (var i = 0; i < valeEls.length; i++) valeEls[i].hidden = !ok;
    }
    function waLink(msg) {
      if (!wa) return '';
      var u = 'https://wa.me/' + encodeURIComponent(wa) + '?text=' + encodeURIComponent(msg);
      return ' <a class="lnat-link" href="' + esc(u) + '" target="_blank" rel="noopener">Marcar por WhatsApp<span class="lnat-sr"> (abre noutra janela)</span></a>';
    }
    function entrega() {
      var L = window.LOD_NATAL;
      if (!entregaEl) return;
      if (!L || !L.d || typeof L.passou !== 'function' || typeof L.fase !== 'function') { entregaEl.hidden = true; return; }
      var D = L.d, f = L.fase(), h = '';
      /* Vale-prenda só quando é entregue por email: os vales físicos seguem por correio e também já não chegam. */
      var vale = valeDigital ? '<p>Ou ofereça um <a class="lnat-link" href="' + esc(valeUrl) + '">vale-prenda</a>, entregue por email.</p>' : '';
      var reis = '<p>Para chegar até ao Dia de Reis, encomende até <b>' + esc(dataLonga(D.reis)) + '</b> · Portugal continental (prazo indicativo).</p>';
      if (f === 'mirra' || f === 'fim') {
        h += !L.passou(D.reis) ? reis : '<p class="lnat-est__ent-ko">Já não chega a tempo do Dia de Reis por correio.</p><p>Pode levantar a prenda numa das nossas lojas, com marcação.' + waLink('Olá! Gostava de levantar uma prenda numa das vossas lojas.') + '</p>' + vale;
      } else if (f === 'consoada') {
        h += '<p>As encomendas feitas nestes dias seguem a partir de <b>' + esc(dataLonga(D.retoma)) + '</b>.</p>';
        if (!L.passou(D.reis)) h += reis;
      } else {
        var R = [['Portugal continental', 'Portugal continental', D.continente], ['Madeira', 'a Madeira', D.madeira], ['Açores', 'os Açores', D.acores]];
        var ok = R.filter(function (r) { return !L.passou(r[2]); });
        var ko = R.filter(function (r) { return L.passou(r[2]); });
        if (ok.length) {
          h += '<p>Para chegar antes do Natal, encomende até:</p><ul class="lnat-est__regioes">';
          ok.forEach(function (r) { h += '<li><span>' + r[0] + '</span><b>' + esc(dataLonga(r[2])) + '</b></li>'; });
          h += '</ul><p class="lnat-peq lnat-est__ind">Prazos indicativos.</p>';
        }
        if (ko.length) {
          h += '<p class="lnat-est__ent-ko">Já não chega a tempo por correio' + (ko.length === R.length ? '' : ' para ' + juntar(ko.map(function (r) { return r[1]; }))) + '.</p>';
        }
        if (!L.passou(D.loja)) {
          h += '<p>' + (ko.length === R.length ? 'Ainda pode levantar a prenda numa das nossas lojas' : 'Levantar na loja') + ' até <b>' + esc(dataHora(D.loja)) + '</b>, com marcação.' + waLink('Olá! Gostava de levantar uma prenda de Natal numa das vossas lojas.') + '</p>';
        }
        if (ko.length) h += vale;
      }
      entregaEl.innerHTML = h;
      entregaEl.hidden = !h;
    }
    function publicar(s, n) {
      clearTimeout(tPub);
      tPub = setTimeout(function () {
        try {
          if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) {
            Shopify.analytics.publish('lod_natal_estrela', { para: s.para, metal: s.saltar ? 'n/a' : s.metal, valor: s.valor, n: n });
          }
        } catch (e) {}
      }, 1200);
    }
    /* ---------- barra fixa «Ver N prendas» (telemóvel) ---------- */
    function barra() {
      if (fixa) fixa.classList.toggle('is-visivel', escolheu && vePerguntas && !vePainel);
    }
    function textoBarra(modo, tit, sub) {
      if (!fixa) return;
      fixa.setAttribute('data-modo', modo);
      if (fixaTit) fixaTit.textContent = tit;
      if (fixaSub) { fixaSub.textContent = sub || ''; fixaSub.hidden = !sub; }
    }
    function barraRes(s, n) {
      if (n == null) textoBarra('res', 'A procurar prendas…', frase(s));
      else if (n) textoBarra('res', 'Ver ' + n + (n === 1 ? ' prenda' : ' prendas'), frase(s));
      else textoBarra('res', 'Ver sugestões', 'Sem peças ' + frase(s));
    }

    function desenhar(r, s, origem) {
      lista = r.lista;
      mostrar = POR;
      painel.classList.remove('is-a-carregar');
      painel.removeAttribute('aria-busy');
      erroEl.hidden = true;
      todasEl.href = urlTodas(r.todas, s);
      grelha.textContent = '';
      vales();
      var pre = r.tirado ? 'Sem peças em ' + r.tirado + ' ' + s.resumo + '. ' : '';
      if (!lista.length) {
        grelha.hidden = true;
        maisWrap.hidden = true;
        vazioEl.hidden = false;
        sugerir(r.base, r.baseAlt, s);
        var tente = (!s.saltar && s.metal !== 'tanto-faz') ? 'outro valor ou outro metal' : 'outro valor';
        estadoEl.textContent = pre + 'Não encontrámos peças com estas escolhas. Experimente ' + tente + (valeOk() ? ', ou ofereça um vale-prenda.' : '.');
      } else {
        vazioEl.hidden = true;
        grelha.hidden = false;
        pintar(0, mostrar);
        estadoEl.textContent = pre + resumo(lista.length, s, r.completo) + '.';
      }
      entrega();
      painel.classList.add('is-pronto');
      barraRes(s, lista.length);
      if (origem === 'utilizador' || origem === 'sugestao' || origem === 'hash') publicar(s, lista.length);
    }
    function falhou() {
      painel.classList.remove('is-a-carregar');
      painel.removeAttribute('aria-busy');
      grelha.textContent = '';
      grelha.hidden = true;
      maisWrap.hidden = true;
      vazioEl.hidden = true;
      erroEl.hidden = false;
      vales();
      estadoEl.textContent = 'Não conseguimos mostrar as peças agora. Tente de novo ou veja a coleção.';
      textoBarra('res', 'Ver resultados', 'Não conseguimos mostrar as peças agora.');
    }
    function abrir() { if (painel.hidden) painel.hidden = false; }
    /* Sem escolha «Para quem»: painel fechado, pronto a reabrir com o esqueleto. */
    function fechar() {
      seq++;
      lista = [];
      painel.hidden = true;
      painel.classList.remove('is-pronto', 'is-a-carregar');
      painel.setAttribute('aria-busy', 'true');
      grelha.innerHTML = esqueleto;
      grelha.hidden = false;
      vazioEl.hidden = true;
      erroEl.hidden = true;
      maisWrap.hidden = true;
      estadoEl.textContent = '';
      if (entregaEl) entregaEl.hidden = true;
      textoBarra('para', 'Para quem é a prenda?', 'Escolha no passo I para ver as peças.');
    }
    /* Estado inicial fechado: quando a secção se aproxima, já vai buscando a primeira escolha. */
    function preCarregar() {
      var p = grupo('para')[0];
      var u = p && p.getAttribute('data-url');
      if (u) carregar(u, parseInt(p.getAttribute('data-pag'), 10) || 1).then(null, function () {});
    }

    /* ---------- procura ---------- */
    function correr(origem) {
      var s = estado();
      ui(s);
      if (origem === 'utilizador' || origem === 'sugestao') escreverHash(s);
      if (!s.para || !s.url) {
        metais(s, null, null, false);
        fechar();
        if (origem === 'auto') preCarregar();
        return;
      }
      abrir();
      if (!ativo) return;
      if (ctrlPara !== s.para) {
        if (ctrl) { try { ctrl.abort(); } catch (e) {} }
        ctrl = ('AbortController' in window) ? new AbortController() : null;
        ctrlPara = s.para;
      }
      var temAlt = !!s.alt && s.alt !== s.url;
      metais(s, cache[s.url] || null, temAlt ? cache[s.alt] || null : null, false);
      var meu = ++seq;
      barraRes(s, null);
      if (!cache[s.url]) aCarregar();
      carregar(s.url, s.pag).then(function (d1) {
        if (!temAlt) return { d1: d1, d2: null };
        if (filtrar(d1.itens, s).length >= MINIMO) return { d1: d1, d2: cache[s.alt] || null };
        if (!cache[s.alt] && meu === seq) aCarregar();
        return carregar(s.alt, s.altPag).then(function (d2) { return { d1: d1, d2: d2 }; }, function (e) {
          if (e && e.name === 'AbortError') throw e;
          return { d1: d1, d2: null };
        });
      }).then(function (o) {
        if (meu !== seq) return;
        /* Se o metal escolhido não tem peças nesta escolha, passa a «Tanto faz» e diz porquê. */
        var tirado = metais(s, o.d1, o.d2, true);
        if (tirado) {
          s.metal = 'tanto-faz';
          marcar('metal', 'tanto-faz');
          if (escolheu) escreverHash(s);
        }
        var m1 = filtrar(o.d1.itens, s), r;
        if (m1.length >= MINIMO || !o.d2) {
          r = { lista: m1, completo: o.d1.completo, todas: s.url, base: o.d1.itens, baseAlt: null };
        } else {
          var vistos = {};
          m1.forEach(function (it) { vistos[it.url] = 1; });
          var m2 = filtrar(o.d2.itens, s).filter(function (it) { return !vistos[it.url]; });
          r = { lista: m1.concat(m2), completo: o.d1.completo && o.d2.completo, todas: m2.length ? s.alt : s.url, base: o.d1.itens, baseAlt: o.d2.itens };
        }
        r.tirado = tirado;
        desenhar(r, s, origem);
      }, function (e) {
        if (meu !== seq || (e && e.name === 'AbortError')) return;
        falhou();
      });
    }
    function ativar(origem) {
      if (!ativo) {
        ativo = true;
        if (io) { io.disconnect(); io = null; }
      }
      if (origem === 'utilizador' || origem === 'sugestao' || origem === 'hash') { escolheu = true; barra(); }
      correr(origem);
    }

    /* ---------- eventos ---------- */
    form.addEventListener('change', function (e) {
      var t = e.target;
      if (!t || !t.hasAttribute || !t.hasAttribute('data-grupo')) return;
      var fs = t.closest('[data-est-passo]');
      if (fs) passo(fs.getAttribute('data-est-passo'));
      ativar('utilizador');
    });
    form.addEventListener('focusin', function (e) {
      var fs = e.target && e.target.closest && e.target.closest('[data-est-passo]');
      if (fs) passo(fs.getAttribute('data-est-passo'));
    });
    maisBtn.addEventListener('click', function () {
      var de = mostrar;
      mostrar += POR;
      var primeiro = pintar(de, mostrar);
      if (primeiro) { try { primeiro.focus({ preventScroll: false }); } catch (e) { primeiro.focus(); } }
    });
    painel.querySelector('[data-est-recomecar]').addEventListener('click', function () {
      var tudo = form.querySelectorAll('[data-grupo]');
      for (var j = 0; j < tudo.length; j++) tudo[j].checked = false;
      var ini = form.querySelectorAll('[data-inicial]');
      for (var i = 0; i < ini.length; i++) ini[i].checked = true;
      passo(1);
      limparHash();
      escolheu = false;
      barra();
      ativar('recomecar');
      var p = marcado('para') || grupo('para')[0];
      if (p) { try { p.focus({ preventScroll: true }); } catch (e) {} }
      try { root.scrollIntoView({ behavior: 'auto', block: 'start' }); } catch (e) {}
    });
    if (fixaBtn) fixaBtn.addEventListener('click', function () {
      var suave = !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
      var alvo = painel, foco = tituloRes;
      if (fixa.getAttribute('data-modo') === 'para' || painel.hidden) {
        alvo = form.querySelector('[data-est-passo="1"]') || form;
        foco = grupo('para')[0];
      }
      try { alvo.scrollIntoView({ behavior: suave ? 'smooth' : 'auto', block: 'start' }); } catch (e) { alvo.scrollIntoView(); }
      if (foco) { try { foco.focus({ preventScroll: true }); } catch (e) {} }
    });
    painel.querySelector('[data-est-tentar]').addEventListener('click', function () { ativar('utilizador'); });
    sugEl.addEventListener('click', function (e) {
      var b = e.target && e.target.closest && e.target.closest('[data-sug]');
      if (!b) return;
      var g = b.getAttribute('data-sug-grupo');
      if (!marcar(g, b.getAttribute('data-sug'))) return;
      passo(g === 'valor' ? 3 : 2);
      ativar('sugestao');
      try { tituloRes.focus({ preventScroll: true }); } catch (err) {}
    });

    root._lnatEst = {
      hash: function () { if (lerHash()) { ativar('hash'); rolar(); } },
      bloco: function (el) {
        var inp = el && el.querySelector && el.querySelector('[data-grupo="para"]');
        if (!inp) return;
        inp.checked = true;
        passo(1);
        ativar('editor');
      },
      parar: function () {
        if (ctrl) { try { ctrl.abort(); } catch (e) {} }
        if (io) { io.disconnect(); io = null; }
        ioBarra.forEach(function (o) { o.disconnect(); });
        ioBarra = [];
      }
    };

    /* A barra aparece com as perguntas no ecrã e desaparece quando o topo do painel já se vê acima dela. */
    if (fixa && 'IntersectionObserver' in window) {
      var ioP = new IntersectionObserver(function (en) { vePerguntas = en[en.length - 1].isIntersecting; barra(); }, { rootMargin: '0px 0px -64px 0px' });
      var ioR = new IntersectionObserver(function (en) { vePainel = en[en.length - 1].isIntersecting; barra(); }, { rootMargin: '0px 0px -' + (fundo + 80) + 'px 0px' });
      ioP.observe(form);
      ioR.observe(painel);
      ioBarra = [ioP, ioR];
    }

    ui(estado());
    if (!design && lerHash()) {
      ativar('hash');
      rolar();
    } else if ('IntersectionObserver' in window) {
      io = new IntersectionObserver(function (en) {
        for (var i = 0; i < en.length; i++) if (en[i].isIntersecting) { ativar('auto'); break; }
      }, { rootMargin: '300px 0px' });
      io.observe(root);
    } else {
      ativar('auto');
    }
  }

  function todos() { [].forEach.call(document.querySelectorAll('.lnat-est'), init); }
  function daSecao(e) { return e && e.target && e.target.querySelector ? e.target.querySelector('.lnat-est') : null; }

  if (!RAIZ.hasAttribute('data-lnat-est')) {
    RAIZ.setAttribute('data-lnat-est', '');
    document.addEventListener('shopify:section:load', function (e) { init(daSecao(e)); });
    document.addEventListener('shopify:section:unload', function (e) { var r = daSecao(e); if (r && r._lnatEst) r._lnatEst.parar(); });
    document.addEventListener('shopify:block:select', function (e) {
      var r = e.target && e.target.closest ? e.target.closest('.lnat-est') : null;
      if (r && r._lnatEst) r._lnatEst.bloco(e.target);
    });
    window.addEventListener('hashchange', function () {
      [].forEach.call(document.querySelectorAll('.lnat-est'), function (r) { if (r._lnatEst) r._lnatEst.hash(); });
    });
  }
  todos();
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Natal · Siga a estrela",
  "tag": "section",
  "class": "lnat-secao-estrela",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Guia de prendas. Aparece de 1 de dezembro ao Dia de Reis (datas nas definições do tema, Natal 2026). Os resultados carregam quando a secção se aproxima do ecrã."
