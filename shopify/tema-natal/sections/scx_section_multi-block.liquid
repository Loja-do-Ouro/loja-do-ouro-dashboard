{{ 'ouro_asset_timer.css' | asset_url | stylesheet_tag }}
{{ 'scx_asset_multi-block.css' | asset_url | stylesheet_tag }}

{% style %}
  :root {
      --content-gap: {{ section.settings.section_gap }}px;
      --content-gap-tablet: {{ section.settings.section_gap_tablet }}px;
    }
{% endstyle %}

<style>
    .section-{{ section.id }} .multi-block-body {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(100%, 1fr));
      gap: {{ section.settings.section_gap_tablet }}px;
    }

    .section-{{ section.id }} {
      padding-top:{{section.settings.padding_top_mb}}px;
      padding-bottom:{{section.settings.padding_bottom_mb}}px;
    }

    .section-{{section.id }} .multi-block-body--item.reverse-order:nth-child(1) {
      order: 0;
    }
    .section-{{section.id }} .multi-block-body--item.reverse-order:nth-child(2) {
      order: -1;
    }
    .section-{{section.id }} .multi-block-body--item.reverse-order:nth-child(3) {
      order: -2;
    }
    .section-{{section.id }} .multi-block-body--item.reverse-order:nth-child(4) {
      order: -3;
    }

    @media screen and (min-width: 990px) {
      .section-{{ section.id }} .multi-block-body {
        {% comment %} grid-template-columns: repeat(auto-fit, minmax(calc(50% - {{ section.settings.section_gap_tablet }}px), 1fr)); {% endcomment %}
        grid-template-columns: repeat(auto-fit, minmax(calc(25% - {{ section.settings.section_gap }}px), 1fr));

      }

      .section-{{ section.id }} {
        padding-top:{{section.settings.padding_top_dt}}px;
        padding-bottom:{{section.settings.padding_bottom_dt}}px;
      }

      .section-{{section.id }} .multi-block-body--item.reverse-order {
        order: unset !important;
      }
    }

    @media screen and (min-width: 1280px) {
      .section-{{ section.id }} .multi-block-body {
        grid-template-columns: repeat(auto-fit, minmax(calc(25% - {{ section.settings.section_gap }}px), 1fr));
        gap: {{ section.settings.section_gap }}px;
      }
    }

    .section-{{ section.id }}.multi-block-wrapper {
      width: {{ section.settings.total_width }}%;
      margin: 0 auto;
  }

  .side-paddings-{{ section.id }}{
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
    @media (width < 1024px) {
      padding-left: {{ section.settings.padding_left_mb }}px;
      padding-right: {{ section.settings.padding_right_mb }}px;
    }
  }

  {% assign page = template.suffix %}

  {% if page == "outlet" %}
    .section-card-wrapper {
      padding: var(--spacing-spacing-xl) var(--spacing-spacing-xl) var(--spacing-spacing-xl) var(--spacing-spacing-lg);
    }
  {% endif %}  

</style>




<div class="multi-block-wrapper {% if section.settings.hide_mobile %} small-hide {% endif %} section-{{ section.id }} color-{{ section.settings.color_scheme }}">
  {% comment %} TODO: SEO {% endcomment %}
  {% if section.settings.show_content_area == true %}
    <div class="multi-block-header multi-block-header--mb-{{ section.settings.mobile_display_type }} multi-block-header--{{ section.settings.display_type }}">
      <div class="multi-block-header-content multi-block-header-content-mb--{{ section.settings.mobile_display_type }} multi-block-header-content--{{ section.settings.display_type }}">
        <p class="subtitle_md">{{ section.settings.subtitle }}</p>
        <p class="heading_2">{{ section.settings.title }}</p>
        <p>{{ section.settings.description }}</p>
      </div>
      <div class="multi-block-header-timer multi-block-header-timer--mb-{{ section.settings.mobile_display_type }} multi-block-header-timer--{{ section.settings.display_type }}">
        {% if section.settings.date_picker %}
          <script src="{{ 'ouro_asset_definition_timer.js' | asset_url }}" defer="defer"></script>
          {% render 'scx_snippet_timer',
            color: section.settings.color,
            timer_date_picker: section.settings.date_picker,
            finish_message: section.settings.timer_end_message,
            days: settings.global_cd_days_label,
            hours: settings.global_cd_hours_label,
            minutes: settings.global_cd_minutes_label,
            seconds: settings.global_cd_seconds_label,
            separator: ':'
          %}
        {% endif %}

        {% if section.settings.url %}
          <a class="url_link" href="{{ section.settings.url }}">{{ section.settings.link_label }}</a>
        {% endif %}
      </div>
    </div>
  {% endif %}
  <div class="multi-block-body side-paddings-{{ section.id }}">
    {%- for block in section.blocks %}
      {% case block.type %}
       {% when '@app' %}
        {% render block %}
      {% when 'section_card' %}
          <div class="multi-block-body--item {%  if section.settings.reverse_order %}reverse-order {% endif %}">
            {% render 'scx_snippet_section-card',
              background: block.settings.bg_image,
              background_video: block.settings.bg_video,
              caption: block.settings.caption,
              title: block.settings.title,
              description: block.settings.description,
              button1_text: block.settings.button1_text,
              button1_url: block.settings.button1_url,
              button2_text: block.settings.button2_text,
              button2_url: block.settings.button2_url,
              justify_text: block.settings.justify_text,
              vertical_alignment: block.settings.vertical_alignment,
              enable_shadow: block.settings.enable_shadow,
              shadow_position: block.settings.shadow_position,
              shadow_color: block.settings.shadow_color,
              buttons_width: block.settings.buttons_width,
              color: block.settings.color,
              timer_date_picker: block.settings.date_picker,
              finish_message: block.settings.timer_end_message,
              max_height: section.settings.max_height,
              color_scheme: block.settings.color_scheme,
              remove_min_height: block.settings.remove_min_height
            %}
          </div>
         
        {% when 'product-list' %}
          {% render 'scx_snippet_product-list',
            color_schema: block.settings.color_schema,
            background: block.settings.image_background,
            sectionid: section.id,
            list: block.settings.product_list,
            product_layout: block.settings.product_layout
          %}
      {% endcase %}
    {%- endfor -%}
  </div>

  <div class="multi-block-header"></div>
</div>
