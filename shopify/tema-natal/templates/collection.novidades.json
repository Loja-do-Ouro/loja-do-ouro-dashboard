      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign lod_locale = request.locale.iso_code | downcase %}\n\n{%- comment -%}\nLOJA DO OURO / GOLD STORE PREMIUM\nCOLECAO NOVIDADES - EDITORIAL PREMIUM · NATAL 2026 «OURO DE REIS»\nMesmo desenho do editorial «O universo do ouro», com a mensagem de Natal\ne a fotografia do saco de oferta junto à árvore.\nPT / EN / ES / FR / DE / IT\n{%- endcomment -%}\n\n{% assign lod_kicker = 'OURO DE REIS · NATAL 2026' %}\n{% assign lod_title = 'Desde o primeiro Natal, o ouro é a prenda que fica.' %}\n{% assign lod_text = 'Antes de qualquer outra prenda, houve ouro: foi um dos presentes que os Magos levaram ao Menino. Descubra as novidades deste Natal e junte, no carrinho, o embrulho de oferta e a sua mensagem.' %}\n{% assign lod_cta = 'Ver as novidades' %}\n{% assign lod_label = 'Ouro de Reis' %}\n{% assign lod_signature = 'Seleção de Natal · Loja do Ouro' %}\n{% assign lod_alt = 'Saco de oferta preto da Loja do Ouro, com o logótipo dourado e um laço de fita preta com o nome da marca em dourado, junto a uma árvore de Natal.' %}\n\n{% if lod_locale contains 'en' %}\n\n  {% assign lod_kicker = 'GOLD OF THE MAGI · CHRISTMAS 2026' %}\n  {% assign lod_title = 'Since the first Christmas, gold has been the gift that lasts.' %}\n  {% assign lod_text = 'Before any other gift, there was gold: one of the treasures the Magi brought to the Christ Child. Discover our new arrivals for Christmas and add gift wrapping and your own message in your bag.' %}\n  {% assign lod_cta = 'See new arrivals' %}\n  {% assign lod_label = 'Gold of the Magi' %}\n  {% assign lod_signature = 'Christmas Selection · Gold Store Premium' %}\n  {% assign lod_alt = 'Black gift bag with a gold logo, tied with a black ribbon lettered in gold, beside a Christmas tree.' %}\n\n{% elsif lod_locale contains 'es' %}\n\n  {% assign lod_kicker = 'ORO DE REYES · NAVIDAD 2026' %}\n  {% assign lod_title = 'Desde la primera Navidad, el oro es el regalo que perdura.' %}\n  {% assign lod_text = 'Antes de cualquier otro regalo, hubo oro: fue uno de los presentes que los Magos llevaron al Niño. Descubra las novedades de esta Navidad y añada al carrito el envoltorio de regalo y su mensaje.' %}\n  {% assign lod_cta = 'Ver las novedades' %}\n  {% assign lod_label = 'Oro de Reyes' %}\n  {% assign lod_signature = 'Selección de Navidad · Gold Store Premium' %}\n  {% assign lod_alt = 'Bolsa de regalo negra con logotipo dorado y lazo de cinta negra con letras doradas, junto a un árbol de Navidad.' %}\n\n{% elsif lod_locale contains 'fr' %}\n\n  {% assign lod_kicker = 'L’OR DES MAGES · NOËL 2026' %}\n  {% assign lod_title = 'Depuis le premier Noël, l’or est le cadeau qui reste.' %}\n  {% assign lod_text = 'Avant tout autre cadeau, il y eut l’or : l’un des présents que les Mages apportèrent à l’Enfant. Découvrez les nouveautés de Noël et offrez-les avec un emballage cadeau et votre message, à choisir dans le panier.' %}\n  {% assign lod_cta = 'Voir les nouveautés' %}\n  {% assign lod_label = 'L’or des Mages' %}\n  {% assign lod_signature = 'Sélection de Noël · Gold Store Premium' %}\n  {% assign lod_alt = 'Sac cadeau noir au logo doré, noué d’un ruban noir aux lettres dorées, près d’un sapin de Noël.' %}\n\n{% elsif lod_locale contains 'de' %}\n\n  {% assign lod_kicker = 'GOLD DER WEISEN · WEIHNACHTEN 2026' %}\n  {% assign lod_title = 'Seit dem ersten Weihnachtsfest ist Gold das Geschenk, das bleibt.' %}\n  {% assign lod_text = 'Vor jedem anderen Geschenk gab es Gold: eine der Gaben der Weisen an das Jesuskind. Entdecken Sie unsere Weihnachtsneuheiten – Geschenkverpackung und persönliche Nachricht können Sie im Warenkorb hinzufügen.' %}\n  {% assign lod_cta = 'Neuheiten ansehen' %}\n  {% assign lod_label = 'Das Gold der Weisen' %}\n  {% assign lod_signature = 'Weihnachtsauswahl · Gold Store Premium' %}\n  {% assign lod_alt = 'Schwarze Geschenktüte mit goldenem Logo und schwarzer Schleife mit goldener Schrift, neben einem Weihnachtsbaum.' %}\n\n{% elsif lod_locale contains 'it' %}\n\n  {% assign lod_kicker = 'L’ORO DEI MAGI · NATALE 2026' %}\n  {% assign lod_title = 'Dal primo Natale, l’oro è il regalo che resta.' %}\n  {% assign lod_text = 'Prima di ogni altro regalo, c’era l’oro: uno dei doni che i Magi portarono al Bambino. Scopra le novità di questo Natale e aggiunga al carrello la confezione regalo e il suo messaggio.' %}\n  {% assign lod_cta = 'Vedi le novità' %}\n  {% assign lod_label = 'L’oro dei Magi' %}\n  {% assign lod_signature = 'Selezione di Natale · Gold Store Premium' %}\n  {% assign lod_alt = 'Shopper regalo nera con logo dorato e fiocco di nastro nero con scritte dorate, accanto a un albero di Natale.' %}\n\n{% endif %}\n\n{%- assign lod_img = 'https://cdn.shopify.com/s/files/1/0933/8811/2256/files/Design_sem_nome_-_2026-11-04T100207.494.png?v=1793787640' -%}\n\n<section class=\"lod-collection-editorial lod-collection-editorial--natal\" aria-label=\"{{ lod_kicker | escape }}\">\n\n  <div class=\"lod-collection-editorial__frame\">\n\n    <!-- CONTEUDO EDITORIAL -->\n\n    <div class=\"lod-collection-editorial__content\">\n\n      <div class=\"lod-collection-editorial__topline\">\n        <span class=\"lod-collection-editorial__line\"></span>\n        <span>{{ lod_kicker }}</span>\n      </div>\n\n      <h1 class=\"lod-collection-editorial__title\">\n        {{ lod_title }}\n      </h1>\n\n      <p class=\"lod-collection-editorial__copy\">\n        {{ lod_text }}\n      </p>\n\n      <!-- BOTAO COM SCROLL PARA PRODUTOS -->\n\n      <button\n        type=\"button\"\n        class=\"lod-collection-editorial__cta\"\n        aria-label=\"{{ lod_cta | escape }}\"\n      >\n        <span>{{ lod_cta }}</span>\n\n        <svg\n          width=\"18\"\n          height=\"18\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          aria-hidden=\"true\"\n        >\n          <path\n            d=\"M5 12H19M13 6L19 12L13 18\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.4\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n        </svg>\n      </button>\n\n      <!-- ASSINATURA -->\n\n      <div class=\"lod-collection-editorial__signature\">\n        <span class=\"lod-collection-editorial__diamond\">◇</span>\n        <span>{{ lod_signature }}</span>\n      </div>\n\n    </div>\n\n    <!-- FOTOGRAFIA DE NATAL: SACO DE OFERTA JUNTO A ARVORE -->\n\n    <div class=\"lod-collection-editorial__visual\">\n\n      <picture>\n        <img\n          src=\"{{ lod_img }}&width=1400\"\n          srcset=\"{{ lod_img }}&width=700 700w, {{ lod_img }}&width=1000 1000w, {{ lod_img }}&width=1350 1350w\"\n          sizes=\"(max-width: 749px) 100vw, 56vw\"\n          alt=\"{{ lod_alt | escape }}\"\n          width=\"1350\"\n          height=\"1080\"\n          loading=\"eager\"\n          fetchpriority=\"high\"\n        >\n      </picture>\n\n      <div class=\"lod-collection-editorial__visual-shade\"></div>\n\n      <!-- ETIQUETA SOBRE A IMAGEM -->\n\n      <div class=\"lod-collection-editorial__floating-label\">\n        <span>01</span>\n        <i></i>\n        <strong>{{ lod_label }}</strong>\n      </div>\n\n      <!-- CANTO DECORATIVO DA IMAGEM -->\n\n      <div class=\"lod-collection-editorial__corner\" aria-hidden=\"true\">\n        <span></span>\n      </div>\n\n    </div>\n\n  </div>\n\n</section>\n\n<script>\n(function() {\n\n  function initLodEditorial() {\n\n    document.querySelectorAll('.lod-collection-editorial__cta').forEach(function(button) {\n\n      if (button.dataset.lodReady === 'true') return;\n      button.dataset.lodReady = 'true';\n\n      button.addEventListener('click', function() {\n\n        var currentSection = button.closest('.shopify-section');\n\n        if (!currentSection) return;\n\n        var target = currentSection.nextElementSibling;\n\n        while (target) {\n\n          if (target.querySelector(\n            '.collection, .product-grid, [id*=\"product-grid\"], [class*=\"collection-product\"]'\n          )) {\n            break;\n          }\n\n          target = target.nextElementSibling;\n        }\n\n        if (!target) {\n          target = currentSection.nextElementSibling;\n        }\n\n        if (target) {\n          target.scrollIntoView({\n            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',\n            block: 'start'\n          });\n        }\n\n      });\n\n    });\n\n  }\n\n  initLodEditorial();\n\n  document.addEventListener('shopify:section:load', initLodEditorial);\n\n})();\n</script>\n\n<style>\n\n/* =========================================\n   EDITORIAL PREMIUM\n   ========================================= */\n\n.lod-collection-editorial {\n  --lod-gold: #c49a5b;\n  --lod-gold-light: #e5c58e;\n  --lod-gold-dark: #98703d;\n  --lod-cream: #f4eee6;\n  --lod-black: #15110e;\n  --lod-black-2: #1c1612;\n\n  width: 100%;\n  padding: clamp(16px, 2vw, 30px);\n\n  background:\n    linear-gradient(\n      180deg,\n      #f6f3ef 0%,\n      #ffffff 100%\n    );\n}\n\n/* =========================================\n   ESTRUTURA PRINCIPAL\n   ========================================= */\n\n.lod-collection-editorial__frame {\n  position: relative;\n  width: min(100%, 1560px);\n  min-height: 545px;\n  margin: 0 auto;\n\n  display: grid;\n  grid-template-columns:\n    minmax(390px, .90fr)\n    minmax(520px, 1.10fr);\n\n  overflow: hidden;\n  border-radius: 10px;\n  background: var(--lod-black);\n\n  box-shadow:\n    0 24px 70px rgba(30,20,12,.10);\n}\n\n/* =========================================\n   CONTEUDO\n   ========================================= */\n\n.lod-collection-editorial__content {\n  position: relative;\n  z-index: 2;\n\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: flex-start;\n\n  padding:\n    clamp(48px, 5vw, 82px)\n    clamp(40px, 5vw, 82px);\n\n  background:\n    radial-gradient(\n      circle at 15% 10%,\n      rgba(196,154,91,.08),\n      transparent 35%\n    ),\n    linear-gradient(\n      145deg,\n      #17120f 0%,\n      #1a1410 60%,\n      #130f0c 100%\n    );\n}\n\n/* DIVISORIA DOURADA */\n\n.lod-collection-editorial__content::after {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  right: 0;\n  width: 1px;\n  height: 100%;\n\n  background:\n    linear-gradient(\n      180deg,\n      transparent 5%,\n      rgba(229,197,142,.36) 50%,\n      transparent 95%\n    );\n}\n\n/* =========================================\n   SUBTITULO\n   ========================================= */\n\n.lod-collection-editorial__topline {\n  display: flex;\n  align-items: center;\n  gap: 15px;\n  margin-bottom: 23px;\n\n  color: var(--lod-gold-light);\n  font-size: 10px;\n  font-weight: 600;\n  line-height: 1;\n  letter-spacing: .30em;\n  text-transform: uppercase;\n}\n\n.lod-collection-editorial__line {\n  width: 46px;\n  height: 1px;\n  flex: 0 0 auto;\n\n  background:\n    linear-gradient(\n      90deg,\n      var(--lod-gold-dark),\n      var(--lod-gold-light)\n    );\n}\n\n/* =========================================\n   TITULO\n   ========================================= */\n\n.lod-collection-editorial__title {\n  max-width: 580px;\n  margin: 0;\n\n  font-family:\n    \"Iowan Old Style\",\n    Baskerville,\n    \"Times New Roman\",\n    Georgia,\n    serif;\n\n  font-size: clamp(46px, 4.3vw, 70px);\n  line-height: .98;\n  font-weight: 400;\n  letter-spacing: -.04em;\n  color: #ffffff;\n  text-wrap: balance;\n}\n\n/* =========================================\n   TEXTO\n   ========================================= */\n\n.lod-collection-editorial__copy {\n  max-width: 500px;\n  margin: 27px 0 31px;\n\n  font-size: clamp(14px, 1vw, 17px);\n  line-height: 1.72;\n  font-weight: 300;\n  letter-spacing: .015em;\n\n  color: rgba(255,255,255,.76);\n}\n\n/* =========================================\n   BOTAO PREMIUM\n   ========================================= */\n\n.lod-collection-editorial__cta {\n  appearance: none;\n  width: fit-content;\n  min-height: 55px;\n  padding: 0 25px;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 22px;\n\n  border:\n    1px solid rgba(229,197,142,.48);\n\n  border-radius: 999px;\n  background: transparent;\n  color: #ffffff;\n\n  font-family: inherit;\n  font-size: 11px;\n  line-height: 1;\n  font-weight: 600;\n  letter-spacing: .17em;\n  text-transform: uppercase;\n  cursor: pointer;\n\n  transition:\n    background .35s ease,\n    color .35s ease,\n    border-color .35s ease,\n    transform .35s ease,\n    box-shadow .35s ease;\n}\n\n.lod-collection-editorial__cta svg {\n  flex: 0 0 auto;\n  transition: transform .35s ease;\n}\n\n.lod-collection-editorial__cta:hover {\n  color: #16110d;\n  border-color: var(--lod-gold-light);\n\n  background:\n    linear-gradient(\n      135deg,\n      #e0bc80,\n      #be8d4c\n    );\n\n  transform: translateY(-2px);\n\n  box-shadow:\n    0 13px 32px rgba(0,0,0,.18);\n}\n\n.lod-collection-editorial__cta:hover svg {\n  transform: translateX(4px);\n}\n\n.lod-collection-editorial__cta:focus-visible {\n  outline: 2px solid var(--lod-gold-light);\n  outline-offset: 3px;\n}\n\n/* =========================================\n   ASSINATURA\n   ========================================= */\n\n.lod-collection-editorial__signature {\n  margin-top: 22px;\n  display: flex;\n  align-items: center;\n  gap: 9px;\n\n  font-size: 9px;\n  font-weight: 500;\n  line-height: 1;\n  letter-spacing: .18em;\n  text-transform: uppercase;\n\n  color: rgba(255,255,255,.42);\n}\n\n.lod-collection-editorial__diamond {\n  font-size: 14px;\n  color: var(--lod-gold-light);\n}\n\n/* =========================================\n   IMAGEM\n   ========================================= */\n\n.lod-collection-editorial__visual {\n  position: relative;\n  min-height: 545px;\n  overflow: hidden;\n  background: #2a1d14;\n}\n\n.lod-collection-editorial__visual picture {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n}\n\n.lod-collection-editorial__visual img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: 50% 42%;\n  transform: scale(1.01);\n\n  transition:\n    transform 7s cubic-bezier(.2,.65,.25,1);\n}\n\n/* PREMIUM IMAGE ZOOM */\n\n@media (hover: hover) {\n  .lod-collection-editorial__frame:hover\n  .lod-collection-editorial__visual img {\n    transform: scale(1.045);\n  }\n}\n\n/* =========================================\n   SOMBREAMENTO\n   ========================================= */\n\n.lod-collection-editorial__visual-shade {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n\n  background:\n    linear-gradient(\n      90deg,\n      rgba(18,13,9,.16) 0%,\n      transparent 28%\n    ),\n    linear-gradient(\n      0deg,\n      rgba(12,9,7,.17) 0%,\n      transparent 32%\n    );\n}\n\n/* =========================================\n   ETIQUETA DA IMAGEM\n   ========================================= */\n\n.lod-collection-editorial__floating-label {\n  position: absolute;\n  left: 30px;\n  bottom: 27px;\n  z-index: 2;\n\n  display: flex;\n  align-items: center;\n  gap: 11px;\n  padding: 11px 15px;\n  border-radius: 999px;\n\n  border:\n    1px solid rgba(255,255,255,.30);\n\n  background:\n    rgba(20,15,11,.42);\n\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  color: #ffffff;\n}\n\n.lod-collection-editorial__floating-label span {\n  color: var(--lod-gold-light);\n  font-family: Georgia, serif;\n  font-size: 12px;\n}\n\n.lod-collection-editorial__floating-label i {\n  width: 22px;\n  height: 1px;\n  background: rgba(255,255,255,.40);\n}\n\n.lod-collection-editorial__floating-label strong {\n  font-size: 9px;\n  line-height: 1;\n  font-weight: 600;\n  letter-spacing: .17em;\n  text-transform: uppercase;\n}\n\n/* =========================================\n   CANTO DECORATIVO\n   ========================================= */\n\n.lod-collection-editorial__corner {\n  position: absolute;\n  top: 25px;\n  right: 25px;\n  width: 74px;\n  height: 74px;\n\n  border-top:\n    1px solid rgba(255,255,255,.38);\n\n  border-right:\n    1px solid rgba(255,255,255,.38);\n}\n\n.lod-collection-editorial__corner span {\n  position: absolute;\n  top: -4px;\n  right: -4px;\n  width: 7px;\n  height: 7px;\n  background: var(--lod-gold-light);\n  transform: rotate(45deg);\n}\n\n/* =========================================\n   TABLET\n   ========================================= */\n\n@media screen and (max-width: 1050px) {\n\n  .lod-collection-editorial__frame {\n    grid-template-columns: .95fr 1.05fr;\n  }\n\n  .lod-collection-editorial__content {\n    padding: 45px 36px;\n  }\n\n  .lod-collection-editorial__title {\n    font-size: clamp(40px, 5vw, 58px);\n  }\n\n}\n\n/* =========================================\n   MOBILE\n   ========================================= */\n\n@media screen and (max-width: 749px) {\n\n  .lod-collection-editorial {\n    padding: 8px 10px 18px;\n  }\n\n  .lod-collection-editorial__frame {\n    display: flex;\n    flex-direction: column;\n    min-height: 0;\n    border-radius: 18px;\n  }\n\n  /* IMAGEM PRIMEIRO */\n\n  .lod-collection-editorial__visual {\n    order: 1;\n    width: 100%;\n    min-height: 0;\n    height: clamp(360px, 100vw, 520px);\n  }\n\n  .lod-collection-editorial__visual img {\n    object-position: 49% 45%;\n    transform: none;\n  }\n\n  .lod-collection-editorial__visual-shade {\n    background:\n      linear-gradient(\n        0deg,\n        rgba(13,10,8,.20) 0%,\n        transparent 29%\n      );\n  }\n\n  /* TEXTO ABAIXO DA IMAGEM */\n\n  .lod-collection-editorial__content {\n    order: 2;\n    padding: 31px 22px 28px;\n\n    background:\n      radial-gradient(\n        circle at 100% 0%,\n        rgba(197,154,91,.10),\n        transparent 35%\n      ),\n      linear-gradient(\n        160deg,\n        #17120f,\n        #100d0b\n      );\n  }\n\n  .lod-collection-editorial__content::after {\n    display: none;\n  }\n\n  /* SUBTITULO */\n\n  .lod-collection-editorial__topline {\n    margin-bottom: 16px;\n    font-size: 9px;\n    letter-spacing: .25em;\n  }\n\n  .lod-collection-editorial__line {\n    width: 29px;\n  }\n\n  /* TITULO */\n\n  .lod-collection-editorial__title {\n    max-width: 100%;\n    font-size: clamp(34px, 10vw, 46px);\n    line-height: 1;\n  }\n\n  /* DESCRICAO */\n\n  .lod-collection-editorial__copy {\n    max-width: 100%;\n    margin: 19px 0 24px;\n    font-size: 13.5px;\n    line-height: 1.62;\n  }\n\n  /* BOTAO */\n\n  .lod-collection-editorial__cta {\n    width: 100%;\n    min-height: 53px;\n    font-size: 10px;\n    letter-spacing: .14em;\n  }\n\n  /* ASSINATURA */\n\n  .lod-collection-editorial__signature {\n    margin-top: 18px;\n    font-size: 8.5px;\n  }\n\n  /* ETIQUETA */\n\n  .lod-collection-editorial__floating-label {\n    left: 15px;\n    bottom: 15px;\n    padding: 9px 12px;\n  }\n\n  .lod-collection-editorial__floating-label strong {\n    font-size: 8px;\n  }\n\n  /* CANTO DECORATIVO */\n\n  .lod-collection-editorial__corner {\n    top: 17px;\n    right: 17px;\n    width: 49px;\n    height: 49px;\n  }\n\n}\n\n/* =========================================\n   MOBILE PEQUENO\n   ========================================= */\n\n@media screen and (max-width: 390px) {\n\n  .lod-collection-editorial__visual {\n    height: 380px;\n  }\n\n  .lod-collection-editorial__content {\n    padding: 27px 18px 24px;\n  }\n\n  .lod-collection-editorial__title {\n    font-size: 32px;\n  }\n\n  .lod-collection-editorial__copy {\n    font-size: 13px;\n  }\n\n}\n\n/* =========================================\n   DESKTOP GRANDE\n   ========================================= */\n\n@media screen and (min-width: 1800px) {\n\n  .lod-collection-editorial__frame {\n    min-height: 590px;\n  }\n\n  .lod-collection-editorial__visual {\n    min-height: 590px;\n  }\n\n  .lod-collection-editorial__title {\n    font-size: 74px;\n  }\n\n  .lod-collection-editorial__copy {\n 