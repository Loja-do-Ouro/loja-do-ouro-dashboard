        },
        "dia_20261207": {
          "type": "dia",
          "settings": {
            "data": "2026-12-07",
            "titulo": "Bonecos de Estremoz",
            "historia": "Faz hoje nove anos: a 7 de dezembro de 2017, a UNESCO inscreveu a arte dos bonecos de Estremoz na Lista Representativa do Património Cultural Imaterial da Humanidade. E conta a própria UNESCO que este barro começou nos presépios — o presépio de altar e o presépio de três figuras. Um Natal português feito à mão, como a nossa filigrana.",
            "icone": "estrela",
            "dica": "Amanhã, dia 8, é feriado: a porta abre com o Coração de Viana.",
