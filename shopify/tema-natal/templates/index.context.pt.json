        },
        "dia_20261204": {
          "type": "dia",
          "settings": {
            "data": "2026-12-04",
            "titulo": "A libra, e o último dia para os Açores",
            "historia": "Em Portugal, a libra é uma moeda de ouro que se oferece e se guarda — e que também se usa ao peito, com aro. Durante gerações, as mulheres portuguesas viram no ouro um adorno e, ao mesmo tempo, uma segurança para o futuro. Hoje: uma meia libra e uma libra da rainha Vitória, ambas montadas em aro trabalhado de ouro de 19,2 quilates.",
