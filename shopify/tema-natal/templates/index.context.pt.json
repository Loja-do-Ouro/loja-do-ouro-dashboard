        "dia_20261203": {
          "type": "dia",
          "settings": {
            "data": "2026-12-03",
            "titulo": "A enchedeira",
            "historia": "Em Gondomar e na Póvoa de Lanhoso, a filigrana faz-se fio a fio. A enchedeira — tradicionalmente uma mulher — enche a moldura da peça com fio torcido de ouro ou prata, em espirais e esses, sempre em curva, nunca em ângulo reto. É do seu trabalho que vem a maior parte do valor de uma peça. Hoje: uma medalha em filigrana de ouro e uns brincos em filigrana de prata dourada.",
            "icone": "estrela",
            "produto": "medalha-floral-em-filigrana-ouro-19kl-com-turquesas-e-perola-4-5cm",
