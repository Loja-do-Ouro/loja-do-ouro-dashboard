        "dia_20261206": {
          "type": "dia",
          "settings": {
            "data": "2026-12-06",
            "titulo": "Arrecadas: mais de 2000 anos de filigrana",
            "historia": "As arrecadas são brincos tradicionais do ouro do Minho. Os seus antepassados são as arrecadas de ouro da Idade do Ferro, encontradas em Laúndos, Estela e Afife, que já tinham filigrana e granulado. Mais de 2000 anos depois, a arte continua viva. Hoje: uns brincos arrecadas em prata dourada, feitos em Portugal.",
            "icone": "estrela",
            "produto": "brincos-arrecadas-em-prata",
            "colecao": "tradicao-ouro",
            "cta_texto": "Ver ouro tradicional",
            "dica": "Volte amanhã: a porta de 7 de dezembro conta a história dos bonecos de Estremoz.",
