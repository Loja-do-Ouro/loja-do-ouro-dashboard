        },
        "dia_20270106": {
          "type": "dia",
          "settings": {
            "data": "2027-01-06",
            "titulo": "Dia de Reis",
            "historia": "Hoje é Dia de Reis, o fim tradicional da quadra do Natal em Portugal, com as últimas Janeiras e o Bolo-Rei à mesa. Fechamos aqui o Calendário de Ouro: obrigado por ter aberto connosco 37 portas. Para a última, uma medalha com letra em ouro de 19,2 quilates e um fio com cruz em filigrana de prata dourada.",
