        "dia_20270104": {
          "type": "dia",
          "settings": {
            "data": "2027-01-04",
            "titulo": "Bolo-Rei, desde o século XIX",
            "historia": "O Bolo-Rei chegou de França no século XIX. A Confeitaria Nacional, em Lisboa, conta que foi Balthazar Castanheiro Júnior quem trouxe a receita. Tem a forma de uma coroa — e é por isso que, nesta porta, as coroas são de ouro: um solitário Tiara e um anel com tiara de rubis, ambos em ouro de 19,2 quilates.",
            "icone": "coroa",
            "produto": "anel-solitario-em-ouro-19kl-com-zirconia-formato-tiara",
            "produto_2": "anel-em-ouro-19kl-com-tiara-de-rubis-t16",
            "dica": "Na mesa, a coroa é para partilhar; a de ouro é para guardar.",
            "sem_venda": false
          }
        },
        "dia_20270105": {
          "type": "dia",
          "settings": {
            "data": "2027-01-05",
            "titulo": "Ouro, incenso e mirra",
            "historia": "Na véspera de Reis, voltamos ao princípio: ouro, incenso e mirra. Na leitura de São João Paulo II, o ouro é oferecido ao Rei, o incenso a Deus e a mirra ao homem que viria a ser sepultado. O ouro continua a ser a prenda que fica: hoje, uma pulseira em filigrana e uma pequena medalha de Nossa Senhora de Fátima, ambas em ouro de 19,2 quilates.",
            "icone": "ouro",
            "produto": "pulseira-filigrana-em-ouro-21cm",
            "produto_2": "medalha-nossa-senhora-em-ouro-19kl-0-9cm",
