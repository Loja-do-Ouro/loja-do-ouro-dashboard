        "dia_20261205": {
          "type": "dia",
          "settings": {
            "data": "2026-12-05",
            "titulo": "Contas de Viana",
            "historia": "As Contas de Viana são contas de ouro e uma das mais antigas tradições do Minho. Hoje usam-se num colar, num fio com uma só conta ou num par de brincos. Para esta porta escolhemos uns brincos em prata dourada e uma conta em ouro de 19,2 quilates — o princípio de um colar que pode crescer de Natal em Natal.",
            "icone": "ouro",
