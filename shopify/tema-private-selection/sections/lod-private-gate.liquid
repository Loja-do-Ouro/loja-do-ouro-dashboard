    font-size: clamp(38px, 8vw, 66px);
    line-height: 1.02;
    color: var(--lss-fg, #f7f3ec);
    text-wrap: balance;
  }
  .lps__brand + .lps__name { margin-top: 18px; }
  .lps__intro {
    max-width: 36ch;
    margin: 22px auto 0;
    font-family: var(--lss-serif, Georgia, serif);
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.55;
    color: var(--lss-soft, #d6d1c8);
    text-wrap: pretty;
  }
  .lps__checking {
    display: none;
    margin-top: 40px;
    text-align: center;
    font-size: 13px;
    letter-spacing: .04em;
    color: var(--lss-muted, #a29f99);
  }
  html.lps-checking .lps__checking { display: block; }
  html.lps-checking .lps__body { display: none; }

  .lps__body { width: 100%; max-width: 440px; margin: clamp(36px, 5vw, 52px) auto 0; }
  .lps__tabs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); border-bottom: 1px solid var(--lss-line, rgba(247, 243, 236, .14)); }
  .lps .lps__tab {
    position: relative;
    min-height: 48px;
    margin: 0;
    padding: 12px 8px;
    border: 0;
    border-radius: 0;
    background: none;
    color: var(--lss-muted, #a29f99);
    font: inherit;
    font-size: 13px;
    letter-spacing: .04em;
    line-height: 1.3;
    text-align: center;
    cursor: pointer;
    transition: color .3s ease;
  }
  .lps__tab::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--lss-gold, #bc914c);
    transform: scaleX(0);
    transition: transform .35s ease;
  }
  .lps .lps__tab:hover, .lps .lps__tab[aria-selected="true"] { color: var(--lss-fg, #f7f3ec); }
  .lps__tab[aria-selected="true"]::after { transform: scaleX(1); }
  .lps__panel { padding-top: 30px; }
  .lps__panel[hidden] { display: none; }

  .lps__notice {
    margin-bottom: 22px;
    padding: 14px 16px;
    border: 1px solid var(--lss-line, rgba(247, 243, 236, .14));
    font-size: 14px;
    line-height: 1.6;
    color: var(--lss-fg, #f7f3ec);
  }
  .lps__notice:empty { display: none; }
  .lps .lps__notice:focus { outline: none; box-shadow: none; border-color: var(--lss-gold, #bc914c); }
  .lps__lead { margin-bottom: 6px; font-size: 14px; line-height: 1.6; color: var(--lss-soft, #d6d1c8); }

  .lps__field + .lps__field, .lps__lead + .lps__form .lps__field:first-child { margin-top: 22px; }
  .lps__label-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .lps__label {
    display: block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .14em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--lss-muted, #a29f99);
  }
  .lps .lps__input {
    display: block;
    width: 100%;
    min-width: 0;
    margin: 6px 0 0;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid var(--lss-line, rgba(247, 243, 236, .14));
    border-radius: 0;
    background: transparent;
    color: var(--lss-fg, #f7f3ec);
    font: inherit;
    font-size: 16px;
    line-height: 1.4;
    box-shadow: none;
    -webkit-appearance: none;
    appearance: none;
    transition: border-color .3s ease;
  }
  .lps .lps__input:focus, .lps .lps__input:focus-visible { outline: none; border-bottom-color: var(--lss-gold, #bc914c); box-shadow: 0 1px 0 var(--lss-gold, #bc914c); }
  .lps .lps__input[aria-invalid="true"] { border-bottom-color: #e8b4a8; }
  .lps .lps__input:-webkit-autofill { -webkit-text-fill-color: var(--lss-fg, #f7f3ec); -webkit-box-shadow: 0 0 0 1000px var(--lss-bg, #0b0b09) inset; caret-color: var(--lss-fg, #f7f3ec); }
  .lps .lps__input:-webkit-autofill:focus { -webkit-box-shadow: 0 0 0 1000px var(--lss-bg, #0b0b09) inset, 0 1px 0 var(--lss-gold, #bc914c); }
  .lps__hint { margin-top: 8px; font-size: 12px; line-height: 1.5; color: var(--lss-muted, #a29f99); }
  .lps .lps__toggle {
    min-height: 24px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--lss-muted, #a29f99);
    font: inherit;
    font-size: 12px;
    text-decoration: underline;
    text-decoration-color: var(--lss-line, rgba(247, 243, 236, .14));
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color .3s ease;
  }
  .lps .lps__toggle:hover { color: var(--lss-fg, #f7f3ec); }

  .lps__hp { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  .lps__check { display: flex; align-items: flex-start; gap: 12px; margin-top: 26px; font-size: 13px; line-height: 1.55; color: var(--lss-soft, #d6d1c8); cursor: pointer; }
  .lps .lps__check input {
    -webkit-appearance: none;
    appearance: none;
    flex: none;
    display: grid;
    place-content: center;
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    border: 1px solid var(--lss-muted, #a29f99);
    border-radius: 0;
    background: transparent;
    cursor: pointer;
  }
  .lps__check input::after {
    content: "";
    width: 9px;
    height: 5px;
    border: solid var(--lss-bg, #0b0b09);
    border-width: 0 0 1.5px 1.5px;
    transform: translateY(-1px) rotate(-45deg);
    opacity: 0;
  }
  .lps .lps__check input:checked { border-color: var(--lss-gold, #bc914c); background: var(--lss-gold, #bc914c); }
  .lps__check input:checked::after { opacity: 1; }
  .lps__privacy { margin-top: 16px; font-size: 12px; line-height: 1.6; color: var(--lss-muted, #a29f99); }
  .lps .lps__privacy a { color: var(--lss-soft, #d6d1c8); text-decoration: underline; text-decoration-color: var(--lss-gold, #bc914c); text-underline-offset: 3px; }

  .lps__error { margin-top: 18px; font-size: 13px; line-height: 1.5; color: #e8b4a8; }
  .lps__error:empty { margin-top: 0; }
  .lps .lps__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 56px;
    margin: 22px 0 0;
    padding: 0 28px;
    border: 1px solid var(--lss-fg, #f7f3ec);
    border-radius: 0;
    background: var(--lss-fg, #f7f3ec);
    color: var(--lss-bg, #0b0b09);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .02em;
    cursor: pointer;
    transition: background-color .3s ease, color .3s ease;
  }
  .lps .lps__submit:hover:not([aria-disabled="true"]) { background: transparent; color: var(--lss-fg, #f7f3ec); }
  .lps .lps__submit[aria-disabled="true"] { opacity: .7; cursor: progress; }
  .lps a:focus-visible, .lps button:focus-visible, .lps .lps__check input:focus-visible { outline: 1px solid var(--lss-gold, #bc914c); outline-offset: 4px; box-shadow: none; }
  html.lps-member [data-lps-focus]:focus { outline: none; box-shadow: none; }

  .lps-editor-note { margin: 0; padding: 10px 16px; background: var(--lss-panel, #1a1916); border-bottom: 1px solid var(--lss-line, rgba(247, 243, 236, .14)); font: 12px/1.5 var(--lss-sans, Arial, sans-serif); color: var(--lss-muted, #a29f99); text-align: center; }

  @media (prefers-reduced-motion: reduce) {
    .lps__tab, .lps__tab::after, .lps .lps__input, .lps .lps__submit, .lps .lps__toggle { transition: none; }
  }
</style>

{%- if request.design_mode -%}
  {%- if lps_editor_open -%}
    <p class="lps-editor-note">Private Selection: no editor a peça está à vista sem entrar. Para ver a porta de entrada como os clientes, desligue «Mostrar o conteúdo no editor» nesta secção.</p>
  {%- else -%}
    <p class="lps-editor-note">Pré-visualização da porta de entrada. Os pedidos e as entradas feitos aqui são reais (vão para o dashboard).</p>
  {%- endif -%}
{%- endif -%}

<section
  class="lps"
  id="{{ lps_id }}"
  data-api="{{ lps_api | escape }}"
  data-locale="{{ lps_locale }}"
  data-brand="{{ lps_brand }}"
  data-editor-open="{{ lps_editor_open }}"
  aria-labelledby="{{ lps_id }}-title"
>
  <div class="lps__wrap">
    <header class="lps__head">
      <h1 class="lps__title" id="{{ lps_id }}-title" tabindex="-1" data-lps-title>
        {%- if x_title != blank -%}
          <span class="lps__name">{{ x_title }}</span>
        {%- else -%}
          <span class="lps__brand">{{ lps_brand_name }}</span> <span class="lps__name">Private Selection</span>
        {%- endif -%}
      </h1>
      <p class="lps__intro">{{ x_intro }}</p>
    </header>

    <p class="lps__checking">{{ x_checking }}</p>

    <div class="lps__body">
      <div class="lps__tabs" role="tablist" aria-labelledby="{{ lps_id }}-title">
        <button class="lps__tab" type="button" role="tab" id="{{ lps_id }}-tab-request" aria-controls="{{ lps_id }}-panel-request" aria-selected="true" data-lps-tab="request">{{ x_tab_request }}</button>
        <button class="lps__tab" type="button" role="tab" id="{{ lps_id }}-tab-login" aria-controls="{{ lps_id }}-panel-login" aria-selected="false" tabindex="-1" data-lps-tab="login">{{ x_tab_login }}</button>
      </div>

      <div class="lps__panel" role="tabpanel" id="{{ lps_id }}-panel-request" aria-labelledby="{{ lps_id }}-tab-request" data-lps-panel="request">
        <form class="lps__form" method="post" action="#" novalidate data-lps-form="request">
          <div class="lps__field">
            <label class="lps__label" for="{{ lps_id }}-name">{{ x_name }}</label>
            <input class="lps__input" id="{{ lps_id }}-name" name="name" type="text" autocomplete="name" autocapitalize="words" maxlength="120" required data-lps-field="name">
          </div>
          <div class="lps__field">
            <label class="lps__label" for="{{ lps_id }}-email">{{ x_email }}</label>
            <input class="lps__input" id="{{ lps_id }}-email" name="email" type="email" autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" maxlength="254" required data-lps-field="email">
          </div>
          <div class="lps__field">
            <label class="lps__label" for="{{ lps_id }}-phone">{{ x_phone }}</label>
            <input class="lps__input" id="{{ lps_id }}-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="32" required aria-describedby="{{ lps_id }}-phone-hint" data-lps-field="phone">
            <p class="lps__hint" id="{{ lps_id }}-phone-hint">{{ x_phone_hint }}</p>
          </div>
          <div class="lps__hp" aria-hidden="true">
            <label for="{{ lps_id }}-website">Website</label>
            <input id="{{ lps_id }}-website" name="website" type="text" tabindex="-1" autocomplete="off" data-lps-field="website">
          </div>
          <label class="lps__check">
            <input type="checkbox" name="consent_marketing" data-lps-field="consent">
            <span>{{ x_consent }}</span>
          </label>
          <p class="lps__privacy">{{ x_privacy }} <a href="{{ lps_privacy }}" target="_blank" rel="noopener">{{ x_privacy_link }}</a></p>
          <p class="lps__error" role="alert" data-lps-error></p>
          <button class="lps__submit" type="submit" data-busy="{{ x_sending | escape }}">{{ x_request_button }}</button>
        </form>
      </div>

      <div class="lps__panel" role="tabpanel" id="{{ lps_id }}-panel-login" aria-labelledby="{{ lps_id }}-tab-login" data-lps-panel="login" hidden>
        <p class="lps__notice" role="status" tabindex="-1" data-lps-notice></p>
        <p class="lps__lead">{{ x_login_hint }}</p>
        <form class="lps__form" method="post" action="#" novalidate data-lps-form="login">
          <div class="lps__field">
            <label class="lps__label" for="{{ lps_id }}-login-email">{{ x_email }}</label>
            <input class="lps__input" id="{{ lps_id }}-login-email" name="email" type="email" autocomplete="username" inputmode="email" autocapitalize="off" spellcheck="false" maxlength="254" required data-lps-field="email">
          </div>
          <div class="lps__field">
            <div class="lps__label-row">
              <label class="lps__label" for="{{ lps_id }}-password">{{ x_password }}</label>
              <button class="lps__toggle" type="button" aria-controls="{{ lps_id }}-password" data-lps-toggle data-show="{{ x_show_password | escape }}" data-hide="{{ x_hide_password | escape }}">{{ x_show_password }}</button>
            </div>
            <input class="lps__input" id="{{ lps_id }}-password" name="password" type="password" autocomplete="current-password" autocapitalize="off" spellcheck="false" maxlength="200" required data-lps-field="password">
          </div>
          <p class="lps__error" role="alert" data-lps-error></p>
          <button class="lps__submit" type="submit" data-busy="{{ x_checking | escape }}">{{ x_login_button }}</button>
        </form>
      </div>
    </div>
  </div>
</section>

<noscript>
  <style>
    #MainContent > .shopify-section:not(.lps-keep):not(.lss-header-section):not(.lps-section),
    main > .shopify-section:not(.lps-keep):not(.lss-header-section):not(.lps-section) { display: none !important; }
  </style>
  <div class="lps lps--nojs">
    <div class="lps__wrap">
      <div class="lps__head">
        <p class="lps__title">
          {%- if x_title != blank -%}
            <span class="lps__name">{{ x_title }}</span>
          {%- else -%}
            <span class="lps__brand">{{ lps_brand_name }}</span> <span class="lps__name">Private Selection</span>
          {%- endif -%}
        </p>
        <p class="lps__intro">{{ x_nojs }}</p>
      </div>
    </div>
  </div>
</noscript>

<script>
  (function () {
    var root = document.getElementById('{{ lps_id }}');
    if (!root) return;
    var html = document.documentElement;
    var api = (root.getAttribute('data-api') || '').replace(/\/+$/, '');
    var locale = root.getAttribute('data-locale') || 'pt';
    var brand = root.getAttribute('data-brand') === 'ldo' ? 'ldo' : 'gsp';
    var TTL = 5 * 60 * 1000;
    var EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    var T = {
      received: {{ x_received | json }},
      invalid_name: {{ x_err_name | json }},
      invalid_email: {{ x_err_email | json }},
      invalid_phone: {{ x_err_phone | json }},
      invalid_password: {{ x_err_password | json }},
      invalid_request: {{ x_err_request | json }},
      origin: {{ x_err_origin | json }},
      rate_limited: {{ x_err_rate | json }},
      unavailable: {{ x_err_unavailable | json }},
      invalid: {{ x_err_invalid | json }},
      locked: {{ x_err_locked | json }},
      expired: {{ x_err_expired | json }},
      network: {{ x_err_network | json }}
    };
    /* Campo a assinalar para cada código de erro */
    var FIELD = { invalid_name: 'name', invalid_email: 'email', invalid_phone: 'phone', invalid_password: 'password', invalid: 'password' };

    if (root.getAttribute('data-editor-open') === 'true') {
      html.classList.remove('lps-locked');
      html.classList.remove('lps-checking');
      return;
    }

    /* ----- Guardar no navegador (com reserva em memória se o navegador não deixar) ----- */
    var memory = {};
    function read(kind, key) {
      try {
        var value = window[kind].getItem(key);
        if (value !== null) return value;
      } catch (e) {}
      return Object.prototype.hasOwnProperty.call(memory, kind + key) ? memory[kind + key] : null;
    }
    function write(kind, key, value) {
      if (value === null) delete memory[kind + key]; else memory[kind + key] = value;
      try {
        if (value === null) window[kind].removeItem(key); else window[kind].setItem(key, value);
      } catch (e) {}
    }
    function forget() {
      write('localStorage', 'lps_token', null);
      write('sessionStorage', 'lps_ok_until', null);
    }
    function clientKey() {
      var key = read('localStorage', 'lps_client_key');
      if (key) return key;
      if (window.crypto && typeof window.crypto.randomUUID === 'function') {
        key = window.crypto.randomUUID();
      } else {
        key = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
          var r = Math.random() * 16 | 0;
          return (c === 'x' ? r : (r & 3 | 8)).toString(16);
        });
      }
      write('localStorage', 'lps_client_key', key);
      return key;
    }

    /* ----- Pedidos ao dashboard ----- */
    function call(path, body, bearer) {
      var headers = { 'Content-Type': 'application/json', Accept: 'application/json' };
      if (bearer) headers.Authorization = 'Bearer ' + bearer;
      var ctrl = typeof AbortController === 'function' ? new AbortController() : null;
      var timer = ctrl ? setTimeout(function () { ctrl.abort(); }, 20000) : null;
      function done(result) {
        if (timer) clearTimeout(timer);
        return result;
      }
      return fetch(api + '/api/private-selection/' + path, {
        method: 'POST',
        mode: 'cors',
        credentials: 'omit',
        cache: 'no-store',
        headers: headers,
        body: JSON.stringify(body || {}),
        signal: ctrl ? ctrl.signal : undefined
      }).then(function (r) {
        return r.json().then(null, function () { return {}; }).then(function (data) {
          data = data && typeof data === 'object' ? data : {};
          if (r.ok && data.ok === true) return done(data);
          var code = typeof data.code === 'string' && data.code ? data.code : '';
          if (!code) {
            if (r.status === 401) code = path === 'login' ? 'invalid' : 'expired';
            else if (r.status === 403) code = 'origin';
            else if (r.status === 429) code = 'rate_limited';
            else if (r.status >= 500) code = 'unavailable';
            else code = 'invalid_request';
          }
          return done({ ok: false, code: code, status: r.status });
        });
      }, function () {
        return done({ ok: false, code: 'network' });
      });
    }

    /* ----- Separadores ----- */
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-lps-tab]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[data-lps-panel]'));
    var reqForm = root.querySelector('[data-lps-form="request"]');
    var logForm = root.querySelector('[data-lps-form="login"]');
    var notice = root.querySelector('[data-lps-notice]');
    var title = root.querySelector('[data-lps-title]');
    var toggle = root.querySelector('[data-lps-toggle]');

    function field(form, key) { return form ? form.querySelector('[data-lps-field="' + key + '"]') : null; }

    function select(name, focusTab) {
      tabs.forEach(function (tab) {
        var on = tab.getAttribute('data-lps-tab') === name;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        if (on && focusTab) tab.focus();
      });
      panels.forEach(function (panel) { panel.hidden = panel.getAttribute('data-lps-panel') !== name; });
    }
    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () { select(tab.getAttribute('data-lps-tab'), false); });
      tab.addEventListener('keydown', function (e) {
        var n = null;
        if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
        if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
        if (e.key === 'Home') n = 0;
        if (e.key === 'End') n = tabs.length - 1;
        if (n === null) return;
        e.preventDefault();
        select(tabs[n].getAttribute('data-lps-tab'), true);
      });
    });

    /* ----- Mensagens ----- */
    function clear(form) {
      if (!form) return;
      var box = form.querySelector('[data-lps-error]');
      if (box) box.textContent = '';
      Array.prototype.forEach.call(form.querySelectorAll('[aria-invalid]'), function (el) { el.removeAttribute('aria-invalid'); });
    }
    function fail(form, code, focus) {
      if (!form) return;
      var box = form.querySelector('[data-lps-error]');
      if (box) box.textContent = T[code] || T.invalid_request;
      var el = FIELD[code] ? field(form, FIELD[code]) : null;
      if (!el) return;
      el.setAttribute('aria-invalid', 'true');
      if (focus) el.focus();
    }
    function busy(form, on) {
      var btn = form.querySelector('[type="submit"]');
      form.setAttribute('aria-busy', on ? 'true' : 'false');
      if (!btn) return;
      if (on) {
        btn.setAttribute('data-label', btn.textContent);
        btn.textContent = btn.getAttribute('data-busy');
        btn.setAttribute('aria-disabled', 'true');
      } else {
        if (btn.getAttribute('data-label')) btn.textContent = btn.getAttribute('data-label');
        btn.removeAttribute('aria-disabled');
      }
    }
    root.addEventListener('input', function (e) {
      if (e.target && e.target.removeAttribute) e.target.removeAttribute('aria-invalid');
    });

    /* ----- Porta fechada / aberta ----- */
    function checking(on) {
      if (on) html.classList.add('lps-checking'); else html.classList.remove('lps-checking');
      root.setAttribute('aria-busy', on ? 'true' : 'false');
    }
    function showGate(tab, code) {
      checking(false);
      html.classList.add('lps-locked');
      html.classList.remove('lps-member');
      select(tab, false);
      if (code) fail(tab === 'login' ? logForm : reqForm, code, false);
    }
    function unlock(moveFocus) {
      write('sessionStorage', 'lps_ok_until', String(Date.now() + TTL));
      checking(false);
      html.classList.remove('lps-locked');
      html.classList.add('lps-member');
      try { window.dispatchEvent(new Event('resize')); } catch (e) {}
      try { document.dispatchEvent(new CustomEvent('lps:unlocked')); } catch (e) {}
      if (!moveFocus) return;
      /* Leva o foco para o título da peça (o primeiro h1 fora da porta) e volta ao topo */
      var heads = document.querySelectorAll('#MainContent h1, main h1');
      for (var i = 0; i < heads.length; i++) {
        if (!root.contains(heads[i]) && heads[i].getClientRects().length) {
          heads[i].setAttribute('tabindex', '-1');
          heads[i].setAttribute('data-lps-focus', '');
          try { heads[i].focus({ preventScroll: true }); } catch (e) { heads[i].focus(); }
          break;
        }
      }
      window.scrollTo(0, 0);
    }
    function verify() {
      var token = read('localStorage', 'lps_token');
      if (!token) {
        showGate(read('localStorage', 'lps_email') ? 'login' : 'request');
        return;
      }
      checking(true);
      call('session', {}, token).then(function (res) {
        if (res.ok) return unlock(false);
        /* Sessão recusada: apaga o token. Falha de rede ou serviço: guarda-o para a próxima tentativa. */
        if (res.code === 'expired' || res.status === 401) forget();
        showGate('login', res.code === 'expired' || res.status === 401 ? 'expired' : res.code);
      });
    }

    /* ----- Pedir acesso ----- */
    if (reqForm) reqForm.addEventListener('submit', function (e) {
      e.preventDefault();
      if (reqForm.getAttribute('aria-busy') === 'true') return;
      clear(reqForm);
      var name = (field(reqForm, 'name').value || '').replace(/\s+/g, ' ').trim();
      var email = (field(reqForm, 'email').value || '').trim();
      var phone = (field(reqForm, 'phone').value || '').trim();
      var consent = field(reqForm, 'consent');
      var trap = field(reqForm, 'website');
      if (name.length < 2) return fail(reqForm, 'invalid_name', true);
      if (!EMAIL.test(email)) return fail(reqForm, 'invalid_email', true);
      if (phone.replace(/\D/g, '').length < 8) return fail(reqForm, 'invalid_phone', true);
      busy(reqForm, true);
      call('request', {
        name: name,
        email: email,
        phone: phone,
        locale: locale,
        brand: brand,
        consent_marketing: !!(consent && consent.checked),
        client_key: clientKey(),
        website: trap ? trap.value : ''
      }).then(function (res) {
        busy(reqForm, false);
        if (!res.ok) return fail(reqForm, res.code, true);
        write('localStorage', 'lps_email', email);
        reqForm.reset();
        var loginEmail = field(logForm, 'email');
        if (loginEmail) loginEmail.value = email;
        clear(logForm);
        select('login', false);
        if (notice) {
          notice.textContent = T.received;
          notice.focus();
        }
      });
    });

    /* ----- Já tenho acesso ----- */
    if (logForm) logForm.addEventListener('submit', function (e) {
      e.preventDefault();
      if (logForm.getAttribute('aria-busy') === 'true') return;
      clear(logForm);
      var emailEl = field(logForm, 'email');
      var passEl = field(logForm, 'password');
      var email = (emailEl.value || '').trim();
      var password = passEl.value || '';
      if (!EMAIL.test(email)) return fail(logForm, 'invalid_email', true);
      if (!password) return fail(logForm, 'invalid_password', true);
      busy(logForm, true);
      call('login', { email: email, password: password }).then(function (res) {
        busy(logForm, false);
        if (res.ok && res.token) {
          write('localStorage', 'lps_token', String(res.token));
          write('localStorage', 'lps_email', email);
          passEl.value = '';
          passEl.type = 'password';
          if (toggle) toggle.textContent = toggle.getAttribute('data-show');
          if (notice) notice.textContent = '';
          unlock(true);
          return;
        }
        fail(logForm, res.ok ? 'unavailable' : res.code, true);
      });
    });

    if (toggle) toggle.addEventListener('click', function () {
      var passEl = field(logForm, 'password');
      if (!passEl) return;
      var show = passEl.type === 'password';
      passEl.type = show ? 'text' : 'password';
      toggle.textContent = toggle.getAttribute(show ? 'data-hide' : 'data-show');
    });

    /* ----- Terminar sessão (chamado pelo cabeçalho) ----- */
    window.lpsLogout = function () {
      var token = read('localStorage', 'lps_token');
      forget();
      write('localStorage', 'lps_email', null);
      if (token) call('logout', {}, token);
      clear(reqForm);
      clear(logForm);
      if (notice) notice.textContent = '';
      var loginEmail = field(logForm, 'email');
      if (loginEmail) loginEmail.value = '';
      showGate('login');
      window.scrollTo(0, 0);
      if (title) title.focus();
    };

    /* ----- Arranque ----- */
    var saved = read('localStorage', 'lps_email');
    var savedField = field(logForm, 'email');
    if (saved && savedField && !savedField.value) savedField.value = saved;
    if (html.classList.contains('lps-locked')) verify();

    /* Página reposta pelo botão «Voltar» (cache do navegador): os scripts não voltam a correr,
       por isso confirma de novo (ex.: terminou a sessão noutra página, ou entrou noutra página). */
    window.addEventListener('pageshow', function (e) {
      if (!e.persisted) return;
      /* A memória desta página pode estar antiga; se o navegador deixa ler, vale o que está guardado. */
      try {
        window.localStorage.getItem('lps_token');
        window.sessionStorage.getItem('lps_ok_until');
        memory = {};
      } catch (err) {}
      var token = read('localStorage', 'lps_token');
      var until = Number(read('sessionStorage', 'lps_ok_until')) || 0;
      var locked = html.classList.contains('lps-locked');
      if (!token) {
        if (!locked || html.classList.contains('lps-checking')) showGate(read('localStorage', 'lps_email') ? 'login' : 'request');
        return;
      }
      if (!locked && until > Date.now()) return;
      html.classList.add('lps-locked');
      html.classList.remove('lps-member');
      verify();
    });
  })();
</script>

