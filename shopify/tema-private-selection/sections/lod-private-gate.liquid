<script>
  /* Antes de a página aparecer: fecha a porta, a não ser que haja uma confirmação válida (5 min). */
  (function () {
    var d = document.documentElement;
    var token = null;
    var until = 0;
    try {
      token = window.localStorage.getItem('lps_token');
      until = Number(window.sessionStorage.getItem('lps_ok_until')) || 0;
    } catch (e) {}
    d.classList.remove('lps-checking');
    if ({{ lps_editor_open }}) {
      d.classList.remove('lps-locked');
    } else if (token && until > Date.now()) {
      d.classList.remove('lps-locked');
      d.classList.add('lps-member');
    } else {
      d.classList.add('lps-locked');
      d.classList.remove('lps-member');
      if (token) d.classList.add('lps-checking');
    }
  })();
</script>

