    "custom_liquid_UpFHrA": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- assign ldo_lang = request.locale.iso_code | slice: 0, 2 | downcase -%}\n\n{%- case ldo_lang -%}\n  {%- when 'en' -%}\n    {%- assign ldo_kicker = 'Journal' -%}\n    {%- assign ldo_title = 'Stories, inspiration & expertise' -%}\n    {%- assign ldo_intro = 'Discover guides, trends and insights on jewellery, watches, precious metals and investment gold.' -%}\n    {%- assign ldo_read = 'Read article' -%}\n    {%- assign ldo_all = 'Explore the journal' -%}\n  {%- when 'es' -%}\n    {%- assign ldo_kicker = 'Journal' -%}\n    {%- assign ldo_title = 'Historias, inspiración y conocimiento' -%}\n    {%- assign ldo_intro = 'Descubra guías, tendencias y contenidos sobre joyería, relojes, metales preciosos y oro de inversión.' -%}\n    {%- assign ldo_read = 'Leer artículo' -%}\n    {%- assign ldo_all = 'Explorar el journal' -%}\n  {%- when 'fr' -%}\n    {%- assign ldo_kicker = 'Journal' -%}\n    {%- assign ldo_title = 'Histoires, inspiration & expertise' -%}\n    {%- assign ldo_intro = 'Découvrez nos guides, tendances et conseils autour de la joaillerie, des montres, des métaux précieux et de l’or d’investissement.' -%}\n    {%- assign ldo_read = 'Lire l’article' -%}\n    {%- assign ldo_all = 'Découvrir le journal' -%}\n  {%- when 'de' -%}\n    {%- assign ldo_kicker = 'Journal' -%}\n    {%- assign ldo_title = 'Geschichten, Inspiration & Expertise' -%}\n    {%- assign ldo_intro = 'Entdecken Sie Ratgeber, Trends und Wissen rund um Schmuck, Uhren, Edelmetalle und Anlagegold.' -%}\n    {%- assign ldo_read = 'Artikel lesen' -%}\n    {%- assign ldo_all = 'Journal entdecken' -%}\n  {%- else -%}\n    {%- assign ldo_kicker = 'Journal' -%}\n    {%- assign ldo_title = 'Histórias, inspiração & conhecimento' -%}\n    {%- assign ldo_intro = 'Descubra guias, tendências e conhecimento sobre joalharia, relógios, metais preciosos e ouro de investimento.' -%}\n    {%- assign ldo_read = 'Ler artigo' -%}\n    {%- assign ldo_all = 'Explorar o journal' -%}\n{%- endcase -%}\n\n{%- assign ldo_blog = blogs['lojadoouro'] -%}\n\n<style>\n  .ldo-journal{\n    --ink:#211b16;\n    --muted:#746a61;\n    --gold:#a77a32;\n    --gold2:#d8c39d;\n    --ivory:#faf7f1;\n    --line:rgba(167,122,50,.22);\n    --paper:#fff;\n    background:linear-gradient(180deg,#fff 0%,var(--ivory) 100%);\n    color:var(--ink);\n    padding:clamp(56px,7vw,92px) 0;\n    overflow:hidden;\n  }\n  .ldo-journal *{box-sizing:border-box}\n  .ldo-journal__wrap{\n    width:min(1180px,calc(100% - 44px));\n    margin:auto;\n  }\n  .ldo-journal__head{\n    display:grid;\n    grid-template-columns:minmax(0,1fr) minmax(280px,.72fr);\n    gap:48px;\n    align-items:end;\n    margin-bottom:38px;\n  }\n  .ldo-journal__kicker{\n    margin:0 0 12px;\n    font:700 10px/1 Arial,Helvetica,sans-serif;\n    letter-spacing:.24em;\n    text-transform:uppercase;\n    color:var(--gold);\n  }\n  .ldo-journal__title{\n    margin:0;\n    font:400 clamp(38px,5vw,62px)/1.04 Georgia,\"Times New Roman\",serif;\n    letter-spacing:-.03em;\n    color:var(--ink);\n  }\n  .ldo-journal__intro{\n    margin:0;\n    max-width:520px;\n    color:var(--muted);\n    font:400 15px/1.75 Arial,Helvetica,sans-serif;\n  }\n  .ldo-journal__grid{\n    display:grid;\n    grid-template-columns:repeat(12,minmax(0,1fr));\n    gap:18px;\n  }\n  .ldo-journal__card{\n    grid-column:span 4;\n    display:flex;\n    flex-direction:column;\n    min-width:0;\n    background:var(--paper);\n    border:1px solid var(--line);\n    text-decoration:none;\n    color:inherit;\n    box-shadow:0 18px 45px rgba(43,31,20,.045);\n    transition:transform .35s ease,box-shadow .35s ease,border-color .35s ease;\n  }\n  .ldo-journal__card:hover{\n    transform:translateY(-6px);\n    box-shadow:0 24px 56px rgba(43,31,20,.085);\n    border-color:rgba(167,122,50,.5);\n  }\n  .ldo-journal__media{\n    position:relative;\n    aspect-ratio:16/10;\n    overflow:hidden;\n    background:#eee8df;\n  }\n  .ldo-journal__media:after{\n    content:\"\";\n    position:absolute;\n    inset:auto 0 0 0;\n    height:34%;\n    background:linear-gradient(180deg,transparent,rgba(0,0,0,.08));\n    pointer-events:none;\n  }\n  .ldo-journal__img{\n    width:100%;\n    height:100%;\n    display:block;\n    object-fit:cover;\n    transition:transform .65s cubic-bezier(.2,.65,.3,1);\n  }\n  .ldo-journal__card:hover .ldo-journal__img{transform:scale(1.045)}\n  .ldo-journal__body{\n    display:flex;\n    flex:1;\n    flex-direction:column;\n    padding:24px 24px 25px;\n  }\n  .ldo-journal__date{\n    margin:0 0 10px;\n    color:var(--gold);\n    font:700 9px/1.4 Arial,Helvetica,sans-serif;\n    letter-spacing:.15em;\n    text-transform:uppercase;\n  }\n  .ldo-journal__article-title{\n    margin:0 0 13px;\n    color:var(--ink);\n    font:400 clamp(23px,2.1vw,30px)/1.18 Georgia,\"Times New Roman\",serif;\n    letter-spacing:-.015em;\n    display:-webkit-box;\n    -webkit-box-orient:vertical;\n    -webkit-line-clamp:3;\n    overflow:hidden;\n  }\n  .ldo-journal__excerpt{\n    margin:0 0 22px;\n    color:var(--muted);\n    font:400 14px/1.7 Arial,Helvetica,sans-serif;\n    display:-webkit-box;\n    -webkit-box-orient:vertical;\n    -webkit-line-clamp:3;\n    overflow:hidden;\n  }\n  .ldo-journal__cta{\n    display:flex;\n    align-items:center;\n    gap:11px;\n    width:max-content;\n    margin-top:auto;\n    padding-top:2px;\n    color:var(--ink);\n    font:700 10px/1.3 Arial,Helvetica,sans-serif;\n    letter-spacing:.14em;\n    text-transform:uppercase;\n  }\n  .ldo-journal__cta:after{\n    content:\"\";\n    width:28px;\n    height:1px;\n    background:var(--gold);\n    transition:width .25s ease;\n  }\n  .ldo-journal__card:hover .ldo-journal__cta:after{width:40px}\n  .ldo-journal__footer{\n    display:flex;\n    justify-content:center;\n    margin-top:34px;\n  }\n  .ldo-journal__all{\n    display:inline-flex;\n    align-items:center;\n    gap:12px;\n    padding:13px 18px;\n    border:1px solid var(--gold2);\n    color:var(--ink);\n    background:rgba(255,255,255,.55);\n    text-decoration:none;\n    font:700 10px/1 Arial,Helvetica,sans-serif;\n    letter-spacing:.14em;\n    text-transform:uppercase;\n    transition:.25s ease;\n  }\n  .ldo-journal__all:hover{\n    background:var(--ink);\n    border-color:var(--ink);\n    color:#fff;\n  }\n  .ldo-journal__empty{\n    grid-column:1/-1;\n    padding:28px;\n    border:1px solid var(--line);\n    background:#fff;\n    color:var(--muted);\n  }\n\n  @media(max-width:900px){\n    .ldo-journal__head{grid-template-columns:1fr;gap:16px}\n    .ldo-journal__card{grid-column:span 6}\n    .ldo-journal__card:nth-child(3){grid-column:1/-1}\n    .ldo-journal__card:nth-child(3){display:grid;grid-template-columns:1fr 1fr}\n    .ldo-journal__card:nth-child(3) .ldo-journal__media{aspect-ratio:auto;min-height:280px}\n  }\n\n  @media(max-width:620px){\n    .ldo-journal{\n      padding:48px 0 54px;\n    }\n    .ldo-journal__wrap{\n      width:calc(100% - 28px);\n    }\n    .ldo-journal__head{\n      margin-bottom:26px;\n    }\n    .ldo-journal__intro{\n      font-size:14px;\n    }\n    .ldo-journal__grid{\n      display:flex;\n      gap:14px;\n      overflow-x:auto;\n      scroll-snap-type:x mandatory;\n      padding:0 14px 8px;\n      margin:0 -14px;\n      scrollbar-width:none;\n    }\n    .ldo-journal__grid::-webkit-scrollbar{display:none}\n    .ldo-journal__card,\n    .ldo-journal__card:nth-child(3){\n      display:flex;\n      flex:0 0 86%;\n      scroll-snap-align:start;\n    }\n    .ldo-journal__card:nth-child(3) .ldo-journal__media{\n      aspect-ratio:16/10;\n      min-height:0;\n    }\n    .ldo-journal__body{\n      padding:20px 19px 22px;\n    }\n    .ldo-journal__article-title{\n      font-size:24px;\n    }\n  }\n\n  @media(prefers-reduced-motion:reduce){\n    .ldo-journal__card,\n    .ldo-journal__img,\n    .ldo-journal__cta:after{transition:none!important}\n  }\n</style>\n\n<section class=\"ldo-journal\" aria-labelledby=\"ldo-journal-title\">\n  <div class=\"ldo-journal__wrap\">\n\n    <div class=\"ldo-journal__head\">\n      <div>\n        <p class=\"ldo-journal__kicker\">{{ ldo_kicker }}</p>\n        <h2 class=\"ldo-journal__title\" id=\"ldo-journal-title\">{{ ldo_title }}</h2>\n      </div>\n      <p class=\"ldo-journal__intro\">{{ ldo_intro }}</p>\n    </div>\n\n    <div class=\"ldo-journal__grid\">\n      {%- if ldo_blog != blank and ldo_blog.articles_count > 0 -%}\n        {%- for article in ldo_blog.articles limit: 3 -%}\n          <a class=\"ldo-journal__card\" href=\"{{ article.url }}\">\n            <div class=\"ldo-journal__media\">\n              {%- if article.image -%}\n                {%- assign ldo_alt = article.image.alt | default: article.title -%}\n                {{\n                  article.image\n                  | image_url: width: 1200\n                  | image_tag:\n                    class: 'ldo-journal__img',\n                    loading: 'lazy',\n                    widths: '420, 640, 800, 1000, 1200',\n                    sizes: '(max-width: 620px) 86vw, (max-width: 900px) 50vw, 33vw',\n                    alt: ldo_alt\n                }}\n              {%- endif -%}\n            </div>\n\n            <div class=\"ldo-journal__body\">\n              <p class=\"ldo-journal__date\">\n                {{ article.published_at | date: '%d.%m.%Y' }}\n              </p>\n\n              <h3 class=\"ldo-journal__article-title\">{{ article.title }}</h3>\n\n              {%- assign ldo_excerpt = article.excerpt_or_content | strip_html | strip -%}\n              {%- if ldo_excerpt != blank -%}\n                <p class=\"ldo-journal__excerpt\">\n                  {{ ldo_excerpt | truncate: 150 }}\n                </p>\n              {%- endif -%}\n\n              <span class=\"ldo-journal__cta\">{{ ldo_read }}</span>\n            </div>\n          </a>\n        {%- endfor -%}\n      {%- else -%}\n        <div class=\"ldo-journal__empty\">\n          Blog não encontrado. Confirme que o handle do blogue Shopify é <strong>lojadoouro</strong>.\n        </div>\n      {%- endif -%}\n    </div>\n\n    {%- if ldo_blog != blank -%}\n      <div class=\"ldo-journal__footer\">\n        <a class=\"ldo-journal__all\" href=\"{{ ldo_blog.url }}\">{{ ldo_all }}</a>\n      </div>\n    {%- endif -%}\n\n  </div>\n</section>",
        "color_scheme": "",
