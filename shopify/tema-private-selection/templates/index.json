    "custom_liquid_NJCFDj": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign locale_code = request.locale.iso_code | downcase %}\n\n{%- comment -%}\n=========================================================\nLOJA DO OURO / GOLD STORE PREMIUM\nHOMEPAGE — HERO OURO, JOIAS E INVESTIMENTO\nPT / EN / ES / FR / DE / IT\n=========================================================\n{%- endcomment -%}\n\n{% assign hero_brand = 'Loja do Ouro' %}\n{% assign hero_eyebrow = 'O UNIVERSO DO OURO' %}\n{% assign hero_title = 'Ouro que inspira. Valor que permanece.' %}\n{% assign hero_text = 'Descubra o ouro em todas as suas formas. Das joias que eternizam momentos às moedas e barras que atravessam gerações. Beleza, tradição e valor num só lugar.' %}\n{% assign hero_cta = 'Explorar coleções' %}\n{% assign hero_signature = 'Seleção Loja do Ouro' %}\n\n{% if locale_code contains 'en' %}\n\n  {% assign hero_brand = 'Gold Store Premium' %}\n  {% assign hero_eyebrow = 'THE WORLD OF GOLD' %}\n  {% assign hero_title = 'Gold that inspires. Value that endures.' %}\n  {% assign hero_text = 'Discover gold in all its forms. From jewellery that captures special moments to coins and bars that transcend generations. Beauty, tradition and value in one place.' %}\n  {% assign hero_cta = 'Explore collections' %}\n  {% assign hero_signature = 'Gold Store Premium Selection' %}\n\n{% elsif locale_code contains 'es' %}\n\n  {% assign hero_brand = 'Gold Store Premium' %}\n  {% assign hero_eyebrow = 'EL UNIVERSO DEL ORO' %}\n  {% assign hero_title = 'Oro que inspira. Valor que perdura.' %}\n  {% assign hero_text = 'Descubra el oro en todas sus formas. Desde joyas que eternizan momentos hasta monedas y lingotes que trascienden generaciones. Belleza, tradición y valor en un solo lugar.' %}\n  {% assign hero_cta = 'Explorar colecciones' %}\n  {% assign hero_signature = 'Selección Gold Store Premium' %}\n\n{% elsif locale_code contains 'fr' %}\n\n  {% assign hero_brand = 'Gold Store Premium' %}\n  {% assign hero_eyebrow = 'L’UNIVERS DE L’OR' %}\n  {% assign hero_title = 'L’or qui inspire. La valeur qui demeure.' %}\n  {% assign hero_text = 'Découvrez l’or sous toutes ses formes. Des bijoux qui immortalisent les instants précieux aux pièces et lingots qui traversent les générations. Beauté, tradition et valeur réunies.' %}\n  {% assign hero_cta = 'Explorer les collections' %}\n  {% assign hero_signature = 'Sélection Gold Store Premium' %}\n\n{% elsif locale_code contains 'de' %}\n\n  {% assign hero_brand = 'Gold Store Premium' %}\n  {% assign hero_eyebrow = 'DIE WELT DES GOLDES' %}\n  {% assign hero_title = 'Gold, das inspiriert. Wert, der bleibt.' %}\n  {% assign hero_text = 'Entdecken Sie Gold in all seinen Facetten. Von Schmuck, der besondere Momente verewigt, bis hin zu Münzen und Barren, die Generationen überdauern. Schönheit, Tradition und Wert an einem Ort.' %}\n  {% assign hero_cta = 'Kollektionen entdecken' %}\n  {% assign hero_signature = 'Gold Store Premium Auswahl' %}\n\n{% elsif locale_code contains 'it' %}\n\n  {% assign hero_brand = 'Gold Store Premium' %}\n  {% assign hero_eyebrow = 'IL MONDO DELL’ORO' %}\n  {% assign hero_title = 'Oro che ispira. Valore che dura.' %}\n  {% assign hero_text = 'Scopra l’oro in tutte le sue forme. Dai gioielli che rendono eterni i momenti speciali alle monete e ai lingotti che attraversano le generazioni. Bellezza, tradizione e valore in un unico luogo.' %}\n  {% assign hero_cta = 'Esplora le collezioni' %}\n  {% assign hero_signature = 'Selezione Gold Store Premium' %}\n\n{% endif %}\n\n<section\n  class=\"lod-premium-hero\"\n  aria-label=\"{{ hero_eyebrow | escape }}\"\n>\n\n  <!-- IMAGENS DESKTOP E MOBILE -->\n\n  <div class=\"lod-premium-hero__media\">\n\n    <picture>\n\n      <source\n        media=\"(max-width: 749px)\"\n        srcset=\"https://cdn.shopify.com/s/files/1/0933/8811/2256/files/trio_de_ouro_ao_sol_mediterr_C3_A2nico_1.webp?v=1791542438\"\n      >\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0933/8811/2256/files/NOVO_banner_desktop_geral_1920_x_1080_px_14.jpg?v=1791540559\"\n        alt=\"{{ hero_title | escape }}\"\n        width=\"1920\"\n        height=\"1080\"\n        loading=\"eager\"\n        fetchpriority=\"high\"\n      >\n\n    </picture>\n\n  </div>\n\n  <!-- OVERLAY -->\n\n  <div class=\"lod-premium-hero__overlay\"></div>\n\n  <!-- CONTEUDO PRINCIPAL -->\n\n  <div class=\"lod-premium-hero__inner\">\n\n    <div class=\"lod-premium-hero__content\">\n\n      <!-- SUBTITULO -->\n\n      <div class=\"lod-premium-hero__eyebrow\">\n        <span></span>\n        {{ hero_eyebrow }}\n      </div>\n\n      <!-- TITULO -->\n\n      <h1 class=\"lod-premium-hero__title\">\n        {{ hero_title }}\n      </h1>\n\n      <!-- DESCRICAO -->\n\n      <p class=\"lod-premium-hero__description\">\n        {{ hero_text }}\n      </p>\n\n      <!-- BOTAO COM LINK ORIGINAL -->\n\n      <a\n        href=\"https://www.lojadoouro.pt/collections/novidades\"\n        class=\"lod-premium-hero__cta\"\n        aria-label=\"{{ hero_cta | escape }}\"\n      >\n\n        <span>{{ hero_cta }}</span>\n\n        <svg\n          width=\"18\"\n          height=\"18\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          aria-hidden=\"true\"\n        >\n          <path\n            d=\"M5 12H19M12 5L19 12L12 19\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.5\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n        </svg>\n\n      </a>\n\n      <!-- ASSINATURA -->\n\n      <div class=\"lod-premium-hero__signature\">\n\n        <span class=\"lod-premium-hero__signature-mark\">\n          ◇\n        </span>\n\n        {{ hero_signature }}\n\n      </div>\n\n    </div>\n\n  </div>\n\n  <!-- MARCA LATERAL -->\n\n  <div\n    class=\"lod-premium-hero__side-label\"\n    aria-hidden=\"true\"\n  >\n    {{ hero_brand }}\n  </div>\n\n</section>\n\n\n<style>\n\n/* =========================================\n   LOJA DO OURO — PREMIUM HERO\n   ========================================= */\n\n.lod-premium-hero {\n  --lod-gold: #c59a57;\n  --lod-gold-light: #e7c790;\n  --lod-gold-dark: #a9793f;\n  --lod-dark: #130d09;\n  --lod-dark-soft: #1b130e;\n\n  position: relative;\n  width: 100%;\n  min-height: 670px;\n  height: clamp(670px, 52vw, 860px);\n  overflow: hidden;\n  background: var(--lod-dark);\n  isolation: isolate;\n}\n\n/* =========================================\n   IMAGEM\n   ========================================= */\n\n.lod-premium-hero__media,\n.lod-premium-hero__media picture {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n}\n\n.lod-premium-hero__media img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center center;\n  transform: scale(1.01);\n\n  transition:\n    transform 8s cubic-bezier(.2,.65,.25,1);\n}\n\n/* PREMIUM ZOOM */\n\n@media (hover: hover) {\n  .lod-premium-hero:hover\n  .lod-premium-hero__media img {\n    transform: scale(1.04);\n  }\n}\n\n/* =========================================\n   OVERLAY\n   ========================================= */\n\n.lod-premium-hero__overlay {\n  position: absolute;\n  inset: 0;\n  z-index: 1;\n  pointer-events: none;\n\n  background:\n    linear-gradient(\n      90deg,\n      rgba(10,7,5,.75) 0%,\n      rgba(10,7,5,.58) 23%,\n      rgba(10,7,5,.30) 42%,\n      rgba(10,7,5,.10) 60%,\n      rgba(10,7,5,0) 77%\n    ),\n    linear-gradient(\n      180deg,\n      rgba(8,6,5,.03) 0%,\n      rgba(8,6,5,.06) 48%,\n      rgba(8,6,5,.24) 100%\n    );\n}\n\n/* =========================================\n   INNER\n   ========================================= */\n\n.lod-premium-hero__inner {\n  position: relative;\n  z-index: 3;\n  width: min(92%, 1600px);\n  height: 100%;\n  margin: 0 auto;\n\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n  padding: 30px 0;\n}\n\n/* =========================================\n   CAIXA CASTANHA PREMIUM\n   ========================================= */\n\n.lod-premium-hero__content {\n  position: relative;\n  width: min(540px, 100%);\n  padding: clamp(28px, 3vw, 42px);\n  border-radius: 28px;\n\n  background:\n    linear-gradient(\n      160deg,\n      rgba(22,15,11,.72) 0%,\n      rgba(22,15,11,.55) 48%,\n      rgba(22,15,11,.40) 100%\n    );\n\n  border:\n    1px solid rgba(231,199,144,.18);\n\n  box-shadow:\n    0 20px 60px rgba(0,0,0,.22),\n    inset 0 1px 0 rgba(255,255,255,.05);\n\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n}\n\n/* SEM REBORDOS DECORATIVOS NOS CANTOS */\n\n.lod-premium-hero__content::before,\n.lod-premium-hero__content::after {\n  display: none !important;\n  content: none !important;\n}\n\n/* =========================================\n   EYEBROW\n   ========================================= */\n\n.lod-premium-hero__eyebrow {\n  display: inline-flex;\n  align-items: center;\n  gap: 14px;\n  margin-bottom: 17px;\n\n  font-size: 11px;\n  line-height: 1;\n  font-weight: 600;\n  letter-spacing: .28em;\n  text-transform: uppercase;\n  color: var(--lod-gold-light);\n}\n\n.lod-premium-hero__eyebrow span {\n  display: block;\n  width: 38px;\n  height: 1px;\n\n  background:\n    linear-gradient(\n      90deg,\n      var(--lod-gold-dark),\n      var(--lod-gold-light)\n    );\n}\n\n/* =========================================\n   TITULO PREMIUM\n   ========================================= */\n\n.lod-premium-hero__title {\n  margin: 0;\n  max-width: 470px;\n\n  font-family:\n    \"Iowan Old Style\",\n    Baskerville,\n    \"Times New Roman\",\n    Georgia,\n    serif;\n\n  font-size: clamp(46px, 4.7vw, 74px);\n  line-height: .96;\n  font-weight: 400;\n  letter-spacing: -.04em;\n  color: #ffffff;\n  text-wrap: balance;\n\n  text-shadow:\n    0 8px 24px rgba(0,0,0,.17);\n}\n\n/* =========================================\n   DESCRICAO\n   ========================================= */\n\n.lod-premium-hero__description {\n  max-width: 455px;\n  margin: 22px 0 28px;\n\n  font-size: clamp(15px, 1.05vw, 18px);\n  line-height: 1.68;\n  font-weight: 300;\n  letter-spacing: .01em;\n\n  color: rgba(255,255,255,.86);\n}\n\n/* =========================================\n   BOTAO PREMIUM\n   ========================================= */\n\n.lod-premium-hero__cta {\n  appearance: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 16px;\n\n  min-height: 56px;\n  padding: 0 26px;\n  border-radius: 999px;\n  text-decoration: none !important;\n\n  border:\n    1px solid rgba(231,199,144,.52);\n\n  background:\n    linear-gradient(\n      135deg,\n      rgba(197,154,87,.18) 0%,\n      rgba(197,154,87,.08) 100%\n    );\n\n  color: #ffffff;\n\n  font-size: 12px;\n  line-height: 1;\n  font-weight: 600;\n  letter-spacing: .16em;\n  text-transform: uppercase;\n\n  backdrop-filter: blur(8px);\n  -webkit-backdrop-filter: blur(8px);\n\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.08),\n    0 10px 30px rgba(0,0,0,.14);\n\n  transition:\n    transform .35s ease,\n    background .35s ease,\n    border-color .35s ease,\n    box-shadow .35s ease;\n}\n\n.lod-premium-hero__cta:visited {\n  color: #ffffff;\n}\n\n.lod-premium-hero__cta svg {\n  flex: 0 0 auto;\n  transition: transform .35s ease;\n}\n\n.lod-premium-hero__cta:hover {\n  transform: translateY(-2px);\n\n  background:\n    linear-gradient(\n      135deg,\n      #d4a45f 0%,\n      #b98747 100%\n    );\n\n  border-color: #d4a45f;\n\n  box-shadow:\n    0 18px 40px rgba(0,0,0,.20),\n    0 4px 14px rgba(212,164,95,.16);\n}\n\n.lod-premium-hero__cta:hover svg {\n  transform: translateX(4px);\n}\n\n/* =========================================\n   ASSINATURA\n   ========================================= */\n\n.lod-premium-hero__signature {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  margin-top: 20px;\n\n  font-size: 9px;\n  line-height: 1;\n  font-weight: 500;\n  letter-spacing: .17em;\n  text-transform: uppercase;\n  color: rgba(255,255,255,.50);\n}\n\n.lod-premium-hero__signature-mark {\n  color: var(--lod-gold-light);\n  font-size: 15px;\n}\n\n/* =========================================\n   MARCA LATERAL\n   ========================================= */\n\n.lod-premium-hero__side-label {\n  position: absolute;\n  z-index: 3;\n  right: 27px;\n  bottom: 39px;\n\n  writing-mode: vertical-rl;\n  transform: rotate(180deg);\n\n  font-size: 8px;\n  font-weight: 500;\n  letter-spacing: .30em;\n  text-transform: uppercase;\n\n  color: rgba(255,255,255,.35);\n}\n\n/* =========================================\n   TABLET\n   ========================================= */\n\n@media screen and (max-width: 1080px) {\n\n  .lod-premium-hero {\n    min-height: 640px;\n    height: 720px;\n  }\n\n  .lod-premium-hero__inner {\n    width: min(92%, 1360px);\n  }\n\n  .lod-premium-hero__content {\n    width: min(500px, 100%);\n  }\n\n  .lod-premium-hero__title {\n    font-size: clamp(42px, 5.4vw, 64px);\n  }\n\n}\n\n/* =========================================\n   MOBILE\n   ========================================= */\n\n@media screen and (max-width: 749px) {\n\n  .lod-premium-hero {\n    min-height: 760px;\n    height: min(900px, 96svh);\n    background: #140f0b;\n  }\n\n  /* IMAGEM MOBILE */\n\n  .lod-premium-hero__media img {\n    object-position: center 15%;\n    transform: none;\n  }\n\n  /* OVERLAY MOBILE */\n\n  .lod-premium-hero__overlay {\n    background:\n      linear-gradient(\n        180deg,\n        rgba(10,7,5,0) 0%,\n        rgba(10,7,5,0) 42%,\n        rgba(10,7,5,.06) 54%,\n        rgba(10,7,5,.22) 65%,\n        rgba(10,7,5,.55) 78%,\n        rgba(10,7,5,.82) 100%\n      );\n  }\n\n  /* POSICIONAMENTO */\n\n  .lod-premium-hero__inner {\n    width: 100%;\n    height: 100%;\n    align-items: flex-end;\n    padding: 0;\n  }\n\n  /* CAIXA CASTANHA MOBILE */\n\n  .lod-premium-hero__content {\n    width: calc(100% - 20px);\n    margin: 0 10px 10px;\n    padding: 20px 16px 18px;\n    border-radius: 22px;\n\n    background:\n      linear-gradient(\n        180deg,\n        rgba(19,13,9,.72) 0%,\n        rgba(19,13,9,.86) 100%\n      );\n\n    box-shadow:\n      0 18px 50px rgba(0,0,0,.20),\n      inset 0 1px 0 rgba(255,255,255,.04);\n  }\n\n  /* SUBTITULO MOBILE */\n\n  .lod-premium-hero__eyebrow {\n    margin-bottom: 10px;\n    font-size: 9px;\n    letter-spacing: .23em;\n  }\n\n  .lod-premium-hero__eyebrow span {\n    width: 26px;\n  }\n\n  /* TITULO MOBILE */\n\n  .lod-premium-hero__title {\n    max-width: 100%;\n    font-size: clamp(31px, 9.2vw, 42px);\n    line-height: 1;\n    letter-spacing: -.03em;\n  }\n\n  /* DESCRICAO MOBILE */\n\n  .lod-premium-hero__description {\n    max-width: 100%;\n    margin: 14px 0 18px;\n    font-size: 13px;\n    line-height: 1.52;\n  }\n\n  /* BOTAO MOBILE */\n\n  .lod-premium-hero__cta {\n    width: 100%;\n    min-height: 52px;\n    padding: 0 16px;\n    font-size: 10.5px;\n    letter-spacing: .13em;\n  }\n\n  /* ASSINATURA MOBILE */\n\n  .lod-premium-hero__signature {\n    margin-top: 15px;\n    font-size: 8px;\n    letter-spacing: .14em;\n  }\n\n  .lod-premium-hero__side-label {\n    display: none;\n  }\n\n}\n\n/* =========================================\n   MOBILE PEQUENO\n   ========================================= */\n\n@media screen and (max-width: 390px) {\n\n  .lod-premium-hero {\n    min-height: 720px;\n  }\n\n  .lod-premium-hero__media img {\n    object-position: center 13%;\n  }\n\n  .lod-premium-hero__content {\n    width: calc(100% - 16px);\n    margin: 0 8px 8px;\n    padding: 18px 14px 16px;\n  }\n\n  .lod-premium-hero__title {\n    font-size: 29px;\n  }\n\n  .lod-premium-hero__description {\n    font-size: 12.5px;\n  }\n\n  .lod-premium-hero__cta {\n    font-size: 10px;\n  }\n\n}\n\n/* =========================================\n   DESKTOP GRANDE\n   ========================================= */\n\n@media screen and (min-width: 1800px) {\n\n  .lod-premium-hero__inner {\n    width: min(92%, 1680px);\n  }\n\n  .lod-premium-hero__content {\n    width: 570px;\n  }\n\n  .lod-premium-hero__title {\n    font-size: 78px;\n  }\n\n  .lod-premium-hero__description {\n    max-width: 460px;\n    font-size: 18px;\n  }\n\n}\n\n/* =========================================\n   ACESSIBILIDADE\n   ========================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .lod-premium-hero *,\n  .lod-premium-hero *::before,\n  .lod-premium-hero *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n\n}\n\n</style>",
