<style>
  /* LOJA DO OURO — PAGAMENTO EM PRESTAÇÕES / v4 (compacto, desenhado no servidor) */
  .lodp-inst { width: 100%; margin: 16px 0 0; letter-spacing: normal; container: lodpinst / inline-size; }
  .lodp-inst[hidden], .lodp-inst [hidden] { display: none !important; }
  .lodp-inst__label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 9.5px;
    font-weight: 700;
    line-height: 13px;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  .lodp-inst__label::before { content: ""; width: 24px; height: 1px; flex: 0 0 24px; background: var(--gold); }
  /* Klarna: área livre à volta do badge = altura do nome «Klarna» dentro dele (≈13,1 px a 30 px de altura) → 14 px */
  .lodp-inst__rows { display: flex; flex-direction: column; gap: 14px; margin: 0 !important; padding: 0 !important; list-style: none !important; }
  .lodp-inst__row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0;
    margin: 0 !important;
    padding: 0;
    color: var(--ink);
    font-size: 16px;
    line-height: 24px;
  }
  .lodp-inst__brand { display: flex; align-items: center; min-height: 24px; }
  .lodp-inst__logo { display: block; flex: 0 0 auto; }
  /* Tamanho mínimo da Klarna para ecrã: 70 px de largura. Proporção oficial 1448:609 */
  .lodp-inst__logo--klarna { width: 71.34px; height: 30px; }
  .lodp-inst__logo--sequra { width: 72px; height: 16.58px; }
  .lodp-inst__text { min-width: 0; padding: 0 10px 0 14px; font-weight: 500; }
  .lodp-inst__solo { display: none; }
  .lodp-inst:not(.has-k) .lodp-inst__or { display: none; }
  .lodp-inst:not(.has-k) .lodp-inst__solo { display: inline; }
  .lodp-inst .lodp-inst__more {
    justify-self: end;
    margin: 0;
    padding: 0;
    color: var(--ink);
    background: none;
    border: 0;
    border-radius: 2px;
    font: inherit;
    font-family: var(--font-body-family, Arial, sans-serif);
    font-size: 15px;
    font-weight: 600;
    line-height: 24px;
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .lodp-inst .lodp-inst__more:hover { text-decoration-color: currentColor; }
  /* Informação obrigatória (aviso, diálogos): Arial 16 px = 12 pt, a letra e o tamanho de referência do BdP */
  /* TAEG: letra dos títulos e dos valores Peso/Toque/Metal (Oswald), estreita, para caber por baixo do texto.
     O BdP mede a equivalência pela altura das letras: maiúsculas de 11,7 px ≥ Arial 16 px (11,5 px).
     font-size-adjust fixa essa altura mesmo que a letra dos títulos mude no tema. Cor 7,3:1 sobre o fundo */
  .lodp-inst__taeg {
    grid-column: 2 / -1;
    padding-left: 14px;
    color: #5a554b;
    font-family: var(--font-heading-family, Oswald, sans-serif);
    font-size: 14.5px;
    font-size-adjust: cap-height .81;
    font-weight: 400;
    line-height: 20px;
    letter-spacing: .02em;
  }
  .lodp-inst__taeg[data-inst-pending] { color: var(--muted); }
  .lodp-inst__warning { display: block; margin: 14px 0 0; color: var(--ink); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 700; line-height: 20px; }
  /* Larguras medidas com o pior caso «12x 88,88%»: PT/EN/ES/IT 253 px, FR 265 px, DE 311 px.
     Alinhada com o texto (72 + 14 px) onde cabe; senão ocupa a largura toda; 2 linhas reservadas desde a 1.ª pintura onde nem assim cabe */
  @container lodpinst (max-width: 342.9px) { .lodp-inst__taeg { grid-column: 1 / -1; padding-left: 0; } }
  @container lodpinst (max-width: 354.9px) { .lodp-inst[data-lang="fr"] .lodp-inst__taeg { grid-column: 1 / -1; padding-left: 0; } }
  @container lodpinst (max-width: 400.9px) { .lodp-inst[data-lang="de"] .lodp-inst__taeg { grid-column: 1 / -1; padding-left: 0; } }
  @container lodpinst (max-width: 256.9px) { .lodp-inst__taeg { min-height: 40px; } }
  @container lodpinst (max-width: 268.9px) { .lodp-inst[data-lang="fr"] .lodp-inst__taeg { min-height: 40px; } }
  @container lodpinst (max-width: 314.9px) { .lodp-inst[data-lang="de"] .lodp-inst__taeg { min-height: 40px; } }

  .lodp-inst__dlg {
    width: min(560px, calc(100vw - 32px));
    max-height: min(86vh, 760px);
    margin: auto;
    padding: 0;
    overflow: auto;
    color: var(--text, #292720);
    background: var(--paper, #fffdfa);
    border: 1px solid var(--line, rgba(188, 145, 76, .27));
    border-radius: 14px;
    box-shadow: 0 24px 60px rgba(11, 11, 9, .22);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: normal;
  }
  .lodp-inst__dlg::backdrop { background: rgba(11, 11, 9, .5); }
  .lodp-inst__dlg-in { padding: 22px 24px 24px; }
  .lodp-inst__dlg-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
  .lodp-inst__dlg-title {
    margin: 0;
    color: var(--ink, #0b0b09);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 21px;
    font-weight: 400;
    line-height: 1.25;
  }
  .lodp-inst__dlg-x {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    margin: -8px -10px 0 0;
    padding: 0;
    color: var(--ink, #0b0b09);
    background: none;
    border: 1px solid var(--line, rgba(188, 145, 76, .27));
    border-radius: 999px;
    cursor: pointer;
  }
  .lodp-inst__dlg p { margin: 0 0 12px; }
  .lodp-inst__dlg-plans { margin: 0 0 14px !important; padding: 0 !important; list-style: none !important; border-top: 1px solid var(--line, rgba(188, 145, 76, .27)); }
  .lodp-inst__dlg-plans li { margin: 0 !important; padding: 8px 0; border-bottom: 1px solid var(--line, rgba(188, 145, 76, .27)); font-variant-numeric: tabular-nums; }
  .lodp-inst__dlg-sub { color: var(--ink, #0b0b09); font-weight: 600; }
  .lodp-inst__dlg-muted { color: var(--muted, #746e64); }
  .lodp-inst__dlg-official {
    display: inline-flex;
    text-decoration: none;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    padding: 0 18px;
    color: var(--ink, #0b0b09);
    background: none;
    border: 1px solid var(--ink, #0b0b09);
    border-radius: 999px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .lodp-inst__dlg button:focus-visible, .lodp-inst__dlg a:focus-visible { outline: 2px solid var(--gold, #bc914c); outline-offset: 3px; }
  @media (max-width: 849px) {
    .lodp-inst { margin-top: 14px; }
    .lodp-inst__label {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      margin: 0;
      overflow: hidden !important;
      clip: rect(0 0 0 0) !important;
      white-space: nowrap !important;
    }
    .lodp-inst__row { font-size: 15px; }
    .lodp-inst__dlg-in { padding: 18px 18px 20px; }
    @container lodpinst (max-width: 340px) {
      .lodp-inst__row, .lodp-inst .lodp-inst__more { font-size: 14px; }
    }
  }
</style>

<div
  class="lodp-inst{% if inst_k_show %} has-k{% endif %}"
  id="LODInst-{{ sid }}"
  data-lang="{{ lang | escape }}"
  data-lodp-inst
  {% unless inst_k_show or inst_s_show %}hidden{% endunless %}
>
  <p class="lodp-inst__label" id="LODInstLabel-{{ sid }}">{{ t_label | escape }}</p>
  <ul class="lodp-inst__rows" aria-labelledby="LODInstLabel-{{ sid }}">
    {%- if s.inst_order == 'sequra' -%}
      {{ inst_row_s }}{{ inst_row_k }}
    {%- else -%}
      {{ inst_row_k }}{{ inst_row_s }}
    {%- endif -%}
  </ul>
  {%- if s.inst_warning -%}
    <span class="lodp-inst__warning">{{ t_warning | escape }}</span>
  {%- endif -%}
  {%- if inst_k_market -%}
    <dialog class="lodp-inst__dlg" id="LODInstDlgK-{{ sid }}" data-dlg="klarna" aria-labelledby="LODInstDlgKT-{{ sid }}">
      <div class="lodp-inst__dlg-in">
        <div class="lodp-inst__dlg-head">
          <h2 class="lodp-inst__dlg-title" id="LODInstDlgKT-{{ sid }}">{{ t_kd_title | escape }}</h2>
          <button type="button" class="lodp-inst__dlg-x" data-dlg-close aria-label="{{ t_d_close | escape }}">
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          </button>
        </div>
        <p class="lodp-inst__dlg-sub" data-kd-line>{{ t_kd_line_v | escape }}</p>
        <p>{{ t_kd_when | escape }}</p>
        {%- if s.inst_warning -%}<p class="lodp-inst__dlg-sub">{{ t_warning | escape }}</p>{%- endif -%}
        <p class="lodp-inst__dlg-muted">{{ t_kd_note | escape }}</p>
        <a class="lodp-inst__dlg-official" href="{{ inst_k_url }}" target="_blank" rel="noopener">{{ t_kd_official | escape }}<span class="lodp__sr"> ({{ t_new_tab | escape }})</span></a>
      </div>
    </dialog>
  {%- endif -%}
  {%- if inst_s_market -%}
    <noscript><style>#LODInst-{{ sid }} [data-inst-row="sequra"] { display: none !important; }</style></noscript>
    <dialog class="lodp-inst__dlg" id="LODInstDlg-{{ sid }}" data-dlg="sequra" aria-labelledby="LODInstDlgT-{{ sid }}">
      <div class="lodp-inst__dlg-in">
        <div class="lodp-inst__dlg-head">
          <h2 class="lodp-inst__dlg-title" id="LODInstDlgT-{{ sid }}">{{ t_d_title | escape }}</h2>
          <button type="button" class="lodp-inst__dlg-x" data-dlg-close aria-label="{{ t_d_close | escape }}">
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          </button>
        </div>
        <p data-dlg-status aria-live="polite">{{ t_d_wait | escape }}</p>
        <div data-dlg-body hidden>
          <p class="lodp-inst__dlg-sub" data-dlg-plans-title></p>
          <ul class="lodp-inst__dlg-plans" data-dlg-plans></ul>
          <p data-dlg-example></p>
        </div>
        {%- if s.inst_warning -%}<p class="lodp-inst__dlg-sub">{{ t_warning | escape }}</p>{%- endif -%}
        <p>{{ t_s_note | escape }}</p>
        <p class="lodp-inst__dlg-muted">{{ t_lender | escape }}</p>
        <button
          type="button"
          class="lodp-inst__dlg-official sequra-educational-popup sequra-educational-popup--{{ inst_s_product | escape }}"
          data-dlg-official
          data-product="{{ inst_s_product | escape }}"
          data-amount="{{ inst_cents }}"
        >{{ t_d_official | escape }}</button>
      </div>
    </dialog>
  {%- endif -%}
  <script type="application/json" data-inst-config>
    {
      "sid": {{ sid | json }},
      "lang": {{ lang | json }},
      "cents": {{ inst_cents | json }},
      "moneySample": {{ 123456789 | money | strip_html | json }},
      "k": { "on": {{ inst_k_market | json }}, "min": {{ inst_k_min | json }}, "max": {{ inst_k_max | json }} },
      "s": {
        "on": {{ inst_s_market | json }}, "min": {{ inst_s_min | json }}, "max": {{ inst_s_max | json }},
        "n": {{ inst_s_n | json }}, "product": {{ inst_s_product | json }}, "locale": {{ inst_s_locale | json }},
        "merchant": {{ s.inst_sequra_merchant | default: '' | strip | json }}, "assetKey": {{ s.inst_sequra_asset_key | default: '' | strip | json }},
        "cdn": "https://live.cdn.sequra.svea.com"
      },
      "t": {
        "k": {{ t_k | json }}, "kd": {{ t_kd_line | json }}, "sOr": {{ t_s_or | json }}, "sSolo": {{ t_s_solo | json }},
        "taeg": {{ t_taeg | json }}, "plansTitle": {{ t_d_plans | json }}, "plan": {{ t_d_plan | json }},
        "ex": {{ t_ex | json }}, "exLast": {{ t_ex_last | json }}, "over": {{ t_over | json }}, "fail": {{ t_d_fail | json }},
        "frame": {{ t_sq_frame | json }}
      }
    }
  </script>
</div>
{%- if inst_s_market -%}
  {%- assign inst_s_merchant = s.inst_sequra_merchant | default: '' | strip -%}
  {%- assign inst_s_key = s.inst_sequra_asset_key | default: '' | strip -%}
  {%- if inst_s_merchant != blank and inst_s_key != blank -%}
    {%- comment -%} Pedidos da seQura em paralelo, logo aqui: a biblioteca e a tabela de custos do produto {%- endcomment -%}
    <link rel="preload" as="script" href="https://live.cdn.sequra.svea.com/assets/sequra-checkout.min.js">
    <link rel="preload" as="fetch" crossorigin="anonymous" href="https://live.cdn.sequra.svea.com/scripts/{{ inst_s_merchant | url_encode }}/{{ inst_s_key | url_encode }}/{{ inst_s_product | url_encode }}_cost.json">
  {%- else -%}
    <link rel="preconnect" href="https://live.cdn.sequra.svea.com" crossorigin>
  {%- endif -%}
{%- endif -%}

<script>
  (function () {
    'use strict';
    var PCT_SPACE = { es: 1, fr: 1, de: 1 };
    var SEQURA_WAIT = 8000;       /* biblioteca pedida aqui: tempo máximo a contar do pedido */
    var SEQURA_WAIT_APP = 6000;   /* sem pedido nosso (definições vazias): a contar do «load», porque a app seQura só pede a biblioteca depois */

    function decode(s) {
      try { var t = document.createElement('textarea'); t.innerHTML = String(s || ''); return t.value; }
      catch (e) { return String(s || ''); }
    }
    /* Formato de dinheiro da loja (o mesmo do preço da ficha), lido de um exemplo formatado pela Shopify (1234567,89) */
    function moneyFormat(sample) {
      var str = decode(sample);
      var m = str.match(/\d[\d.,'   ]*\d/);
      var pre = '€', suf = '', thou = '.', dec = ',';
      if (m) {
        var n = m[0];
        pre = str.slice(0, m.index);
        suf = str.slice(m.index + n.length);
        thou = /\d/.test(n.charAt(1)) ? '' : n.charAt(1);
        dec = /[.,]89$/.test(n) ? n.charAt(n.length - 3) : (thou === ',' ? '.' : ',');
      }
      return {
        thou: thou,
        dec: dec,
        money: function (cents) {
          cents = Math.round(Number(cents));
          if (!isFinite(cents)) return '—';
          var neg = cents < 0; if (neg) cents = -cents;
          var units = String(Math.floor(cents / 100)).replace(/\B(?=(\d{3})+(?!\d))/g, thou);
          var c = cents % 100;
          return (neg ? '-' : '') + pre + units + dec + (c < 10 ? '0' : '') + c + suf;
        }
      };
    }
    function fill(tpl, map) {
      return String(tpl || '').replace(/\[([a-z_0-9]+)\]/gi, function (m, k) {
        return Object.prototype.hasOwnProperty.call(map, k) ? map[k] : m;
      });
    }
    function num(x) { return x && typeof x === 'object' ? Number(x.value) : Number(x); }
    function poll(test, ms, done, step) {
      var t0 = Date.now();
      (function tick() {
        var ok = false;
        try { ok = !!test(); } catch (e) {}
        if (ok) return done(true);
        if (Date.now() - t0 >= ms) return done(false);
        setTimeout(tick, step || 200);
      })();
    }
    function shown(n) {
      if (!n || !document.documentElement.contains(n)) return false;
      var cs = getComputedStyle(n);
      return cs.display !== 'none' && cs.visibility !== 'hidden' && n.getClientRects().length > 0;
    }
    function focusEl(n) { if (!n) return; try { n.focus({ preventScroll: true }); } catch (e) { try { n.focus(); } catch (x) {} } }

    /* ----- seQura: pedir já a biblioteca oficial, com a mesma configuração da app seQura ----- */
    function sequraBoot(c, dec, thou) {
      var S = window.Sequra;
      if (S && typeof S.computeCreditAgreements === 'function') return;
      if (window.SequraConfiguration || window.__lodpSqBoot) return;
      if (!c.merchant || !c.assetKey) return;
      window.__lodpSqBoot = Date.now();
      var g = {
        merchant: c.merchant,
        assetKey: c.assetKey,
        products: [c.product],
        scriptUri: c.cdn + '/assets/sequra-checkout.min.js',
        decimalSeparator: dec,
        thousandSeparator: thou || '.',
        locale: c.locale,
        currency: 'EUR'
      };
      window.SequraConfiguration = g;
      window.SequraOnLoad = [];
      window.Sequra = { onLoad: function (cb) { window.SequraOnLoad.push(cb); } };
      var a = document.createElement('script');
      a.async = true;
      a.src = g.scriptUri;
      /* Pedido falhado (bloqueador, sem rede, CDN em baixo): a linha seQura sai logo, sem esperar */
      a.onerror = function () { window.__lodpSqFail = 1; sequraKick(); };
      (document.head || document.documentElement).appendChild(a);
      /* Biblioteca carregada: a app seQura já não a volta a pedir nesta página (o widget dela não tem onde aparecer na ficha LOD) */
      window.Sequra.onLoad(function () { window.sequraWidgetsScriptLoaded = true; sequraKick(); });
    }
    /* Avisa logo quem espera pela seQura (biblioteca pronta ou pedido falhado), sem esperar pela próxima verificação */
    function sequraKick() { try { window.dispatchEvent(new Event('lodp:sequra')); } catch (e) {} }
    function sequraFn() { var S = window.Sequra; return S && typeof S.computeCreditAgreements === 'function' ? S : null; }

    function init(el) {
      if (!el || el.dataset.instReady === '1') return;
      el.dataset.instReady = '1';
      var cfg;
      try { cfg = JSON.parse(el.querySelector('[data-inst-config]').textContent); } catch (e) { return; }
      var fmt = moneyFormat(cfg.moneySample);
      var lang = cfg.lang || 'pt';
      function money(c) { return fmt.money(c); }
      /* Percentagens com o mesmo separador decimal do preço da ficha */
      function pct(bp) {
        var v = Number(bp);
        if (!isFinite(v)) return '—';
        var s = v === 0 ? '0' : (v / 100).toFixed(2);
        return s.replace('.', fmt.dec) + (PCT_SPACE[lang] ? ' %' : '%');
      }
      var host = el.closest('[data-lodp]') || document;
      var kRow = el.querySelector('[data-inst-row="klarna"]');
      var sRow = el.querySelector('[data-inst-row="sequra"]');
      var kText = kRow && kRow.querySelector('[data-k-text]');
      var kMore = kRow && kRow.querySelector('[data-k-more]');
      var sOr = sRow && sRow.querySelector('[data-s-or]');
      var sSolo = sRow && sRow.querySelector('[data-s-solo]');
      var sMore = sRow && sRow.querySelector('[data-s-more]');
      var sTaeg = sRow && sRow.querySelector('[data-s-taeg]');
      var dlg = el.querySelector('[data-dlg="sequra"]');
      var kDlg = el.querySelector('[data-dlg="klarna"]');
      var kdLine = kDlg && kDlg.querySelector('[data-kd-line]');
      var st = { cents: Number(cfg.cents) || 0, sNa: false, sq: 'wait', plans: null, plansFor: -1 };

      function inRange(p) { return !!(p && p.on && st.cents >= p.min && st.cents <= p.max); }
      function layout() {
        var kShow = !!kRow && inRange(cfg.k);
        var sShow = !!sRow && inRange(cfg.s) && !st.sNa;
        if (kRow) kRow.hidden = !kShow;
        if (sRow) sRow.hidden = !sShow;
        el.classList.toggle('has-k', kShow);
        el.hidden = !(kShow || sShow);
      }

      /* ===== Klarna: só texto da loja, a partir do preço da variante (limites nas definições) ===== */
      function klarnaUpdate() {
        var third = Math.floor(st.cents / 3);
        var v = { valor: money(third), credito: money(st.cents - third) };
        if (kText) kText.textContent = fill(cfg.t.k, v);
        if (kdLine) kdLine.textContent = fill(cfg.t.kd, v);
      }

      /* ===== seQura ===== */
      function isFree(p) { return num(p.apr) === 0 && num(p.cost_of_credit) === 0; }
      function sequraPlans(cents) {
        var S = sequraFn();
        if (!S) return null;
        var r = S.computeCreditAgreements({ amount: String(cents), product: cfg.s.product });
        var list = (r && r[cfg.s.product]) || [];
        return list
          .filter(function (p) { return p && p.available && p.instalment_count > 0; })
          .sort(function (a, b) { return a.instalment_count - b.instalment_count; });
      }
      function setN(n) {
        if (sOr) sOr.textContent = fill(cfg.t.sOr, { n: String(n) });
        if (sSolo) sSolo.textContent = fill(cfg.t.sSolo, { n: String(n) });
      }
      function sequraRender() {
        if (!sRow) return;
        if (!inRange(cfg.s)) { layout(); return; }
        var plans = null;
        try { plans = sequraPlans(st.cents); } catch (e) { plans = null; }
        if (plans === null) return false;          /* biblioteca ainda não pronta */
        if (!plans.length) return false;
        st.plans = plans; st.plansFor = st.cents; st.sNa = false;
        var top = plans[plans.length - 1];
        setN(top.instalment_count);
        var costed = plans.filter(function (p) { return !isFree(p); });
        if (sTaeg) {
          sTaeg.textContent = cfg.t.taeg + (lang === 'fr' ? ' : ' : ': ') + (costed.length
            ? costed.map(function (p) { return p.instalment_count + 'x ' + pct(num(p.apr)); }).join(' · ')
            : pct(0));
          sTaeg.removeAttribute('data-inst-pending');
        }
        dialogFill();
        layout();
        return true;
      }
      function sequraLibReady() {
        var S = sequraFn();
        if (!S) return false;
        try {
          var r = S.computeCreditAgreements({ amount: String(Math.max(st.cents, cfg.s.min)), product: cfg.s.product });
          var l = r && r[cfg.s.product];
          return !!(l && l.length);
        } catch (e) { return false; }
      }
      function sequraWait(cb) {
        /* A nossa biblioteca (pedida já): até SEQURA_WAIT depois do pedido, ou falha logo se o pedido der erro.
           Sem pedido nosso: a da app seQura, até SEQURA_WAIT_APP depois do «load». */
        var own = !!window.__lodpSqBoot, t0 = own ? window.__lodpSqBoot : Date.now();
        var tLoad = document.readyState === 'complete' ? Date.now() : 0, done = false, timer = 0;
        if (!tLoad) window.addEventListener('load', function () { tLoad = Date.now(); }, { once: true });
        function finish(ok) { done = true; clearTimeout(timer); window.removeEventListener('lodp:sequra', tick); cb(ok); }
        function tick() {
          if (done) return;
          clearTimeout(timer);
          if (sequraLibReady()) return finish(true);
          var now = Date.now();
          if (own && (window.__lodpSqFail || now - t0 > SEQURA_WAIT)) return finish(false);
          if (!own && tLoad && now - tLoad > SEQURA_WAIT_APP) return finish(false);
          timer = setTimeout(tick, 100);
        }
        window.addEventListener('lodp:sequra', tick);
        tick();
      }

      /* ----- Diálogo «Saber mais» da seQura (modal nativo: foco dentro, Tab fica dentro, Escape fecha) ----- */
      var dlgStatus = dlg && dlg.querySelector('[data-dlg-status]');
      var dlgBody = dlg && dlg.querySelector('[data-dlg-body]');
      var dlgOfficial = dlg && dlg.querySelector('[data-dlg-official]');
      function dialogFill() {
        if (!dlg || !st.plans || st.plansFor !== st.cents) return;
        var plans = st.plans, top = plans[plans.length - 1];
        var costed = plans.filter(function (p) { return !isFree(p); });
        dlg.querySelector('[data-dlg-plans-title]').textContent = fill(cfg.t.plansTitle, { preco: money(st.cents) });
        var ul = dlg.querySelector('[data-dlg-plans]');
        ul.textContent = '';
        plans.forEach(function (p) {
          var li = document.createElement('li');
          li.textContent = fill(cfg.t.plan, { n: String(p.instalment_count), valor: money(num(p.instalment_total)), taeg: pct(num(p.apr)), total: money(num(p.grand_total)) });
          ul.appendChild(li);
        });
        var ex = dlg.querySelector('[data-dlg-example]');
        var ref = costed.length ? costed[costed.length - 1] : null;
        if (ref) {
          var n = ref.instalment_count, inst = num(ref.instalment_total), grand = num(ref.grand_total);
          var down = num(ref.down_payment_total); if (!isFinite(down)) down = inst;
          var rest = num(ref.remaining_instalment_count); if (!isFinite(rest)) rest = n - 1;
          var credit = num(ref.drawdown_payment_amount); if (!isFinite(credit)) credit = st.cents - down;
          var costCredit = num(ref.cost_of_credit);
          var last = n >= 2 ? grand - down - (n - 2) * inst : inst;
          var ultima = (isFinite(last) && last > 0 && Math.abs(last - inst) >= 1) ? fill(cfg.t.exLast, { x: money(last) }) : '';
          var text = fill(cfg.t.ex, {
            preco: money(st.cents), n: String(n), valor: money(inst), ultima: ultima,
            custo_mes: money(num(ref.instalment_fee)), sinal: money(down), resto: String(rest),
            credito: money(credit), meses: String(rest), tan: pct(num(ref.interest)), taeg: pct(num(ref.apr)),
            custo_credito: money(costCredit),
            /* DL 133/2009, art. 4.º, n.º 1, al. h): montante total imputado ao consumidor = montante total do crédito + custo total do crédito */
            imputado: money(credit + costCredit),
            total: money(grand)
          });
          if (num(top.over_max) > 0) text += ' ' + fill(cfg.t.over, { max: money(num(top.max_financed_amount)) });
          ex.textContent = text;
          ex.hidden = false;
        } else {
          ex.textContent = '';
          ex.hidden = true;
        }
        if (dlgStatus) dlgStatus.hidden = true;
        if (dlgBody) dlgBody.hidden = false;
      }
      function dialogCtl(d, invoker, beforeOpen) {
        if (!d || !invoker) return null;
        var ctl = { after: null };
        function onClose() {
          invoker.setAttribute('aria-expanded', 'false');
          if (ctl.after) { var fn = ctl.after; ctl.after = null; fn(); return; }
          setTimeout(function () { focusEl(invoker); }, 0);
        }
        ctl.open = function () {
          if (beforeOpen) beforeOpen();
          ctl.after = null;
          if (typeof d.showModal === 'function') { if (!d.open) d.showModal(); }
          else d.setAttribute('open', '');
          invoker.setAttribute('aria-expanded', 'true');
          focusEl(d.querySelector('[data-dlg-close]'));
        };
        ctl.close = function () {
          if (typeof d.close === 'function') { if (d.open) d.close(); }
          else if (d.hasAttribute('open')) { d.removeAttribute('open'); onClose(); }
        };
        d.addEventListener('close', onClose);
        d.addEventListener('click', function (e) { if (e.target === d) ctl.close(); });   /* clique no fundo */
        var x = d.querySelector('[data-dlg-close]');
        if (x) x.addEventListener('click', ctl.close);
        invoker.setAttribute('aria-haspopup', 'dialog');
        invoker.setAttribute('aria-controls', d.id);
        invoker.setAttribute('aria-expanded', 'false');
        invoker.addEventListener('click', function (e) { e.preventDefault(); ctl.open(); });
        return ctl;
      }
      var sCtl = dialogCtl(dlg, sMore, function () {
        if (st.plans && st.plansFor === st.cents) dialogFill();
        else if (st.sq === 'fail' && dlgStatus) { dlgStatus.textContent = cfg.t.fail; dlgStatus.hidden = false; if (dlgBody) dlgBody.hidden = true; }
      });
      dialogCtl(kDlg, kMore, null);   /* Klarna: o link abre a página oficial sem JavaScript; com JavaScript abre o nosso diálogo */

      /* ----- Simulador oficial seQura (pop-up da seQura, num iframe dela) -----
         O foco entra no iframe, Tab e Shift+Tab ficam no pop-up (guardas antes e depois do iframe),
         Escape fecha-o e o foco volta ao «Saber mais». O iframe recebe um nome na língua da página. */
      var sqOpen = null;
      function sqFrame() {
        var ws = document.querySelectorAll('.Sequra__EducationalPopupWrapper');
        for (var i = ws.length - 1; i >= 0; i--) {
          var f = ws[i].querySelector('iframe.Sequra__EducationalPopup') || ws[i].querySelector('iframe');
          if (f && shown(ws[i]) && shown(f)) return f;
        }
        return null;
      }
      function sqClose() {
        var o = sqOpen;
        if (!o) return;
        sqOpen = null;
        clearInterval(o.timer);
        document.removeEventListener('keydown', o.onKey, true);
        document.removeEventListener('focusin', o.onFocus, true);
        o.guards.forEach(function (g) { if (g.parentNode) g.parentNode.removeChild(g); });
        setTimeout(function () { focusEl(sMore); }, 0);
      }
      function sqWatch() {
        if (sqOpen) return;
        poll(sqFrame, 3000, function (ok) {
          var f = ok ? sqFrame() : null;
          if (!f) { focusEl(sMore); return; }
          var w = f.closest('.Sequra__EducationalPopupWrapper');
          var o = sqOpen = { frame: f, guards: [] };
          f.setAttribute('title', cfg.t.frame || 'seQura');
          if (w) {
            ['afterbegin', 'beforeend'].forEach(function (pos) {
              var g = document.createElement('span');
              g.tabIndex = 0;
              g.className = 'lodp__sr';
              g.setAttribute('data-lodp-guard', '');
              g.addEventListener('focus', function () { if (sqOpen === o) focusEl(f); });
              w.insertAdjacentElement(pos, g);
              o.guards.push(g);
            });
          }
          focusEl(f);
          f.addEventListener('load', function () { if (sqOpen === o && document.activeElement !== f) focusEl(f); });
          o.onKey = function (e) {
            if (sqOpen !== o || (e.key !== 'Escape' && e.key !== 'Esc')) return;
            e.preventDefault();
            var ww = f.closest('.Sequra__EducationalPopupWrapper') || f;
            if (ww.parentNode) ww.parentNode.removeChild(ww);   /* o mesmo que a seQura faz ao fechar */
            sqClose();
          };
          o.onFocus = function (e) {
            if (sqOpen !== o) return;
            var ww = f.closest('.Sequra__EducationalPopupWrapper');
            if (e.target !== f && !(ww && ww.contains(e.target))) focusEl(f);
          };
          document.addEventListener('keydown', o.onKey, true);
          document.addEventListener('focusin', o.onFocus, true);
          o.timer = setInterval(function () { if (sqOpen === o && !shown(f)) sqClose(); }, 250);
        }, 100);
      }
      if (dlgOfficial) {
        dlgOfficial.addEventListener('click', function () {
          /* o pop-up da seQura abre por baixo de um <dialog> modal: fechar primeiro o nosso */
          if (!sCtl) return;
          sCtl.after = sequraFn() ? sqWatch : null;
          sCtl.close();
        });
      }
      function officialAmount() {
        if (!dlgOfficial || dlgOfficial.getAttribute('data-amount') === String(st.cents)) return;
        dlgOfficial.setAttribute('data-amount', String(st.cents));
        try { var S = sequraFn(); if (S && typeof S.refreshComponents === 'function') S.refreshComponents(); } catch (e) {}
      }

      /* ===== Mudança de variante (evento emitido pela ficha) ===== */
      host.addEventListener('lodp:variant-change', function (event) {
        var v = event.detail && event.detail.variant;
        var cents = v ? Number(v.cents) : NaN;
        if (!isFinite(cents) || cents === st.cents) return;
        st.cents = cents;
        klarnaUpdate();
        if (sRow) {
          officialAmount();
          if (st.sq === 'ok') {
            st.sNa = false;
            if (sequraRender() !== true && inRange(cfg.s)) { st.sNa = true; }
          }
        }
        layout();
      });

      /* ===== Arranque ===== */
      layout();
      if (sRow) {
        sequraBoot(cfg.s, fmt.dec, fmt.thou);
        sequraWait(function (ok) {
          st.sq = ok ? 'ok' : 'fail';
          if (!ok) {
            /* Sem dados da seQura não se pode mostrar «até [n]x» sem a TAEG: a linha sai */
            st.sNa = true;
            layout();
            if (dlg && dlg.open && dlgStatus) { dlgStatus.textContent = cfg.t.fail; dlgStatus.hidden = false; if (dlgBody) dlgBody.hidden = true; }
            return;
          }
          if (inRange(cfg.s) && sequraRender() !== true) { st.sNa = true; layout(); }
          try { var S = sequraFn(); if (S && typeof S.refreshComponents === 'function') S.refreshComponents(); } catch (e) {}
          officialAmount();
        });
      }
    }

    function initAll(scope) { (scope || document).querySelectorAll('[data-lodp-inst]').forEach(init); }
    initAll(document);
    if (!window.__lodpInstListen) {
      window.__lodpInstListen = true;
      document.addEventListener('shopify:section:load', function (event) { initAll(event.target); });
    }
  })();
</script>
{%- endif -%}
