<style>
  /* LOJA DO OURO — PAGAMENTO EM PRESTAÇÕES / v3 (compacto, desenhado no servidor) */
  .lodp-inst { margin: 16px 0 0; }
  .lodp-inst[hidden], .lodp-inst [hidden] { display: none !important; }
  .lodp-inst__label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 9.5px;
    font-weight: 700;
    line-height: 13px;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  .lodp-inst__label::before { content: ""; width: 24px; height: 1px; flex: 0 0 24px; background: var(--gold); }
  .lodp-inst__rows { display: flex; flex-direction: column; gap: 12px; margin: 0 !important; padding: 0 !important; list-style: none !important; }
  .lodp-inst__row {
    display: grid;
    grid-template-columns: 61px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 12px;
    margin: 0 !important;
    padding: 0;
    color: var(--ink);
    font-size: 16px;
    line-height: 24px;
  }
  .lodp-inst__brand { display: flex; align-items: center; height: 24px; }
  .lodp-inst__logo { display: block; flex: 0 0 auto; }
  .lodp-inst__logo--klarna { width: 57px; height: 24px; }
  .lodp-inst__logo--sequra { width: 61px; height: 14px; }
  .lodp-inst__text { min-width: 0; font-weight: 500; }
  .lodp-inst__solo { display: none; }
  .lodp-inst:not(.has-k) .lodp-inst__or { display: none; }
  .lodp-inst:not(.has-k) .lodp-inst__solo { display: inline; }
  .lodp-inst .lodp-inst__more {
    justify-self: end;
    margin: 0;
    padding: 0;
    color: var(--ink);
    background: none;
    border: 0;
    border-radius: 2px;
    font: inherit;
    font-family: var(--font-body-family, Arial, sans-serif);
    font-size: 15px;
    font-weight: 600;
    line-height: 24px;
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .lodp-inst .lodp-inst__more:hover { text-decoration-color: currentColor; }
  .lodp-inst__taeg {
    grid-column: 2 / -1;
    margin-top: 2px;
    color: var(--text);
    font-size: 16px;
    line-height: 22px;
  }
  .lodp-inst__taeg[data-inst-pending] { color: var(--muted); }
  .lodp-inst__warning { display: block; margin: 10px 0 0; color: var(--ink); font-size: 16px; font-weight: 600; line-height: 22px; }

  .lodp-inst__dlg {
    width: min(560px, calc(100vw - 32px));
    max-height: min(86vh, 760px);
    margin: auto;
    padding: 0;
    overflow: auto;
    color: var(--text, #292720);
    background: var(--paper, #fffdfa);
    border: 1px solid var(--line, rgba(188, 145, 76, .27));
    border-radius: 14px;
    box-shadow: 0 24px 60px rgba(11, 11, 9, .22);
    font-size: 16px;
    line-height: 1.55;
  }
  .lodp-inst__dlg::backdrop { background: rgba(11, 11, 9, .5); }
  .lodp-inst__dlg-in { padding: 22px 24px 24px; }
  .lodp-inst__dlg-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
  .lodp-inst__dlg-title {
    margin: 0;
    color: var(--ink, #0b0b09);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 21px;
    font-weight: 400;
    line-height: 1.25;
  }
  .lodp-inst__dlg-x {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    margin: -8px -10px 0 0;
    padding: 0;
    color: var(--ink, #0b0b09);
    background: none;
    border: 1px solid var(--line, rgba(188, 145, 76, .27));
    border-radius: 999px;
    cursor: pointer;
  }
  .lodp-inst__dlg p { margin: 0 0 12px; }
  .lodp-inst__dlg-plans { margin: 0 0 14px !important; padding: 0 !important; list-style: none !important; border-top: 1px solid var(--line, rgba(188, 145, 76, .27)); }
  .lodp-inst__dlg-plans li { margin: 0 !important; padding: 8px 0; border-bottom: 1px solid var(--line, rgba(188, 145, 76, .27)); font-variant-numeric: tabular-nums; }
  .lodp-inst__dlg-sub { color: var(--ink, #0b0b09); font-weight: 600; }
  .lodp-inst__dlg-muted { color: var(--muted, #746e64); }
  .lodp-inst__dlg-official {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    padding: 0 18px;
    color: var(--ink, #0b0b09);
    background: none;
    border: 1px solid var(--ink, #0b0b09);
    border-radius: 999px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .lodp-inst__dlg button:focus-visible, .lodp-inst__dlg a:focus-visible { outline: 2px solid var(--gold, #bc914c); outline-offset: 3px; }
  @media (max-width: 849px) {
    .lodp-inst { margin-top: 14px; }
    .lodp-inst__label {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      margin: 0;
      overflow: hidden !important;
      clip: rect(0 0 0 0) !important;
      white-space: nowrap !important;
    }
    .lodp-inst__rows { gap: 11px; }
    .lodp-inst__row { grid-template-columns: 56px minmax(0, 1fr) auto; gap: 0 10px; font-size: 15px; }
    .lodp-inst__logo--klarna { width: 48px; height: 20px; }
    .lodp-inst__logo--sequra { width: 56px; height: 13px; }
    .lodp-inst__taeg { grid-column: 1 / -1; font-size: 16px; }
    .lodp-inst__dlg-in { padding: 18px 18px 20px; }
  }
</style>

<div
  class="lodp-inst{% if inst_k_show %} has-k{% endif %}"
  id="LODInst-{{ sid }}"
  data-lodp-inst
  {% unless inst_k_show or inst_s_show %}hidden{% endunless %}
>
  <p class="lodp-inst__label" id="LODInstLabel-{{ sid }}">{{ t_label | escape }}</p>
  <ul class="lodp-inst__rows" aria-labelledby="LODInstLabel-{{ sid }}">
    {%- if s.inst_order == 'sequra' -%}
      {{ inst_row_s }}{{ inst_row_k }}
    {%- else -%}
      {{ inst_row_k }}{{ inst_row_s }}
    {%- endif -%}
  </ul>
  {%- if s.inst_warning -%}
    <span class="lodp-inst__warning">{{ t_warning | escape }}</span>
  {%- endif -%}
  {%- if inst_s_market -%}
    {%- if s.inst_sequra_taeg -%}
      <noscript><style>#LODInst-{{ sid }} [data-inst-row="sequra"] { display: none !important; }</style></noscript>
    {%- endif -%}
    <dialog class="lodp-inst__dlg" id="LODInstDlg-{{ sid }}" aria-labelledby="LODInstDlgT-{{ sid }}">
      <div class="lodp-inst__dlg-in">
        <div class="lodp-inst__dlg-head">
          <h2 class="lodp-inst__dlg-title" id="LODInstDlgT-{{ sid }}">{{ t_d_title | escape }}</h2>
          <button type="button" class="lodp-inst__dlg-x" data-dlg-close aria-label="{{ t_d_close | escape }}">
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          </button>
        </div>
        <p data-dlg-status aria-live="polite">{{ t_d_wait | escape }}</p>
        <div data-dlg-body hidden>
          <p class="lodp-inst__dlg-sub" data-dlg-plans-title></p>
          <ul class="lodp-inst__dlg-plans" data-dlg-plans></ul>
          <p data-dlg-example></p>
        </div>
        {%- if s.inst_warning -%}<p class="lodp-inst__dlg-sub">{{ t_warning | escape }}</p>{%- endif -%}
        <p>{{ t_s_note | escape }}</p>
        <p class="lodp-inst__dlg-muted">{{ t_lender | escape }}</p>
        <button
          type="button"
          class="lodp-inst__dlg-official sequra-educational-popup sequra-educational-popup--{{ inst_s_product | escape }}"
          data-dlg-official
          data-product="{{ inst_s_product | escape }}"
          data-amount="{{ inst_cents }}"
        >{{ t_d_official | escape }}</button>
      </div>
    </dialog>
  {%- endif -%}
  <script type="application/json" data-inst-config>
    {
      "sid": {{ sid | json }},
      "lang": {{ lang | json }},
      "cents": {{ inst_cents | json }},
      "variantId": {{ variant.id | json }},
      "firstVariantId": {{ product.variants.first.id | json }},
      "moneySample": {{ 123456789 | money | strip_html | json }},
      "k": { "on": {{ inst_k_market | json }}, "min": {{ inst_k_min | json }}, "max": {{ inst_k_max | json }}, "locale": {{ inst_k_locale | json }} },
      "s": {
        "on": {{ inst_s_market | json }}, "min": {{ inst_s_min | json }}, "max": {{ inst_s_max | json }},
        "n": {{ inst_s_n | json }}, "product": {{ inst_s_product | json }}, "locale": {{ inst_s_locale | json }},
        "merchant": {{ s.inst_sequra_merchant | default: '' | strip | json }}, "assetKey": {{ s.inst_sequra_asset_key | default: '' | strip | json }},
        "cdn": "https://live.cdn.sequra.svea.com", "taeg": {{ s.inst_sequra_taeg | json }}
      },
      "t": {
        "k": {{ t_k | json }}, "sOr": {{ t_s_or | json }}, "sSolo": {{ t_s_solo | json }},
        "taeg": {{ t_taeg | json }}, "plansTitle": {{ t_d_plans | json }}, "plan": {{ t_d_plan | json }},
        "ex": {{ t_ex | json }}, "exLast": {{ t_ex_last | json }}, "over": {{ t_over | json }}, "fail": {{ t_d_fail | json }}
      }
    }
  </script>
</div>
{%- if inst_s_market -%}
  <link rel="preconnect" href="https://live.cdn.sequra.svea.com">
  <link rel="preconnect" href="https://live.cdn.sequra.svea.com" crossorigin>
{%- endif -%}

<script>
  (function () {
    'use strict';
    var PCT_SPACE = { es: 1, fr: 1, de: 1 };
    var SEQURA_WAIT = 20000;   /* depois do «load»: a app seQura pode ainda carregar a biblioteca */
    var KLARNA_WAIT = 15000;   /* depois do «load»: o SDK da Klarna é carregado pela app Klarna */

    function decode(s) {
      try { var t = document.createElement('textarea'); t.innerHTML = String(s || ''); return t.value; }
      catch (e) { return String(s || ''); }
    }
    /* Formato de dinheiro da loja (o mesmo do preço da ficha), lido de um exemplo formatado pela Shopify (1234567,89) */
    function moneyFormat(sample) {
      var str = decode(sample);
      var m = str.match(/\d[\d.,'   ]*\d/);
      var pre = '€', suf = '', thou = '.', dec = ',';
      if (m) {
        var n = m[0];
        pre = str.slice(0, m.index);
        suf = str.slice(m.index + n.length);
        thou = /\d/.test(n.charAt(1)) ? '' : n.charAt(1);
        dec = /[.,]89$/.test(n) ? n.charAt(n.length - 3) : (thou === ',' ? '.' : ',');
      }
      return {
        thou: thou,
        dec: dec,
        money: function (cents) {
          cents = Math.round(Number(cents));
          if (!isFinite(cents)) return '—';
          var neg = cents < 0; if (neg) cents = -cents;
          var units = String(Math.floor(cents / 100)).replace(/\B(?=(\d{3})+(?!\d))/g, thou);
          var c = cents % 100;
          return (neg ? '-' : '') + pre + units + dec + (c < 10 ? '0' : '') + c + suf;
        }
      };
    }
    function fill(tpl, map) {
      return String(tpl || '').replace(/\[([a-z_0-9]+)\]/gi, function (m, k) {
        return Object.prototype.hasOwnProperty.call(map, k) ? map[k] : m;
      });
    }
    function num(x) { return x && typeof x === 'object' ? Number(x.value) : Number(x); }
    function poll(test, ms, done, step) {
      var t0 = Date.now();
      (function tick() {
        var ok = false;
        try { ok = !!test(); } catch (e) {}
        if (ok) return done(true);
        if (Date.now() - t0 >= ms) return done(false);
        setTimeout(tick, step || 200);
      })();
    }
    function afterLoad(fn) {
      if (document.readyState === 'complete') setTimeout(fn, 0);
      else window.addEventListener('load', function () { setTimeout(fn, 0); }, { once: true });
    }
    function shown(n) {
      if (!n || !document.documentElement.contains(n)) return false;
      var cs = getComputedStyle(n);
      return cs.display !== 'none' && cs.visibility !== 'hidden' && n.getClientRects().length > 0;
    }
    function focusEl(n) { if (!n) return; try { n.focus({ preventScroll: true }); } catch (e) { try { n.focus(); } catch (x) {} } }

    /* ----- seQura: pedir já a biblioteca oficial (prioridade baixa), com a mesma configuração da app seQura ----- */
    function sequraBoot(c, dec, thou) {
      var S = window.Sequra;
      if (S && typeof S.computeCreditAgreements === 'function') return;
      if (window.SequraConfiguration || window.__lodpSqBoot) return;
      if (!c.merchant || !c.assetKey) return;
      window.__lodpSqBoot = 1;
      var g = {
        merchant: c.merchant,
        assetKey: c.assetKey,
        products: [c.product],
        scriptUri: c.cdn + '/assets/sequra-checkout.min.js',
        decimalSeparator: dec,
        thousandSeparator: thou || '.',
        locale: c.locale,
        currency: 'EUR'
      };
      window.SequraConfiguration = g;
      window.SequraOnLoad = [];
      window.Sequra = { onLoad: function (cb) { window.SequraOnLoad.push(cb); } };
      var a = document.createElement('script');
      a.async = true;
      a.src = g.scriptUri;
      try { a.fetchPriority = 'low'; } catch (e) {}
      (document.head || document.documentElement).appendChild(a);
      /* Biblioteca carregada: a app seQura já não a volta a pedir nesta página (o widget dela não tem onde aparecer na ficha LOD) */
      window.Sequra.onLoad(function () { window.sequraWidgetsScriptLoaded = true; });
    }
    function sequraFn() { var S = window.Sequra; return S && typeof S.computeCreditAgreements === 'function' ? S : null; }

    function init(el) {
      if (!el || el.dataset.instReady === '1') return;
      el.dataset.instReady = '1';
      var cfg;
      try { cfg = JSON.parse(el.querySelector('[data-inst-config]').textContent); } catch (e) { return; }
      var fmt = moneyFormat(cfg.moneySample);
      var lang = cfg.lang || 'pt';
      var pctDec = lang === 'en' ? '.' : ',';
      function money(c) { return fmt.money(c); }
      function pct(bp) {
        var v = Number(bp);
        if (!isFinite(v)) return '—';
        var s = v === 0 ? '0' : (v / 100).toFixed(2);
        return s.replace('.', pctDec) + (PCT_SPACE[lang] ? ' %' : '%');
      }
      var host = el.closest('[data-lodp]') || document;
      var kRow = el.querySelector('[data-inst-row="klarna"]');
      var sRow = el.querySelector('[data-inst-row="sequra"]');
      var kText = kRow && kRow.querySelector('[data-k-text]');
      var kMore = kRow && kRow.querySelector('[data-k-more]');
      var sOr = sRow && sRow.querySelector('[data-s-or]');
      var sSolo = sRow && sRow.querySelector('[data-s-solo]');
      var sMore = sRow && sRow.querySelector('[data-s-more]');
      var sTaeg = sRow && sRow.querySelector('[data-s-taeg]');
      var dlg = el.querySelector('.lodp-inst__dlg');
      var st = { cents: Number(cfg.cents) || 0, kNa: false, sNa: false, sq: 'wait', plans: null, plansFor: -1 };

      function inRange(p) { return !!(p && p.on && st.cents >= p.min && st.cents <= p.max); }
      function layout() {
        var kShow = !!kRow && inRange(cfg.k) && !st.kNa;
        var sShow = !!sRow && inRange(cfg.s) && !st.sNa;
        if (kRow) kRow.hidden = !kShow;
        if (sRow) sRow.hidden = !sShow;
        el.classList.toggle('has-k', kShow);
        el.hidden = !(kShow || sShow);
      }

      /* ===== Klarna ===== */
      function klarnaText() {
        if (kText) kText.textContent = fill(cfg.t.k, { valor: money(Math.floor(st.cents / 3)) });
      }
      var kHost = null, kPl = null, kOpen = null;
      function kSdk() { return window.Klarna && Klarna.OnsiteMessaging && typeof Klarna.OnsiteMessaging.refresh === 'function'; }
      function kMount() {
        if (kPl || !kRow || !kSdk()) return !!kPl;
        kHost = document.createElement('div');
        kHost.setAttribute('aria-hidden', 'true');
        kHost.className = 'lodp-inst-klarna-host';
        kHost.style.cssText = 'position:absolute;left:-10000px;top:0;width:360px;visibility:hidden;pointer-events:none;';
        kPl = document.createElement('klarna-placement');
        kPl.setAttribute('data-key', 'credit-promotion-auto-size');
        kPl.setAttribute('data-locale', cfg.k.locale);
        kPl.setAttribute('data-purchase-amount', String(st.cents));
        kHost.appendChild(kPl);
        document.body.appendChild(kHost);
        try { Klarna.OnsiteMessaging.refresh(); } catch (e) {}
        kCheck();
        return true;
      }
      function kMsg() {
        var r = kPl && kPl.shadowRoot;
        var m = r && r.querySelector('[part~="osm-message"]');
        return m ? (m.textContent || '').replace(/\s+/g, ' ').trim() : '';
      }
      function kCta() { var r = kPl && kPl.shadowRoot; return r ? r.querySelector('[part~="osm-cta"]') : null; }
      /* Elegibilidade: a mensagem oficial tem de ter o 3 e um valor (ex.: «3 pagamentos de 241,73 €»); senão a linha sai */
      var kCheckToken = 0;
      function kHas(t) { return t.replace(/\D/g, '').indexOf(String(Math.floor(st.cents / 3))) >= 0 && /(^|\D)3(\D|$)/.test(t); }
      function kCheck() {
        if (!kPl) return;
        var token = ++kCheckToken, want = String(st.cents);
        poll(function () {
          var t = kMsg();
          /* resposta da Klarna para este valor: ou tem a prestação certa, ou não tem prestação nenhuma («Paga depois») */
          return kPl.getAttribute('data-purchase-amount') === want && /\d/.test(t) && (kHas(t) || !/\d[.,]\d{2}(\D|$)/.test(t));
        }, 8000, function (ok) {
          if (token !== kCheckToken || !ok) return;
          var valid = kHas(kMsg());
          if (st.kNa !== !valid) { st.kNa = !valid; layout(); }
        }, 250);
      }
      function kWatch() {
        var o = kOpen = { t0: Date.now(), seen: false };
        var timer = setInterval(function () {
          if (kOpen !== o) { clearInterval(timer); return; }
          var m = document.getElementById('klarna-fullscreen-shadow-dom');
          var on = !!(m && shown(m));
          if (on) o.seen = true;
          if ((o.seen && !on) || (!o.seen && Date.now() - o.t0 > 4000)) {
            clearInterval(timer);
            kOpen = null;
            var a = document.activeElement;
            if (o.seen && (!a || a === document.body || a === document.documentElement || (kHost && kHost.contains(a)))) focusEl(kMore);
          }
        }, 200);
      }
      if (kMore) {
        var warm = function () { if (!kPl) kMount(); };
        kMore.addEventListener('pointerenter', warm);
        kMore.addEventListener('focus', warm);
        kMore.addEventListener('touchstart', warm, { passive: true });
        kMore.addEventListener('click', function (e) {
          var c = kCta();
          if (!c) return;            /* sem SDK: o link abre a página oficial da Klarna */
          e.preventDefault();
          c.click();                 /* modal oficial da Klarna */
          kWatch();
        });
      }
      function klarnaUpdate() {
        klarnaText();
        if (!kPl) return;
        kPl.setAttribute('data-purchase-amount', String(st.cents));
        try { if (kSdk()) Klarna.OnsiteMessaging.refresh(); } catch (e) {}
        kCheck();
      }

      /* ===== seQura ===== */
      function isFree(p) { return num(p.apr) === 0 && num(p.cost_of_credit) === 0; }
      function sequraPlans(cents) {
        var S = sequraFn();
        if (!S) return null;
        var r = S.computeCreditAgreements({ amount: String(cents), product: cfg.s.product });
        var list = (r && r[cfg.s.product]) || [];
        return list
          .filter(function (p) { return p && p.available && p.instalment_count > 0; })
          .sort(function (a, b) { return a.instalment_count - b.instalment_count; });
      }
      function setN(n) {
        if (sOr) sOr.textContent = fill(cfg.t.sOr, { n: String(n) });
        if (sSolo) sSolo.textContent = fill(cfg.t.sSolo, { n: String(n) });
      }
      function sequraRender() {
        if (!sRow) return;
        if (!inRange(cfg.s)) { layout(); return; }
        var plans = null;
        try { plans = sequraPlans(st.cents); } catch (e) { plans = null; }
        if (plans === null) return false;          /* biblioteca ainda não pronta */
        if (!plans.length) return false;
        st.plans = plans; st.plansFor = st.cents; st.sNa = false;
        var top = plans[plans.length - 1];
        setN(top.instalment_count);
        var costed = plans.filter(function (p) { return !isFree(p); });
        if (sTaeg) {
          sTaeg.textContent = cfg.t.taeg + (lang === 'fr' ? ' : ' : ': ') + (costed.length
            ? costed.map(function (p) { return p.instalment_count + 'x ' + pct(num(p.apr)); }).join(' · ')
            : pct(0));
          sTaeg.removeAttribute('data-inst-pending');
        }
        dialogFill();
        layout();
        return true;
      }
      function sequraLibReady() {
        var S = sequraFn();
        if (!S) return false;
        try {
          var r = S.computeCreditAgreements({ amount: String(Math.max(st.cents, cfg.s.min)), product: cfg.s.product });
          var l = r && r[cfg.s.product];
          return !!(l && l.length);
        } catch (e) { return false; }
      }
      function sequraWait(cb) {
        /* espera pela biblioteca: a nossa (pedida já) ou, se falhar, a da app seQura depois do «load» */
        var t0 = Date.now(), loaded = document.readyState === 'complete', tLoad = loaded ? t0 : 0;
        if (!loaded) window.addEventListener('load', function () { tLoad = Date.now(); }, { once: true });
        (function tick() {
          if (sequraLibReady()) return cb(true);
          if (tLoad && Date.now() - tLoad > SEQURA_WAIT) return cb(false);
          setTimeout(tick, sequraFn() ? 250 : 150);
        })();
      }

      /* ----- Diálogo «Saber mais» da seQura (modal nativo: foco dentro, Tab fica dentro, Escape fecha) ----- */
      var dlgStatus = dlg && dlg.querySelector('[data-dlg-status]');
      var dlgBody = dlg && dlg.querySelector('[data-dlg-body]');
      var dlgOfficial = dlg && dlg.querySelector('[data-dlg-official]');
      var toOfficial = false;
      function dialogFill() {
        if (!dlg || !st.plans || st.plansFor !== st.cents) return;
        var plans = st.plans, top = plans[plans.length - 1];
        var costed = plans.filter(function (p) { return !isFree(p); });
        dlg.querySelector('[data-dlg-plans-title]').textContent = fill(cfg.t.plansTitle, { preco: money(st.cents) });
        var ul = dlg.querySelector('[data-dlg-plans]');
        ul.textContent = '';
        plans.forEach(function (p) {
          var li = document.createElement('li');
          li.textContent = fill(cfg.t.plan, { n: String(p.instalment_count), valor: money(num(p.instalment_total)), taeg: pct(num(p.apr)), total: money(num(p.grand_total)) });
          ul.appendChild(li);
        });
        var ex = dlg.querySelector('[data-dlg-example]');
        var ref = costed.length ? costed[costed.length - 1] : null;
        if (ref) {
          var n = ref.instalment_count, inst = num(ref.instalment_total), grand = num(ref.grand_total);
          var down = num(ref.down_payment_total); if (!isFinite(down)) down = inst;
          var rest = num(ref.remaining_instalment_count); if (!isFinite(rest)) rest = n - 1;
          var credit = num(ref.drawdown_payment_amount); if (!isFinite(credit)) credit = st.cents - down;
          var last = n >= 2 ? grand - down - (n - 2) * inst : inst;
          var ultima = (isFinite(last) && last > 0 && Math.abs(last - inst) >= 1) ? fill(cfg.t.exLast, { x: money(last) }) : '';
          var text = fill(cfg.t.ex, {
            preco: money(st.cents), n: String(n), valor: money(inst), ultima: ultima,
            custo_mes: money(num(ref.instalment_fee)), sinal: money(down), resto: String(rest),
            credito: money(credit), meses: String(rest), tan: pct(num(ref.interest)), taeg: pct(num(ref.apr)),
            custo_credito: money(num(ref.cost_of_credit)), total: money(grand)
          });
          if (num(top.over_max) > 0) text += ' ' + fill(cfg.t.over, { max: money(num(top.max_financed_amount)) });
          ex.textContent = text;
          ex.hidden = false;
        } else {
          ex.textContent = '';
          ex.hidden = true;
        }
        if (dlgStatus) dlgStatus.hidden = true;
        if (dlgBody) dlgBody.hidden = false;
      }
      function dialogOpen() {
        if (!dlg) return;
        if (st.plans && st.plansFor === st.cents) dialogFill();
        else if (st.sq === 'fail' && dlgStatus) { dlgStatus.textContent = cfg.t.fail; dlgStatus.hidden = false; if (dlgBody) dlgBody.hidden = true; }
        toOfficial = false;
        if (typeof dlg.showModal === 'function') { if (!dlg.open) dlg.showModal(); }
        else dlg.setAttribute('open', '');
        if (sMore) sMore.setAttribute('aria-expanded', 'true');
        focusEl(dlg.querySelector('[data-dlg-close]'));
      }
      function dialogClose() {
        if (!dlg) return;
        if (typeof dlg.close === 'function') { if (dlg.open) dlg.close(); }
        else { dlg.removeAttribute('open'); onDialogClose(); }
      }
      function onDialogClose() {
        if (sMore) sMore.setAttribute('aria-expanded', 'false');
        if (toOfficial) { toOfficial = false; sqWatch(); return; }
        setTimeout(function () { focusEl(sMore); }, 0);
      }
      if (dlg) {
        dlg.addEventListener('close', onDialogClose);
        dlg.addEventListener('click', function (e) { if (e.target === dlg) dialogClose(); });   /* clique no fundo */
        var x = dlg.querySelector('[data-dlg-close]');
        if (x) x.addEventListener('click', dialogClose);
      }
      if (sMore) { sMore.setAttribute('aria-expanded', 'false'); sMore.addEventListener('click', dialogOpen); }

      /* ----- Simulador oficial seQura (pop-up da seQura): o foco entra, Escape fecha, o foco volta ao «Saber mais» ----- */
      var sqOpen = null;
      function sqFrame() {
        var ws = document.querySelectorAll('.Sequra__EducationalPopupWrapper');
        for (var i = ws.length - 1; i >= 0; i--) {
          var f = ws[i].querySelector('iframe.Sequra__EducationalPopup') || ws[i].querySelector('iframe');
          if (f && shown(ws[i]) && shown(f)) return f;
        }
        return null;
      }
      function sqClose() {
        var o = sqOpen;
        if (!o) return;
        sqOpen = null;
        clearInterval(o.timer);
        document.removeEventListener('keydown', o.onKey, true);
        document.removeEventListener('focusin', o.onFocus, true);
        setTimeout(function () { focusEl(sMore); }, 0);
      }
      function sqWatch() {
        if (sqOpen) return;
        poll(sqFrame, 3000, function (ok) {
          var f = ok ? sqFrame() : null;
          if (!f) { focusEl(sMore); return; }
          var o = sqOpen = { frame: f };
          if (!f.getAttribute('title')) f.setAttribute('title', dlgOfficial ? dlgOfficial.textContent : 'seQura');
          focusEl(f);
          f.addEventListener('load', function () { if (sqOpen === o && document.activeElement !== f) focusEl(f); });
          o.onKey = function (e) {
            if (sqOpen !== o || (e.key !== 'Escape' && e.key !== 'Esc')) return;
            e.preventDefault();
            var w = f.closest('.Sequra__EducationalPopupWrapper') || f;
            if (w.parentNode) w.parentNode.removeChild(w);   /* o mesmo que a seQura faz ao fechar */
            sqClose();
          };
          o.onFocus = function (e) {
            if (sqOpen !== o) return;
            var w = f.closest('.Sequra__EducationalPopupWrapper');
            if (e.target !== f && !(w && w.contains(e.target))) focusEl(f);
          };
          document.addEventListener('keydown', o.onKey, true);
          document.addEventListener('focusin', o.onFocus, true);
          o.timer = setInterval(function () { if (sqOpen === o && !shown(f)) sqClose(); }, 250);
        }, 100);
      }
      if (dlgOfficial) {
        dlgOfficial.addEventListener('click', function () {
          /* o pop-up da seQura abre por baixo de um <dialog> modal: fechar primeiro o nosso */
          toOfficial = true;
          dialogClose();
          if (!sequraFn()) { toOfficial = false; focusEl(sMore); }
        });
      }
      function officialAmount() {
        if (!dlgOfficial || dlgOfficial.getAttribute('data-amount') === String(st.cents)) return;
        dlgOfficial.setAttribute('data-amount', String(st.cents));
        try { var S = sequraFn(); if (S && typeof S.refreshComponents === 'function') S.refreshComponents(); } catch (e) {}
      }

      /* ===== A app Klarna lê ?variant= (ou a 1.ª variante): alinhar com a variante mostrada ===== */
      if (kRow && cfg.variantId && cfg.firstVariantId && cfg.variantId !== cfg.firstVariantId) {
        try {
          var u = new URL(window.location.href);
          if (!u.searchParams.get('variant')) {
            u.searchParams.set('variant', cfg.variantId);
            window.history.replaceState(window.history.state, '', u.toString());
          }
        } catch (e) {}
      }

      /* ===== Mudança de variante (evento emitido pela ficha) ===== */
      host.addEventListener('lodp:variant-change', function (event) {
        var v = event.detail && event.detail.variant;
        var cents = v ? Number(v.cents) : NaN;
        if (!isFinite(cents) || cents === st.cents) return;
        st.cents = cents;
        st.kNa = false;
        klarnaUpdate();
        if (sRow) {
          officialAmount();
          if (st.sq === 'ok') {
            st.sNa = false;
            if (sequraRender() !== true && inRange(cfg.s)) { st.sNa = true; }
          }
        }
        layout();
      });

      /* ===== Arranque ===== */
      layout();
      if (sRow) {
        sequraBoot(cfg.s, fmt.dec, fmt.thou);
        sequraWait(function (ok) {
          st.sq = ok ? 'ok' : 'fail';
          if (ok && inRange(cfg.s) && sequraRender() !== true) { st.sNa = true; layout(); }
          if (ok) { try { var S = sequraFn(); if (S && typeof S.refreshComponents === 'function') S.refreshComponents(); } catch (e) {} }
          if (!ok) {
            /* Sem dados da seQura não se pode mostrar «até [n]x» sem a TAEG: a linha sai */
            if (cfg.s.taeg !== false) { st.sNa = true; layout(); }
            if (dlg && dlg.open && dlgStatus) { dlgStatus.textContent = cfg.t.fail; dlgStatus.hidden = false; }
            return;
          }
          officialAmount();
        });
      }
      if (kRow) {
        afterLoad(function () {
          poll(kSdk, KLARNA_WAIT, function (ok) {
            if (!ok) return;
            var go = function () { kMount(); };
            if (window.requestIdleCallback) requestIdleCallback(go, { timeout: 3000 }); else setTimeout(go, 1200);
          }, 300);
        });
      }
    }

    function initAll(scope) { (scope || document).querySelectorAll('[data-lodp-inst]').forEach(init); }
    initAll(document);
    if (!window.__lodpInstListen) {
      window.__lodpInstListen = true;
      document.addEventListener('shopify:section:load', function (event) { initAll(event.target); });
    }
  })();
</script>
{%- endif -%}
