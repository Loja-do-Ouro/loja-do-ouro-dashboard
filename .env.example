# Dashboard protection (server-only). Changing the password ends every open session.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Vercel Cron secret: protects /api/cron/ingest (nightly) and /api/cron/refresh (monitor)
CRON_SECRET=

# Windsor.ai (server-only): Meta, Google Ads, GA4, Klaviyo, Search Console, Merchant
WINDSOR_API_KEY=
# Optional account overrides; defaults are in lib/bi/accounts.ts
WINDSOR_SHOPIFY_ACCOUNT_ID=lojadoouro-online.myshopify.com
WINDSOR_META_ACCOUNT_ID=189245068300417
WINDSOR_GOOGLE_ACCOUNT_ID=266-236-4039
WINDSOR_GA4_ACCOUNT_ID=292767515

# Shopify Admin API (server-only), custom app with read_reports and read_orders.
# Supplies the official sales report, sessions, fulfillments and the order cohort.
SHOPIFY_STORE_DOMAIN=lojadoouro-online.myshopify.com
SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2026-07

# Private BI store. Only used server-side; never use NEXT_PUBLIC_ credentials.
# With these set, the dashboard reads the stored closes instead of querying Windsor.
BI_SUPABASE_URL=https://eblxrzsjocvzjewrapnh.supabase.co
# Required by the nightly ingestion to write the ldo_bi_* tables (server-only secret).
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively, read-only access with a BI member JWT, which preserves RLS:
BI_SUPABASE_PUBLISHABLE_KEY=
BI_SUPABASE_ACCESS_TOKEN=

# Emergency only: publish a code fix while a data source is down (login still checked).
# RELEASE_SKIP_DATA_CHECK=1
