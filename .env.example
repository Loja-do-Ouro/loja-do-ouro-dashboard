# Dashboard protection (server-only). Changing the password ends every open session.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Vercel Cron secret: protects /api/cron/ingest (nightly) and /api/cron/refresh (monitor)
CRON_SECRET=

# Windsor.ai (server-only): Meta, Google Ads, GA4, Klaviyo, Search Console, Merchant
WINDSOR_API_KEY=
# Optional account overrides; defaults are in lib/bi/accounts.ts
WINDSOR_SHOPIFY_ACCOUNT_ID=lojadoouro-online.myshopify.com
WINDSOR_META_ACCOUNT_ID=189245068300417
WINDSOR_GOOGLE_ACCOUNT_ID=266-236-4039
WINDSOR_GA4_ACCOUNT_ID=292767515

# Shopify Admin API (server-only), custom app with read_reports and read_orders.
# Supplies the official sales report, sessions, fulfillments and the order cohort.
SHOPIFY_STORE_DOMAIN=lojadoouro-online.myshopify.com
SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2026-07

# Private BI store. Only used server-side; never use NEXT_PUBLIC_ credentials.
# With these set, the dashboard reads the stored closes instead of querying Windsor.
BI_SUPABASE_URL=https://eblxrzsjocvzjewrapnh.supabase.co
# Required by the nightly ingestion to write the ldo_bi_* tables (server-only secret).
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively, read-only access with a BI member JWT, which preserves RLS:
BI_SUPABASE_PUBLISHABLE_KEY=
BI_SUPABASE_ACCESS_TOKEN=

# Emergency only: publish a code fix while a data source is down (login still checked).
# RELEASE_SKIP_DATA_CHECK=1

# Apoio ao Cliente (server-only). Reuses METRICOOL_USER_TOKEN and BI_INGEST_TOKEN.
# Zendesk OAuth client "lojadoouro_apoio_cliente" (scopes tickets:read tickets:write users:read).
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
# Optional; defaults to goldstorepremium.
# ZENDESK_SUBDOMAIN=goldstorepremium
# 32 random bytes in base64; encrypts the Zendesk tokens stored in Supabase. Changing it requires reconnecting Zendesk.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SUPPORT_ENCRYPTION_KEY=
# Optional: fixed public URL used to build the OAuth redirect (defaults to the Vercel production domain).
# SUPPORT_PUBLIC_URL=https://loja-do-ouro-dashboard.vercel.app
# Email do apoio diretamente pelo Gmail (Google Workspace), replacing Zendesk. Google Cloud project
# "dashboard-loja-do-ouro": OAuth client (Web, Internal audience, scope gmail.modify) with the redirect URI
# <production>/api/support/gmail/callback, and Pub/Sub topic + push subscription (OIDC auth with the service account
# below, audience = endpoint <production>/api/support/webhooks/gmail). The Super Admin connects the mailbox in
# /apoio/configuracao (production only). Tokens are encrypted with SUPPORT_ENCRYPTION_KEY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# projects/<project>/topics/<topic> (gmail-api-push@system.gserviceaccount.com needs Pub/Sub Publisher on it).
GMAIL_PUBSUB_TOPIC=
# Service account the push subscription signs its tokens with (only these tokens are accepted).
GMAIL_PUSH_SERVICE_ACCOUNT=
# Optional: mailbox (default apoiocliente@lojadoouro.pt), redirect URI and push audience overrides.
# GMAIL_MAILBOX=apoiocliente@lojadoouro.pt
# GMAIL_REDIRECT_URI=https://loja-do-ouro-dashboard.vercel.app/api/support/gmail/callback
# GMAIL_PUSH_AUDIENCE=https://loja-do-ouro-dashboard.vercel.app/api/support/webhooks/gmail
# Folha das lojas (Google Sheets "Análise de Vendas"): reuses GOOGLE_CLIENT_ID/SECRET and SUPPORT_ENCRYPTION_KEY.
# Add <production>/api/admin/folha-lojas/callback as an Authorized redirect URI of the same OAuth client, enable the
# Google Sheets API and add the spreadsheets.readonly scope to the consent screen. Optional override:
# STORE_SHEET_REDIRECT_URI=https://loja-do-ouro-dashboard.vercel.app/api/admin/folha-lojas/callback
# WhatsApp Cloud API: next phase, not configured.
# WHATSAPP_ACCESS_TOKEN= WHATSAPP_PHONE_NUMBER_ID= WHATSAPP_APP_SECRET= WHATSAPP_VERIFY_TOKEN=

# Assistente de IA do Apoio ao Cliente (server-only, mark as Sensitive in Vercel).
# Create at console.anthropic.com -> API Keys. Without it the AI tab shows "por configurar".
ANTHROPIC_API_KEY=
# Only for keys not scoped to a workspace ("This API key is not scoped to a workspace"): the workspace ID
# (wrkspc_..., Claude Console -> Settings -> Workspaces), sent as the anthropic-workspace-id header. Not a secret.
ANTHROPIC_WORKSPACE_ID=

# Chat do site (botão no tema Shopify). Optional; all server-only.
# Same random value as the theme setting "Chave de verificação": confirms the email of logged-in customers.
SITE_CHAT_SECRET=
# Comma-separated https origins allowed to use the chat (default: www.lojadoouro.pt, lojadoouro.pt, lojadoouro-online.myshopify.com).
# SITE_CHAT_ORIGINS=
# Sender of support emails (chat replies to customers, transfer notices to colleagues). Needs lojadoouro.pt verified in Resend.
# SUPPORT_EMAIL_FROM=Loja do Ouro <apoiocliente@lojadoouro.pt>
# SITE_CHAT_FROM=Loja do Ouro <apoio@lojadoouro.pt>   (older name, still accepted)
# Reply-to and the site link in the chat reply emails.
# SITE_CHAT_REPLY_TO=apoiocliente@lojadoouro.pt
# SITE_CHAT_URL=https://www.lojadoouro.pt
